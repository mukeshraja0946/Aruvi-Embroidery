<%- include('../partials/header') %>

<div class="container" style="margin-top: 1.8rem; margin-bottom: 2.2rem;">
  <div style="max-width: 480px; margin: 0 auto; background: #FFFFFF; border: 1px solid var(--border-light); border-radius: 18px; padding: 2rem 2.2rem; box-shadow: 0 10px 30px rgba(0,0,0,0.04);">
    
    <div style="text-align: center; margin-bottom: 1.2rem;">
      <% if (siteSettings && siteSettings.logo_url) { %>
        <img src="<%= siteSettings.logo_url %>" alt="ARUVI EMBROIDERY STUDIO" style="max-height: 50px; width: auto; margin: 0 auto 0.6rem; object-fit: contain;">
      <% } else { %>
        <img src="/public/images/logo.jpg" alt="ARUVI EMBROIDERY STUDIO" style="max-height: 50px; width: auto; margin: 0 auto 0.6rem; object-fit: contain;">
      <% } %>
      <h2 style="font-family: var(--font-heading); font-size: 1.75rem; color: var(--text-dark); margin-bottom: 0.3rem;">Welcome to Aruvi Embroidery</h2>
      <p style="color: var(--text-muted); font-size: 0.88rem; line-height: 1.4;">Sign in to discover beautiful embroidery designs and access your purchases.</p>
    </div>

    <% 
      const _hasFlashErr = (typeof flash !== 'undefined' && flash && flash.error && flash.error.length > 0);
      const _flashErrMsg = _hasFlashErr ? flash.error[0] : '';
    %>
    <div id="loginErrorAlert" class="alert alert-error" style="display: <%= _hasFlashErr ? 'flex' : 'none' %>; margin-bottom: 1rem; border-radius: 10px; font-size: 0.85rem; align-items: center; gap: 8px;">
      <i class="fa-solid fa-circle-exclamation"></i>
      <span id="loginErrorMessage"><%= _flashErrMsg %></span>
    </div>

    <%- include('../partials/auth-methods', { mode: 'login', isModal: false, returnTo: typeof returnTo !== 'undefined' ? returnTo : '' }) %>

  </div>
</div>

<% if (typeof flash !== 'undefined' && flash && flash.account_not_found && flash.account_not_found.length > 0) { %>
  <!-- Account Not Found Modal Popup matching Requirement 3 -->
  <div id="accountNotFoundModal" style="position: fixed; inset: 0; background: rgba(0,0,0,0.6); z-index: 9999; display: flex; align-items: center; justify-content: center; backdrop-filter: blur(4px);">
    <div style="background: #FFFFFF; border-radius: 18px; max-width: 440px; width: 90%; padding: 2.2rem; box-shadow: 0 20px 40px rgba(0,0,0,0.2); text-align: center; border: 1px solid var(--border-light);">
      <div style="width: 60px; height: 60px; border-radius: 50%; background: #FDE8E8; color: #C62828; display: flex; align-items: center; justify-content: center; font-size: 1.8rem; margin: 0 auto 1.2rem;">
        <i class="fa-solid fa-user-xmark"></i>
      </div>

      <h3 style="font-family: var(--font-heading); font-size: 1.6rem; font-weight: 700; color: var(--text-dark); margin-bottom: 0.6rem;">Account not found</h3>
      
      <p style="font-size: 0.92rem; color: var(--text-muted); line-height: 1.5; margin-bottom: 1.8rem;">
        We couldn't find an account with this email address. Please create an account to continue.
      </p>

      <div style="display: flex; gap: 1rem; justify-content: center;">
        <button type="button" onclick="document.getElementById('accountNotFoundModal').style.display='none'" class="btn btn-outline" style="flex: 1; height: 44px; border-radius: 10px; font-weight: 600; background: #FFF;">
          Close
        </button>
        <a href="/auth/register<%= typeof returnTo !== 'undefined' && returnTo ? '?returnTo=' + encodeURIComponent(returnTo) : '' %>" class="btn btn-primary" style="flex: 1.2; height: 44px; border-radius: 10px; font-weight: 600; display: flex; align-items: center; justify-content: center; text-decoration: none;">
          Create Account
        </a>
      </div>
    </div>
  </div>
<% } %>

<script>
  const configuredGoogleClientId = "<%= process.env.GOOGLE_CLIENT_ID || '' %>";

  function showLoginError(msg) {
    const alertBox = document.getElementById('loginErrorAlert');
    const msgSpan = document.getElementById('loginErrorMessage');
    if (alertBox && msgSpan) {
      msgSpan.textContent = msg;
      alertBox.style.display = 'flex';
    } else {
      alert(msg);
    }
  }

  const toggleBtn = document.getElementById('togglePasswordBtn');
  if (toggleBtn) {
    toggleBtn.addEventListener('click', function() {
      const pwdInput = document.getElementById('customerPassword');
      if (pwdInput) {
        if (pwdInput.type === 'password') {
          pwdInput.type = 'text';
          this.classList.remove('fa-eye');
          this.classList.add('fa-eye-slash');
        } else {
          pwdInput.type = 'password';
          this.classList.remove('fa-eye-slash');
          this.classList.add('fa-eye');
        }
      }
    });
  }

  function triggerGoogleSignIn() {
    if (!configuredGoogleClientId || configuredGoogleClientId === 'sample-google-client-id') {
      showLoginError('Google Sign-In is not currently configured with a valid Google Client ID. Please sign in with your email address.');
      return;
    }
    // Full-page OAuth flow: navigates top-level main window directly to Google without popup/iframe issues
    window.location.href = '/auth/google';
  }
</script>

<%- include('../partials/footer') %>
