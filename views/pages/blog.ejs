<%- include('../partials/header') %>

<div class="container" style="margin-top: 2rem; margin-bottom: 5rem;">
  <!-- Breadcrumb Trail -->
  <div class="breadcrumb-trail" style="margin-bottom: 1.5rem;">
    <a href="/">Home</a> &nbsp;>&nbsp; <span>Blog & Guides</span>
  </div>

  <!-- Page Banner -->
  <div class="page-banner-card" style="margin-bottom: 3rem; padding: 2.5rem 3rem;">
    <div class="banner-content" style="max-width: 650px;">
      <h1 class="page-banner-title" style="font-size: 2.8rem;">
        ARUVI <span style="color: var(--primary);">Embroidery Journal</span>
      </h1>
      <h3 style="font-family: var(--font-heading); font-size: 1.25rem; font-weight: 600; color: var(--text-dark); margin-bottom: 0.8rem;">
        Master Digitizing Guides, Embroidery Tips & Studio Insights
      </h3>
      <p class="page-banner-subtitle" style="font-size: 0.95rem; margin-bottom: 1.5rem; line-height: 1.6;">
        Explore expert articles on machine formats (DST, PES, JEF, EXP), stabilizer selection, bridal blouse placement techniques, and digitizing best practices.
      </p>
    </div>

    <div class="banner-image-box" style="width: 380px; height: 230px; position: relative;">
      <img src="/public/images/hero_embroidery.jpg" alt="ARUVI Embroidery Journal">
    </div>
  </div>

  <!-- Empty State / Upcoming Blog Articles Box -->
  <div style="background: #FFF; border: 1px solid var(--border-light); border-radius: 20px; padding: 3.5rem 2rem; text-align: center; max-width: 860px; margin: 0 auto 4rem; box-shadow: var(--shadow-sm);">
    <div style="width: 80px; height: 80px; background: #FAF6F0; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem; color: var(--primary); font-size: 2.2rem; border: 1px solid #E8E0D5;">
      <i class="fa-solid fa-pen-nib"></i>
    </div>
    
    <h2 style="font-family: var(--font-heading); font-size: 1.9rem; font-weight: 700; color: var(--text-dark); margin-bottom: 0.8rem;">
      Embroidery Guides & Articles Coming Soon!
    </h2>
    
    <p style="font-size: 0.98rem; color: var(--text-muted); max-width: 620px; margin: 0 auto 2rem; line-height: 1.7;">
      Our master digitizers and embroidery specialists are crafting detailed tutorials on machine format conversion, hoop tension, thread pairing, and bridal neck embroidery trends. Stay tuned!
    </p>

    <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
      <a href="/designs" class="btn btn-primary btn-md">
        <i class="fa-solid fa-shapes"></i> Browse Embroidery Designs
      </a>
      <a href="/custom-order" class="btn btn-outline btn-md">
        <i class="fa-solid fa-wand-magic-sparkles"></i> Request Custom Design
      </a>
    </div>
  </div>

  <!-- Featured Topic Categories Preview -->
  <div style="margin-bottom: 2rem;">
    <h3 style="font-family: var(--font-heading); font-size: 1.6rem; font-weight: 700; color: var(--text-dark); text-align: center; margin-bottom: 2rem;">
      Upcoming Topic Highlights
    </h3>

    <div class="grid-3">
      <div class="mission-vision-card" style="background: #FAF6F0; border: 1px solid #E8E0D5;">
        <div class="mv-icon-badge" style="background: #231815; color: #E5C396;"><i class="fa-solid fa-file-code"></i></div>
        <h3 class="mv-card-title">Machine Format Compatibility</h3>
        <p class="mv-card-text">
          Understanding the differences between DST, PES, JEF, and EXP machine files, and how to transfer them seamlessly via USB to Tajima, Brother, Janome, and Bernina machines.
        </p>
      </div>

      <div class="mission-vision-card" style="background: #FAF6F0; border: 1px solid #E8E0D5;">
        <div class="mv-icon-badge" style="background: #231815; color: #E5C396;"><i class="fa-solid fa-gem"></i></div>
        <h3 class="mv-card-title">Bridal Blouse Digitizing</h3>
        <p class="mv-card-text">
          Step-by-step techniques for positioning intricate zardosi, peacocks, temple borders, and floral motifs on silk blouse necklines for high-density stitching.
        </p>
      </div>

      <div class="mission-vision-card" style="background: #FAF6F0; border: 1px solid #E8E0D5;">
        <div class="mv-icon-badge" style="background: #231815; color: #E5C396;"><i class="fa-solid fa-scissors"></i></div>
        <h3 class="mv-card-title">Stabilizer & Thread Guide</h3>
        <p class="mv-card-text">
          Choosing the right tear-away, cut-away, or water-soluble stabilizers and rayon/polyester thread weights to prevent puckering on delicate fabrics.
        </p>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
