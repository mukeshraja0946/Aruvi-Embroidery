<%- include('../partials/header') %>

<div class="container" style="margin-top: 2rem; margin-bottom: 5rem;">
  <!-- Breadcrumb Trail -->
  <div class="breadcrumb-trail" style="margin-bottom: 1.5rem;">
    <a href="/">Home</a> &nbsp;>&nbsp; <span>Custom Order</span>
  </div>

  <!-- Hero Banner matching Reference -->
  <div class="page-banner-card" style="margin-bottom: 3rem; padding: 3rem;">
    <div class="banner-content" style="max-width: 680px;">
      <h1 class="page-banner-title" style="font-size: 3.2rem;">
        Request a <span class="highlight-italic">Custom</span> Design
      </h1>
      <p class="page-banner-subtitle" style="font-size: 1.05rem; margin-bottom: 2rem;">
        Share your ideas and get a unique embroidery design crafted just for you. Perfect for personal use, business, branding and more.
      </p>

      <!-- 4 Hero Feature Badges Row -->
      <div style="display: flex; gap: 1.2rem; flex-wrap: wrap;">
        <div class="hero-pill-item" style="font-size: 0.82rem;">
          <div class="pill-icon" style="width: 32px; height: 32px; font-size: 0.85rem;"><i class="fa-solid fa-pen-nib"></i></div>
          <span>Unique & Original Designs</span>
        </div>
        <div class="hero-pill-item" style="font-size: 0.82rem;">
          <div class="pill-icon" style="width: 32px; height: 32px; font-size: 0.85rem;"><i class="fa-solid fa-clock"></i></div>
          <span>Fast Turnaround Time</span>
        </div>
        <div class="hero-pill-item" style="font-size: 0.82rem;">
          <div class="pill-icon" style="width: 32px; height: 32px; font-size: 0.85rem;"><i class="fa-solid fa-shield-halved"></i></div>
          <span>High-Quality Machine Fills</span>
        </div>
        <div class="hero-pill-item" style="font-size: 0.82rem;">
          <div class="pill-icon" style="width: 32px; height: 32px; font-size: 0.85rem;"><i class="fa-solid fa-headset"></i></div>
          <span>Dedicated Support</span>
        </div>
      </div>
    </div>

    <div class="banner-image-box" style="width: 380px; height: 220px;">
      <img src="/public/images/hero_embroidery.jpg" alt="Custom Design Digitization Studio">
    </div>
  </div>

  <!-- Main Custom Order Layout Grid (Left Form + Right Sidebar) -->
  <div class="checkout-main-grid">
    <!-- Left Main Custom Order Form Container -->
    <div class="checkout-form-container">
      <!-- 3-Step Progress Indicator Bar matching Reference -->
      <div class="checkout-steps-bar">
        <div class="step-item active">
          <div class="step-num">1</div>
          <div class="step-info">
            <strong>Design Details</strong>
            <span>Tell us about your design</span>
          </div>
        </div>
        <i class="fa-solid fa-chevron-right step-chevron"></i>
        
        <div class="step-item">
          <div class="step-num">2</div>
          <div class="step-info">
            <strong>Requirements</strong>
            <span>Provide specific details</span>
          </div>
        </div>
        <i class="fa-solid fa-chevron-right step-chevron"></i>

        <div class="step-item">
          <div class="step-num">3</div>
          <div class="step-info">
            <strong>Review & Submit</strong>
            <span>Check your information</span>
          </div>
        </div>
      </div>

      <!-- Request Form Box -->
      <div class="checkout-section-box">
        <form action="/custom-order?_csrf=<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" method="POST" enctype="multipart/form-data">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

          <!-- Design Title -->
          <div class="form-group-field" style="margin-bottom: 1.2rem;">
            <label>Design Title <span class="req">*</span></label>
            <input type="text" name="design_title" placeholder="E.g., Wedding Monogram, Logo Design, Name Design..." required>
          </div>

          <!-- Design Type & Purpose -->
          <div class="form-grid-2" style="margin-bottom: 1.2rem;">
            <div class="form-group-field">
              <label>Design Type <span class="req">*</span></label>
              <select name="design_type" required>
                <option value="">Select design type</option>
                <option value="Bridal Blouse">Bridal Blouse Design</option>
                <option value="Monogram">Wedding Monogram</option>
                <option value="Logo">Boutique Logo / Branding</option>
                <option value="Saree Border">Saree Border / Dupatta</option>
                <option value="Traditional">Traditional / Temple Art</option>
                <option value="Kids">Kids / Cartoon Art</option>
              </select>
            </div>

            <div class="form-group-field">
              <label>Purpose <span class="req">*</span></label>
              <select name="purpose" required>
                <option value="">Select purpose</option>
                <option value="Personal Use">Personal Use</option>
                <option value="Boutique Business">Boutique Business</option>
                <option value="Commercial Production">Commercial Production</option>
                <option value="Gift">Gift / Custom Present</option>
              </select>
            </div>
          </div>

          <!-- Design Description -->
          <div class="form-group-field" style="margin-bottom: 1.5rem; position: relative;">
            <label>Design Description <span class="req">*</span></label>
            <textarea name="design_details" rows="5" placeholder="Describe your design idea, theme, text, size, colors, style or any specific details..." required></textarea>
            <span style="position: absolute; right: 10px; bottom: 8px; font-size: 0.75rem; color: var(--text-muted);">0/500</span>
          </div>

          <!-- Lower 2-Column: Reference Images + Preferred Size & Formats -->
          <div class="form-grid-2" style="margin-bottom: 1.8rem;">
            <!-- Left: Reference Images Dropzone -->
            <div class="form-group-field">
              <label>Reference Images</label>
              <div class="dropzone-upload-box">
                <i class="fa-solid fa-cloud-arrow-up"></i>
                <p>Upload images (Optional)</p>
                <span>JPG, PNG (Max 10MB each)</span>
                <input type="file" name="reference_image" accept="image/*" class="dropzone-file-input">
              </div>
            </div>

            <!-- Right: Preferred Size & Formats -->
            <div style="display: flex; flex-direction: column; gap: 1.2rem;">
              <div class="form-group-field">
                <label>Preferred Size (Optional)</label>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px;">
                  <input type="text" name="width_mm" placeholder="Width (mm)">
                  <input type="text" name="height_mm" placeholder="Height (mm)">
                </div>
              </div>

              <div class="form-group-field">
                <label>Preferred Formats</label>
                <div style="display: flex; gap: 1rem; align-items: center; margin-top: 4px;">
                  <label class="checkbox-item" style="font-size: 0.85rem;"><input type="checkbox" name="formats" value="DST" checked> DST</label>
                  <label class="checkbox-item" style="font-size: 0.85rem;"><input type="checkbox" name="formats" value="PES"> PES</label>
                  <label class="checkbox-item" style="font-size: 0.85rem;"><input type="checkbox" name="formats" value="JEF"> JEF</label>
                  <label class="checkbox-item" style="font-size: 0.85rem;"><input type="checkbox" name="formats" value="EXP"> EXP</label>
                </div>
              </div>
            </div>
          </div>

          <!-- Primary Submit CTA Button -->
          <button type="submit" class="btn btn-primary btn-block place-order-btn" style="margin-top: 1rem;">
            Submit Custom Order <i class="fa-solid fa-arrow-right"></i>
          </button>
        </form>
      </div>
    </div>

    <!-- Right Sidebar Stack: "How It Works?" & "Need Help?" Cards -->
    <aside class="checkout-summary-sidebar">
      <!-- Card 1: How It Works? -->
      <div class="summary-box-card">
        <h3 class="summary-title" style="margin-bottom: 1.5rem;">How It Works?</h3>

        <div class="how-it-works-list">
          <div class="how-step-item">
            <div class="how-icon-box"><i class="fa-regular fa-file-lines"></i></div>
            <div>
              <h4>1. Submit Your Request</h4>
              <p>Share your design idea, details and reference images.</p>
            </div>
          </div>

          <div class="how-step-item">
            <div class="how-icon-box"><i class="fa-solid fa-magnifying-glass"></i></div>
            <div>
              <h4>2. Review & Quote</h4>
              <p>We will review your request and send you a quote.</p>
            </div>
          </div>

          <div class="how-step-item">
            <div class="how-icon-box"><i class="fa-regular fa-credit-card"></i></div>
            <div>
              <h4>3. Make Payment</h4>
              <p>After you approve the quote, complete the payment.</p>
            </div>
          </div>

          <div class="how-step-item">
            <div class="how-icon-box"><i class="fa-solid fa-gear"></i></div>
            <div>
              <h4>4. Design Creation</h4>
              <p>Our team will create and test the design.</p>
            </div>
          </div>

          <div class="how-step-item">
            <div class="how-icon-box"><i class="fa-solid fa-download"></i></div>
            <div>
              <h4>5. Get Your Files</h4>
              <p>Receive high-quality files in your selected formats.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Card 2: Need Help? -->
      <div class="trust-features-card" style="text-align: center; display: flex; flex-direction: column; align-items: center; padding: 2rem 1.5rem;">
        <div class="pill-icon" style="width: 50px; height: 50px; font-size: 1.3rem; margin-bottom: 0.8rem; background: #FFFFFF;"><i class="fa-solid fa-headset"></i></div>
        <h4 style="font-family: var(--font-heading); font-size: 1.2rem; font-weight: 700; color: var(--text-dark); margin-bottom: 0.3rem;">Need Help?</h4>
        <p style="font-size: 0.82rem; color: var(--text-muted); margin-bottom: 1.2rem; line-height: 1.5;">
          Have questions about custom designs?<br>We're here to help you.
        </p>
        <a href="/contact" class="btn btn-outline btn-block" style="border-radius: var(--radius-full); text-align: center;">
          Contact Us <i class="fa-solid fa-arrow-right"></i>
        </a>
      </div>
    </aside>
  </div>

  <!-- Bottom Feature Pills Bar matching Reference -->
  <div class="hero-feature-pills" style="margin-top: 4rem; background: #F6F1EA; border-radius: 16px; padding: 1.5rem 2rem;">
    <div class="hero-pill-item">
      <div class="pill-icon"><i class="fa-solid fa-award"></i></div>
      <div>
        <strong style="display: block; font-size: 0.88rem;">Premium Quality Designs</strong>
        <span style="font-size: 0.76rem; color: var(--text-muted);">Crafted with precision</span>
      </div>
    </div>
    <div class="hero-pill-item">
      <div class="pill-icon"><i class="fa-solid fa-download"></i></div>
      <div>
        <strong style="display: block; font-size: 0.88rem;">Instant Download</strong>
        <span style="font-size: 0.76rem; color: var(--text-muted);">Get files immediately</span>
      </div>
    </div>
    <div class="hero-pill-item">
      <div class="pill-icon"><i class="fa-solid fa-shield-halved"></i></div>
      <div>
        <strong style="display: block; font-size: 0.88rem;">100% Tested Machine Fills</strong>
        <span style="font-size: 0.76rem; color: var(--text-muted);">Quality assured designs</span>
      </div>
    </div>
    <div class="hero-pill-item">
      <div class="pill-icon"><i class="fa-solid fa-headset"></i></div>
      <div>
        <strong style="display: block; font-size: 0.88rem;">Dedicated Support</strong>
        <span style="font-size: 0.76rem; color: var(--text-muted);">We're here to help you</span>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
