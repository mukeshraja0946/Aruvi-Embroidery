<%- include('../partials/header') %>

<div class="container contact-page-container" style="margin-top: 1.5rem; margin-bottom: 5rem;">
  <!-- Breadcrumb & Section Title -->
  <div style="margin-bottom: 2rem;">
    <div class="breadcrumb-trail" style="margin-bottom: 0.5rem;">
      <a href="/">Home</a> &nbsp;>&nbsp; <span>Contact</span>
    </div>
    <h1 class="section-title" style="font-size: 2.4rem; margin-bottom: 0.2rem;">Contact Us</h1>
    <p style="color: var(--text-muted); font-size: 0.95rem;">Have a question, need a custom design, or want to collaborate? Fill out the form and we'll get back to you shortly.</p>
  </div>

  <!-- Main 3-Column Layout Grid (Form + Contact Info + Location & FAQs) -->
  <div class="contact-main-grid">
    <!-- Column 1: Send Us a Message Form Card -->
    <div class="checkout-section-box" style="margin-bottom: 0;">
      <div class="section-box-header">
        <div class="section-icon-badge"><i class="fa-regular fa-envelope"></i></div>
        <div>
          <h3>Send Us a Message</h3>
        </div>
      </div>

      <form action="/contact" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <!-- Anti-spam Honeypot field (hidden from real users) -->
        <div style="display: none !important; opacity: 0; position: absolute; left: -9999px;">
          <input type="text" name="website_url_hp" tabindex="-1" autocomplete="off">
        </div>

        <div class="form-grid-2" style="margin-bottom: 1.2rem;">
          <div class="form-group-field">
            <label>Full Name <span class="req">*</span></label>
            <input type="text" name="name" value="<%= currentUser ? currentUser.full_name : '' %>" placeholder="Enter your full name" required>
          </div>

          <div class="form-group-field">
            <label>Email Address <span class="req">*</span></label>
            <input type="email" name="email" value="<%= currentUser ? currentUser.email : '' %>" placeholder="you@example.com" required>
          </div>
        </div>

        <div class="form-grid-2" style="margin-bottom: 1.2rem;">
          <div class="form-group-field">
            <label>Subject <span class="req">*</span></label>
            <select name="subject" required>
              <option value="">Select a subject</option>
              <option value="General Inquiry">General Inquiry</option>
              <option value="Custom Order Question">Custom Order Question</option>
              <option value="File Download Help">File Download Help</option>
              <option value="Payment / Refund">Payment / Refund</option>
            </select>
          </div>

          <div class="form-group-field">
            <label>Phone Number (Optional)</label>
            <input type="tel" name="phone" placeholder="+91 98765 43210">
          </div>
        </div>

        <div class="form-group-field" style="margin-bottom: 1.5rem; position: relative;">
          <label>Message <span class="req">*</span></label>
          <textarea name="message" rows="5" placeholder="Tell us about your requirement..." required></textarea>
          <span style="position: absolute; right: 10px; bottom: 8px; font-size: 0.75rem; color: var(--text-muted);">0/500</span>
        </div>

        <button type="submit" class="btn btn-primary btn-block place-order-btn">
          <i class="fa-regular fa-paper-plane"></i> Send Message
        </button>
      </form>
    </div>

    <!-- Column 2: Contact Information Card -->
    <div class="summary-box-card" style="display: flex; flex-direction: column;">
      <div class="section-box-header">
        <div class="section-icon-badge"><i class="fa-solid fa-phone"></i></div>
        <div>
          <h3 style="font-size: 1.25rem;">Contact Information</h3>
          <p>We're always happy to help!</p>
        </div>
      </div>

      <div class="contact-info-list" style="display: flex; flex-direction: column; gap: 1.2rem; margin-bottom: 2rem;">
        <div class="contact-info-item" style="display: flex; gap: 12px; align-items: flex-start;">
          <div class="how-icon-box"><i class="fa-regular fa-envelope"></i></div>
          <div>
            <strong style="display: block; font-size: 0.9rem; color: var(--text-dark); margin-bottom: 1px;">Email Us</strong>
            <a href="mailto:aruviembroidery@gmail.com" style="font-size: 0.88rem; font-weight: 600; color: var(--text-dark);">aruviembroidery@gmail.com</a>
            <span style="display: block; font-size: 0.76rem; color: var(--text-muted); margin-top: 2px;">We usually respond within 24 hours</span>
          </div>
        </div>

        <div class="contact-info-item" style="display: flex; gap: 12px; align-items: flex-start;">
          <div class="how-icon-box"><i class="fa-solid fa-headset"></i></div>
          <div>
            <strong style="display: block; font-size: 0.9rem; color: var(--text-dark); margin-bottom: 1px;">Support</strong>
            <a href="mailto:aruviembroidery@gmail.com" style="font-size: 0.88rem; font-weight: 600; color: var(--text-dark);">aruviembroidery@gmail.com</a>
            <span style="display: block; font-size: 0.76rem; color: var(--text-muted); margin-top: 2px;">For any support or queries</span>
          </div>
        </div>

        <div class="contact-info-item" style="display: flex; gap: 12px; align-items: flex-start;">
          <div class="how-icon-box"><i class="fa-regular fa-clock"></i></div>
          <div>
            <strong style="display: block; font-size: 0.9rem; color: var(--text-dark); margin-bottom: 1px;">Working Hours</strong>
            <span style="display: block; font-size: 0.88rem; font-weight: 600; color: var(--text-dark);">Monday - Saturday</span>
            <span style="display: block; font-size: 0.76rem; color: var(--text-muted); margin-top: 2px;">9:00 AM - 6:00 PM (IST)</span>
          </div>
        </div>

        <% if (typeof siteSettings !== 'undefined' && siteSettings.contact_address_line && siteSettings.contact_address_line.trim()) { %>
          <div class="contact-info-item" style="display: flex; gap: 12px; align-items: flex-start;">
            <div class="how-icon-box"><i class="fa-solid fa-location-dot"></i></div>
            <div>
              <strong style="display: block; font-size: 0.9rem; color: var(--text-dark); margin-bottom: 1px;">Studio Address</strong>
              <span style="display: block; font-size: 0.88rem; font-weight: 600; color: var(--text-dark);"><%= siteSettings.contact_address_line.trim() %></span>
            </div>
          </div>
        <% } %>
      </div>

      <!-- Follow Us Social Links Row -->
      <div style="margin-top: auto; padding-top: 1.2rem; border-top: 1px solid var(--border-light);">
        <strong style="display: block; font-size: 0.88rem; color: var(--text-dark); margin-bottom: 2px;">Follow Us</strong>
        <span style="display: block; font-size: 0.76rem; color: var(--text-muted); margin-bottom: 1rem;">Stay connected for new designs, updates and offers.</span>
        
        <div style="display: flex; gap: 10px; flex-wrap: wrap;">
          <% if (typeof siteSettings !== 'undefined' && siteSettings.instagram_url && siteSettings.instagram_url.trim()) { %>
            <a href="<%= siteSettings.instagram_url.trim() %>" target="_blank" rel="noopener noreferrer" class="btn btn-outline btn-sm" style="flex: 1; min-width: 120px; border-radius: var(--radius-full); justify-content: center; font-size: 0.82rem;" aria-label="Instagram">
              <i class="fa-brands fa-instagram" style="color: #E1306C;"></i> Instagram <i class="fa-solid fa-arrow-up-right-from-square" style="font-size: 0.68rem; margin-left: 2px;"></i>
            </a>
          <% } %>
          <% if (typeof siteSettings !== 'undefined' && siteSettings.pinterest_url && siteSettings.pinterest_url.trim()) { %>
            <a href="<%= siteSettings.pinterest_url.trim() %>" target="_blank" rel="noopener noreferrer" class="btn btn-outline btn-sm" style="flex: 1; min-width: 120px; border-radius: var(--radius-full); justify-content: center; font-size: 0.82rem;" aria-label="Pinterest">
              <i class="fa-brands fa-pinterest" style="color: #E60023;"></i> Pinterest <i class="fa-solid fa-arrow-up-right-from-square" style="font-size: 0.68rem; margin-left: 2px;"></i>
            </a>
          <% } %>
          <% if (typeof siteSettings !== 'undefined' && siteSettings.facebook_url && siteSettings.facebook_url.trim()) { %>
            <a href="<%= siteSettings.facebook_url.trim() %>" target="_blank" rel="noopener noreferrer" class="btn btn-outline btn-sm" style="flex: 1; min-width: 120px; border-radius: var(--radius-full); justify-content: center; font-size: 0.82rem;" aria-label="Facebook">
              <i class="fa-brands fa-facebook" style="color: #1877F2;"></i> Facebook <i class="fa-solid fa-arrow-up-right-from-square" style="font-size: 0.68rem; margin-left: 2px;"></i>
            </a>
          <% } %>
          <% if (typeof siteSettings !== 'undefined' && siteSettings.youtube_url && siteSettings.youtube_url.trim()) { %>
            <a href="<%= siteSettings.youtube_url.trim() %>" target="_blank" rel="noopener noreferrer" class="btn btn-outline btn-sm" style="flex: 1; min-width: 120px; border-radius: var(--radius-full); justify-content: center; font-size: 0.82rem;" aria-label="YouTube">
              <i class="fa-brands fa-youtube" style="color: #FF0000;"></i> YouTube <i class="fa-solid fa-arrow-up-right-from-square" style="font-size: 0.68rem; margin-left: 2px;"></i>
            </a>
          <% } %>
        </div>
      </div>
    </div>

    <!-- Column 3: Location Map & FAQs Accordion Stack -->
    <div style="display: flex; flex-direction: column; gap: 1.5rem;">
      <% if (typeof siteSettings !== 'undefined' && siteSettings.show_contact_map === '1') { %>
        <!-- Card 1: Our Location (Optional - Default OFF) -->
        <div class="summary-box-card" style="padding: 1.4rem;">
          <div class="section-box-header" style="margin-bottom: 1rem; padding-bottom: 0.6rem;">
            <div class="section-icon-badge" style="width: 34px; height: 34px; font-size: 0.9rem;"><i class="fa-solid fa-location-dot"></i></div>
            <div>
              <h4 style="font-family: var(--font-heading); font-size: 1.1rem; font-weight: 700;">Our Location</h4>
              <span style="font-size: 0.75rem; color: var(--text-muted);"><%= (siteSettings.contact_address_line && siteSettings.contact_address_line.trim()) ? siteSettings.contact_address_line.trim() : "We're based in India and serve customers worldwide." %></span>
            </div>
          </div>

          <div style="border-radius: 12px; overflow: hidden; border: 1px solid var(--border-light); height: 160px; position: relative;">
            <img src="<%= siteSettings.contact_map_image || '/public/images/map_erode.jpg' %>" alt="ARUVI Embroidery Location Map" style="width: 100%; height: 100%; object-fit: cover;">
          </div>
        </div>
      <% } %>

      <!-- Card 2: Frequently Asked Questions Accordion -->
      <div class="summary-box-card" style="padding: 1.4rem;">
        <div class="section-box-header" style="margin-bottom: 1rem; padding-bottom: 0.6rem;">
          <div class="section-icon-badge" style="width: 34px; height: 34px; font-size: 0.9rem;"><i class="fa-regular fa-circle-question"></i></div>
          <div>
            <h4 style="font-family: var(--font-heading); font-size: 1.1rem; font-weight: 700;">Frequently Asked Questions</h4>
            <span style="font-size: 0.75rem; color: var(--text-muted);">Quick answers to common questions.</span>
          </div>
        </div>

        <div class="contact-faq-accordion" id="contactFaqAccordion" style="display: flex; flex-direction: column; gap: 8px;">
          <!-- FAQ 1 -->
          <div class="contact-faq-item" style="background: #F6F1EA; border-radius: 8px; border: 1px solid rgba(45, 35, 30, 0.06); overflow: hidden;">
            <button type="button" class="contact-faq-btn" aria-expanded="false" aria-controls="faq-ans-1" id="faq-q-1" style="width: 100%; padding: 0.75rem 0.9rem; font-size: 0.82rem; font-weight: 600; color: var(--text-dark); display: flex; justify-content: space-between; align-items: center; cursor: pointer; background: transparent; border: none; text-align: left; font-family: inherit;">
              <span>How will I receive my design files?</span>
              <i class="fa-solid fa-chevron-down faq-chevron" style="font-size: 0.75rem; color: var(--text-muted); transition: transform 0.25s ease;" aria-hidden="true"></i>
            </button>
            <div class="contact-faq-panel" id="faq-ans-1" role="region" aria-labelledby="faq-q-1" style="display: none; padding: 0 0.9rem 0.75rem 0.9rem; font-size: 0.8rem; color: var(--text-muted); line-height: 1.55;">
              Immediately after successful payment, your digital download link becomes active on the confirmation screen and is permanently available in your account under <a href="/user/orders" style="color: var(--primary); font-weight: 600; text-decoration: underline;">My Orders</a>.
            </div>
          </div>

          <!-- FAQ 2 -->
          <div class="contact-faq-item" style="background: #F6F1EA; border-radius: 8px; border: 1px solid rgba(45, 35, 30, 0.06); overflow: hidden;">
            <button type="button" class="contact-faq-btn" aria-expanded="false" aria-controls="faq-ans-2" id="faq-q-2" style="width: 100%; padding: 0.75rem 0.9rem; font-size: 0.82rem; font-weight: 600; color: var(--text-dark); display: flex; justify-content: space-between; align-items: center; cursor: pointer; background: transparent; border: none; text-align: left; font-family: inherit;">
              <span>What file formats do you provide?</span>
              <i class="fa-solid fa-chevron-down faq-chevron" style="font-size: 0.75rem; color: var(--text-muted); transition: transform 0.25s ease;" aria-hidden="true"></i>
            </button>
            <div class="contact-faq-panel" id="faq-ans-2" role="region" aria-labelledby="faq-q-2" style="display: none; padding: 0 0.9rem 0.75rem 0.9rem; font-size: 0.8rem; color: var(--text-muted); line-height: 1.55;">
              Each ZIP download includes multiple machine embroidery formats: <strong>DST</strong> (Tajima/Industrial), <strong>PES</strong> (Brother), <strong>JEF</strong> (Janome), <strong>EXP</strong> (Bernina/Melco), <strong>HUS/VP3</strong>, and <strong>XXX</strong>.
            </div>
          </div>

          <!-- FAQ 3 -->
          <div class="contact-faq-item" style="background: #F6F1EA; border-radius: 8px; border: 1px solid rgba(45, 35, 30, 0.06); overflow: hidden;">
            <button type="button" class="contact-faq-btn" aria-expanded="false" aria-controls="faq-ans-3" id="faq-q-3" style="width: 100%; padding: 0.75rem 0.9rem; font-size: 0.82rem; font-weight: 600; color: var(--text-dark); display: flex; justify-content: space-between; align-items: center; cursor: pointer; background: transparent; border: none; text-align: left; font-family: inherit;">
              <span>Can I request a custom design?</span>
              <i class="fa-solid fa-chevron-down faq-chevron" style="font-size: 0.75rem; color: var(--text-muted); transition: transform 0.25s ease;" aria-hidden="true"></i>
            </button>
            <div class="contact-faq-panel" id="faq-ans-3" role="region" aria-labelledby="faq-q-3" style="display: none; padding: 0 0.9rem 0.75rem 0.9rem; font-size: 0.8rem; color: var(--text-muted); line-height: 1.55;">
              Yes! You can submit your reference artwork or photo via our <a href="/custom-order" style="color: var(--primary); font-weight: 600; text-decoration: underline;">Custom Order page</a>. Our expert digitizers will convert it into high-precision machine embroidery files.
            </div>
          </div>
        </div>

        <script>
          (function () {
            const accordion = document.getElementById('contactFaqAccordion');
            if (!accordion) return;

            accordion.querySelectorAll('.contact-faq-btn').forEach(btn => {
              btn.addEventListener('click', function () {
                const isExpanded = this.getAttribute('aria-expanded') === 'true';
                const panel = document.getElementById(this.getAttribute('aria-controls'));
                const chevron = this.querySelector('.faq-chevron');

                // Close siblings
                accordion.querySelectorAll('.contact-faq-btn').forEach(otherBtn => {
                  if (otherBtn !== this) {
                    otherBtn.setAttribute('aria-expanded', 'false');
                    const otherPanel = document.getElementById(otherBtn.getAttribute('aria-controls'));
                    const otherChevron = otherBtn.querySelector('.faq-chevron');
                    if (otherPanel) otherPanel.style.display = 'none';
                    if (otherChevron) otherChevron.style.transform = 'rotate(0deg)';
                  }
                });

                // Toggle current
                if (isExpanded) {
                  this.setAttribute('aria-expanded', 'false');
                  if (panel) panel.style.display = 'none';
                  if (chevron) chevron.style.transform = 'rotate(0deg)';
                } else {
                  this.setAttribute('aria-expanded', 'true');
                  if (panel) panel.style.display = 'block';
                  if (chevron) chevron.style.transform = 'rotate(180deg)';
                }
              });
            });
          })();
        </script>
      </div>
    </div>
  </div>

  <!-- Reusable Trust/Feature Cards Bar (Controls via Admin Homepage/Settings) -->
  <%- include('../partials/feature-cards', { page: 'contact' }) %>
</div>

<%- include('../partials/footer') %>
