<%- include('../partials/header') %>

<%
  const _settings = (typeof settings !== 'undefined' && settings) ? settings : ((typeof siteSettings !== 'undefined' && siteSettings) ? siteSettings : {});
  const _stats = (typeof stats !== 'undefined' && stats) ? stats : {
    stat1: { num: '10,000+', label: 'Happy Customers' },
    stat2: { num: '5,000+', label: 'Unique Designs' },
    stat3: { num: '50+', label: 'Countries Worldwide' },
    stat4: { num: '4.9/5', label: 'Customer Rating' }
  };
%>

<div class="container about-page-container">
  <!-- Breadcrumb Trail -->
  <div class="breadcrumb-trail banner-desktop-only">
    <a href="/">Home</a> &nbsp;>&nbsp; <span>About</span>
  </div>

  <!-- Hero Banner matching Reference -->
  <div class="page-banner-card about-hero-card">
    <div class="banner-content">
      <h1 class="page-banner-title">
        <%= _settings.about_hero_title || 'About ARUVI' %>
      </h1>
      <h3 class="about-hero-subtitle">
        <%= _settings.about_hero_subtitle || 'Crafting Beautiful Designs for Your Creative Journey' %>
      </h3>
      <p class="page-banner-subtitle">
        <%= _settings.about_hero_description || 'At ARUVI Embroidery Studio, we create high-quality machine embroidery designs that bring your ideas to life. Our designs are crafted with precision, creativity, and a passion for embroidery, helping individuals and businesses create beautiful, professional embroidery projects.' %>
      </p>

      <a href="/designs" class="btn btn-primary about-hero-btn">Our Designs <i class="fa-solid fa-arrow-right"></i></a>
    </div>
  </div>

  <!-- 4 Hero Feature Pills Bar -->
  <div class="hero-feature-pills">
    <div class="hero-pill-item">
      <div class="pill-icon"><i class="fa-regular fa-gem"></i></div>
      <div class="pill-text-wrap">
        <strong>Premium Quality</strong>
        <span>Carefully crafted designs</span>
      </div>
    </div>
    <div class="hero-pill-item">
      <div class="pill-icon"><i class="fa-solid fa-download"></i></div>
      <div class="pill-text-wrap">
        <strong>Instant Download</strong>
        <span>Get files immediately</span>
      </div>
    </div>
    <div class="hero-pill-item">
      <div class="pill-icon"><i class="fa-solid fa-shield-halved"></i></div>
      <div class="pill-text-wrap">
        <strong>Tested Designs</strong>
        <span>100% machine tested</span>
      </div>
    </div>
    <div class="hero-pill-item">
      <div class="pill-icon"><i class="fa-solid fa-headset"></i></div>
      <div class="pill-text-wrap">
        <strong>Dedicated Support</strong>
        <span>We're here to help you</span>
      </div>
    </div>
  </div>

  <!-- "Our Story" & Statistics Grid: 3-column desktop, stacked single-column on mobile -->
  <div class="about-story-layout">
    <!-- Story Image -->
    <div class="story-image-card">
      <img src="/public/images/cat_floral.jpg" alt="ARUVI Embroidery Craftsmanship">
    </div>

    <!-- Story Text Content -->
    <div class="story-text-content">
      <div class="eyebrow-tag">
        <span>OUR STORY</span>
        <span class="eyebrow-line"></span>
      </div>
      <h2 class="section-title"><%= _settings.about_story_title || 'A Passion for Embroidery' %></h2>
      <p class="story-paragraph">
        <%= _settings.about_story_p1 || 'ARUVI Embroidery Studio started with a simple idea — to make high-quality embroidery designs accessible to everyone. What began as a passion for creativity and design has now grown into a trusted platform for thousands of embroidery enthusiasts around the world.' %>
      </p>
      <p class="story-paragraph">
        <%= _settings.about_story_p2 || 'We believe embroidery is more than just a craft — it\'s a way to express creativity, culture, and individuality. Our mission is to provide unique, high-quality, and easy-to-use machine embroidery designs that help you bring your creative ideas to life.' %>
      </p>
    </div>

    <!-- Statistics Card Box: 4 items, 2x2 grid on mobile, stacked on desktop -->
    <div class="stats-card-box">
      <div class="stat-item-row">
        <div class="stat-icon-badge"><i class="fa-solid fa-users"></i></div>
        <div class="stat-info-wrap">
          <h3 class="stat-num-val"><%= _stats.stat1.num %></h3>
          <span class="stat-label-text"><%= _stats.stat1.label %></span>
        </div>
      </div>

      <div class="stat-item-row">
        <div class="stat-icon-badge"><i class="fa-solid fa-file-code"></i></div>
        <div class="stat-info-wrap">
          <h3 class="stat-num-val"><%= _stats.stat2.num %></h3>
          <span class="stat-label-text"><%= _stats.stat2.label %></span>
        </div>
      </div>

      <div class="stat-item-row">
        <div class="stat-icon-badge"><i class="fa-solid fa-earth-americas"></i></div>
        <div class="stat-info-wrap">
          <h3 class="stat-num-val"><%= _stats.stat3.num %></h3>
          <span class="stat-label-text"><%= _stats.stat3.label %></span>
        </div>
      </div>

      <div class="stat-item-row">
        <div class="stat-icon-badge"><i class="fa-solid fa-star"></i></div>
        <div class="stat-info-wrap">
          <h3 class="stat-num-val"><%= _stats.stat4.num %></h3>
          <span class="stat-label-text"><%= _stats.stat4.label %></span>
        </div>
      </div>
    </div>
  </div>

  <!-- Mission, Vision & Values Section (3 Cards Grid) -->
  <div class="grid-3 about-mv-grid">
    <!-- Card 1: Our Mission -->
    <div class="mission-vision-card">
      <div class="mv-icon-badge"><i class="fa-solid fa-bullseye"></i></div>
      <h3 class="mv-card-title"><%= _settings.about_mission_title || 'Our Mission' %></h3>
      <p class="mv-card-text">
        <%= _settings.about_mission_text || 'To deliver high-quality, creative, and reliable embroidery designs that inspire and support embroidery creators worldwide.' %>
      </p>
    </div>

    <!-- Card 2: Our Vision -->
    <div class="mission-vision-card">
      <div class="mv-icon-badge"><i class="fa-regular fa-eye"></i></div>
      <h3 class="mv-card-title"><%= _settings.about_vision_title || 'Our Vision' %></h3>
      <p class="mv-card-text">
        <%= _settings.about_vision_text || 'To become a global leader in machine embroidery designs, known for quality, creativity, and excellent customer support.' %>
      </p>
    </div>

    <!-- Card 3: Our Values -->
    <div class="mission-vision-card">
      <div class="mv-icon-badge"><i class="fa-regular fa-heart"></i></div>
      <h3 class="mv-card-title"><%= _settings.about_values_title || 'Our Values' %></h3>
      <p class="mv-card-text">
        <%= _settings.about_values_text || 'Quality, Creativity, Customer Satisfaction and Continuous Innovation.' %>
      </p>
    </div>
  </div>

  <!-- Bottom CTA Callout Banner ("Let's Create Something Beautiful Together") -->
  <div class="about-cta-banner">
    <div class="cta-banner-left">
      <h2>Let's Create Something Beautiful Together</h2>
      <p>Explore our designs or request a custom design to bring your ideas to life.</p>
    </div>
    <div class="cta-banner-right">
      <a href="/designs" class="btn btn-primary btn-lg">Browse Designs <i class="fa-solid fa-arrow-right"></i></a>
      <a href="/custom-order" class="btn btn-outline btn-lg">Request Custom Design</a>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
