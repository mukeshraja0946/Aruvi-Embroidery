<%- include('../partials/header') %>

<div class="container" style="margin-top: 2rem; margin-bottom: 5rem;">
  <!-- Breadcrumb Trail -->
  <div class="breadcrumb-trail" style="margin-bottom: 1.5rem;">
    <a href="/">Home</a> &nbsp;>&nbsp; <span>About</span>
  </div>

  <!-- Hero Banner matching Reference -->
  <div class="page-banner-card" style="margin-bottom: 3rem; padding: 3rem;">
    <div class="banner-content" style="max-width: 620px;">
      <h1 class="page-banner-title" style="font-size: 3.2rem;">
        About <span style="color: var(--primary);">ARUVI</span>
      </h1>
      <h3 style="font-family: var(--font-heading); font-size: 1.35rem; font-weight: 600; color: var(--text-dark); margin-bottom: 0.8rem;">
        Crafting Beautiful Designs for Your Creative Journey
      </h3>
      <p class="page-banner-subtitle" style="font-size: 0.95rem; margin-bottom: 1.8rem; line-height: 1.6;">
        At ARUVI Embroidery Studio, we create high-quality machine embroidery designs that bring your ideas to life. Our designs are crafted with precision, creativity, and a passion for embroidery, helping individuals and businesses create beautiful, professional embroidery projects.
      </p>

      <a href="/designs" class="btn btn-primary btn-lg">Our Designs <i class="fa-solid fa-arrow-right"></i></a>
    </div>

    <div class="banner-image-box" style="width: 440px; height: 260px; position: relative;">
      <img src="/public/images/hero_embroidery.jpg" alt="About ARUVI Embroidery Studio">
    </div>
  </div>

  <!-- 4 Hero Feature Pills Bar -->
  <div class="hero-feature-pills" style="margin-bottom: 4rem; background: #F6F1EA; border-radius: 16px; padding: 1.5rem 2rem;">
    <div class="hero-pill-item">
      <div class="pill-icon"><i class="fa-regular fa-gem"></i></div>
      <div>
        <strong style="display: block; font-size: 0.88rem;">Premium Quality</strong>
        <span style="font-size: 0.76rem; color: var(--text-muted);">Carefully crafted designs</span>
      </div>
    </div>
    <div class="hero-pill-item">
      <div class="pill-icon"><i class="fa-solid fa-download"></i></div>
      <div>
        <strong style="display: block; font-size: 0.88rem;">Instant Download</strong>
        <span style="font-size: 0.76rem; color: var(--text-muted);">Get files immediately</span>
      </div>
    </div>
    <div class="hero-pill-item">
      <div class="pill-icon"><i class="fa-solid fa-shield-halved"></i></div>
      <div>
        <strong style="display: block; font-size: 0.88rem;">Tested Designs</strong>
        <span style="font-size: 0.76rem; color: var(--text-muted);">100% machine tested</span>
      </div>
    </div>
    <div class="hero-pill-item">
      <div class="pill-icon"><i class="fa-solid fa-headset"></i></div>
      <div>
        <strong style="display: block; font-size: 0.88rem;">Dedicated Support</strong>
        <span style="font-size: 0.76rem; color: var(--text-muted);">We're here to help you</span>
      </div>
    </div>
  </div>

  <!-- "Our Story" & Statistics Grid matching Reference -->
  <div class="about-story-layout" style="margin-bottom: 4rem;">
    <!-- Left Story Image -->
    <div class="story-image-card">
      <img src="/public/images/cat_floral.jpg" alt="ARUVI Embroidery Craftsmanship">
    </div>

    <!-- Middle Story Text Content -->
    <div class="story-text-content">
      <div class="eyebrow-tag">
        <span>OUR STORY</span>
        <span class="eyebrow-line"></span>
      </div>
      <h2 class="section-title" style="font-size: 2.4rem; margin-bottom: 1.2rem;">A Passion for Embroidery</h2>
      <p style="color: var(--text-muted); font-size: 0.95rem; line-height: 1.7; margin-bottom: 1.2rem;">
        ARUVI Embroidery Studio started with a simple idea — to make high-quality embroidery designs accessible to everyone. What began as a passion for creativity and design has now grown into a trusted platform for thousands of embroidery enthusiasts around the world.
      </p>
      <p style="color: var(--text-muted); font-size: 0.95rem; line-height: 1.7;">
        We believe embroidery is more than just a craft — it's a way to express creativity, culture, and individuality. Our mission is to provide unique, high-quality, and easy-to-use machine embroidery designs that help you bring your creative ideas to life.
      </p>
    </div>

    <!-- Right Statistics Card Box -->
    <div class="stats-card-box">
      <div class="stat-item-row">
        <div class="stat-icon-badge"><i class="fa-solid fa-users"></i></div>
        <div>
          <h3 class="stat-num-val">10,000+</h3>
          <span class="stat-label-text">Happy Customers</span>
        </div>
      </div>

      <div class="stat-item-row">
        <div class="stat-icon-badge"><i class="fa-solid fa-file-code"></i></div>
        <div>
          <h3 class="stat-num-val">5,000+</h3>
          <span class="stat-label-text">Unique Designs</span>
        </div>
      </div>

      <div class="stat-item-row">
        <div class="stat-icon-badge"><i class="fa-solid fa-earth-americas"></i></div>
        <div>
          <h3 class="stat-num-val">50+</h3>
          <span class="stat-label-text">Countries Worldwide</span>
        </div>
      </div>

      <div class="stat-item-row">
        <div class="stat-icon-badge"><i class="fa-solid fa-star"></i></div>
        <div>
          <h3 class="stat-num-val">4.9/5</h3>
          <span class="stat-label-text">Customer Rating</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Mission, Vision & Values Section (3 Cards Grid) -->
  <div class="grid-3" style="margin-bottom: 4rem;">
    <!-- Card 1: Our Mission -->
    <div class="mission-vision-card">
      <div class="mv-icon-badge"><i class="fa-solid fa-bullseye"></i></div>
      <h3 class="mv-card-title">Our Mission</h3>
      <p class="mv-card-text">
        To deliver high-quality, creative, and reliable embroidery designs that inspire and support embroidery creators worldwide.
      </p>
    </div>

    <!-- Card 2: Our Vision -->
    <div class="mission-vision-card">
      <div class="mv-icon-badge"><i class="fa-regular fa-eye"></i></div>
      <h3 class="mv-card-title">Our Vision</h3>
      <p class="mv-card-text">
        To become a global leader in machine embroidery designs, known for quality, creativity, and excellent customer support.
      </p>
    </div>

    <!-- Card 3: Our Values -->
    <div class="mission-vision-card">
      <div class="mv-icon-badge"><i class="fa-regular fa-heart"></i></div>
      <h3 class="mv-card-title">Our Values</h3>
      <p class="mv-card-text">
        Quality, Creativity, Customer Satisfaction and Continuous Innovation.
      </p>
    </div>
  </div>

  <!-- Bottom CTA Callout Banner ("Let's Create Something Beautiful Together") -->
  <div class="about-cta-banner">
    <div class="cta-banner-left">
      <h2>Let's Create Something Beautiful Together</h2>
      <p>Explore our designs or request a custom design to bring your ideas to life.</p>
    </div>
    <div class="cta-banner-right">
      <a href="/designs" class="btn btn-primary btn-lg">Browse Designs <i class="fa-solid fa-arrow-right"></i></a>
      <a href="/custom-order" class="btn btn-outline btn-lg">Request Custom Design</a>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
