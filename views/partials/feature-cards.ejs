<%
  const _s = (typeof siteSettings !== 'undefined' && siteSettings) ? siteSettings : ((typeof settings !== 'undefined' && settings) ? settings : {});
  const targetPage = typeof page !== 'undefined' ? page : null;
  const cards = (typeof getFeatureCards === 'function')
    ? getFeatureCards(targetPage)
    : (typeof Setting !== 'undefined' && Setting.getFeatureCards
        ? Setting.getFeatureCards(targetPage, _s)
        : []);

  function getFallbackSvg(iconClass) {
    const cls = String(iconClass || '').toLowerCase();
    if (cls.includes('award')) {
      return '<svg class="fa-fallback-svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="6"></circle><path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"></path></svg>';
    }
    if (cls.includes('download')) {
      return '<svg class="fa-fallback-svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>';
    }
    if (cls.includes('shield')) {
      return '<svg class="fa-fallback-svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>';
    }
    if (cls.includes('headset')) {
      return '<svg class="fa-fallback-svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 18v-6a9 9 0 0 1 18 0v6"></path><path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"></path></svg>';
    }
    if (cls.includes('truck')) {
      return '<svg class="fa-fallback-svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>';
    }
    if (cls.includes('lock')) {
      return '<svg class="fa-fallback-svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>';
    }
    if (cls.includes('star')) {
      return '<svg class="fa-fallback-svg" viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>';
    }
    if (cls.includes('heart')) {
      return '<svg class="fa-fallback-svg" viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>';
    }
    if (cls.includes('gift')) {
      return '<svg class="fa-fallback-svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 12 20 22 4 22 4 12"></polyline><rect x="2" y="7" width="20" height="5"></rect><line x1="12" y1="22" x2="12" y2="7"></line></svg>';
    }
    if (cls.includes('clock')) {
      return '<svg class="fa-fallback-svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>';
    }
    if (cls.includes('check')) {
      return '<svg class="fa-fallback-svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>';
    }
    if (cls.includes('thumbs')) {
      return '<svg class="fa-fallback-svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 9V5a3 3 0 0 0-3-3l-4 9v11h11.28a2 2 0 0 0 2-1.7l1.38-9a2 2 0 0 0-2-2.3zM7 22H4a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2h3"></path></svg>';
    }
    if (cls.includes('zipper') || cls.includes('zip') || cls.includes('file')) {
      return '<svg class="fa-fallback-svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><polyline points="21 8 21 21 3 21 3 8"></polyline><rect x="1" y="3" width="22" height="5"></rect><line x1="10" y1="12" x2="14" y2="12"></line></svg>';
    }
    if (cls.includes('tag')) {
      return '<svg class="fa-fallback-svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path><line x1="7" y1="7" x2="7.01" y2="7"></line></svg>';
    }
    return '<svg class="fa-fallback-svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg>';
  }
%>

<% if (cards && cards.length > 0) { %>
  <% if (typeof wrapperClass !== 'undefined' && wrapperClass) { %>
    <div class="<%= wrapperClass %>">
  <% } %>

  <div class="site-feature-cards-grid cards-count-<%= cards.length %>" id="siteFeatureCards">
    <% cards.forEach(card => { %>
      <% const isLink = Boolean(card.link && String(card.link).trim()); %>
      <% if (isLink) { %>
        <a href="<%= card.link.trim() %>" class="site-feature-card site-feature-card-link" title="<%= card.title %>">
      <% } else { %>
        <div class="site-feature-card">
      <% } %>

        <div class="site-feature-card-icon">
          <i class="<%= card.icon %>" aria-hidden="true"></i>
          <%- getFallbackSvg(card.icon) %>
        </div>
        <div class="site-feature-card-text">
          <strong class="site-feature-card-title"><%= card.title %></strong>
          <% if (card.subtitle) { %>
            <span class="site-feature-card-subtitle"><%= card.subtitle %></span>
          <% } %>
        </div>

      <% if (isLink) { %>
        </a>
      <% } else { %>
        </div>
      <% } %>
    <% }) %>
  </div>

  <% if (typeof wrapperClass !== 'undefined' && wrapperClass) { %>
    </div>
  <% } %>

  <script>
    if (!window._faFontChecked) {
      window._faFontChecked = true;
      if (document.fonts && document.fonts.check) {
        document.fonts.ready.then(function() {
          if (!document.fonts.check('16px "Font Awesome 6 Free"')) {
            document.documentElement.classList.add('fa-fallback-active');
          }
        });
      }
    }
  </script>
<% } %>
