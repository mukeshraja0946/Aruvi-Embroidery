   ------------------------------------------------------------- */
.aruvi-pl-reveal-stage {
  position: relative;
  display: inline-block;
  padding: 8px;
}

.aruvi-pl-reveal-box {
  position: relative;
  overflow: hidden;
  max-width: 210px;
  max-height: 95px;
  clip-path: inset(0 100% 0 0);
  animation: plRevealClip calc(1.3s * var(--pl-speed)) cubic-bezier(0.25, 1, 0.5, 1) forwards;
}

@keyframes plRevealClip {
  to { clip-path: inset(0 0% 0 0); }
}

.aruvi-pl-reveal-box img {
  display: block;
  max-width: 100%;
  max-height: 95px;
  object-fit: contain;
}

.aruvi-pl-reveal-shimmer {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent 0%, rgba(255, 255, 255, 0.75) 50%, transparent 100%);
  transform: translateX(-120%);
  animation: plSweep calc(1.8s * var(--pl-speed)) ease-in-out calc(1.1s * var(--pl-speed)) infinite;
  pointer-events: none;
}

@keyframes plSweep {
  0% { transform: translateX(-120%); }
  100% { transform: translateX(220%); }
}

/* -------------------------------------------------------------
   STYLE 5: DOTS & STITCHES
   ------------------------------------------------------------- */
.aruvi-pl-dots-stage {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16px;
}

.aruvi-pl-dots-logo {
