<style id="aruvi-preloader-critical-css">
:root {
  --pl-maroon: <%= colPrimary %>;
  --pl-copper: <%= colSecondary %>;
  --pl-rose: <%= colRose %>;
  --pl-bg: <%= colBg %>;
  --pl-thread: <%= colThread %>;
  --pl-stitch: <%= colStitch %>;
  --pl-speed: <%= speedVal %>;
}

#aruvi-preloader {
  position: fixed;
  inset: 0;
  width: 100vw;
  height: 100vh;
  z-index: 9999999;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  background-color: var(--pl-bg);
  padding: env(safe-area-inset-top, 20px) env(safe-area-inset-right, 20px) env(safe-area-inset-bottom, 20px) env(safe-area-inset-left, 20px);
  box-sizing: border-box;
  opacity: 1;
  transition: opacity calc(0.6s * var(--pl-speed)) ease, transform calc(0.6s * var(--pl-speed)) ease;
  overflow: hidden;
  user-select: none;
}

body.aruvi-preloader-locked {
  overflow: hidden !important;
}

.aruvi-pl-sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0,0,0,0);
  border: 0;
}

/* Curtain background split sheets */
.aruvi-pl-curtain-top,
.aruvi-pl-curtain-bottom {
  position: absolute;
  left: 0;
  width: 100%;
  height: 50.5%;
  background: var(--pl-bg);
  z-index: 1;
  transition: transform calc(0.65s * var(--pl-speed)) cubic-bezier(0.77, 0, 0.175, 1);
  pointer-events: none;
}
.aruvi-pl-curtain-top { top: 0; }
.aruvi-pl-curtain-bottom { bottom: 0; }

.aruvi-pl-content {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  max-width: 90vw;
  transition: opacity calc(0.45s * var(--pl-speed)) ease, transform calc(0.45s * var(--pl-speed)) cubic-bezier(0.2, 0.8, 0.2, 1);
}

/* Brand typography in preloader */
.aruvi-pl-shopname {
  font-family: 'Playfair Display', Georgia, serif;
  font-size: clamp(1.15rem, 3.8vw, 1.55rem);
  font-weight: 700;
  letter-spacing: 0.14em;
  color: var(--pl-maroon);
  margin-top: 18px;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  line-height: 1.25;
}

.aruvi-pl-char {
  display: inline-block;
  opacity: 0;
  transform: translateY(6px);
  animation: plCharIn calc(0.35s * var(--pl-speed)) ease forwards;
  animation-delay: calc((1.35s + var(--pl-char-idx) * 0.038s) * var(--pl-speed));
}

@keyframes plCharIn {
  to { opacity: 1; transform: translateY(0); }
}

.aruvi-pl-tagline {
  font-family: 'Caveat', cursive, 'Poppins', sans-serif;
  font-size: clamp(0.95rem, 3.2vw, 1.25rem);
  color: var(--pl-rose);
  letter-spacing: 0.05em;
  margin-top: 6px;
  opacity: 0;
  transform: translateY(8px);
  animation: plTaglineIn calc(0.5s * var(--pl-speed)) ease calc(1.75s * var(--pl-speed)) forwards;
}

@keyframes plTaglineIn {
  to { opacity: 0.95; transform: translateY(0); }
}

/* Exit effect variations */
#aruvi-preloader.aruvi-pl-exit-fade {
  opacity: 0;
  pointer-events: none;
}
#aruvi-preloader.aruvi-pl-exit-fade .aruvi-pl-content {
  transform: scale(1.08);
  opacity: 0;
}

#aruvi-preloader.aruvi-pl-exit-curtain {
  background: transparent !important;
  pointer-events: none;
}
#aruvi-preloader.aruvi-pl-exit-curtain .aruvi-pl-curtain-top {
  transform: translateY(-100%);
}
#aruvi-preloader.aruvi-pl-exit-curtain .aruvi-pl-curtain-bottom {
  transform: translateY(100%);
}
#aruvi-preloader.aruvi-pl-exit-curtain .aruvi-pl-content {
  transform: scale(1.08);
  opacity: 0;
}

#aruvi-preloader.aruvi-pl-exit-zoom {
  opacity: 0;
  transform: scale(1.12);
  pointer-events: none;
}
#aruvi-preloader.aruvi-pl-exit-zoom .aruvi-pl-content {
  transform: scale(1.1);
  opacity: 0;
}

/* -------------------------------------------------------------
   STYLE 1: STITCHING HEXAGON (DEFAULT)
   ------------------------------------------------------------- */
.aruvi-pl-hex-stage {
  position: relative;
  width: 170px;
  height: 170px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.aruvi-pl-hex-svg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  overflow: visible;
}

.aruvi-pl-hex-outline {
  fill: var(--pl-bg);
  fill-opacity: 0;
  stroke: var(--pl-maroon);
  stroke-width: 3.2;
  stroke-linecap: round;
  stroke-linejoin: round;
  stroke-dasharray: 9 6;
  stroke-dashoffset: 374;
  animation: plHexStroke calc(1.4s * var(--pl-speed)) cubic-bezier(0.45, 0, 0.25, 1) forwards,
             plHexFillIn calc(0.45s * var(--pl-speed)) ease calc(1.35s * var(--pl-speed)) forwards,
             plHexShimmer calc(3.2s * var(--pl-speed)) ease-in-out calc(1.85s * var(--pl-speed)) infinite alternate;
}

@keyframes plHexStroke {
  to { stroke-dashoffset: 0; }
}
@keyframes plHexFillIn {
  to { fill-opacity: 1; }
}
@keyframes plHexShimmer {
  0% { stroke: var(--pl-maroon); filter: drop-shadow(0 0 0px transparent); }
  50% { stroke: var(--pl-rose); filter: drop-shadow(0 0 8px rgba(187, 69, 88, 0.45)); }
  100% { stroke: var(--pl-copper); filter: drop-shadow(0 0 5px rgba(199, 135, 108, 0.35)); }
}

.aruvi-pl-hex-needle {
  position: absolute;
  top: 0;
  left: 0;
  width: 22px;
  height: 22px;
  offset-path: path("M 85,20 L 140,52 L 140,118 L 85,150 L 30,118 L 30,52 Z");
  offset-rotate: auto 0deg;
  animation: plNeedleTrack calc(1.4s * var(--pl-speed)) cubic-bezier(0.45, 0, 0.25, 1) forwards;
  pointer-events: none;
}

@keyframes plNeedleTrack {
  0% { offset-distance: 0%; opacity: 1; }
  98% { offset-distance: 100%; opacity: 1; }
  100% { offset-distance: 100%; opacity: 0; }
}

.aruvi-pl-hex-logo-wrap {
  position: absolute;
  width: 78px;
  height: 78px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  z-index: 2;
  opacity: 0;
  transform: scale(0.88);
  animation: plHexLogoIn calc(0.5s * var(--pl-speed)) cubic-bezier(0.2, 0.8, 0.3, 1) calc(1.3s * var(--pl-speed)) forwards;
}

@keyframes plHexLogoIn {
  to {
    opacity: 1;
    transform: scale(1);
    filter: drop-shadow(0 4px 12px rgba(75, 15, 28, 0.15));
  }
}

.aruvi-pl-hex-logo-wrap img {
  max-width: 100%;
  max-height: 100%;
  object-fit: contain;
}

/* -------------------------------------------------------------
   STYLE 2: NEEDLE & THREAD LOOP
   ------------------------------------------------------------- */
.aruvi-pl-loop-stage {
  position: relative;
  width: 190px;
  height: 160px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.aruvi-pl-loop-svg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  overflow: visible;
}

.aruvi-pl-loop-track {
  fill: none;
