  border-radius: 3px;
  transform: scaleX(0.3);
  opacity: 0.35;
  animation: plDashWave calc(1.3s * var(--pl-speed)) ease-in-out infinite;
  animation-delay: calc(var(--pl-dash-idx) * 0.16s * var(--pl-speed));
}

@keyframes plDashWave {
  0%, 100% { transform: scaleX(0.3); opacity: 0.35; background: var(--pl-stitch); }
  50% { transform: scaleX(1.45); opacity: 1; background: var(--pl-rose); box-shadow: 0 0 6px rgba(187, 69, 88, 0.5); }
}

