  stroke-width: 2.8;
  stroke-dasharray: 7 5;
  stroke-dashoffset: 350;
  animation: plLoopDraw calc(1.6s * var(--pl-speed)) cubic-bezier(0.45, 0, 0.25, 1) forwards,
             plLoopGlow calc(2.4s * var(--pl-speed)) ease-in-out calc(1.6s * var(--pl-speed)) infinite alternate;
}

@keyframes plLoopDraw {
  to { stroke-dashoffset: 0; }
}
@keyframes plLoopGlow {
  0% { stroke: var(--pl-copper); }
