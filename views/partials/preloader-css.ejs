}

.aruvi-pl-loop-needle {
  position: absolute;
  top: 0;
  left: 0;
  width: 20px;
  height: 20px;
  offset-path: path("M 30,80 C 30,35 75,35 95,80 C 115,125 160,125 160,80 C 160,35 115,35 95,80 C 75,125 30,125 30,80 Z");
  offset-rotate: auto 0deg;
  animation: plNeedleTrack calc(1.6s * var(--pl-speed)) cubic-bezier(0.45, 0, 0.25, 1) forwards;
}

