  70% { box-shadow: 0 0 0 24px rgba(187, 69, 88, 0), 0 0 0 38px rgba(199, 135, 108, 0); }
  100% { box-shadow: 0 0 0 0 rgba(187, 69, 88, 0), 0 0 0 0 rgba(199, 135, 108, 0); }
}

