<%
  // Standardized Sort By Dropdown Component
  const _id = (typeof id !== 'undefined' && id) ? id : ('sort_dd_' + Math.random().toString(36).substring(2, 8));
  const _name = (typeof name !== 'undefined' && name) ? name : 'sort';
  const _label = (typeof label !== 'undefined' && label) ? label : 'Sort by:';
  const _actionType = (typeof actionType !== 'undefined' && actionType) ? actionType : 'submit'; // 'url' or 'submit' or 'direct-url'
  const _currentVal = (typeof currentSort !== 'undefined' && currentSort) ? currentSort : 'newest';

  // Helper to render icon for option
  function renderSortIcon(type, customSvg, customClass) {
    if (customSvg) return customSvg;
    if (customClass) return `<i class="${customClass}"></i>`;
    switch(type) {
      case 'oldest':
        return `<svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="8" r="6.2"/><path d="M8 4.8v3.4l2.4 1.4"/></svg>`;
      case 'price_low':
        return `<svg width="14" height="15" viewBox="0 0 14 15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 12.5V2.5M7 2.5L3 6.5M7 2.5L11 6.5"/></svg>`;
      case 'price_high':
        return `<svg width="14" height="15" viewBox="0 0 14 15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 2.5V12.5M7 12.5L3 8.5M7 12.5L11 8.5"/></svg>`;
      case 'popular':
        return `<svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><polygon points="8 1.8 10 6 14.5 6.6 11.2 9.8 12 14.2 8 12.1 4 14.2 4.8 9.8 1.5 6.6 6 6 8 1.8"/></svg>`;
      case 'rating':
        return `<svg width="15" height="15" viewBox="0 0 16 16" fill="currentColor"><polygon points="8 1.8 10 6 14.5 6.6 11.2 9.8 12 14.2 8 12.1 4 14.2 4.8 9.8 1.5 6.6 6 6 8 1.8"/></svg>`;
      case 'name':
        return `<i class="fa-solid fa-arrow-down-a-z"></i>`;
      case 'amount':
      case 'amount_high':
      case 'spent_high':
        return `<i class="fa-solid fa-indian-rupee-sign" style="font-size: 0.85rem;"></i>`;
      case 'count':
        return `<i class="fa-solid fa-layer-group"></i>`;
      case 'latest':
      case 'newest':
      default:
        return `<svg width="14" height="15" viewBox="0 0 14 15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12V3M4 3L1.5 5.5M4 3L6.5 5.5M10 3V12M10 12L7.5 9.5M10 12L12.5 9.5"/></svg>`;
    }
  }

  // Find active option
  let activeOpt = options.find(o => o.value === _currentVal);
  if (!activeOpt && (_currentVal === 'newest' || _currentVal === 'latest')) {
    activeOpt = options.find(o => o.value === 'newest' || o.value === 'latest');
  }
  if (!activeOpt && options.length > 0) {
    activeOpt = options[0];
  }
%>

<div class="aruvi-sort-container" id="<%= _id %>_wrap" data-action-type="<%= _actionType %>">
  <% if (_label) { %>
    <span class="aruvi-sort-label"><%= _label %></span>
  <% } %>

  <input type="hidden" name="<%= _name %>" value="<%= activeOpt ? activeOpt.value : '' %>" id="<%= _id %>_input">

  <div class="aruvi-sort-dropdown" id="<%= _id %>">
    <!-- Trigger Button -->
    <button type="button" class="aruvi-sort-trigger" aria-haspopup="listbox" aria-expanded="false" id="<%= _id %>_btn">
      <div class="aruvi-sort-trigger-left">
        <span class="aruvi-sort-icon">
          <%- renderSortIcon(activeOpt ? activeOpt.iconType : 'latest', activeOpt ? activeOpt.customSvg : null, activeOpt ? activeOpt.customClass : null) %>
        </span>
        <span class="aruvi-sort-value-text"><%= activeOpt ? activeOpt.label : 'Latest' %></span>
      </div>
      <span class="aruvi-sort-chevron">
        <svg width="12" height="12" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 5l4 4 4-4"/>
        </svg>
      </span>
    </button>

    <!-- Floating Dropdown Panel -->
    <div class="aruvi-sort-menu" role="listbox" aria-labelledby="<%= _id %>_btn">
      <% options.forEach(opt => { 
        const isSelected = activeOpt && (opt.value === activeOpt.value);
      %>
        <div class="aruvi-sort-option <%= isSelected ? 'selected' : '' %>"
             role="option"
             aria-selected="<%= isSelected ? 'true' : 'false' %>"
             data-value="<%= opt.value %>"
             <% if (opt.url) { %>data-url="<%= opt.url %>"<% } %>>
          <span class="aruvi-sort-opt-icon">
            <%- renderSortIcon(opt.iconType, opt.customSvg, opt.customClass) %>
          </span>
          <span class="aruvi-sort-option-label"><%= opt.label %></span>
        </div>
      <% }) %>
    </div>
  </div>
</div>
