<%
  // Standardized Reusable Sort Dropdown Component for Aruvi Embroidery
  const _id = (typeof id !== 'undefined' && id) ? id : ('sort_dd_' + Math.random().toString(36).substring(2, 8));
  const _name = (typeof name !== 'undefined' && name) ? name : 'sort';
  const _actionType = (typeof actionType !== 'undefined' && actionType) ? actionType : 'ajax'; // 'ajax' (with live grid reload) or 'url' or 'submit'
  const _rawSort = (typeof currentSort !== 'undefined' && currentSort) ? currentSort : 'latest';
  const _extraClass = (typeof containerClass !== 'undefined' && containerClass) ? (' ' + containerClass) : '';

  // Normalize sort value
  function normalizeSortValue(val) {
    if (!val) return 'latest';
    if (val === 'newest') return 'latest';
    if (val === 'price_low') return 'price_asc';
    if (val === 'price_high') return 'price_desc';
    if (val === 'rating') return 'top_rated';
    if (val === 'most_popular') return 'popular';
    return val;
  }

  const _activeVal = normalizeSortValue(_rawSort);

  // Default 5 standard options if not supplied
  const _defaultOptions = [
    {
      value: 'latest',
      label: 'Latest',
      iconSvg: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>`
    },
    {
      value: 'price_asc',
      label: 'Price: Low to High',
      iconSvg: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="19" x2="12" y2="5"/><polyline points="5 12 12 5 19 12"/></svg>`
    },
    {
      value: 'price_desc',
      label: 'Price: High to Low',
      iconSvg: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><polyline points="19 12 12 19 5 12"/></svg>`
    },
    {
      value: 'popular',
      label: 'Popular',
      iconSvg: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 17c1.38 0 2.5-1.12 2.5-2.5 0-.61-.22-1.18-.58-1.63L12 11.5l-.92 1.37c-.36.45-.58 1.02-.58 1.63z"/><path d="M12 2c1.5 3 4 5.5 4 9.5 0 3.59-2.91 6.5-6.5 6.5S3 15.09 3 11.5c0-4 3.5-7 5.5-9.5C9.5 4.5 11 5 12 2z"/></svg>`
    },
    {
      value: 'top_rated',
      label: 'Top Rated',
      iconSvg: `<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" stroke="none"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>`
    }
  ];

  const _opts = (typeof options !== 'undefined' && Array.isArray(options) && options.length > 0) ? options : _defaultOptions;
  let activeOpt = _opts.find(o => normalizeSortValue(o.value) === _activeVal);
  if (!activeOpt && _opts.length > 0) activeOpt = _opts[0];
%>

<div class="aruvi-sort-wrapper<%= _extraClass %>" id="<%= _id %>_wrap" data-action-type="<%= _actionType %>" data-param-name="<%= _name %>">
  <input type="hidden" name="<%= _name %>" value="<%= activeOpt ? activeOpt.value : 'latest' %>" id="<%= _id %>_input">

  <!-- Trigger Button: Exactly 48px height, 14px radius, white bg, sort icon, brand red label -->
  <button type="button" 
          class="aruvi-sort-btn" 
          id="<%= _id %>_btn" 
          aria-haspopup="listbox" 
          aria-expanded="false" 
          aria-controls="<%= _id %>_menu"
          aria-label="Sort options, current: <%= activeOpt ? activeOpt.label : 'Latest' %>">
    <div class="aruvi-sort-btn-left">
      <span class="aruvi-sort-btn-icon" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="4" y1="6" x2="20" y2="6"></line>
          <line x1="4" y1="12" x2="14" y2="12"></line>
          <line x1="4" y1="18" x2="8" y2="18"></line>
        </svg>
      </span>
      <span class="aruvi-sort-btn-label">
        Sort: <strong class="aruvi-sort-val-text"><%= activeOpt ? activeOpt.label : 'Latest' %></strong>
      </span>
    </div>
    <span class="aruvi-sort-btn-chevron" aria-hidden="true">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="6 9 12 15 18 9"></polyline>
      </svg>
    </span>
  </button>

  <!-- Sort Dropdown Panel: 260px, 16px radius, soft shadow, z-index above cards -->
  <div class="aruvi-sort-panel" 
       id="<%= _id %>_menu" 
       role="listbox" 
       aria-labelledby="<%= _id %>_btn" 
       tabindex="-1">
    <div class="aruvi-sort-panel-inner">
      <% _opts.forEach((opt, idx) => { 
        const isSelected = activeOpt && (normalizeSortValue(opt.value) === normalizeSortValue(activeOpt.value));
      %>
        <div class="aruvi-sort-item <%= isSelected ? 'selected' : '' %>"
             role="option"
             id="<%= _id %>_opt_<%= idx %>"
             aria-selected="<%= isSelected ? 'true' : 'false' %>"
             data-value="<%= opt.value %>"
             tabindex="0">
          <div class="aruvi-sort-item-left">
            <span class="aruvi-sort-item-icon" aria-hidden="true">
              <%- opt.iconSvg || '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/></svg>' %>
            </span>
            <span class="aruvi-sort-item-title"><%= opt.label %></span>
          </div>
          <span class="aruvi-sort-item-check" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </span>
        </div>
      <% }) %>
    </div>
  </div>
</div>
