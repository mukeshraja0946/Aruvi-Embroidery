<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title><%= typeof title !== 'undefined' ? title : 'ARUVI EMBROIDERY STUDIO | Where Threads Tell Stories' %></title>
  <meta name="description" content="ARUVI EMBROIDERY STUDIO - Premium digitized machine embroidery designs in DST, PES, JEF, and EXP formats. Instant download.">
  <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
  <meta name="theme-color" id="metaThemeColor" content="#FFFDF9">
  <meta name="color-scheme" content="light dark">

  <!-- Instant Pre-paint Theme Script (Eliminates White Flash) -->
  <script>
    (function() {
      try {
        var defaultTheme = '<%= (typeof siteSettings !== "undefined" && siteSettings.default_theme) ? siteSettings.default_theme : "system" %>';
        var stored = localStorage.getItem('aruvi_theme') || '';
        if (!stored) {
          var m = document.cookie.match(/(?:^|;\s*)aruvi_theme=([^;]+)/);
          if (m) stored = decodeURIComponent(m[1]);
        }
        var choice = stored || defaultTheme || 'system';
        var isDark = choice === 'dark' || (choice === 'system' && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches);
        var activeTheme = isDark ? 'dark' : 'light';
        document.documentElement.setAttribute('data-theme', activeTheme);
        document.documentElement.setAttribute('data-theme-preference', choice);
        var metaColor = document.getElementById('metaThemeColor');
        if (metaColor) metaColor.content = isDark ? '#17090D' : '#FFFDF9';
      } catch (e) {}
    })();
  </script>

  <!-- Favicon -->
  <link rel="icon" type="image/jpeg" href="<%= (typeof siteSettings !== 'undefined' && siteSettings.favicon_url) ? siteSettings.favicon_url : '/public/images/logo.jpg' %>">

  <!-- Google Fonts: Playfair Display & Poppins & Caveat Script -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@600&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,400;1,600&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

  <%
    var _currentUser = (typeof currentUser !== 'undefined') ? currentUser : null;
    var _currentPath = (typeof currentPath !== 'undefined' && currentPath) ? currentPath : ((typeof _currentPath !== 'undefined') ? _currentPath : '');
    var _cartCount = (typeof cartCount !== 'undefined') ? cartCount : 0;
    var _wishlistCount = (typeof wishlistCount !== 'undefined') ? wishlistCount : 0;
    var _flash = (typeof flash !== 'undefined' && flash && Object.keys(flash).length > 0) ? flash : ((typeof _flash !== 'undefined') ? _flash : {});
  %>

  <!-- Main Stylesheet -->
  <link rel="stylesheet" href="/public/css/main.css">
  <% if (_currentUser && _currentUser.role === 'admin' && _currentPath.startsWith('/admin')) { %>
    <link rel="stylesheet" href="/public/css/admin.css">
  <% } %>
  <!-- Critical Animated Preloader (inlined in head for instant paint before other CSS) -->
  <%- include('preloader-css') %>
</head>
<body>
  <!-- Brand Preloader Overlay -->
  <%- include('preloader', { isPreview: false, hasIncludedPreloaderCss: true }) %>

  <!-- Top Announcement Bar matching Reference -->
  <div class="header-top">
    <div class="container top-flex">
      <div style="display: flex; align-items: center; gap: 8px;">
        <i class="fa-solid fa-truck-fast"></i>
        <span><%= (typeof siteSettings !== 'undefined' && siteSettings.announcement_bar) ? siteSettings.announcement_bar : 'Premium Machine Embroidery Designs — DST, PES, JEF, EXP & More | Instant Download' %></span>
      </div>
      <div style="display: flex; gap: 1.5rem; align-items: center;">
        <a href="/custom-order" style="display: flex; align-items: center; gap: 6px;">
          <i class="fa-solid fa-percent" style="font-size: 0.75rem;"></i> Get Custom Design
        </a>
        <span style="opacity: 0.3;">|</span>
        <a href="/contact" style="display: flex; align-items: center; gap: 6px;">
          <i class="fa-solid fa-headset" style="font-size: 0.85rem;"></i> Support
        </a>
        <span style="opacity: 0.3;">|</span>
        <div style="cursor: pointer; display: flex; align-items: center; gap: 4px;">
          <span>English</span> <i class="fa-solid fa-chevron-down" style="font-size: 0.7rem;"></i>
        </div>
      </div>
    </div>
  </div>

  <!-- Header Navigation Bar matching Reference -->
  <header class="site-header">
    <div class="container">
      <nav class="navbar">
        <!-- Mobile Menu Hamburger Button -->
        <button class="mobile-menu-toggle" id="mobileMenuBtn" aria-label="Open Navigation Menu">
          <i class="fa-solid fa-bars"></i>
        </button>

        <!-- Logo (with Dark mode fallback support) -->
        <a href="/" class="brand-logo" aria-label="ARUVI EMBROIDERY Home">
          <% 
            const headerLogo = (typeof siteSettings !== 'undefined' && siteSettings.logo_url) ? siteSettings.logo_url : '/public/images/logo.jpg';
            const darkLogo = (typeof siteSettings !== 'undefined' && siteSettings.footer_logo_url) ? siteSettings.footer_logo_url : headerLogo;
          %>
          <img src="<%= headerLogo %>" alt="ARUVI EMBROIDERY" onerror="this.onerror=null;this.src='/public/images/logo.jpg';" class="header-logo-img logo-light">
          <img src="<%= darkLogo %>" alt="ARUVI EMBROIDERY" onerror="this.onerror=null;this.src='<%= headerLogo %>';" class="header-logo-img logo-dark" style="display: none;">
        </a>

        <!-- Navigation Links -->
        <ul class="nav-links">
          <li><a href="/" class="<%= _currentPath === '/' ? 'active' : '' %>">Home</a></li>
          <li>
            <a href="/designs" class="<%= _currentPath.startsWith('/designs') || _currentPath.startsWith('/shop') ? 'active' : '' %>">
              Designs <i class="fa-solid fa-chevron-down" style="font-size: 0.7rem; margin-left: 2px;"></i>
            </a>
          </li>
          <li>
            <a href="/categories" class="<%= _currentPath.startsWith('/categor') ? 'active' : '' %>">
              Categories <i class="fa-solid fa-chevron-down" style="font-size: 0.7rem; margin-left: 2px;"></i>
            </a>
          </li>
          <li><a href="/custom-order" class="<%= _currentPath === '/custom-order' ? 'active' : '' %>">Custom Order</a></li>
          <li><a href="/about" class="<%= _currentPath === '/about' ? 'active' : '' %>">About</a></li>
          <li><a href="/contact" class="<%= _currentPath === '/contact' ? 'active' : '' %>">Contact</a></li>
        </ul>

        <!-- Search Box Pill -->
        <form action="/designs" method="GET" class="header-search">
          <i class="fa-solid fa-magnifying-glass"></i>
          <input type="text" name="search" placeholder="Search designs, categories..." value="<%= typeof search !== 'undefined' ? search : '' %>">
        </form>

        <!-- Right Action Icons -->
        <div class="header-actions">
          <!-- Desktop Theme Switcher -->
          <% const showThemeSwitcher = (typeof siteSettings === 'undefined' || siteSettings.theme_switcher_enabled !== '0'); %>
          <% if (showThemeSwitcher) { %>
            <div class="desktop-theme-switcher-wrap" id="desktopThemeSwitcherWrap">
              <button type="button" class="header-icon-btn theme-switcher-toggle" id="desktopThemeToggleBtn" aria-label="Switch Theme" aria-haspopup="true" aria-expanded="false" title="Theme (Light / Dark / System)">
                <i class="fa-solid fa-circle-half-stroke theme-active-icon"></i>
              </button>
              <div class="theme-dropdown-menu" id="desktopThemeDropdown" style="display: none;">
                <button type="button" class="theme-dropdown-item" data-theme-val="light"><i class="fa-regular fa-sun"></i> <span>Light</span></button>
                <button type="button" class="theme-dropdown-item" data-theme-val="dark"><i class="fa-regular fa-moon"></i> <span>Dark</span></button>
                <button type="button" class="theme-dropdown-item" data-theme-val="system"><i class="fa-solid fa-desktop"></i> <span>System</span></button>
              </div>
            </div>
          <% } %>

          <a href="/wishlist" class="header-icon-btn" aria-label="Wishlist (<%= _wishlistCount %> items)" title="Wishlist">
            <i class="fa-regular fa-heart"></i>
            <span class="header-badge wishlist-badge"><%= _wishlistCount %></span>
          </a>
          
          <% if (_currentUser && _currentUser.role === 'admin') { %>
            <a href="/admin" class="header-icon-btn" aria-label="Admin Panel" title="Admin Panel" style="background: var(--header-bar-bg, #231815); color: #FFFFFF;">
              <i class="fa-solid fa-user-gear"></i>
            </a>
          <% } else if (_currentUser) { %>
            <a href="/user/dashboard" class="header-icon-btn" aria-label="My Account" title="My Account">
              <i class="fa-regular fa-user"></i>
            </a>
          <% } else { %>
            <a href="/auth/login" class="header-icon-btn" aria-label="Sign In" title="Sign In">
              <i class="fa-regular fa-user"></i>
            </a>
          <% } %>

          <a href="/cart" class="header-icon-btn" aria-label="Shopping Cart (<%= _cartCount %> items)" title="Cart">
            <i class="fa-solid fa-bag-shopping"></i>
            <span class="header-badge cart-badge"><%= _cartCount %></span>
          </a>
        </div>
      </nav>
    </div>
  </header>

  <!-- Mobile Navigation Drawer -->
  <div class="mobile-drawer-overlay" id="mobileDrawerOverlay"></div>
  <div class="mobile-nav-drawer" id="mobileNavDrawer">
    <!-- Fixed Drawer Top: Header with Logo, Close & Search -->
    <div class="mobile-drawer-top-fixed">
      <div class="mobile-drawer-header">
        <div class="drawer-logo">
          <img src="<%= headerLogo %>" alt="ARUVI EMBROIDERY" class="logo-light" onerror="this.onerror=null;this.src='/public/images/logo.jpg';">
          <img src="<%= darkLogo %>" alt="ARUVI EMBROIDERY" class="logo-dark" style="display: none;" onerror="this.onerror=null;this.src='<%= headerLogo %>';">
        </div>
        <button class="mobile-drawer-close" id="closeMobileMenu" aria-label="Close Menu">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>

      <div class="mobile-drawer-search">
        <form action="/designs" method="GET">
          <i class="fa-solid fa-magnifying-glass"></i>
          <input type="text" name="search" placeholder="Search designs..." value="<%= typeof search !== 'undefined' ? search : '' %>">
        </form>
      </div>
    </div>

    <!-- Scrollable Drawer Menu List (padding-top 8px) -->
    <div class="mobile-drawer-scrollable">
      <nav class="mobile-drawer-nav" aria-label="Mobile Navigation">
        <!-- Group 1: Store Navigation Links -->
        <div class="drawer-nav-group">
          <a href="/" class="drawer-nav-row <%= _currentPath === '/' ? 'active' : '' %>">
            <span class="drawer-nav-icon"><i class="fa-solid fa-house"></i></span>
            <span class="drawer-nav-label">Home</span>
          </a>
          <a href="/designs" class="drawer-nav-row <%= _currentPath.startsWith('/designs') || _currentPath.startsWith('/shop') ? 'active' : '' %>">
            <span class="drawer-nav-icon"><i class="fa-solid fa-shapes"></i></span>
            <span class="drawer-nav-label">Designs</span>
            <i class="fa-solid fa-chevron-right drawer-chevron"></i>
          </a>
          <a href="/categories" class="drawer-nav-row <%= _currentPath.startsWith('/categor') ? 'active' : '' %>">
            <span class="drawer-nav-icon"><i class="fa-solid fa-layer-group"></i></span>
            <span class="drawer-nav-label">Categories</span>
            <i class="fa-solid fa-chevron-right drawer-chevron"></i>
          </a>
          <a href="/custom-order" class="drawer-nav-row <%= _currentPath === '/custom-order' ? 'active' : '' %>">
            <span class="drawer-nav-icon"><i class="fa-solid fa-wand-magic-sparkles"></i></span>
            <span class="drawer-nav-label">Custom Order</span>
          </a>
          <a href="/about" class="drawer-nav-row <%= _currentPath === '/about' ? 'active' : '' %>">
            <span class="drawer-nav-icon"><i class="fa-solid fa-circle-info"></i></span>
            <span class="drawer-nav-label">About</span>
          </a>
          <a href="/contact" class="drawer-nav-row <%= _currentPath === '/contact' ? 'active' : '' %>">
            <span class="drawer-nav-icon"><i class="fa-solid fa-headset"></i></span>
            <span class="drawer-nav-label">Contact</span>
          </a>
        </div>

        <!-- Consistent Divider -->
        <div class="drawer-divider"></div>

        <!-- Group 2: User Account & Cart/Wishlist Links -->
        <div class="drawer-nav-group">
          <% if (_currentUser) { %>
            <a href="/user/dashboard" class="drawer-nav-row <%= _currentPath.startsWith('/user/dashboard') ? 'active' : '' %>">
              <span class="drawer-nav-icon"><i class="fa-regular fa-user"></i></span>
              <span class="drawer-nav-label">My Account</span>
            </a>
            <a href="/user/orders" class="drawer-nav-row <%= _currentPath.startsWith('/user/orders') ? 'active' : '' %>">
              <span class="drawer-nav-icon"><i class="fa-solid fa-box-archive"></i></span>
              <span class="drawer-nav-label">My Orders</span>
            </a>
          <% } else { %>
            <a href="/auth/login" class="drawer-nav-row">
              <span class="drawer-nav-icon"><i class="fa-regular fa-user"></i></span>
              <span class="drawer-nav-label">My Account</span>
            </a>
            <a href="/auth/login" class="drawer-nav-row">
              <span class="drawer-nav-icon"><i class="fa-solid fa-box-archive"></i></span>
              <span class="drawer-nav-label">My Orders</span>
            </a>
          <% } %>
          <a href="/wishlist" class="drawer-nav-row <%= _currentPath.startsWith('/wishlist') ? 'active' : '' %>">
            <span class="drawer-nav-icon"><i class="fa-regular fa-heart"></i></span>
            <span class="drawer-nav-label">Wishlist</span>
            <span class="drawer-nav-pill wishlist-badge <%= _wishlistCount > 0 ? '' : 'is-zero' %>" id="drawerWishlistBadge"><%= _wishlistCount %></span>
          </a>
          <a href="/cart" class="drawer-nav-row <%= _currentPath === '/cart' ? 'active' : '' %>">
            <span class="drawer-nav-icon"><i class="fa-solid fa-bag-shopping"></i></span>
            <span class="drawer-nav-label">Cart</span>
            <span class="drawer-nav-pill cart-badge <%= _cartCount > 0 ? '' : 'is-zero' %>" id="drawerCartBadge"><%= _cartCount %></span>
          </a>
        </div>
      </nav>
    </div>

    <!-- Drawer Footer: Appearance Block & View Cart Button -->
    <div class="mobile-drawer-footer">
      <% if (showThemeSwitcher) { %>
        <div class="drawer-appearance-block" id="drawerAppearanceBlock">
          <div class="appearance-block-title">
            <i class="fa-solid fa-circle-half-stroke"></i>
            <span>Appearance</span>
          </div>
          <div class="theme-segmented-ctrl" role="group" aria-label="Theme Selection">
            <button type="button" class="theme-seg-btn" data-theme-val="light" aria-pressed="false" title="Light Theme">
              <i class="fa-solid fa-sun"></i>
              <span>Light</span>
            </button>
            <button type="button" class="theme-seg-btn" data-theme-val="dark" aria-pressed="false" title="Dark Theme">
              <i class="fa-solid fa-moon"></i>
              <span>Dark</span>
            </button>
            <button type="button" class="theme-seg-btn" data-theme-val="system" aria-pressed="true" title="System Theme">
              <i class="fa-solid fa-desktop"></i>
              <span>System</span>
            </button>
          </div>
        </div>
      <% } %>

      <div class="drawer-action-btns">
        <a href="/cart" class="btn btn-primary btn-block drawer-view-cart-btn">
          <i class="fa-solid fa-bag-shopping"></i>
          <span>View Cart</span>
          <span class="drawer-cart-pill cart-badge" id="drawerViewCartBadge"><%= _cartCount %></span>
        </a>
      </div>
    </div>
  </div>

  <!-- Auth Login Modal Popup matching Aruvi Theme -->
  <div id="authLoginModal" class="modal-overlay" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(35, 24, 21, 0.65); backdrop-filter: blur(4px); z-index: 999999; align-items: center; justify-content: center; padding: 1rem;">
    <div class="modal-card" style="background: var(--bg-card, #FFF); width: 100%; max-width: 440px; border-radius: 20px; padding: 2.2rem; box-shadow: var(--shadow-lg); position: relative; border: 1px solid var(--border-light, #E8E0D5);">
      <button type="button" onclick="closeLoginModal()" style="position: absolute; top: 18px; right: 18px; background: none; border: none; font-size: 1.4rem; color: var(--text-muted, #8C7F79); cursor: pointer;" aria-label="Close">&times;</button>
      
      <div style="text-align: center; margin-bottom: 1.2rem;">
        <img src="<%= headerLogo %>" alt="Aruvi Embroidery" class="logo-light" style="max-height: 48px; width: auto; margin-bottom: 0.8rem; object-fit: contain;">
        <img src="<%= darkLogo %>" alt="Aruvi Embroidery" class="logo-dark" style="display: none; max-height: 48px; width: auto; margin-bottom: 0.8rem; object-fit: contain;">
        <h3 style="font-family: var(--font-heading); font-size: 1.6rem; font-weight: 700; color: var(--text-dark, #231815); margin-bottom: 4px;">Sign In Required</h3>
        <p style="font-size: 0.85rem; color: var(--text-muted, #8C7F79); margin: 0;">Please log in to your account to continue your purchase and instant file download.</p>
      </div>

      <div id="loginModalError" style="display: none; background: var(--color-error-bg, #FCE8E6); color: var(--color-error, #B8402A); padding: 0.75rem 1rem; border-radius: 10px; font-size: 0.85rem; font-weight: 500; margin-bottom: 1.2rem; text-align: center;"></div>

      <%- include('auth-methods', { mode: 'modal', isModal: true, submitText: 'Sign In & Continue', formId: 'loginModalForm' }) %>
    </div>
  </div>

  <script>
    window.isUserLoggedIn = <%= _currentUser ? 'true' : 'false' %>;
    window.pendingAuthAction = null;

    function openLoginModal(onSuccessCallback, customReturnUrl) {
      if (window.isUserLoggedIn) {
        if (typeof onSuccessCallback === 'function') onSuccessCallback();
        return;
      }
      window.pendingAuthAction = onSuccessCallback || null;
      const targetUrl = customReturnUrl || (window.location.pathname + window.location.search);
      const modal = document.getElementById('authLoginModal');
      if (modal) {
        const modalGoogle = document.getElementById('modalGoogleBtn');
        if (modalGoogle) {
          modalGoogle.href = '/auth/google?returnTo=' + encodeURIComponent(targetUrl);
        }
        const returnInput = document.getElementById('modalReturnTo');
        if (returnInput) {
          returnInput.value = targetUrl;
        }
        modal.style.display = 'flex';
      } else {
        window.location.href = '/auth/login?returnTo=' + encodeURIComponent(targetUrl);
      }
    }

    function closeLoginModal() {
      const modal = document.getElementById('authLoginModal');
      if (modal) modal.style.display = 'none';
      const errDiv = document.getElementById('loginModalError');
      if (errDiv) errDiv.style.display = 'none';
    }

    // Universal Badge Updater for header & sidebar counts
    window.updateStoreBadges = function(counts) {
      if (!counts) return;
      if (counts.cart !== undefined) {
        document.querySelectorAll('.cart-badge').forEach(function(el) {
          el.textContent = counts.cart;
          if (el.classList.contains('drawer-nav-pill')) {
            if (parseInt(counts.cart, 10) > 0) {
              el.classList.remove('is-zero');
            } else {
              el.classList.add('is-zero');
            }
          }
        });
      }
      if (counts.wishlist !== undefined) {
        document.querySelectorAll('.wishlist-badge').forEach(function(el) {
          el.textContent = counts.wishlist;
          if (el.classList.contains('drawer-nav-pill')) {
            if (parseInt(counts.wishlist, 10) > 0) {
              el.classList.remove('is-zero');
            } else {
              el.classList.add('is-zero');
            }
          }
        });
      }
    };

    // Synchronize Mobile Navigation Drawer open/close state with body.drawer-open
    document.addEventListener('DOMContentLoaded', function() {
      var mobileMenuBtn = document.getElementById('mobileMenuBtn');
      var closeMobileMenu = document.getElementById('closeMobileMenu');
      var mobileNavDrawer = document.getElementById('mobileNavDrawer');
      var mobileDrawerOverlay = document.getElementById('mobileDrawerOverlay');

      function openDrawer() {
        if (mobileNavDrawer && mobileDrawerOverlay) {
          mobileNavDrawer.classList.add('open');
          mobileDrawerOverlay.classList.add('active');
          document.body.classList.add('drawer-open');
          document.body.style.overflow = 'hidden';
        }
      }

      function closeDrawer() {
        if (mobileNavDrawer && mobileDrawerOverlay) {
          mobileNavDrawer.classList.remove('open');
          mobileDrawerOverlay.classList.remove('active');
          document.body.classList.remove('drawer-open');
          document.body.style.overflow = '';
        }
      }

      if (mobileMenuBtn) mobileMenuBtn.addEventListener('click', openDrawer);
      if (closeMobileMenu) closeMobileMenu.addEventListener('click', closeDrawer);
      if (mobileDrawerOverlay) mobileDrawerOverlay.addEventListener('click', closeDrawer);
    });

    // Theme Switcher Controller (Part 2: Light / Dark / System)
    (function initThemeSwitcher() {
      var defaultTheme = '<%= (typeof siteSettings !== "undefined" && siteSettings.default_theme) ? siteSettings.default_theme : "system" %>';

      function getStoredTheme() {
        try {
          var s = localStorage.getItem('aruvi_theme');
          if (s && ['light', 'dark', 'system'].indexOf(s) !== -1) return s;
        } catch (_) {}
        var m = document.cookie.match(/(?:^|;\s*)aruvi_theme=([^;]+)/);
        if (m && ['light', 'dark', 'system'].indexOf(decodeURIComponent(m[1])) !== -1) {
          return decodeURIComponent(m[1]);
        }
        return defaultTheme || 'system';
      }

      function applyTheme(choice) {
        var isDark = choice === 'dark' || (choice === 'system' && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches);
        var activeTheme = isDark ? 'dark' : 'light';
        document.documentElement.setAttribute('data-theme', activeTheme);
        document.documentElement.setAttribute('data-theme-preference', choice);
        
        var metaColor = document.getElementById('metaThemeColor');
        if (metaColor) metaColor.content = isDark ? '#17090D' : '#FFFDF9';

        // Update segmented buttons
        document.querySelectorAll('.theme-seg-btn, .theme-dropdown-item, .footer-theme-btn').forEach(function(btn) {
          var val = btn.getAttribute('data-theme-val');
          var isCurrent = val === choice;
          btn.setAttribute('aria-pressed', isCurrent ? 'true' : 'false');
          if (isCurrent) {
            btn.classList.add('active');
          } else {
            btn.classList.remove('active');
          }
        });

        // Update desktop toggle icon
        var desktopIcon = document.getElementById('desktopThemeActiveIcon');
        if (desktopIcon) {
          if (choice === 'light') desktopIcon.className = 'fa-regular fa-sun';
          else if (choice === 'dark') desktopIcon.className = 'fa-regular fa-moon';
          else desktopIcon.className = 'fa-solid fa-circle-half-stroke';
        }

        try {
          localStorage.setItem('aruvi_theme', choice);
        } catch (_) {}
        try {
          document.cookie = 'aruvi_theme=' + encodeURIComponent(choice) + ';path=/;max-age=31536000;SameSite=Lax';
        } catch (_) {}
      }

      // Initial apply & sync UI state
      document.addEventListener('DOMContentLoaded', function() {
        var currentChoice = getStoredTheme();
        applyTheme(currentChoice);

        // Wire segmented buttons in mobile drawer
        document.querySelectorAll('.theme-seg-btn, .footer-theme-btn').forEach(function(btn) {
          btn.addEventListener('click', function(e) {
            e.preventDefault();
            var val = this.getAttribute('data-theme-val');
            if (val) applyTheme(val);
          });
        });

        // Wire desktop switcher toggle & dropdown
        var desktopToggleBtn = document.getElementById('desktopThemeToggleBtn');
        var desktopDropdown = document.getElementById('desktopThemeDropdown');
        if (desktopToggleBtn && desktopDropdown) {
          desktopToggleBtn.addEventListener('click', function(e) {
            e.stopPropagation();
            var isHidden = desktopDropdown.style.display === 'none';
            desktopDropdown.style.display = isHidden ? 'block' : 'none';
            desktopToggleBtn.setAttribute('aria-expanded', isHidden ? 'true' : 'false');
          });

          document.querySelectorAll('.theme-dropdown-item').forEach(function(item) {
            item.addEventListener('click', function(e) {
              e.preventDefault();
              var val = this.getAttribute('data-theme-val');
              if (val) applyTheme(val);
              desktopDropdown.style.display = 'none';
              desktopToggleBtn.setAttribute('aria-expanded', 'false');
            });
          });

          document.addEventListener('click', function(e) {
            if (!e.target.closest('#desktopThemeSwitcherWrap')) {
              desktopDropdown.style.display = 'none';
              desktopToggleBtn.setAttribute('aria-expanded', 'false');
            }
          });
        }

        // System theme live listener
        if (window.matchMedia) {
          window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function() {
            var current = getStoredTheme();
            if (current === 'system') {
              applyTheme('system');
            }
          });
        }
      });
    })();

    document.addEventListener('DOMContentLoaded', () => {
      const loginForm = document.getElementById('loginModalForm');
      if (loginForm) {
        loginForm.addEventListener('submit', async function(e) {
          e.preventDefault();
          const btn = document.getElementById('loginModalBtn');
          const errDiv = document.getElementById('loginModalError');
          btn.disabled = true;
          btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Authenticating...';
          if (errDiv) errDiv.style.display = 'none';

          const email = document.getElementById('loginModalEmail').value;
          const password = document.getElementById('loginModalPassword').value;
          const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content');
          const returnTo = document.getElementById('modalReturnTo')?.value || '';

          try {
            const payload = { email, password, _csrf: csrfToken, _ajax: '1' };
            if (returnTo) payload.returnTo = returnTo;

            const res = await fetch('/auth/login', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'Accept': 'application/json',
                'X-Requested-With': 'XMLHttpRequest',
                'X-CSRF-Token': csrfToken
              },
              body: new URLSearchParams(payload)
            });

            const data = await res.json();
            if (res.ok && data.success) {
              window.isUserLoggedIn = true;
              closeLoginModal();
              if (typeof window.pendingAuthAction === 'function') {
                const cb = window.pendingAuthAction;
                window.pendingAuthAction = null;
                cb();
              } else if (data.redirect) {
                window.location.href = data.redirect;
              } else {
                window.location.reload();
              }
            } else {
              if (errDiv) {
                if (data.code === 'ACCOUNT_NOT_FOUND') {
                  errDiv.innerHTML = `${data.message || 'No account found with this email.'} <a href="/auth/register" style="color: var(--primary, #900C3F); font-weight: 700; text-decoration: underline; margin-left: 4px;">Create Account</a>`;
                } else {
                  errDiv.textContent = data.message || 'Invalid email or password.';
                }
                errDiv.style.display = 'block';
              }
              btn.disabled = false;
              btn.innerHTML = '<i class="fa-solid fa-arrow-right-to-bracket"></i> Sign In & Continue';
            }
          } catch (err) {
            console.error('Modal login error:', err);
            if (errDiv) {
              errDiv.textContent = 'An error occurred during authentication. Please try again.';
              errDiv.style.display = 'block';
            }
            btn.disabled = false;
            btn.innerHTML = '<i class="fa-solid fa-arrow-right-to-bracket"></i> Sign In & Continue';
          }
        });
      }

      const toggleModalPwd = document.getElementById('toggleModalPasswordBtn');
      if (toggleModalPwd) {
        toggleModalPwd.addEventListener('click', function() {
          const pwdInput = document.getElementById('loginModalPassword');
          if (pwdInput) {
            if (pwdInput.type === 'password') {
              pwdInput.type = 'text';
              this.classList.remove('fa-eye');
              this.classList.add('fa-eye-slash');
            } else {
              pwdInput.type = 'password';
              this.classList.remove('fa-eye-slash');
              this.classList.add('fa-eye');
            }
          }
        });
      }
    });
  </script>

  <!-- Flash Messages (Only rendered when flash messages exist) -->
  <% 
    const hasFlashMsgs = (_flash && (
      (_flash.success && _flash.success.length > 0) ||
      (_flash.error && _flash.error.length > 0) ||
      (_flash.info && _flash.info.length > 0)
    ));
  %>
  <% if (_currentPath !== '/admin/login' && hasFlashMsgs) { %>
    <div class="container flash-messages-container" style="margin-top: 0.75rem; margin-bottom: 0.5rem;">
      <% if (_flash.success && _flash.success.length > 0) { %>
        <div class="alert alert-success">
          <i class="fa-solid fa-circle-check"></i> <%= _flash.success[0] %>
        </div>
      <% } %>
      <% if (_flash.error && _flash.error.length > 0) { %>
        <div class="alert alert-error">
          <i class="fa-solid fa-circle-exclamation"></i> <%= _flash.error[0] %>
        </div>
      <% } %>
      <% if (_flash.info && _flash.info.length > 0) { %>
        <div class="alert alert-info">
          <i class="fa-solid fa-circle-info"></i> <%= _flash.info[0] %>
        </div>
      <% } %>
    </div>
  <% } %>
