<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'ARUVI EMBROIDERY STUDIO | Where Threads Tell Stories' %></title>
  <meta name="description" content="ARUVI EMBROIDERY STUDIO - Premium digitized machine embroidery designs in DST, PES, JEF, and EXP formats. Instant download.">
  <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">

  <!-- Favicon -->
  <link rel="icon" type="image/jpeg" href="<%= (typeof siteSettings !== 'undefined' && siteSettings.favicon_url) ? siteSettings.favicon_url : '/public/images/logo.jpg' %>">

  <!-- Google Fonts: Playfair Display & Poppins & Caveat Script -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@600&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,400;1,600&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

  <%
    var _currentUser = (typeof currentUser !== 'undefined') ? currentUser : null;
    var _currentPath = (typeof currentPath !== 'undefined') ? currentPath : '';
    var _cartCount = (typeof cartCount !== 'undefined') ? cartCount : 0;
    var _flash = (typeof flash !== 'undefined') ? flash : {};
  %>

  <!-- Main Stylesheet -->
  <link rel="stylesheet" href="/public/css/main.css">
  <% if (_currentUser && _currentUser.role === 'admin' && _currentPath.startsWith('/admin')) { %>
    <link rel="stylesheet" href="/public/css/admin.css">
  <% } %>
</head>
<body>

  <!-- Top Announcement Bar matching Reference -->
  <div class="header-top">
    <div class="container top-flex">
      <div style="display: flex; align-items: center; gap: 8px;">
        <i class="fa-solid fa-truck-fast"></i>
        <span><%= (typeof siteSettings !== 'undefined' && siteSettings.announcement_bar) ? siteSettings.announcement_bar : 'Premium Machine Embroidery Designs — DST, PES, JEF, EXP & More | Instant Download' %></span>
      </div>
      <div style="display: flex; gap: 1.5rem; align-items: center;">
        <a href="/custom-order" style="display: flex; align-items: center; gap: 6px;">
          <i class="fa-solid fa-percent" style="font-size: 0.75rem;"></i> Get Custom Design
        </a>
        <span style="opacity: 0.3;">|</span>
        <a href="/contact" style="display: flex; align-items: center; gap: 6px;">
          <i class="fa-solid fa-headset" style="font-size: 0.85rem;"></i> Support
        </a>
        <span style="opacity: 0.3;">|</span>
        <div style="cursor: pointer; display: flex; align-items: center; gap: 4px;">
          <span>English</span> <i class="fa-solid fa-chevron-down" style="font-size: 0.7rem;"></i>
        </div>
      </div>
    </div>
  </div>

  <!-- Header Navigation Bar matching Reference -->
  <header class="site-header">
    <div class="container">
      <nav class="navbar">
        <!-- Mobile Menu Hamburger Button -->
        <button class="mobile-menu-toggle" id="mobileMenuBtn" aria-label="Open Navigation Menu">
          <i class="fa-solid fa-bars"></i>
        </button>

        <!-- Logo -->
        <a href="/" class="brand-logo">
          <% if (typeof siteSettings !== 'undefined' && siteSettings.logo_url) { %>
            <img src="<%= siteSettings.logo_url %>" alt="ARUVI EMBROIDERY STUDIO" style="max-height: 48px; width: auto; object-fit: contain;">
          <% } else { %>
            <img src="/public/images/logo.jpg" alt="ARUVI EMBROIDERY STUDIO" style="max-height: 48px; width: auto; object-fit: contain;">
          <% } %>
        </a>

        <!-- Navigation Links -->
        <ul class="nav-links">
          <li><a href="/" class="<%= _currentPath === '/' ? 'active' : '' %>">Home</a></li>
          <li>
            <a href="/designs" class="<%= _currentPath.startsWith('/designs') || _currentPath.startsWith('/shop') ? 'active' : '' %>">
              Designs <i class="fa-solid fa-chevron-down" style="font-size: 0.7rem; margin-left: 2px;"></i>
            </a>
          </li>
          <li>
            <a href="/categories" class="<%= _currentPath.startsWith('/categor') ? 'active' : '' %>">
              Categories <i class="fa-solid fa-chevron-down" style="font-size: 0.7rem; margin-left: 2px;"></i>
            </a>
          </li>
          <li><a href="/custom-order" class="<%= _currentPath === '/custom-order' ? 'active' : '' %>">Custom Order</a></li>
          <li><a href="/about" class="<%= _currentPath === '/about' ? 'active' : '' %>">About</a></li>
          <li><a href="/contact" class="<%= _currentPath === '/contact' ? 'active' : '' %>">Contact</a></li>
        </ul>

        <!-- Search Box Pill -->
        <form action="/designs" method="GET" class="header-search">
          <i class="fa-solid fa-magnifying-glass"></i>
          <input type="text" name="search" placeholder="Search designs, categories..." value="<%= typeof search !== 'undefined' ? search : '' %>">
        </form>

        <!-- Right Action Icons -->
        <div class="header-actions">
          <a href="/user/wishlist" class="header-icon-btn" title="Wishlist">
            <i class="fa-regular fa-heart"></i>
            <span class="cart-badge">2</span>
          </a>
          
          <% if (_currentUser && _currentUser.role === 'admin') { %>
            <a href="/admin" class="header-icon-btn" title="Admin Panel" style="background: #231815; color: #FFFFFF;">
              <i class="fa-solid fa-user-gear"></i>
            </a>
          <% } else if (_currentUser) { %>
            <a href="/user/dashboard" class="header-icon-btn" title="Account">
              <i class="fa-regular fa-user"></i>
            </a>
          <% } else { %>
            <a href="/auth/login" class="header-icon-btn" title="Sign In">
              <i class="fa-regular fa-user"></i>
            </a>
          <% } %>

          <a href="/cart" class="header-icon-btn" title="Cart">
            <i class="fa-solid fa-bag-shopping"></i>
            <span class="cart-badge"><%= _cartCount %></span>
          </a>
        </div>
      </nav>
    </div>
  </header>

  <!-- Mobile Navigation Drawer -->
  <div class="mobile-drawer-overlay" id="mobileDrawerOverlay"></div>
  <div class="mobile-nav-drawer" id="mobileNavDrawer">
    <div class="mobile-drawer-header">
      <div class="drawer-logo">
        <img src="<%= (typeof siteSettings !== 'undefined' && siteSettings.logo_url) ? siteSettings.logo_url : '/public/images/logo.jpg' %>" alt="ARUVI EMBROIDERY">
      </div>
      <button class="mobile-drawer-close" id="closeMobileMenu" aria-label="Close Menu">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>

    <div class="mobile-drawer-search">
      <form action="/designs" method="GET">
        <i class="fa-solid fa-magnifying-glass"></i>
        <input type="text" name="search" placeholder="Search designs..." value="<%= typeof search !== 'undefined' ? search : '' %>">
      </form>
    </div>

    <ul class="mobile-drawer-links">
      <li><a href="/" class="<%= _currentPath === '/' ? 'active' : '' %>"><i class="fa-solid fa-house"></i> Home</a></li>
      <li><a href="/designs" class="<%= _currentPath.startsWith('/designs') || _currentPath.startsWith('/shop') ? 'active' : '' %>"><i class="fa-solid fa-shapes"></i> Designs <i class="fa-solid fa-chevron-down" style="margin-left: auto; font-size: 0.75rem;"></i></a></li>
      <li><a href="/categories" class="<%= _currentPath.startsWith('/categor') ? 'active' : '' %>"><i class="fa-solid fa-layer-group"></i> Categories <i class="fa-solid fa-chevron-down" style="margin-left: auto; font-size: 0.75rem;"></i></a></li>
      <li><a href="/custom-order" class="<%= _currentPath === '/custom-order' ? 'active' : '' %>"><i class="fa-solid fa-wand-magic-sparkles"></i> Custom Order</a></li>
      <li><a href="/about" class="<%= _currentPath === '/about' ? 'active' : '' %>"><i class="fa-solid fa-circle-info"></i> About</a></li>
      <li><a href="/contact" class="<%= _currentPath === '/contact' ? 'active' : '' %>"><i class="fa-solid fa-headset"></i> Contact</a></li>
      <li style="border-top: 1px solid var(--border-light); margin-top: 6px; padding-top: 6px;">
        <% if (_currentUser) { %>
          <a href="/user/dashboard"><i class="fa-regular fa-user"></i> My Account</a>
          <a href="/user/orders"><i class="fa-solid fa-box-archive"></i> My Orders</a>
        <% } else { %>
          <a href="/auth/login"><i class="fa-regular fa-user"></i> My Account</a>
          <a href="/auth/login"><i class="fa-solid fa-box-archive"></i> My Orders</a>
        <% } %>
        <a href="/user/wishlist"><i class="fa-regular fa-heart"></i> Wishlist</a>
        <a href="/cart"><i class="fa-solid fa-bag-shopping"></i> Cart (<%= _cartCount %>)</a>
      </li>
    </ul>

    <div class="mobile-drawer-footer">
      <div class="drawer-action-btns">
        <a href="/cart" class="btn btn-primary btn-block"><i class="fa-solid fa-bag-shopping"></i> View Cart (<%= _cartCount %>)</a>
      </div>
    </div>
  </div>

  <!-- Auth Login Modal Popup matching Aruvi Theme -->
  <div id="authLoginModal" class="modal-overlay" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(35, 24, 21, 0.65); backdrop-filter: blur(4px); z-index: 999999; align-items: center; justify-content: center; padding: 1rem;">
    <div class="modal-card" style="background: #FFF; width: 100%; max-width: 440px; border-radius: 20px; padding: 2.2rem; box-shadow: 0 20px 40px rgba(0,0,0,0.25); position: relative; border: 1px solid #E8E0D5;">
      <button type="button" onclick="closeLoginModal()" style="position: absolute; top: 18px; right: 18px; background: none; border: none; font-size: 1.4rem; color: #8C7F79; cursor: pointer;">&times;</button>
      
      <div style="text-align: center; margin-bottom: 1.5rem;">
        <img src="<%= (typeof siteSettings !== 'undefined' && siteSettings.logo_url) ? siteSettings.logo_url : '/public/images/logo.jpg' %>" alt="Aruvi Embroidery" style="max-height: 48px; width: auto; margin-bottom: 0.8rem; object-fit: contain;">
        <h3 style="font-family: var(--font-heading); font-size: 1.6rem; font-weight: 700; color: #231815; margin-bottom: 4px;">Sign In Required</h3>
        <p style="font-size: 0.85rem; color: #8C7F79; margin: 0;">Please log in to your account to continue your purchase and instant file download.</p>
      </div>

      <div id="loginModalError" style="display: none; background: #FCE8E6; color: #B8402A; padding: 0.75rem 1rem; border-radius: 10px; font-size: 0.85rem; font-weight: 500; margin-bottom: 1.2rem; text-align: center;"></div>

      <form id="loginModalForm">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div style="margin-bottom: 1.1rem;">
          <label style="display: block; font-size: 0.82rem; font-weight: 600; color: #231815; margin-bottom: 6px;">Email Address <span style="color: #B8402A;">*</span></label>
          <input type="email" id="loginModalEmail" name="email" class="form-control" placeholder="your.email@example.com" required style="width: 100%; height: 44px; border-radius: 10px; border: 1px solid #E8E0D5; padding: 0 1rem; font-size: 0.9rem;">
        </div>

        <div style="margin-bottom: 1.5rem;">
          <label style="display: block; font-size: 0.82rem; font-weight: 600; color: #231815; margin-bottom: 6px;">Password <span style="color: #B8402A;">*</span></label>
          <input type="password" id="loginModalPassword" name="password" class="form-control" placeholder="••••••••" required style="width: 100%; height: 44px; border-radius: 10px; border: 1px solid #E8E0D5; padding: 0 1rem; font-size: 0.9rem;">
        </div>

        <button type="submit" id="loginModalBtn" class="btn btn-primary btn-block" style="height: 46px; border-radius: 10px; font-weight: 600; font-size: 0.95rem; display: flex; align-items: center; justify-content: center; gap: 8px; background-color: var(--primary);">
          <i class="fa-solid fa-arrow-right-to-bracket"></i> Sign In & Continue
        </button>
      </form>

      <div style="text-align: center; margin-top: 1.2rem; font-size: 0.85rem; color: #8C7F79;">
        Don't have an account? <a href="/auth/register" style="color: #B8402A; font-weight: 600; text-decoration: none;">Create Account</a>
      </div>
    </div>
  </div>

  <script>
    window.isUserLoggedIn = <%= _currentUser ? 'true' : 'false' %>;
    window.pendingAuthAction = null;

    function openLoginModal(onSuccessCallback) {
      if (window.isUserLoggedIn) {
        if (typeof onSuccessCallback === 'function') onSuccessCallback();
        return;
      }
      window.pendingAuthAction = onSuccessCallback || null;
      const modal = document.getElementById('authLoginModal');
      if (modal) {
        modal.style.display = 'flex';
      } else {
        window.location.href = '/auth/login';
      }
    }

    function closeLoginModal() {
      const modal = document.getElementById('authLoginModal');
      if (modal) modal.style.display = 'none';
      const errDiv = document.getElementById('loginModalError');
      if (errDiv) errDiv.style.display = 'none';
    }

    document.addEventListener('DOMContentLoaded', () => {
      const loginForm = document.getElementById('loginModalForm');
      if (loginForm) {
        loginForm.addEventListener('submit', async function(e) {
          e.preventDefault();
          const btn = document.getElementById('loginModalBtn');
          const errDiv = document.getElementById('loginModalError');
          btn.disabled = true;
          btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Authenticating...';
          if (errDiv) errDiv.style.display = 'none';

          const email = document.getElementById('loginModalEmail').value;
          const password = document.getElementById('loginModalPassword').value;
          const csrfToken = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content');

          try {
            const res = await fetch('/auth/login', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/x-www-form-urlencoded',
                'Accept': 'application/json',
                'X-CSRF-Token': csrfToken
              },
              body: new URLSearchParams({ email, password, _csrf: csrfToken })
            });

            const data = await res.json();
            if (data.success) {
              window.isUserLoggedIn = true;
              closeLoginModal();
              if (typeof window.pendingAuthAction === 'function') {
                const cb = window.pendingAuthAction;
                window.pendingAuthAction = null;
                cb();
              } else {
                window.location.reload();
              }
            } else {
              if (errDiv) {
                errDiv.textContent = data.message || 'Invalid email or password.';
                errDiv.style.display = 'block';
              }
              btn.disabled = false;
              btn.innerHTML = '<i class="fa-solid fa-arrow-right-to-bracket"></i> Sign In & Continue';
            }
          } catch (err) {
            console.error('Modal login error:', err);
            if (errDiv) {
              errDiv.textContent = 'An error occurred during authentication.';
              errDiv.style.display = 'block';
            }
            btn.disabled = false;
            btn.innerHTML = '<i class="fa-solid fa-arrow-right-to-bracket"></i> Sign In & Continue';
          }
        });
      }
    });
  </script>

  <!-- Flash Messages -->
  <div class="container" style="margin-top: 1rem;">
    <% if (_flash.success && _flash.success.length > 0) { %>
      <div class="alert alert-success">
        <i class="fa-solid fa-circle-check"></i> <%= _flash.success[0] %>
      </div>
    <% } %>
    <% if (_flash.error && _flash.error.length > 0) { %>
      <div class="alert alert-error">
        <i class="fa-solid fa-circle-exclamation"></i> <%= _flash.error[0] %>
      </div>
    <% } %>
    <% if (_flash.info && _flash.info.length > 0) { %>
      <div class="alert alert-info">
        <i class="fa-solid fa-circle-info"></i> <%= _flash.info[0] %>
      </div>
    <% } %>
  </div>
