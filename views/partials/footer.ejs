<%
  const settings = (typeof siteSettings !== 'undefined' && siteSettings) ? siteSettings : {};
%>

  <!-- Footer -->
  <footer class="site-footer">
    <div class="container">
      <div class="footer-grid">
        <!-- Col 1: Brand Info -->
        <div class="footer-col">
          <div class="brand-logo" style="margin-bottom: 1.2rem;">
            <% if (settings.logo_url) { %>
              <img src="<%= settings.logo_url %>" alt="Aruvi Embroidery Logo" style="max-height: 52px; width: auto; object-fit: contain;">
            <% } else { %>
              <img src="/public/images/logo.jpg" alt="Aruvi Embroidery Logo" style="max-height: 52px; width: auto; object-fit: contain;">
            <% } %>
          </div>
          <p>
            Aruvi Embroidery is your ultimate destination for high-precision digital embroidery design machine files. 
            We specialize in bridal blouse necklines, saree borders, temple gods, peacock motifs, and contemporary floral art.
          </p>
          <div class="social-icons">
            <% if (settings.facebook_url) { %>
              <a href="<%= settings.facebook_url %>" class="social-icon" target="_blank" rel="noopener noreferrer" title="Facebook"><i class="fa-brands fa-facebook-f"></i></a>
            <% } %>
            <% if (settings.instagram_url) { %>
              <a href="<%= settings.instagram_url %>" class="social-icon" target="_blank" rel="noopener noreferrer" title="Instagram"><i class="fa-brands fa-instagram"></i></a>
            <% } %>
            <% if (settings.pinterest_url) { %>
              <a href="<%= settings.pinterest_url %>" class="social-icon" target="_blank" rel="noopener noreferrer" title="Pinterest"><i class="fa-brands fa-pinterest-p"></i></a>
            <% } %>
            <% if (settings.youtube_url) { %>
              <a href="<%= settings.youtube_url %>" class="social-icon" target="_blank" rel="noopener noreferrer" title="YouTube"><i class="fa-brands fa-youtube"></i></a>
            <% } %>
            <% if (settings.linkedin_url) { %>
              <a href="<%= settings.linkedin_url %>" class="social-icon" target="_blank" rel="noopener noreferrer" title="LinkedIn"><i class="fa-brands fa-linkedin-in"></i></a>
            <% } %>
            <% if (settings.twitter_url) { %>
              <a href="<%= settings.twitter_url %>" class="social-icon" target="_blank" rel="noopener noreferrer" title="Twitter"><i class="fa-brands fa-x-twitter"></i></a>
            <% } %>
          </div>
        </div>

        <!-- Col 2: Quick Links -->
        <div class="footer-col">
          <h4>Explore</h4>
          <ul class="footer-links">
            <li><a href="/">Home</a></li>
            <li><a href="/shop">Shop All Designs</a></li>
            <li><a href="/shop?category=bridal-blouse-motifs">Bridal Blouse Motifs</a></li>
            <li><a href="/shop?category=god-spiritual">God & Spiritual Art</a></li>
            <li><a href="/shop?category=peacock-floral">Peacock & Floral</a></li>
          </ul>
        </div>

        <!-- Col 3: Customer Care -->
        <div class="footer-col">
          <h4>Customer Care</h4>
          <ul class="footer-links">
            <li><a href="/about">About Our Studio</a></li>
            <li><a href="/contact">Contact Support</a></li>
            <li><a href="/faq">Frequently Asked Questions</a></li>
            <li><a href="/privacy">Privacy Policy</a></li>
            <li><a href="/terms">Terms of Service</a></li>
            <li><a href="/refund">Digital Refund Policy</a></li>
          </ul>
        </div>

        <!-- Col 4: Contact & Machine Formats -->
        <div class="footer-col">
          <h4>Contact & Formats</h4>
          <p style="margin-bottom: 0.8rem;"><i class="fa-solid fa-location-dot" style="color: var(--primary);"></i> <%= settings.address || 'Chennai, Tamil Nadu, India' %></p>
          <p style="margin-bottom: 0.8rem;"><i class="fa-solid fa-envelope" style="color: var(--primary);"></i> <%= settings.contact_email || 'contact@aruviembroidery.com' %></p>
          <p style="margin-bottom: 1.2rem;"><i class="fa-solid fa-phone" style="color: var(--primary);"></i> <%= settings.contact_phone || '+91 98765 43210' %></p>
          
          <h5 style="color: white; font-size: 0.85rem; margin-bottom: 0.5rem;">Supported Machine Formats:</h5>
          <p style="font-size: 0.8rem; color: #D3B9C0;">
            DST &bull; PES &bull; JEF &bull; EXP &bull; HUS &bull; VIP &bull; VP3 &bull; XXX
          </p>
        </div>
      </div>

      <!-- Stitch Divider -->
      <div class="stitch-divider" style="margin: 1.5rem 0;"></div>

      <div class="footer-bottom">
        <p>&copy; <%= new Date().getFullYear() %> <%= settings.shop_name || 'Aruvi Embroidery' %>. All Rights Reserved. Tagline: <em>"<%= settings.tagline || 'Where Threads Tell Stories' %>"</em>.</p>
      </div>
    </div>
  </footer>

  <!-- Scripts -->
  <script src="/public/js/main.js"></script>
</body>
</html>
