<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Banners Management - ARUVI Admin</title>
  <link rel="icon" type="image/jpeg" href="/public/images/logo.jpg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;1,400&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="/public/css/main.css">
  <link rel="stylesheet" href="/public/css/admin.css">
  <style>
    .action-icon-btn {
      width: 32px; height: 32px; border-radius: 8px; border: 1px solid var(--admin-border); background: #FFFFFF; color: var(--admin-text-dark); display: inline-flex; align-items: center; justify-content: center; font-size: 0.82rem; text-decoration: none; transition: var(--transition);
    }
    .action-icon-btn:hover { border-color: var(--admin-primary); color: var(--admin-primary); background: #FAF6F0; }
  </style>
</head>
<body class="admin-body">

<div class="admin-wrapper">
  <!-- Top Header matching Master Manage Designs UI -->
  <header class="admin-top-header">
    <a href="/admin" class="admin-header-brand">
      <% const currentLogo = (typeof siteSettings !== 'undefined' && siteSettings.logo_url) ? siteSettings.logo_url : '/public/images/logo.jpg'; %>
      <img src="<%= currentLogo %>" alt="ARUVI Admin Logo" style="max-height: 42px; width: auto; object-fit: contain;">
    </a>

    <!-- Global Search -->
    <div class="admin-search-bar">
      <i class="fa-solid fa-magnifying-glass"></i>
      <input type="text" placeholder="Search designs, orders, customers...">
    </div>

    <!-- Right User Header Icons -->
    <div class="admin-header-right">
      <a href="#" class="admin-icon-btn" title="Notifications">
        <i class="fa-regular fa-bell"></i>
        <span class="badge-count">3</span>
      </a>

      <div class="admin-user-menu">
        <div class="admin-user-avatar">A</div>
        <div class="admin-user-info">
          <strong>Admin</strong>
          <span>Administrator</span>
        </div>
        <i class="fa-solid fa-chevron-down" style="font-size: 0.75rem; color: var(--admin-text-muted); margin-left: 4px;"></i>
      </div>
    </div>
  </header>

  <!-- Admin Main Layout with Sidebar -->
  <div class="admin-main-container">
    <!-- Left Sidebar matching Master Manage Designs UI -->
    <aside class="admin-sidebar">
      <ul class="sidebar-nav-list" style="margin-bottom: 1.2rem;">
        <li class="sidebar-nav-item">
          <a href="/admin">
            <span><i class="fa-solid fa-house"></i> Dashboard</span>
          </a>
        </li>
      </ul>

      <!-- DESIGNS Section -->
      <div class="admin-sidebar-section">
        <div class="sidebar-heading">DESIGNS</div>
        <ul class="sidebar-nav-list">
          <li class="sidebar-nav-item"><a href="/admin/designs"><span><i class="fa-solid fa-box-archive"></i> Manage Designs</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/designs/create"><span><i class="fa-solid fa-circle-plus"></i> Add New Design</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/categories"><span><i class="fa-solid fa-border-all"></i> Categories</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/custom-orders"><span><i class="fa-solid fa-wand-magic-sparkles"></i> Custom Orders</span></a></li>
        </ul>
      </div>

      <!-- ORDERS Section -->
      <div class="admin-sidebar-section">
        <div class="sidebar-heading">ORDERS</div>
        <ul class="sidebar-nav-list">
          <li class="sidebar-nav-item"><a href="/admin/orders"><span><i class="fa-regular fa-newspaper"></i> All Orders</span></a></li>
          <li class="sidebar-nav-item">
            <a href="/admin/orders?status=pending">
              <span><i class="fa-regular fa-clock"></i> Pending Orders</span>
              <span class="sidebar-badge">5</span>
            </a>
          </li>
          <li class="sidebar-nav-item"><a href="/admin/orders?status=completed"><span><i class="fa-regular fa-circle-check"></i> Completed Orders</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/orders?status=cancelled"><span><i class="fa-regular fa-circle-xmark"></i> Cancelled Orders</span></a></li>
        </ul>
      </div>

      <!-- CUSTOMERS Section -->
      <div class="admin-sidebar-section">
        <div class="sidebar-heading">CUSTOMERS</div>
        <ul class="sidebar-nav-list">
          <li class="sidebar-nav-item"><a href="/admin/customers"><span><i class="fa-solid fa-users"></i> All Customers</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/messages"><span><i class="fa-regular fa-comment-dots"></i> Enquiries</span></a></li>
        </ul>
      </div>

      <!-- CONTENT Section -->
      <div class="admin-sidebar-section">
        <div class="sidebar-heading">CONTENT</div>
        <ul class="sidebar-nav-list">
          <li class="sidebar-nav-item"><a href="/admin/homepage"><span><i class="fa-solid fa-house-chimney"></i> Homepage</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/banners" class="active"><span><i class="fa-regular fa-image"></i> Banners</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/homepage#about"><span><i class="fa-regular fa-circle-info"></i> About Page</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/settings#contact"><span><i class="fa-solid fa-location-dot"></i> Contact Info</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/settings"><span><i class="fa-solid fa-gear"></i> Website Settings</span></a></li>
        </ul>
      </div>

      <div style="margin-top: auto; padding-top: 1rem; border-top: 1px solid var(--admin-border);">
        <a href="/admin/logout" style="display: flex; align-items: center; gap: 8px; color: var(--admin-primary); font-size: 0.85rem; font-weight: 600; text-decoration: none; padding: 0.5rem 0.8rem;">
          <i class="fa-solid fa-arrow-right-from-bracket"></i> Logout Admin
        </a>
      </div>
    </aside>

    <!-- Main Content Body -->
    <main class="admin-content-body">

      <!-- Breadcrumbs & Header -->
      <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1.8rem;">
        <div>
          <div style="font-size: 0.8rem; color: var(--admin-text-muted); margin-bottom: 0.4rem;">
            <a href="/admin" style="color: var(--admin-text-muted); text-decoration: none;">Dashboard</a> &nbsp;>&nbsp; <span style="color: var(--admin-primary); font-weight: 600;">Banners</span>
          </div>
          <h1 style="font-family: var(--font-heading); font-size: 2.2rem; font-weight: 700; color: var(--admin-text-dark); margin: 0 0 0.3rem;">Promotional Banners</h1>
          <p style="font-size: 0.88rem; color: var(--admin-text-muted); margin: 0;">Manage homepage promotional slider banners and sales campaign graphics.</p>
        </div>

        <button type="button" onclick="openAddBannerModal()" class="btn btn-primary" style="height: 44px; padding: 0 1.4rem; border-radius: 10px; font-size: 0.9rem; font-weight: 600; display: inline-flex; align-items: center; gap: 8px;">
          <i class="fa-solid fa-plus"></i> Add Banner
        </button>
      </div>

      <% if (flash && flash.success && flash.success.length > 0) { %>
        <div id="adminToastPopup" style="position: fixed; top: 25px; right: 25px; background: #1B5E20; color: white; padding: 1.1rem 1.8rem; border-radius: 14px; box-shadow: 0 12px 30px rgba(0,0,0,0.25); z-index: 999999; display: flex; align-items: center; gap: 12px; font-weight: 600; font-size: 1rem; border: 2px solid #81C784;">
          <i class="fa-solid fa-circle-check" style="font-size: 1.5rem; color: #66BB6A;"></i>
          <span><%= flash.success[0] %></span>
          <button type="button" onclick="this.parentElement.remove()" style="background: none; border: none; color: white; margin-left: 15px; cursor: pointer; font-size: 1.3rem;">&times;</button>
        </div>
        <script>
          setTimeout(() => {
            const popup = document.getElementById('adminToastPopup');
            if (popup) popup.style.display = 'none';
          }, 4500);
        </script>
        <div class="alert alert-success" style="margin-bottom: 1.5rem; border-radius: 10px;">
          <i class="fa-solid fa-circle-check"></i> <%= flash.success[0] %>
        </div>
      <% } %>

      <!-- 4 Stat Summary Cards Row matching Master Manage Designs UI -->
      <div class="admin-stats-row" style="margin-bottom: 1.8rem;">
        <div class="admin-summary-card">
          <div class="card-icon-badge"><i class="fa-regular fa-image"></i></div>
          <div class="card-info-content">
            <div class="stat-title">Total Banners</div>
            <div style="display: flex; align-items: baseline;">
              <span class="stat-num"><%= banners ? banners.length : 6 %></span>
              <span class="stat-trend"><i class="fa-solid fa-arrow-up"></i> 2 new</span>
            </div>
            <span style="font-size: 0.72rem; color: var(--admin-text-muted);">from last month</span>
          </div>
        </div>

        <div class="admin-summary-card">
          <div class="card-icon-badge"><i class="fa-regular fa-eye"></i></div>
          <div class="card-info-content">
            <div class="stat-title">Active Banners</div>
            <div style="display: flex; align-items: baseline;">
              <span class="stat-num">5</span>
              <span class="stat-trend"><i class="fa-solid fa-arrow-up"></i> 83%</span>
            </div>
            <span style="font-size: 0.72rem; color: var(--admin-text-muted);">currently displayed</span>
          </div>
        </div>

        <div class="admin-summary-card">
          <div class="card-icon-badge"><i class="fa-regular fa-calendar"></i></div>
          <div class="card-info-content">
            <div class="stat-title">Scheduled</div>
            <div style="display: flex; align-items: baseline;">
              <span class="stat-num">1</span>
              <span class="stat-trend" style="color: var(--admin-primary);"><i class="fa-solid fa-arrow-up"></i> upcoming</span>
            </div>
            <span style="font-size: 0.72rem; color: var(--admin-text-muted);">festive offer</span>
          </div>
        </div>

        <div class="admin-summary-card">
          <div class="card-icon-badge"><i class="fa-solid fa-pause"></i></div>
          <div class="card-info-content">
            <div class="stat-title">Inactive</div>
            <div style="display: flex; align-items: baseline;">
              <span class="stat-num">0</span>
              <span class="stat-trend" style="color: var(--admin-text-muted);">0%</span>
            </div>
            <span style="font-size: 0.72rem; color: var(--admin-text-muted);">expired banners</span>
          </div>
        </div>
      </div>

      <!-- Filter Controls Bar Card -->
      <div class="admin-card-box" style="padding: 1rem 1.4rem; margin-bottom: 1.5rem;">
        <form action="/admin/banners" method="GET" style="display: flex; gap: 1rem; align-items: center; flex-wrap: wrap;">
          <div style="flex: 1; min-width: 280px; position: relative;">
            <i class="fa-solid fa-magnifying-glass" style="position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: var(--admin-text-muted); font-size: 0.88rem;"></i>
            <input type="text" name="search" placeholder="Search banners by title or link..." style="width: 100%; height: 40px; border-radius: 8px; border: 1px solid var(--admin-border); padding-left: 2.5rem; font-size: 0.85rem;">
          </div>

          <select name="status" style="height: 40px; border-radius: 8px; border: 1px solid var(--admin-border); padding: 0 1rem; font-size: 0.85rem; background: #FFFFFF; color: var(--admin-text-dark);">
            <option value="">All Positions</option>
            <option value="hero">Homepage Main Hero</option>
            <option value="middle">Middle Promo Banner</option>
          </select>

          <a href="/admin/banners" class="btn btn-outline" style="height: 40px; border-radius: 8px; font-size: 0.85rem; padding: 0 1rem; display: inline-flex; align-items: center; gap: 6px; background: #FFF;">
            <i class="fa-solid fa-rotate-left"></i> Reset
          </a>
        </form>
      </div>

      <!-- Main Banners Table Card matching Master Manage Designs UI -->
      <div class="admin-card-box" style="padding: 0; overflow: hidden; margin-bottom: 1.5rem;">
        <table class="admin-table-styled">
          <thead>
            <tr>
              <th style="width: 38px; text-align: center;"><input type="checkbox"></th>
              <th>Banner Image</th>
              <th>Banner Name</th>
              <th>Position</th>
              <th>Target Link</th>
              <th>Status</th>
              <th>Date Added</th>
              <th style="text-align: right;">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (banners && banners.length > 0) { %>
              <% banners.forEach((b, idx) => { %>
                <tr>
                  <td style="text-align: center;"><input type="checkbox"></td>
                  <td>
                    <img src="<%= b.image_url || '/public/images/hero_embroidery.jpg' %>" alt="<%= b.title %>" style="height: 44px; width: 90px; object-fit: cover; border-radius: 8px; border: 1px solid var(--admin-border);">
                  </td>
                  <td>
                    <strong style="display: block; font-size: 0.9rem; color: var(--admin-text-dark);"><%= b.title %></strong>
                    <span style="font-size: 0.72rem; color: var(--admin-text-muted);">#BNR-<%= b.id %></span>
                  </td>
                  <td><span style="font-size: 0.82rem; color: var(--admin-text-dark); font-weight: 500;">Homepage Hero Slider</span></td>
                  <td>
                    <code style="font-size: 0.78rem; background: #FAF6F0; padding: 2px 8px; border-radius: 4px; border: 1px solid var(--admin-border);"><%= b.link_url || '/designs' %></code>
                  </td>
                  <td>
                    <span style="background: #E8F5E9; color: #2E7D32; padding: 3px 10px; border-radius: 12px; font-size: 0.74rem; font-weight: 600;">Active</span>
                  </td>
                  <td style="color: var(--admin-text-muted); font-size: 0.78rem;">
                    01 Oct 2026
                  </td>
                  <td style="text-align: right;">
                    <div style="display: inline-flex; gap: 6px;">
                      <a href="<%= b.link_url || '#' %>" target="_blank" class="action-icon-btn" title="View Target Link"><i class="fa-regular fa-eye"></i></a>
                      <form action="/admin/banners/delete/<%= b.id %>" method="POST" style="display: inline;">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button type="submit" class="action-icon-btn" style="color: #C62828;" title="Delete Banner"><i class="fa-regular fa-trash-can"></i></button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="8" style="text-align: center; padding: 2rem; color: var(--admin-text-muted);">
                  No promotional banners found.
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>

        <!-- Pagination Bar matching Master Manage Designs UI -->
        <div style="padding: 1rem 1.4rem; background: #FAF6F0; border-top: 1px solid var(--admin-border); display: flex; align-items: center; justify-content: space-between;">
          <div style="font-size: 0.82rem; color: var(--admin-text-muted);">
            Showing 1 to <%= banners ? banners.length : 3 %> of <strong><%= banners ? banners.length : 6 %></strong> banners
          </div>

          <div style="display: flex; gap: 6px;">
            <a href="#" class="action-icon-btn" style="width: 32px; height: 32px;"><i class="fa-solid fa-chevron-left" style="font-size: 0.7rem;"></i></a>
            <a href="#" class="action-icon-btn" style="width: 32px; height: 32px; background: var(--admin-primary); color: #FFFFFF; border-color: var(--admin-primary); font-weight: 700;">1</a>
            <a href="#" class="action-icon-btn" style="width: 32px; height: 32px;"><i class="fa-solid fa-chevron-right" style="font-size: 0.7rem;"></i></a>
          </div>
        </div>
      </div>

    </main>
  </div>
</div>

<!-- Add Banner Modal matching Master Manage Designs UI -->
<div id="bannerModal" style="position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 9999; display: none; align-items: center; justify-content: center; backdrop-filter: blur(3px);">
  <div style="background: #FFFFFF; border-radius: 18px; max-width: 500px; width: 90%; padding: 2.2rem; box-shadow: 0 20px 40px rgba(0,0,0,0.15); border: 1px solid var(--admin-border);">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.4rem; padding-bottom: 0.8rem; border-bottom: 1px solid var(--admin-border);">
      <h3 style="font-family: var(--font-heading); font-size: 1.4rem; font-weight: 700; color: var(--admin-text-dark); margin: 0;">Add New Banner</h3>
      <i class="fa-solid fa-xmark" onclick="closeAddBannerModal()" style="cursor: pointer; font-size: 1.1rem; color: var(--admin-text-muted);"></i>
    </div>

    <form action="/admin/banners/create?_csrf=<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" method="POST" enctype="multipart/form-data">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div style="margin-bottom: 1.1rem;">
        <label style="display: block; font-size: 0.82rem; font-weight: 600; color: var(--admin-text-dark); margin-bottom: 6px;">Banner Title <span style="color: var(--admin-primary);">*</span></label>
        <input type="text" name="title" class="form-control" placeholder="e.g. Festive Discount Offer" required style="height: 42px; border-radius: 8px;">
      </div>

      <div style="margin-bottom: 1.1rem;">
        <label style="display: block; font-size: 0.82rem; font-weight: 600; color: var(--admin-text-dark); margin-bottom: 6px;">Target Link URL</label>
        <input type="text" name="link_url" class="form-control" placeholder="/designs?category=bridal" style="height: 42px; border-radius: 8px;">
      </div>

      <div style="margin-bottom: 1.5rem;">
        <label style="display: block; font-size: 0.82rem; font-weight: 600; color: var(--admin-text-dark); margin-bottom: 6px;">Banner Image File <span style="color: var(--admin-primary);">*</span></label>
        <input type="file" name="image" class="form-control" accept="image/*" required style="height: 42px; border-radius: 8px;">
      </div>

      <div style="display: flex; gap: 1rem; justify-content: flex-end;">
        <button type="button" onclick="closeAddBannerModal()" class="btn btn-outline" style="height: 44px; border-radius: 10px; font-weight: 600; background: #FFF; padding: 0 1.2rem;">Cancel</button>
        <button type="submit" class="btn btn-primary" style="height: 44px; border-radius: 10px; font-weight: 600; padding: 0 1.5rem;">Upload Banner</button>
      </div>
    </form>
  </div>
</div>

<script>
  function openAddBannerModal() {
    document.getElementById('bannerModal').style.display = 'flex';
  }
  function closeAddBannerModal() {
    document.getElementById('bannerModal').style.display = 'none';
  }
</script>

</body>
</html>
