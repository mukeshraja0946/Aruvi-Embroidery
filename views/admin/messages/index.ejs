<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Enquiries & Messages - ARUVI Admin</title>
  <link rel="icon" type="image/jpeg" href="/public/images/logo.jpg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;1,400&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="/public/css/main.css">
  <link rel="stylesheet" href="/public/css/admin.css">
  <style>
    .action-icon-btn {
      width: 32px; height: 32px; border-radius: 8px; border: 1px solid var(--admin-border); background: #FFFFFF; color: var(--admin-text-dark); display: inline-flex; align-items: center; justify-content: center; font-size: 0.82rem; text-decoration: none; transition: var(--transition);
    }
    .action-icon-btn:hover { border-color: var(--admin-primary); color: var(--admin-primary); background: #FAF6F0; }
  </style>
</head>
<body class="admin-body">

<div class="admin-wrapper">
  <!-- Top Header matching Master Manage Designs UI -->
  <header class="admin-top-header">
    <a href="/admin" class="admin-header-brand">
      <% const currentLogo = (typeof siteSettings !== 'undefined' && siteSettings.logo_url) ? siteSettings.logo_url : '/public/images/logo.jpg'; %>
      <img src="<%= currentLogo %>" alt="ARUVI Admin Logo" style="max-height: 42px; width: auto; object-fit: contain;">
    </a>

    <!-- Global Search -->
    <div class="admin-search-bar">
      <i class="fa-solid fa-magnifying-glass"></i>
      <input type="text" placeholder="Search designs, orders, customers...">
    </div>

    <!-- Right User Header Icons -->
    <div class="admin-header-right">
      <a href="#" class="admin-icon-btn" title="Notifications">
        <i class="fa-regular fa-bell"></i>
        <span class="badge-count">3</span>
      </a>

      <div class="admin-user-menu">
        <div class="admin-user-avatar">A</div>
        <div class="admin-user-info">
          <strong>Admin</strong>
          <span>Administrator</span>
        </div>
        <i class="fa-solid fa-chevron-down" style="font-size: 0.75rem; color: var(--admin-text-muted); margin-left: 4px;"></i>
      </div>
    </div>
  </header>

  <!-- Admin Main Layout with Sidebar -->
  <div class="admin-main-container">
    <!-- Left Sidebar matching Master Manage Designs UI -->
    <aside class="admin-sidebar">
      <ul class="sidebar-nav-list" style="margin-bottom: 1.2rem;">
        <li class="sidebar-nav-item">
          <a href="/admin">
            <span><i class="fa-solid fa-house"></i> Dashboard</span>
          </a>
        </li>
      </ul>

      <!-- DESIGNS Section -->
      <div class="admin-sidebar-section">
        <div class="sidebar-heading">DESIGNS</div>
        <ul class="sidebar-nav-list">
          <li class="sidebar-nav-item"><a href="/admin/designs"><span><i class="fa-solid fa-box-archive"></i> Manage Designs</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/designs/create"><span><i class="fa-solid fa-circle-plus"></i> Add New Design</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/categories"><span><i class="fa-solid fa-border-all"></i> Categories</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/custom-orders"><span><i class="fa-solid fa-wand-magic-sparkles"></i> Custom Orders</span></a></li>
        </ul>
      </div>

      <!-- ORDERS Section -->
      <div class="admin-sidebar-section">
        <div class="sidebar-heading">ORDERS</div>
        <ul class="sidebar-nav-list">
          <li class="sidebar-nav-item"><a href="/admin/orders"><span><i class="fa-regular fa-newspaper"></i> All Orders</span></a></li>
          <li class="sidebar-nav-item">
            <a href="/admin/orders?status=pending">
              <span><i class="fa-regular fa-clock"></i> Pending Orders</span>
              <span class="sidebar-badge">5</span>
            </a>
          </li>
          <li class="sidebar-nav-item"><a href="/admin/orders?status=completed"><span><i class="fa-regular fa-circle-check"></i> Completed Orders</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/orders?status=cancelled"><span><i class="fa-regular fa-circle-xmark"></i> Cancelled Orders</span></a></li>
        </ul>
      </div>

      <!-- CUSTOMERS Section -->
      <div class="admin-sidebar-section">
        <div class="sidebar-heading">CUSTOMERS</div>
        <ul class="sidebar-nav-list">
          <li class="sidebar-nav-item"><a href="/admin/customers"><span><i class="fa-solid fa-users"></i> All Customers</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/messages" class="active"><span><i class="fa-regular fa-comment-dots"></i> Enquiries</span></a></li>
        </ul>
      </div>

      <!-- CONTENT Section -->
      <div class="admin-sidebar-section">
        <div class="sidebar-heading">CONTENT</div>
        <ul class="sidebar-nav-list">
          <li class="sidebar-nav-item"><a href="/admin/homepage"><span><i class="fa-solid fa-house-chimney"></i> Homepage</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/banners"><span><i class="fa-regular fa-image"></i> Banners</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/homepage#about"><span><i class="fa-regular fa-circle-info"></i> About Page</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/settings#contact"><span><i class="fa-solid fa-location-dot"></i> Contact Info</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/settings"><span><i class="fa-solid fa-gear"></i> Website Settings</span></a></li>
        </ul>
      </div>

      <div style="margin-top: auto; padding-top: 1rem; border-top: 1px solid var(--admin-border);">
        <a href="/admin/logout" style="display: flex; align-items: center; gap: 8px; color: var(--admin-primary); font-size: 0.85rem; font-weight: 600; text-decoration: none; padding: 0.5rem 0.8rem;">
          <i class="fa-solid fa-arrow-right-from-bracket"></i> Logout Admin
        </a>
      </div>
    </aside>

    <!-- Main Content Body -->
    <main class="admin-content-body">

      <!-- Breadcrumbs & Header -->
      <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1.8rem; flex-wrap: wrap; gap: 1rem;">
        <div>
          <div style="font-size: 0.8rem; color: var(--admin-text-muted); margin-bottom: 0.4rem;">
            <a href="/admin" style="color: var(--admin-text-muted); text-decoration: none;">Dashboard</a> &nbsp;>&nbsp; <span style="color: var(--admin-primary); font-weight: 600;">Enquiries</span>
          </div>
          <h1 style="font-family: var(--font-heading); font-size: 2.2rem; font-weight: 700; color: var(--admin-text-dark); margin: 0 0 0.3rem;">Enquiries</h1>
          <p style="font-size: 0.88rem; color: var(--admin-text-muted); margin: 0;">Inquiries submitted via the Contact Us page.</p>
        </div>

        <div>
          <button type="button" onclick="openCreateModal()" class="btn btn-primary" style="height: 42px; border-radius: 10px; font-size: 0.88rem; font-weight: 600; display: inline-flex; align-items: center; gap: 8px; background: var(--admin-primary); color: #FFF; border: none; padding: 0 1.2rem;">
            <i class="fa-solid fa-plus"></i> Add Manual Enquiry
          </button>
        </div>
      </div>

      <!-- 4 Stat Summary Cards Row matching Master Manage Designs UI -->
      <div class="admin-stats-row" style="margin-bottom: 1.8rem;">
        <div class="admin-summary-card">
          <div class="card-icon-badge"><i class="fa-regular fa-comment-dots"></i></div>
          <div class="card-info-content">
            <div class="stat-title">Total Enquiries</div>
            <div style="display: flex; align-items: baseline;">
              <span class="stat-num"><%= (typeof stats !== 'undefined' && stats.totalMessages !== undefined) ? stats.totalMessages : (messages ? messages.length : 0) %></span>
              <% if (typeof stats !== 'undefined' && stats.messagesTrend) { %>
                <span class="stat-trend">
                  <i class="fa-solid fa-arrow-up"></i> <%= stats.messagesTrend.text %>
                </span>
              <% } %>
            </div>
            <span style="font-size: 0.72rem; color: var(--admin-text-muted);">from last month</span>
          </div>
        </div>

        <div class="admin-summary-card">
          <div class="card-icon-badge"><i class="fa-regular fa-envelope"></i></div>
          <div class="card-info-content">
            <div class="stat-title">New</div>
            <div style="display: flex; align-items: baseline;">
              <span class="stat-num"><%= (typeof stats !== 'undefined' && stats.newMessages !== undefined) ? stats.newMessages : 0 %></span>
              <% if (typeof stats !== 'undefined' && stats.newTrend) { %>
                <span class="stat-trend" style="color: var(--admin-primary);">
                  <i class="fa-solid fa-arrow-up"></i> <%= stats.newTrend.text %>
                </span>
              <% } %>
            </div>
            <span style="font-size: 0.72rem; color: var(--admin-text-muted);">unread messages</span>
          </div>
        </div>

        <div class="admin-summary-card">
          <div class="card-icon-badge"><i class="fa-solid fa-spinner"></i></div>
          <div class="card-info-content">
            <div class="stat-title">In Progress</div>
            <div style="display: flex; align-items: baseline;">
              <span class="stat-num"><%= (typeof stats !== 'undefined' && stats.inProgressMessages !== undefined) ? stats.inProgressMessages : 0 %></span>
              <% if (typeof stats !== 'undefined' && stats.inProgressTrend) { %>
                <span class="stat-trend">
                  <i class="fa-solid fa-arrow-up"></i> <%= stats.inProgressTrend.text %>
                </span>
              <% } %>
            </div>
            <span style="font-size: 0.72rem; color: var(--admin-text-muted);">in review</span>
          </div>
        </div>

        <div class="admin-summary-card">
          <div class="card-icon-badge"><i class="fa-regular fa-circle-check"></i></div>
          <div class="card-info-content">
            <div class="stat-title">Resolved</div>
            <div style="display: flex; align-items: baseline;">
              <span class="stat-num"><%= (typeof stats !== 'undefined' && stats.resolvedMessages !== undefined) ? stats.resolvedMessages : 0 %></span>
              <% if (typeof stats !== 'undefined' && stats.resolvedTrend) { %>
                <span class="stat-trend">
                  <i class="fa-solid fa-arrow-up"></i> <%= stats.resolvedTrend.text %>
                </span>
              <% } %>
            </div>
            <span style="font-size: 0.72rem; color: var(--admin-text-muted);">replied inquiries</span>
          </div>
        </div>
      </div>

      <!-- Filter Controls Bar Card -->
      <div class="admin-card-box" style="padding: 1rem 1.4rem; margin-bottom: 1.5rem;">
        <form action="/admin/messages" method="GET" style="display: flex; gap: 1rem; align-items: center; flex-wrap: wrap;">
          <div style="flex: 1; min-width: 280px; position: relative;">
            <i class="fa-solid fa-magnifying-glass" style="position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: var(--admin-text-muted); font-size: 0.88rem;"></i>
            <input type="text" name="search" placeholder="Search by sender name, email or subject..." style="width: 100%; height: 40px; border-radius: 8px; border: 1px solid var(--admin-border); padding-left: 2.5rem; font-size: 0.85rem;">
          </div>

          <select name="status" style="height: 40px; border-radius: 8px; border: 1px solid var(--admin-border); padding: 0 1rem; font-size: 0.85rem; background: #FFFFFF; color: var(--admin-text-dark);">
            <option value="">All Status</option>
            <option value="new">New / Unread</option>
            <option value="read">Read</option>
            <option value="replied">Replied</option>
          </select>

          <select name="sort" style="height: 40px; border-radius: 8px; border: 1px solid var(--admin-border); padding: 0 1rem; font-size: 0.85rem; background: #FFFFFF; color: var(--admin-text-dark);">
            <option value="newest">Sort by Newest</option>
            <option value="oldest">Sort by Oldest</option>
          </select>

          <a href="/admin/messages" class="btn btn-outline" style="height: 40px; border-radius: 8px; font-size: 0.85rem; padding: 0 1rem; display: inline-flex; align-items: center; gap: 6px; background: #FFF;">
            <i class="fa-solid fa-rotate-left"></i> Reset
          </a>
        </form>
      </div>

      <!-- Main Messages Table Card matching Master Manage Designs UI -->
      <div class="admin-card-box" style="padding: 0; overflow: hidden; margin-bottom: 1.5rem;">
        <table class="admin-table-styled">
          <thead>
            <tr>
              <th style="width: 38px; text-align: center;"><input type="checkbox"></th>
              <th style="width: 90px;">Enquiry ID</th>
              <th>Customer</th>
              <th>Subject</th>
              <th>Message Preview</th>
              <th>Status</th>
              <th>Date Added</th>
              <th style="text-align: right;">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (messages && messages.length > 0) { %>
              <% messages.forEach((m, idx) => { %>
                <% 
                  const isNew = m.status === 'new';
                  const badgeBg = isNew ? '#FFF8E1' : '#E8F5E9';
                  const badgeColor = isNew ? '#F57F17' : '#2E7D32';
                %>
                <tr id="messageRow-<%= m.id %>">
                  <td style="text-align: center;"><input type="checkbox"></td>
                  <td><strong style="color: var(--admin-text-dark); font-size: 0.85rem;">#ENQ-<%= m.id %></strong></td>
                  <td>
                    <strong style="display: block; font-size: 0.88rem; color: var(--admin-text-dark);"><%= m.name %></strong>
                    <span style="font-size: 0.74rem; color: var(--admin-text-muted);"><%= m.email %></span>
                  </td>
                  <td><strong style="font-size: 0.85rem; color: var(--admin-text-dark);"><%= m.subject %></strong></td>
                  <td style="max-width: 280px;">
                    <span style="font-size: 0.82rem; color: var(--admin-text-muted); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;"><%= m.message %></span>
                  </td>
                  <td>
                    <span style="background: <%= badgeBg %>; color: <%= badgeColor %>; padding: 3px 10px; border-radius: 12px; font-size: 0.74rem; font-weight: 600; text-transform: capitalize;">
                      <%= m.status %>
                    </span>
                  </td>
                  <td style="color: var(--admin-text-muted); font-size: 0.78rem;">
                    <%= m.created_at ? new Date(m.created_at).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) : '01 Oct 2026' %>
                  </td>
                  <td style="text-align: right;">
                    <div style="display: inline-flex; gap: 6px;">
                      <button type="button" onclick="openEnquiryModal(<%= JSON.stringify(m) %>)" class="action-icon-btn" title="View Detail"><i class="fa-regular fa-eye"></i></button>
                      <a href="mailto:<%= m.email %>" class="action-icon-btn" title="Reply via Email"><i class="fa-regular fa-paper-plane"></i></a>
                      <button type="button" onclick="confirmDeleteEnquiry('<%= m.id %>')" class="action-icon-btn" style="color: #C62828; border: none; background: transparent; cursor: pointer;" title="Delete Enquiry"><i class="fa-regular fa-trash-can"></i></button>
                    </div>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="8" style="text-align: center; padding: 3.5rem 1.5rem;">
                  <div style="width: 56px; height: 56px; border-radius: 50%; background: #FAF6F0; color: var(--admin-text-muted); display: inline-flex; align-items: center; justify-content: center; font-size: 1.6rem; margin-bottom: 0.8rem; border: 1px solid var(--admin-border); margin: 0 auto 0.8rem;">
                    <i class="fa-regular fa-envelope-open"></i>
                  </div>
                  <h3 style="font-family: var(--font-heading); font-size: 1.25rem; font-weight: 700; color: var(--admin-text-dark); margin: 0 0 0.3rem;">No enquiries yet</h3>
                  <p style="font-size: 0.85rem; color: var(--admin-text-muted); margin: 0;">Customer enquiries submitted through your website will appear here.</p>
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>

        <!-- Pagination Bar matching Master Manage Designs UI -->
        <div style="padding: 1rem 1.4rem; background: #FAF6F0; border-top: 1px solid var(--admin-border); display: flex; align-items: center; justify-content: space-between;">
          <div style="font-size: 0.82rem; color: var(--admin-text-muted);">
            Showing 1 to <%= messages ? messages.length : 5 %> of <strong><%= messages ? messages.length : 42 %></strong> enquiries
          </div>

          <div style="display: flex; gap: 6px;">
            <a href="#" class="action-icon-btn" style="width: 32px; height: 32px;"><i class="fa-solid fa-chevron-left" style="font-size: 0.7rem;"></i></a>
            <a href="#" class="action-icon-btn" style="width: 32px; height: 32px; background: var(--admin-primary); color: #FFFFFF; border-color: var(--admin-primary); font-weight: 700;">1</a>
            <a href="#" class="action-icon-btn" style="width: 32px; height: 32px;"><i class="fa-solid fa-chevron-right" style="font-size: 0.7rem;"></i></a>
          </div>
        </div>
      </div>

    </main>
  </div>
</div>

<!-- Enquiry Detail Modal -->
<div id="enquiryModal" style="position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 9999; display: none; align-items: center; justify-content: center; backdrop-filter: blur(3px);">
  <div style="background: #FFFFFF; border-radius: 18px; max-width: 540px; width: 90%; padding: 2.2rem; box-shadow: 0 20px 40px rgba(0,0,0,0.15); border: 1px solid var(--admin-border);">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.2rem; padding-bottom: 0.8rem; border-bottom: 1px solid var(--admin-border);">
      <h3 style="font-family: var(--font-heading); font-size: 1.4rem; font-weight: 700; color: var(--admin-text-dark); margin: 0;">Enquiry Details</h3>
      <i class="fa-solid fa-xmark" onclick="closeEnquiryModal()" style="cursor: pointer; font-size: 1.1rem; color: var(--admin-text-muted);"></i>
    </div>

    <div style="margin-bottom: 1rem;">
      <strong style="display: block; font-size: 0.85rem; color: var(--admin-text-muted);">From:</strong>
      <span id="enqName" style="font-size: 1rem; font-weight: 700; color: var(--admin-text-dark);"></span> (<span id="enqEmail" style="color: var(--admin-primary);"></span>)
    </div>

    <div style="margin-bottom: 1rem;">
      <strong style="display: block; font-size: 0.85rem; color: var(--admin-text-muted);">Subject:</strong>
      <span id="enqSubject" style="font-size: 0.95rem; font-weight: 600; color: var(--admin-text-dark);"></span>
    </div>

    <div style="margin-bottom: 1.5rem; background: #FAF6F0; padding: 1rem; border-radius: 10px; border: 1px solid var(--admin-border);">
      <strong style="display: block; font-size: 0.85rem; color: var(--admin-text-muted); margin-bottom: 4px;">Message:</strong>
      <p id="enqMessage" style="font-size: 0.9rem; color: var(--admin-text-dark); margin: 0; line-height: 1.5;"></p>
    </div>

    <div style="display: flex; gap: 1rem; justify-content: flex-end;">
      <button type="button" onclick="closeEnquiryModal()" class="btn btn-outline" style="height: 44px; border-radius: 10px; font-weight: 600; background: #FFF;">Close</button>
      <a id="replyMailLink" href="#" class="btn btn-primary" style="height: 44px; border-radius: 10px; font-weight: 600; display: inline-flex; align-items: center; justify-content: center; gap: 8px; text-decoration: none; padding: 0 1.4rem;">
        <i class="fa-regular fa-paper-plane"></i> Reply via Email
      </a>
    </div>
  </div>
</div>

<!-- Modal Confirmation Dialog for Deleting Enquiry -->
<div id="deleteEnquiryModal" class="modal-overlay" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 9999; align-items: center; justify-content: center;">
  <div class="modal-box" style="background: white; padding: 2rem; border-radius: 12px; max-width: 440px; width: 90%; text-align: center;">
    <div style="width: 56px; height: 56px; border-radius: 50%; background: #FFEBEE; color: #C62828; display: flex; align-items: center; justify-content: center; font-size: 1.6rem; margin: 0 auto 1.2rem;">
      <i class="fa-regular fa-trash-can"></i>
    </div>
    <h3 style="font-size: 1.3rem; color: var(--admin-text-dark); margin-bottom: 0.6rem;">Delete Enquiry?</h3>
    <p style="font-size: 0.9rem; color: var(--admin-text-muted); margin-bottom: 1.8rem; line-height: 1.5;">Are you sure you want to delete this enquiry?</p>
    <div style="display: flex; gap: 12px; justify-content: center;">
      <button type="button" onclick="closeDeleteEnquiryModal()" class="btn btn-outline" style="min-width: 110px; height: 40px; border-radius: 8px;">Cancel</button>
      <button type="button" id="confirmDeleteEnquiryBtn" onclick="executeDeleteEnquiry()" class="btn btn-danger" style="min-width: 110px; height: 40px; border-radius: 8px; background: #C62828; color: white; border: none;">Delete</button>
    </div>
  </div>
</div>

<!-- Modal 3: Manual Enquiry Creation by Admin -->
<div id="createEnquiryModal" style="position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 9999; display: none; align-items: center; justify-content: center; backdrop-filter: blur(3px);">
  <div style="background: #FFFFFF; border-radius: 18px; max-width: 520px; width: 90%; padding: 2rem; box-shadow: 0 20px 40px rgba(0,0,0,0.15); border: 1px solid var(--admin-border);">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.2rem; padding-bottom: 0.8rem; border-bottom: 1px solid var(--admin-border);">
      <h3 style="font-family: var(--font-heading); font-size: 1.35rem; font-weight: 700; color: var(--admin-text-dark); margin: 0;">
        <i class="fa-solid fa-plus" style="color: var(--admin-primary);"></i> Add Manual Enquiry Record
      </h3>
      <i class="fa-solid fa-xmark" onclick="closeCreateModal()" style="cursor: pointer; font-size: 1.1rem; color: var(--admin-text-muted);"></i>
    </div>

    <form id="createEnquiryForm" onsubmit="executeCreateEnquiry(event)">
      <div style="margin-bottom: 1rem;">
        <label style="display: block; font-size: 0.82rem; font-weight: 600; color: var(--admin-text-dark); margin-bottom: 4px;">Customer Name <span style="color:#C62828;">*</span></label>
        <input type="text" id="createName" required placeholder="e.g. Priya Lakshmi" style="width: 100%; height: 40px; border-radius: 8px; border: 1px solid var(--admin-border); padding: 0 0.8rem; font-size: 0.88rem;">
      </div>

      <div style="margin-bottom: 1rem;">
        <label style="display: block; font-size: 0.82rem; font-weight: 600; color: var(--admin-text-dark); margin-bottom: 4px;">Customer Email <span style="color:#C62828;">*</span></label>
        <input type="email" id="createEmail" required placeholder="customer@example.com" style="width: 100%; height: 40px; border-radius: 8px; border: 1px solid var(--admin-border); padding: 0 0.8rem; font-size: 0.88rem;">
      </div>

      <div style="margin-bottom: 1rem;">
        <label style="display: block; font-size: 0.82rem; font-weight: 600; color: var(--admin-text-dark); margin-bottom: 4px;">Subject <span style="color:#C62828;">*</span></label>
        <input type="text" id="createSubject" required value="General Inquiry" style="width: 100%; height: 40px; border-radius: 8px; border: 1px solid var(--admin-border); padding: 0 0.8rem; font-size: 0.88rem;">
      </div>

      <div style="margin-bottom: 1.2rem;">
        <label style="display: block; font-size: 0.82rem; font-weight: 600; color: var(--admin-text-dark); margin-bottom: 4px;">Message Content <span style="color:#C62828;">*</span></label>
        <textarea id="createMessage" rows="4" required placeholder="Enter enquiry message details..." style="width: 100%; border-radius: 8px; border: 1px solid var(--admin-border); padding: 0.8rem; font-size: 0.88rem; font-family: inherit;"></textarea>
      </div>

      <div style="display: flex; gap: 1rem; justify-content: flex-end;">
        <button type="button" onclick="closeCreateModal()" class="btn btn-outline" style="height: 40px; border-radius: 8px; font-weight: 600; background: #FFF;">Cancel</button>
        <button type="submit" id="createSubmitBtn" class="btn btn-primary" style="height: 40px; border-radius: 8px; font-weight: 600; padding: 0 1.4rem; background: var(--admin-primary); color: #FFF; border: none;">
          Save Enquiry
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  let pendingDeleteEnquiryId = null;

  function openCreateModal() {
    document.getElementById('createEnquiryModal').style.display = 'flex';
  }

  function closeCreateModal() {
    document.getElementById('createEnquiryModal').style.display = 'none';
  }

  async function executeCreateEnquiry(e) {
    if (e) e.preventDefault();
    const btn = document.getElementById('createSubmitBtn');
    const name = document.getElementById('createName').value.trim();
    const email = document.getElementById('createEmail').value.trim();
    const subject = document.getElementById('createSubject').value.trim();
    const message = document.getElementById('createMessage').value.trim();

    if (!name || !email || !message) {
      alert('Please fill in Name, Email, and Message.');
      return;
    }

    if (btn) { btn.disabled = true; btn.textContent = 'Saving...'; }

    const csrfToken = '<%= typeof csrfToken !== "undefined" ? csrfToken : "" %>';

    try {
      const res = await fetch('/admin/messages/create', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json',
          'X-Requested-With': 'XMLHttpRequest',
          'X-CSRF-Token': csrfToken
        },
        body: JSON.stringify({ name, email, subject, message, _csrf: csrfToken })
      });

      const data = await res.json();
      if (data.success) {
        closeCreateModal();
        showAdminToast(data.message || 'Manual Enquiry created successfully.');
        setTimeout(() => window.location.reload(), 1000);
      } else {
        alert(data.message || 'Failed to save enquiry.');
      }
    } catch (err) {
      alert('Error creating enquiry: ' + err.message);
    } finally {
      if (btn) { btn.disabled = false; btn.textContent = 'Save Enquiry'; }
    }
  }

  function openEnquiryModal(m) {
    document.getElementById('enqName').innerText = m.name || '';
    document.getElementById('enqEmail').innerText = m.email || '';
    document.getElementById('enqSubject').innerText = m.subject || '';
    document.getElementById('enqMessage').innerText = m.message || '';
    document.getElementById('replyMailLink').href = 'mailto:' + (m.email || '');
    document.getElementById('enquiryModal').style.display = 'flex';
  }

  function closeEnquiryModal() {
    document.getElementById('enquiryModal').style.display = 'none';
  }

  function confirmDeleteEnquiry(id) {
    pendingDeleteEnquiryId = id;
    const modal = document.getElementById('deleteEnquiryModal');
    if (modal) modal.style.display = 'flex';
  }

  function closeDeleteEnquiryModal() {
    pendingDeleteEnquiryId = null;
    const modal = document.getElementById('deleteEnquiryModal');
    if (modal) modal.style.display = 'none';
  }

  function executeDeleteEnquiry() {
    if (!pendingDeleteEnquiryId) return;
    const id = pendingDeleteEnquiryId;
    const btn = document.getElementById('confirmDeleteEnquiryBtn');
    if (btn) { btn.disabled = true; btn.textContent = 'Deleting...'; }

    const csrfToken = '<%= typeof csrfToken !== "undefined" ? csrfToken : "" %>';

    fetch('/admin/messages/delete/' + id + '?format=json', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Accept': 'application/json',
        'X-Requested-With': 'XMLHttpRequest',
        'X-CSRF-Token': csrfToken
      },
      body: JSON.stringify({ _csrf: csrfToken })
    })
    .then(res => res.json())
    .then(data => {
      closeDeleteEnquiryModal();
      if (btn) { btn.disabled = false; btn.textContent = 'Delete'; }
      if (data.success) {
        const row = document.getElementById('messageRow-' + id);
        if (row) {
          row.style.opacity = '0';
          row.style.transition = 'opacity 0.3s ease';
          setTimeout(() => row.remove(), 300);
        }
        showAdminToast(data.message || 'Enquiry deleted successfully.');
      } else {
        alert(data.message || 'Unable to delete enquiry. Please try again.');
      }
    })
    .catch(err => {
      console.error('Enquiry delete error:', err);
      closeDeleteEnquiryModal();
      if (btn) { btn.disabled = false; btn.textContent = 'Delete'; }
      alert('Unable to delete enquiry. Please try again.');
    });
  }

  function showAdminToast(msg) {
    let toast = document.getElementById('adminToastPopup');
    if (!toast) {
      toast = document.createElement('div');
      toast.id = 'adminToastPopup';
      toast.style.cssText = 'position: fixed; top: 25px; right: 25px; background: #1B5E20; color: white; padding: 1.1rem 1.8rem; border-radius: 14px; box-shadow: 0 12px 30px rgba(0,0,0,0.25); z-index: 999999; display: flex; align-items: center; gap: 12px; font-weight: 600; font-size: 1rem; border: 2px solid #81C784;';
      document.body.appendChild(toast);
    }
    toast.innerHTML = `<i class="fa-solid fa-circle-check" style="font-size: 1.5rem; color: #66BB6A;"></i><span>${msg}</span><button type="button" onclick="this.parentElement.style.display='none'" style="background: none; border: none; color: white; margin-left: 15px; cursor: pointer; font-size: 1.3rem;">&times;</button>`;
    toast.style.display = 'flex';
    setTimeout(() => { if (toast) toast.style.display = 'none'; }, 4000);
  }
</script>

</body>
</html>
