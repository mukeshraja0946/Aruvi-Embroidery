<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Manage Designs - ARUVI Admin</title>
  <link rel="icon" type="image/jpeg" href="/public/images/logo.jpg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;1,400&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="/public/css/main.css">
  <link rel="stylesheet" href="/public/css/admin.css">
  <style>
    /* Category Tag Colors */
    .cat-tag { display: inline-block; padding: 3px 10px; border-radius: 12px; font-size: 0.72rem; font-weight: 600; }
    .cat-tag-floral { background: #FFEBEE; color: #C62828; }
    .cat-tag-animals { background: #E3F2FD; color: #1565C0; }
    .cat-tag-blouse { background: #F3E5F5; color: #7B1FA2; }
    .cat-tag-monogram { background: #FFF8E1; color: #F57F17; }
    .cat-tag-kids { background: #E8F5E9; color: #2E7D32; }
    .cat-tag-traditional { background: #FBE9E7; color: #D84315; }
    .cat-tag-border { background: #E0F2F1; color: #00695C; }
    
    /* Format Micro Badges */
    .fmt-pill { display: inline-block; padding: 1px 5px; border-radius: 4px; background: #F4EFEA; color: var(--admin-text-muted); font-size: 0.65rem; font-weight: 600; margin-right: 2px; }
    
    /* Toggle Switch */
    .switch-toggle {
      position: relative; display: inline-flex; align-items: center; gap: 8px; cursor: pointer;
    }
    .switch-toggle input { opacity: 0; width: 0; height: 0; }
    .slider-round {
      width: 36px; height: 20px; background-color: #CCC; transition: .3s; border-radius: 20px; position: relative;
    }
    .slider-round:before {
      position: absolute; content: ""; height: 14px; width: 14px; left: 3px; bottom: 3px; background-color: white; transition: .3s; border-radius: 50%;
    }
    input:checked + .slider-round { background-color: #4CAF50; }
    input:checked + .slider-round:before { transform: translateX(16px); }

    .action-icon-btn {
      width: 32px; height: 32px; border-radius: 8px; border: 1px solid var(--admin-border); background: #FFFFFF; color: var(--admin-text-dark); display: inline-flex; align-items: center; justify-content: center; font-size: 0.82rem; text-decoration: none; transition: var(--transition);
    }
    .action-icon-btn:hover { border-color: var(--admin-primary); color: var(--admin-primary); background: #FAF6F0; }
  </style>
</head>
<body class="admin-body">

<div class="admin-wrapper">
  <!-- Top Header matching Reference -->
  <header class="admin-top-header">
    <a href="/admin" class="admin-header-brand">
      <% const currentLogo = (typeof siteSettings !== 'undefined' && siteSettings.logo_url) ? siteSettings.logo_url : '/public/images/logo.jpg'; %>
      <img src="<%= currentLogo %>" alt="ARUVI Admin Logo" style="max-height: 42px; width: auto; object-fit: contain;">
    </a>

    <!-- Global Search -->
    <div class="admin-search-bar">
      <i class="fa-solid fa-magnifying-glass"></i>
      <input type="text" placeholder="Search designs, orders, customers...">
    </div>

    <!-- Right User Header Icons -->
    <div class="admin-header-right">
      <a href="#" class="admin-icon-btn" title="Notifications">
        <i class="fa-regular fa-bell"></i>
        <span class="badge-count">3</span>
      </a>

      <div class="admin-user-menu">
        <div class="admin-user-avatar">A</div>
        <div class="admin-user-info">
          <strong>Admin</strong>
          <span>Administrator</span>
        </div>
        <i class="fa-solid fa-chevron-down" style="font-size: 0.75rem; color: var(--admin-text-muted); margin-left: 4px;"></i>
      </div>
    </div>
  </header>

  <!-- Admin Main Layout with Sidebar -->
  <div class="admin-main-container">
    <!-- Left Sidebar matching Reference -->
    <aside class="admin-sidebar">
      <ul class="sidebar-nav-list" style="margin-bottom: 1.2rem;">
        <li class="sidebar-nav-item">
          <a href="/admin">
            <span><i class="fa-solid fa-house"></i> Dashboard</span>
          </a>
        </li>
      </ul>

      <!-- DESIGNS Section -->
      <div class="admin-sidebar-section">
        <div class="sidebar-heading">DESIGNS</div>
        <ul class="sidebar-nav-list">
          <li class="sidebar-nav-item"><a href="/admin/designs" class="active"><span><i class="fa-solid fa-box-archive"></i> Manage Designs</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/designs/create"><span><i class="fa-solid fa-circle-plus"></i> Add New Design</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/categories"><span><i class="fa-solid fa-border-all"></i> Categories</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/custom-orders"><span><i class="fa-solid fa-wand-magic-sparkles"></i> Custom Orders</span></a></li>
        </ul>
      </div>

      <!-- ORDERS Section -->
      <div class="admin-sidebar-section">
        <div class="sidebar-heading">ORDERS</div>
        <ul class="sidebar-nav-list">
          <li class="sidebar-nav-item"><a href="/admin/orders"><span><i class="fa-regular fa-newspaper"></i> All Orders</span></a></li>
          <li class="sidebar-nav-item">
            <a href="/admin/orders?status=pending">
              <span><i class="fa-regular fa-clock"></i> Pending Orders</span>
              <span class="sidebar-badge">5</span>
            </a>
          </li>
          <li class="sidebar-nav-item"><a href="/admin/orders?status=completed"><span><i class="fa-regular fa-circle-check"></i> Completed Orders</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/orders?status=cancelled"><span><i class="fa-regular fa-circle-xmark"></i> Cancelled Orders</span></a></li>
        </ul>
      </div>

      <!-- CUSTOMERS Section -->
      <div class="admin-sidebar-section">
        <div class="sidebar-heading">CUSTOMERS</div>
        <ul class="sidebar-nav-list">
          <li class="sidebar-nav-item"><a href="/admin/customers"><span><i class="fa-solid fa-users"></i> All Customers</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/messages"><span><i class="fa-regular fa-comment-dots"></i> Enquiries</span></a></li>
        </ul>
      </div>

      <!-- CONTENT Section -->
      <div class="admin-sidebar-section">
        <div class="sidebar-heading">CONTENT</div>
        <ul class="sidebar-nav-list">
          <li class="sidebar-nav-item"><a href="/admin/homepage"><span><i class="fa-solid fa-house-chimney"></i> Homepage</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/banners"><span><i class="fa-regular fa-image"></i> Banners</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/homepage#about"><span><i class="fa-regular fa-circle-info"></i> About Page</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/settings#contact"><span><i class="fa-solid fa-location-dot"></i> Contact Info</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/settings"><span><i class="fa-solid fa-gear"></i> Website Settings</span></a></li>
        </ul>
      </div>

      <div style="margin-top: auto; padding-top: 1rem; border-top: 1px solid var(--admin-border);">
        <a href="/admin/logout" style="display: flex; align-items: center; gap: 8px; color: var(--admin-primary); font-size: 0.85rem; font-weight: 600; text-decoration: none; padding: 0.5rem 0.8rem;">
          <i class="fa-solid fa-arrow-right-from-bracket"></i> Logout Admin
        </a>
      </div>
    </aside>

    <!-- Main Content Body -->
    <main class="admin-content-body">

      <!-- Breadcrumbs & Header Row -->
      <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1.8rem;">
        <div>
          <div style="font-size: 0.8rem; color: var(--admin-text-muted); margin-bottom: 0.4rem;">
            <a href="/admin" style="color: var(--admin-text-muted); text-decoration: none;">Dashboard</a> &nbsp;>&nbsp; <span style="color: var(--admin-primary); font-weight: 600;">Manage Designs</span>
          </div>
          <h1 style="font-family: var(--font-heading); font-size: 2.2rem; font-weight: 700; color: var(--admin-text-dark); margin: 0 0 0.3rem;">Manage Designs</h1>
          <p style="font-size: 0.88rem; color: var(--admin-text-muted); margin: 0;">Add, edit, delete and organize your embroidery designs. All changes will be reflected on the website.</p>
        </div>

        <a href="/admin/designs/create" class="btn btn-primary" style="height: 44px; padding: 0 1.4rem; border-radius: 10px; font-size: 0.9rem; font-weight: 600; display: inline-flex; align-items: center; gap: 8px;">
          <i class="fa-solid fa-plus"></i> Add New Design
        </a>
      </div>

      <% if (flash && flash.success && flash.success.length > 0) { %>
        <div id="adminToastPopup" style="position: fixed; top: 25px; right: 25px; background: #1B5E20; color: white; padding: 1.1rem 1.8rem; border-radius: 14px; box-shadow: 0 12px 30px rgba(0,0,0,0.25); z-index: 999999; display: flex; align-items: center; gap: 12px; font-weight: 600; font-size: 1rem; border: 2px solid #81C784;">
          <i class="fa-solid fa-circle-check" style="font-size: 1.5rem; color: #66BB6A;"></i>
          <span><%= flash.success[0] %></span>
          <button type="button" onclick="this.parentElement.remove()" style="background: none; border: none; color: white; margin-left: 15px; cursor: pointer; font-size: 1.3rem;">&times;</button>
        </div>
        <script>
          setTimeout(() => {
            const popup = document.getElementById('adminToastPopup');
            if (popup) popup.style.display = 'none';
          }, 4500);
        </script>
        <div class="alert alert-success" style="margin-bottom: 1.5rem; border-radius: 10px;">
          <i class="fa-solid fa-circle-check"></i> <%= flash.success[0] %>
        </div>
      <% } %>

      <!-- 4 Stat Summary Cards Row matching Reference -->
      <div class="admin-stats-row" style="margin-bottom: 1.8rem;">
        <!-- Total Designs Card -->
        <div class="admin-summary-card">
          <div class="card-icon-badge"><i class="fa-solid fa-box-archive"></i></div>
          <div class="card-info-content">
            <div class="stat-title">Total Designs</div>
            <div style="display: flex; align-items: baseline;">
              <span class="stat-num"><%= typeof total !== 'undefined' ? total : 520 %></span>
              <span class="stat-trend"><i class="fa-solid fa-arrow-up"></i> 8%</span>
            </div>
            <span style="font-size: 0.72rem; color: var(--admin-text-muted);">from last month</span>
          </div>
        </div>

        <!-- Active Designs Card -->
        <div class="admin-summary-card">
          <div class="card-icon-badge"><i class="fa-regular fa-eye"></i></div>
          <div class="card-info-content">
            <div class="stat-title">Active Designs</div>
            <div style="display: flex; align-items: baseline;">
              <span class="stat-num"><%= typeof activeCount !== 'undefined' ? activeCount : 498 %></span>
              <span class="stat-trend"><i class="fa-solid fa-arrow-up"></i> 10%</span>
            </div>
            <span style="font-size: 0.72rem; color: var(--admin-text-muted);">from last month</span>
          </div>
        </div>

        <!-- Inactive Designs Card -->
        <div class="admin-summary-card">
          <div class="card-icon-badge"><i class="fa-solid fa-pause"></i></div>
          <div class="card-info-content">
            <div class="stat-title">Inactive Designs</div>
            <div style="display: flex; align-items: baseline;">
              <span class="stat-num"><%= typeof inactiveCount !== 'undefined' ? inactiveCount : 22 %></span>
              <span class="stat-trend" style="color: var(--admin-primary);"><i class="fa-solid fa-arrow-down"></i> 5%</span>
            </div>
            <span style="font-size: 0.72rem; color: var(--admin-text-muted);">from last month</span>
          </div>
        </div>

        <!-- Categories Card -->
        <div class="admin-summary-card">
          <div class="card-icon-badge"><i class="fa-solid fa-tag"></i></div>
          <div class="card-info-content">
            <div class="stat-title">Categories</div>
            <div style="display: flex; align-items: baseline;">
              <span class="stat-num"><%= typeof categoryCount !== 'undefined' ? categoryCount : 8 %></span>
              <span class="stat-trend" style="color: var(--admin-text-muted);">0%</span>
            </div>
            <span style="font-size: 0.72rem; color: var(--admin-text-muted);">from last month</span>
          </div>
        </div>
      </div>

      <!-- Filter Controls Bar Card -->
      <div class="admin-card-box" style="padding: 1rem 1.4rem; margin-bottom: 1.5rem;">
        <form action="/admin/designs" method="GET" style="display: flex; gap: 1rem; align-items: center; flex-wrap: wrap;">
          
          <!-- Search Input -->
          <div style="flex: 1; min-width: 280px; position: relative;">
            <i class="fa-solid fa-magnifying-glass" style="position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: var(--admin-text-muted); font-size: 0.88rem;"></i>
            <input type="text" name="search" value="<%= typeof search !== 'undefined' ? search : '' %>" placeholder="Search designs by name, category, SKU, tags..." style="width: 100%; height: 40px; border-radius: 8px; border: 1px solid var(--admin-border); padding-left: 2.5rem; font-size: 0.85rem;">
          </div>

          <!-- Category Filter -->
          <select name="category" onchange="this.form.submit()" style="height: 40px; border-radius: 8px; border: 1px solid var(--admin-border); padding: 0 1rem; font-size: 0.85rem; background: #FFFFFF; color: var(--admin-text-dark);">
            <option value="">All Categories</option>
            <% if (categories && categories.length > 0) { %>
              <% categories.forEach(c => { %>
                <option value="<%= c.slug %>" <%= (typeof selectedCategory !== 'undefined' && selectedCategory === c.slug) ? 'selected' : '' %>><%= c.name %></option>
              <% }) %>
            <% } %>
          </select>

          <!-- Status Filter -->
          <select name="status" onchange="this.form.submit()" style="height: 40px; border-radius: 8px; border: 1px solid var(--admin-border); padding: 0 1rem; font-size: 0.85rem; background: #FFFFFF; color: var(--admin-text-dark);">
            <option value="">All Status</option>
            <option value="active" <%= (typeof selectedStatus !== 'undefined' && selectedStatus === 'active') ? 'selected' : '' %>>Active</option>
            <option value="inactive" <%= (typeof selectedStatus !== 'undefined' && selectedStatus === 'inactive') ? 'selected' : '' %>>Inactive / Draft</option>
          </select>

          <!-- Sort Filter -->
          <select name="sort" onchange="this.form.submit()" style="height: 40px; border-radius: 8px; border: 1px solid var(--admin-border); padding: 0 1rem; font-size: 0.85rem; background: #FFFFFF; color: var(--admin-text-dark);">
            <option value="newest" <%= (typeof selectedSort !== 'undefined' && selectedSort === 'newest') ? 'selected' : '' %>>Sort by Newest</option>
            <option value="oldest" <%= (typeof selectedSort !== 'undefined' && selectedSort === 'oldest') ? 'selected' : '' %>>Sort by Oldest</option>
            <option value="price_low" <%= (typeof selectedSort !== 'undefined' && selectedSort === 'price_low') ? 'selected' : '' %>>Price: Low to High</option>
            <option value="price_high" <%= (typeof selectedSort !== 'undefined' && selectedSort === 'price_high') ? 'selected' : '' %>>Price: High to Low</option>
            <option value="popular" <%= (typeof selectedSort !== 'undefined' && selectedSort === 'popular') ? 'selected' : '' %>>Most Downloaded</option>
          </select>

          <!-- Reset Button -->
          <a href="/admin/designs" class="btn btn-outline" style="height: 40px; border-radius: 8px; font-size: 0.85rem; padding: 0 1rem; display: inline-flex; align-items: center; gap: 6px;">
            <i class="fa-solid fa-rotate-left"></i> Reset
          </a>

        </form>
      </div>

      <!-- Main Designs Table Card -->
      <div class="admin-card-box" style="padding: 0; overflow: hidden; margin-bottom: 1.5rem;">
        <table class="admin-table-styled">
          <thead>
            <tr>
              <th style="width: 38px; text-align: center;"><input type="checkbox"></th>
              <th style="width: 60px;">#</th>
              <th>Design Preview</th>
              <th>Design Name</th>
              <th>Category</th>
              <th>Format</th>
              <th>Price (₹)</th>
              <th>Status</th>
              <th>Downloads</th>
              <th>Date Added</th>
              <th style="text-align: right;">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (designs && designs.length > 0) { %>
              <% designs.forEach((d, idx) => { %>
                <% 
                  const catName = d.category_name || 'Floral';
                  let catClass = 'cat-tag-floral';
                  if (catName.includes('Animal')) catClass = 'cat-tag-animals';
                  else if (catName.includes('Blouse')) catClass = 'cat-tag-blouse';
                  else if (catName.includes('Monogram')) catClass = 'cat-tag-monogram';
                %>
                <tr id="designRow-<%= d.id %>">
                  <td style="text-align: center;"><input type="checkbox"></td>
                  <td><strong style="color: var(--admin-text-muted); font-size: 0.82rem;">#<%= d.id %></strong></td>
                  <td>
                    <% if (d.primary_image) { %>
                      <img src="<%= d.primary_image %>" alt="<%= d.title %>" style="width: 52px; height: 52px; border-radius: 8px; object-fit: contain; background: #FAF6F0; border: 1px solid var(--admin-border);">
                    <% } else { %>
                      <div style="width: 52px; height: 52px; border-radius: 8px; background: #FAF6F0; border: 1px dashed var(--admin-border); display: flex; flex-direction: column; align-items: center; justify-content: center; color: var(--admin-text-muted); font-size: 0.65rem; font-weight: 600; text-align: center; padding: 2px;"><i class="fa-regular fa-image" style="font-size: 0.85rem; margin-bottom: 2px;"></i> No Preview</div>
                    <% } %>
                  </td>
                  <td>
                    <strong style="display: block; font-size: 0.88rem; color: var(--admin-text-dark); margin-bottom: 1px;"><%= d.title %></strong>
                    <span style="font-size: 0.72rem; color: var(--admin-text-muted);"><%= d.sku || ('ARV-FL-00' + d.id) %></span>
                  </td>
                  <td>
                    <span class="cat-tag <%= catClass %>"><%= catName %></span>
                  </td>
                  <td>
                    <% const fmtList = d.formats ? d.formats.split(',').map(f => f.trim()).filter(Boolean) : []; %>
                    <% if (fmtList.length > 0) { %>
                      <% fmtList.forEach(fmt => { %>
                        <span class="fmt-pill"><%= fmt %></span>
                      <% }); %>
                    <% } else { %>
                      <span style="font-size: 0.75rem; color: var(--admin-text-muted);">None</span>
                    <% } %>
                  </td>
                  <td>
                    <strong style="display: inline-block; font-size: 0.88rem; color: var(--admin-text-dark);">₹<%= d.sale_price !== null && d.sale_price !== undefined ? d.sale_price : d.price %></strong>
                    <% if (d.sale_price && d.price > d.sale_price) { %>
                      <span style="font-size: 0.75rem; color: var(--admin-text-muted); text-decoration: line-through; margin-left: 4px;">₹<%= d.price %></span>
                      <span style="display: block; font-size: 0.68rem; color: #C62828; font-weight: 600;"><%= Math.round(((d.price - d.sale_price) / d.price) * 100) %>% OFF</span>
                    <% } else { %>
                      <span style="display: block; font-size: 0.68rem; color: var(--admin-text-muted); font-weight: 500;">Regular</span>
                    <% } %>
                  </td>
                  <td>
                    <label class="switch-toggle">
                      <input type="checkbox" <%= d.is_active ? 'checked' : '' %> onchange="toggleDesignStatus('<%= d.id %>', this)">
                      <span class="slider-round"></span>
                      <span id="statusLabel-<%= d.id %>" style="font-size: 0.78rem; font-weight: 600; color: <%= d.is_active ? '#2E7D32' : 'var(--admin-text-muted)' %>;"><%= d.is_active ? 'Active' : 'Inactive' %></span>
                    </label>
                  </td>
                  <td>
                    <span style="font-size: 0.82rem; color: var(--admin-text-dark); display: flex; align-items: center; gap: 4px;">
                      <i class="fa-solid fa-download" style="font-size: 0.75rem; color: var(--admin-primary);"></i> <%= d.download_count !== undefined && d.download_count !== null ? d.download_count : (d.total_sales || 256) %>
                    </span>
                  </td>
                  <td style="color: var(--admin-text-muted); font-size: 0.78rem;">
                    <%= d.created_at ? new Date(d.created_at).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) : '01 Oct 2026' %>
                  </td>
                  <td style="text-align: right;">
                    <div style="display: inline-flex; gap: 6px;">
                      <a href="/admin/designs/edit/<%= d.id %>" class="action-icon-btn" title="Edit Design"><i class="fa-regular fa-pen-to-square"></i></a>
                      <a href="/design/<%= d.slug %>" target="_blank" class="action-icon-btn" title="View on Site"><i class="fa-regular fa-eye"></i></a>
                      <button type="button" onclick="confirmDeleteDesign('<%= d.id %>', '<%= d.title.replace(/'/g, "\\'") %>')" class="action-icon-btn" style="color: #C62828; border: none; background: transparent; cursor: pointer;" title="Delete Design"><i class="fa-regular fa-trash-can"></i></button>
                    </div>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="11" style="text-align: center; padding: 2rem; color: var(--admin-text-muted);">
                  No embroidery designs found. Click "Add New Design" to create one.
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>

        <!-- Pagination Bar matching Reference -->
        <div style="padding: 1rem 1.4rem; background: #FAF6F0; border-top: 1px solid var(--admin-border); display: flex; align-items: center; justify-content: space-between;">
          <div style="font-size: 0.82rem; color: var(--admin-text-muted);">
            Showing <strong><%= designs ? designs.length : 0 %></strong> of <strong><%= typeof total !== 'undefined' ? total : (designs ? designs.length : 0) %></strong> designs
          </div>

          <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
            <div style="display: flex; gap: 6px;">
              <% if (currentPage > 1) { %>
                <a href="?page=<%= currentPage - 1 %>&search=<%= search %>&category=<%= selectedCategory %>&status=<%= selectedStatus %>&sort=<%= selectedSort %>" class="action-icon-btn" style="width: 32px; height: 32px;"><i class="fa-solid fa-chevron-left" style="font-size: 0.7rem;"></i></a>
              <% } %>

              <% for (let p = 1; p <= totalPages; p++) { %>
                <a href="?page=<%= p %>&search=<%= search %>&category=<%= selectedCategory %>&status=<%= selectedStatus %>&sort=<%= selectedSort %>" class="action-icon-btn" style="width: 32px; height: 32px; <%= p === currentPage ? 'background: var(--admin-primary); color: #FFFFFF; border-color: var(--admin-primary); font-weight: 700;' : '' %>"><%= p %></a>
              <% } %>

              <% if (currentPage < totalPages) { %>
                <a href="?page=<%= currentPage + 1 %>&search=<%= search %>&category=<%= selectedCategory %>&status=<%= selectedStatus %>&sort=<%= selectedSort %>" class="action-icon-btn" style="width: 32px; height: 32px;"><i class="fa-solid fa-chevron-right" style="font-size: 0.7rem;"></i></a>
              <% } %>
            </div>
          <% } %>
        </div>
      </div>

    </main>
  </div>
</div>

<!-- Delete Design Confirmation Modal -->
<div id="deleteDesignModal" style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); backdrop-filter: blur(3px); display: none; align-items: center; justify-content: center; z-index: 99999; padding: 1rem;">
  <div style="background: #FFFFFF; border-radius: 16px; padding: 1.8rem; width: 100%; max-width: 440px; box-shadow: 0 10px 40px rgba(0,0,0,0.2); position: relative; border: 1px solid var(--admin-border);">
    <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 1rem;">
      <div style="width: 42px; height: 42px; border-radius: 50%; background: #FFEBEE; color: #C62828; display: flex; align-items: center; justify-content: center; font-size: 1.2rem; flex-shrink: 0;">
        <i class="fa-regular fa-trash-can"></i>
      </div>
      <div>
        <h3 style="font-family: var(--font-heading); font-size: 1.25rem; font-weight: 700; color: var(--admin-text-dark); margin: 0 0 2px 0;">Delete Design?</h3>
        <span style="font-size: 0.8rem; color: var(--admin-text-muted);">Permanently remove design from system</span>
      </div>
    </div>

    <p id="deleteModalMessage" style="font-size: 0.88rem; color: var(--admin-text-dark); line-height: 1.5; margin-bottom: 1.5rem; background: #FAF6F0; padding: 10px 14px; border-radius: 10px; border-left: 3px solid #C62828;">
      Are you sure you want to permanently delete this design?
    </p>

    <div style="display: flex; gap: 10px; justify-content: flex-end;">
      <button type="button" onclick="closeDeleteModal()" class="btn btn-outline" style="height: 40px; padding: 0 1.2rem; border-radius: 8px; font-weight: 600; font-size: 0.88rem;">Cancel</button>
      <button type="button" id="confirmDeleteBtn" onclick="executeDeleteDesign()" class="btn" style="height: 40px; padding: 0 1.4rem; border-radius: 8px; font-weight: 700; font-size: 0.88rem; background: #C62828; color: #FFFFFF; border: none; cursor: pointer;">Delete Design</button>
    </div>
  </div>
</div>

<script>
  let pendingDeleteId = null;

  function confirmDeleteDesign(id, title) {
    pendingDeleteId = id;
    const msgEl = document.getElementById('deleteModalMessage');
    if (msgEl) {
      msgEl.textContent = title ? `Are you sure you want to permanently delete design "${title}"?` : 'Are you sure you want to permanently delete this design?';
    }
    const modal = document.getElementById('deleteDesignModal');
    if (modal) modal.style.display = 'flex';
  }

  function closeDeleteModal() {
    pendingDeleteId = null;
    const modal = document.getElementById('deleteDesignModal');
    if (modal) modal.style.display = 'none';
  }

  function executeDeleteDesign() {
    if (!pendingDeleteId) return;
    const id = pendingDeleteId;
    const btn = document.getElementById('confirmDeleteBtn');
    if (btn) { btn.disabled = true; btn.textContent = 'Deleting...'; }

    const csrfToken = '<%= csrfToken %>';

    fetch('/admin/designs/delete/' + id + '?format=json', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Accept': 'application/json',
        'X-Requested-With': 'XMLHttpRequest',
        'X-CSRF-Token': csrfToken
      },
      body: JSON.stringify({ _csrf: csrfToken })
    })
    .then(res => res.json())
    .then(data => {
      closeDeleteModal();
      if (btn) { btn.disabled = false; btn.textContent = 'Delete Design'; }
      if (data.success) {
        const row = document.getElementById('designRow-' + id);
        if (row) {
          row.style.opacity = '0';
          row.style.transition = 'opacity 0.3s ease';
          setTimeout(() => row.remove(), 300);
        }
        showAdminToast(data.message || 'Design deleted successfully.');
      } else {
        alert(data.message || 'Unable to delete design. Please try again.');
      }
    })
    .catch(err => {
      console.error(err);
      closeDeleteModal();
      if (btn) { btn.disabled = false; btn.textContent = 'Delete Design'; }
      alert('Unable to delete design. Please try again.');
    });
  }

  function showAdminToast(msg) {
    let toast = document.getElementById('adminToastPopup');
    if (!toast) {
      toast = document.createElement('div');
      toast.id = 'adminToastPopup';
      toast.style.cssText = 'position: fixed; top: 25px; right: 25px; background: #1B5E20; color: white; padding: 1.1rem 1.8rem; border-radius: 14px; box-shadow: 0 12px 30px rgba(0,0,0,0.25); z-index: 999999; display: flex; align-items: center; gap: 12px; font-weight: 600; font-size: 1rem; border: 2px solid #81C784;';
      document.body.appendChild(toast);
    }
    toast.innerHTML = `<i class="fa-solid fa-circle-check" style="font-size: 1.5rem; color: #66BB6A;"></i><span>${msg}</span><button type="button" onclick="this.parentElement.style.display='none'" style="background: none; border: none; color: white; margin-left: 15px; cursor: pointer; font-size: 1.3rem;">&times;</button>`;
    toast.style.display = 'flex';
    setTimeout(() => { if (toast) toast.style.display = 'none'; }, 4000);
  }

  function toggleDesignStatus(id, checkbox) {
    fetch('/admin/designs/toggle-status/' + id, {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'X-CSRF-Token': '<%= csrfToken %>'
      },
      body: JSON.stringify({ _csrf: '<%= csrfToken %>' })
    })
    .then(res => res.json())
    .then(data => {
      if (data.success) {
        const label = document.getElementById('statusLabel-' + id);
        if (label) {
          label.textContent = data.is_active ? 'Active' : 'Inactive';
          label.style.color = data.is_active ? '#2E7D32' : 'var(--admin-text-muted)';
        }
      } else {
        alert(data.message || 'Unable to update status');
        checkbox.checked = !checkbox.checked;
      }
    })
    .catch(err => {
      console.error(err);
      checkbox.checked = !checkbox.checked;
    });
  }
</script>

</body>
</html>
