<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="csrf-token" content="<%= csrfToken %>">
  <title>Manage Designs - ARUVI Admin</title>
  <link rel="icon" type="image/jpeg" href="/public/images/logo.jpg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;1,400&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="/public/css/main.css">
  <link rel="stylesheet" href="/public/css/admin.css">
  <style>
    /* Category Tag Colors */
    .cat-tag { display: inline-block; padding: 3px 10px; border-radius: 12px; font-size: 0.72rem; font-weight: 600; }
    .cat-tag-floral { background: #FFEBEE; color: #C62828; }
    .cat-tag-animals { background: #E3F2FD; color: #1565C0; }
    .cat-tag-blouse { background: #F3E5F5; color: #7B1FA2; }
    .cat-tag-monogram { background: #FFF8E1; color: #F57F17; }
    .cat-tag-kids { background: #E8F5E9; color: #2E7D32; }
    .cat-tag-traditional { background: #FBE9E7; color: #D84315; }
    .cat-tag-border { background: #E0F2F1; color: #00695C; }
    
    /* Format Micro Badges */
    .fmt-pill { display: inline-block; padding: 1px 5px; border-radius: 4px; background: #F4EFEA; color: var(--admin-text-muted); font-size: 0.65rem; font-weight: 600; margin-right: 2px; }
    
    /* Toggle Switch */
    .switch-toggle {
      position: relative; display: inline-flex; align-items: center; gap: 8px; cursor: pointer;
    }
    .switch-toggle input { opacity: 0; width: 0; height: 0; }
    .slider-round {
      width: 36px; height: 20px; background-color: #CCC; transition: .3s; border-radius: 20px; position: relative;
    }
    .slider-round:before {
      position: absolute; content: ""; height: 14px; width: 14px; left: 3px; bottom: 3px; background-color: white; transition: .3s; border-radius: 50%;
    }
    input:checked + .slider-round { background-color: #4CAF50; }
    input:checked + .slider-round:before { transform: translateX(16px); }

    .action-icon-btn {
      width: 32px; height: 32px; border-radius: 8px; border: 1px solid var(--admin-border); background: #FFFFFF; color: var(--admin-text-dark); display: inline-flex; align-items: center; justify-content: center; font-size: 0.82rem; text-decoration: none; transition: var(--transition);
    }
    .action-icon-btn:hover { border-color: var(--admin-primary); color: var(--admin-primary); background: #FAF6F0; }
  </style>
</head>
<body class="admin-body">

<div class="admin-wrapper">
  <!-- Top Header matching Reference -->
  <header class="admin-top-header">
    <a href="/admin" class="admin-header-brand">
      <% const currentLogo = (typeof siteSettings !== 'undefined' && siteSettings.logo_url) ? siteSettings.logo_url : '/public/images/logo.jpg'; %>
      <img src="<%= currentLogo %>" alt="ARUVI Admin Logo" style="max-height: 42px; width: auto; object-fit: contain;">
    </a>

    <!-- Global Search -->
    <div class="admin-search-bar">
      <i class="fa-solid fa-magnifying-glass"></i>
      <input type="text" placeholder="Search designs, orders, customers...">
    </div>

    <!-- Right User Header Icons -->
    <div class="admin-header-right">
      <a href="/admin/messages" class="admin-icon-btn" title="Enquiries">
        <i class="fa-regular fa-bell"></i>
        <% if (typeof adminNavBadges !== 'undefined' && adminNavBadges.unreadMessages > 0) { %>
          <span class="badge-count"><%= adminNavBadges.unreadMessages %></span>
        <% } %>
      </a>

      <div class="admin-user-menu">
        <div class="admin-user-avatar">A</div>
        <div class="admin-user-info">
          <strong>Admin</strong>
          <span>Administrator</span>
        </div>
        <i class="fa-solid fa-chevron-down" style="font-size: 0.75rem; color: var(--admin-text-muted); margin-left: 4px;"></i>
      </div>
    </div>
  </header>

  <!-- Admin Main Layout with Sidebar -->
  <div class="admin-main-container">
    <!-- Left Sidebar matching Reference -->
    <aside class="admin-sidebar">
      <ul class="sidebar-nav-list" style="margin-bottom: 1.2rem;">
        <li class="sidebar-nav-item">
          <a href="/admin">
            <span><i class="fa-solid fa-house"></i> Dashboard</span>
          </a>
        </li>
      </ul>

      <!-- DESIGNS Section -->
      <div class="admin-sidebar-section">
        <div class="sidebar-heading">DESIGNS</div>
        <ul class="sidebar-nav-list">
          <li class="sidebar-nav-item"><a href="/admin/designs" class="active"><span><i class="fa-solid fa-box-archive"></i> Manage Designs</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/designs/create"><span><i class="fa-solid fa-circle-plus"></i> Add New Design</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/categories"><span><i class="fa-solid fa-border-all"></i> Categories</span></a></li>
          <li class="sidebar-nav-item">
            <a href="/admin/custom-orders">
              <span><i class="fa-solid fa-wand-magic-sparkles"></i> Custom Orders</span>
              <% if (typeof adminNavBadges !== 'undefined' && adminNavBadges.pendingCustomOrders > 0) { %>
                <span class="sidebar-badge"><%= adminNavBadges.pendingCustomOrders %></span>
              <% } %>
            </a>
          </li>
        </ul>
      </div>

      <!-- ORDERS Section -->
      <div class="admin-sidebar-section">
        <div class="sidebar-heading">ORDERS</div>
        <ul class="sidebar-nav-list">
          <li class="sidebar-nav-item"><a href="/admin/orders"><span><i class="fa-regular fa-newspaper"></i> All Orders</span></a></li>
          <li class="sidebar-nav-item">
            <a href="/admin/orders?status=pending">
              <span><i class="fa-regular fa-clock"></i> Pending Orders</span>
              <% if (typeof adminNavBadges !== 'undefined' && adminNavBadges.pendingOrders > 0) { %>
                <span class="sidebar-badge"><%= adminNavBadges.pendingOrders %></span>
              <% } %>
            </a>
          </li>
          <li class="sidebar-nav-item"><a href="/admin/orders?status=completed"><span><i class="fa-regular fa-circle-check"></i> Completed Orders</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/orders?status=cancelled"><span><i class="fa-regular fa-circle-xmark"></i> Cancelled Orders</span></a></li>
        </ul>
      </div>

      <!-- CUSTOMERS Section -->
      <div class="admin-sidebar-section">
        <div class="sidebar-heading">CUSTOMERS</div>
        <ul class="sidebar-nav-list">
          <li class="sidebar-nav-item"><a href="/admin/customers"><span><i class="fa-solid fa-users"></i> All Customers</span></a></li>
          <li class="sidebar-nav-item">
            <a href="/admin/messages">
              <span><i class="fa-regular fa-comment-dots"></i> Enquiries</span>
              <% if (typeof adminNavBadges !== 'undefined' && adminNavBadges.unreadMessages > 0) { %>
                <span class="sidebar-badge"><%= adminNavBadges.unreadMessages %></span>
              <% } %>
            </a>
          </li>
          <li class="sidebar-nav-item"><a href="/admin/reviews"><span><i class="fa-regular fa-star"></i> Reviews</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/email-campaigns"><span><i class="fa-solid fa-paper-plane"></i> Email Campaigns 📧</span></a></li>
        </ul>
      </div>

      <!-- CONTENT Section -->
      <div class="admin-sidebar-section">
        <div class="sidebar-heading">CONTENT</div>
        <ul class="sidebar-nav-list">
          <li class="sidebar-nav-item"><a href="/admin/homepage"><span><i class="fa-solid fa-house-chimney"></i> Homepage</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/banners"><span><i class="fa-regular fa-image"></i> Banners</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/homepage#about"><span><i class="fa-regular fa-circle-info"></i> About Page</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/settings#contact"><span><i class="fa-solid fa-location-dot"></i> Contact Info</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/settings"><span><i class="fa-solid fa-gear"></i> Website Settings</span></a></li>
        </ul>
      </div>

      <div style="margin-top: auto; padding-top: 1rem; border-top: 1px solid var(--admin-border);">
        <a href="/admin/logout" style="display: flex; align-items: center; gap: 8px; color: var(--admin-primary); font-size: 0.85rem; font-weight: 600; text-decoration: none; padding: 0.5rem 0.8rem;">
          <i class="fa-solid fa-arrow-right-from-bracket"></i> Logout Admin
        </a>
      </div>
    </aside>

    <!-- Main Content Body -->
    <main class="admin-content-body">

      <!-- Breadcrumbs & Header Row -->
      <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1.8rem; gap: 1rem; flex-wrap: wrap;">
        <div>
          <div style="font-size: 0.8rem; color: var(--admin-text-muted); margin-bottom: 0.4rem;">
            <a href="/admin" style="color: var(--admin-text-muted); text-decoration: none;">Dashboard</a> &nbsp;>&nbsp; <span style="color: var(--admin-primary); font-weight: 600;">Manage Designs</span>
          </div>
          <h1 style="font-family: var(--font-heading); font-size: 2.2rem; font-weight: 700; color: var(--admin-text-dark); margin: 0 0 0.3rem;">Manage Designs</h1>
          <p style="font-size: 0.88rem; color: var(--admin-text-muted); margin: 0;">Add, edit, delete and organize your embroidery designs. All changes will be reflected on the website.</p>
        </div>

        <div style="display: flex; gap: 10px; align-items: center; flex-wrap: wrap;">
          <a href="/admin/designs/create" class="btn btn-primary" style="height: 42px; padding: 0 1.25rem; border-radius: 10px; font-size: 0.88rem; font-weight: 600; display: inline-flex; align-items: center; gap: 8px; background: var(--admin-primary); color: #FFFFFF; text-decoration: none; border: none; box-shadow: 0 2px 6px rgba(184, 64, 42, 0.2); white-space: nowrap;">
            <i class="fa-solid fa-plus"></i> Add New Design
          </a>
          <button type="button" onclick="openBulkImportModal()" class="btn btn-outline" style="height: 42px; padding: 0 1.25rem; border-radius: 10px; font-size: 0.88rem; font-weight: 600; display: inline-flex; align-items: center; gap: 8px; background: #FFFFFF; border: 1px solid var(--admin-primary); color: var(--admin-primary); cursor: pointer; white-space: nowrap; transition: all 0.2s;">
            <i class="fa-solid fa-file-import"></i> Bulk Import
          </button>
          <button type="button" onclick="openBulkImageUploadModal()" class="btn btn-outline" style="height: 42px; padding: 0 1.25rem; border-radius: 10px; font-size: 0.88rem; font-weight: 600; display: inline-flex; align-items: center; gap: 8px; background: #FFFFFF; border: 1px solid #795548; color: #5D4037; cursor: pointer; white-space: nowrap; transition: all 0.2s;" title="Bulk upload/restore product images">
            <i class="fa-solid fa-images"></i> Bulk Images
          </button>
          <button type="button" id="deleteSelectedBtn" onclick="confirmDeleteSelectedDesigns()" class="btn" style="display: none; height: 42px; padding: 0 1.1rem; border-radius: 10px; font-size: 0.85rem; font-weight: 600; background: #C62828; color: #FFFFFF; border: none; cursor: pointer; align-items: center; gap: 8px; white-space: nowrap;">
            <i class="fa-regular fa-trash-can"></i> Delete Selected (<span id="selectedCountNum">0</span>)
          </button>
          <button type="button" onclick="confirmDeleteAllDesigns()" class="btn" style="height: 42px; padding: 0 1.1rem; border-radius: 10px; font-size: 0.85rem; font-weight: 600; background: #FFF0F0; color: #C62828; border: 1px solid #FFCDD2; cursor: pointer; display: inline-flex; align-items: center; gap: 8px; white-space: nowrap; transition: all 0.2s;">
            <i class="fa-regular fa-trash-can"></i> Delete All Designs
          </button>
        </div>
      </div>

      <% if (typeof flash !== 'undefined' && flash && flash.success && flash.success.length > 0) { %>
        <div id="adminToastPopup" style="position: fixed; top: 25px; right: 25px; background: #1B5E20; color: white; padding: 1.1rem 1.8rem; border-radius: 14px; box-shadow: 0 12px 30px rgba(0,0,0,0.25); z-index: 999999; display: flex; align-items: center; gap: 12px; font-weight: 600; font-size: 1rem; border: 2px solid #81C784;">
          <i class="fa-solid fa-circle-check" style="font-size: 1.5rem; color: #66BB6A;"></i>
          <span><%= flash.success[0] %></span>
          <button type="button" onclick="this.parentElement.remove()" style="background: none; border: none; color: white; margin-left: 15px; cursor: pointer; font-size: 1.3rem;">&times;</button>
        </div>
        <script>
          setTimeout(() => {
            const popup = document.getElementById('adminToastPopup');
            if (popup) popup.style.display = 'none';
          }, 4500);
        </script>
        <div class="alert alert-success" style="margin-bottom: 1.5rem; border-radius: 10px;">
          <i class="fa-solid fa-circle-check"></i> <%= flash.success[0] %>
        </div>
      <% } %>

      <!-- 4 Stat Summary Cards Row matching Reference -->
      <div class="admin-stats-row" style="margin-bottom: 1.8rem;">
        <!-- Total Designs Card -->
        <div class="admin-summary-card">
          <div class="card-icon-badge"><i class="fa-solid fa-box-archive"></i></div>
          <div class="card-info-content">
            <div class="stat-title">Total Designs</div>
            <div style="display: flex; align-items: baseline;">
              <span class="stat-num"><%= typeof total !== 'undefined' ? total : 0 %></span>
              <% if (typeof stats !== 'undefined' && stats.designsTrend) { %>
                <span class="stat-trend" style="color: <%= stats.designsTrend.isPositive ? 'inherit' : 'var(--admin-primary)' %>;">
                  <i class="fa-solid fa-arrow-<%= stats.designsTrend.isPositive ? 'up' : 'down' %>"></i> <%= stats.designsTrend.text %>
                </span>
              <% } %>
            </div>
            <span style="font-size: 0.72rem; color: var(--admin-text-muted);">from last month</span>
          </div>
        </div>

        <!-- Active Designs Card -->
        <div class="admin-summary-card">
          <div class="card-icon-badge"><i class="fa-regular fa-eye"></i></div>
          <div class="card-info-content">
            <div class="stat-title">Active Designs</div>
            <div style="display: flex; align-items: baseline;">
              <span class="stat-num"><%= typeof activeCount !== 'undefined' ? activeCount : 0 %></span>
              <% if (typeof stats !== 'undefined' && stats.activeTrend) { %>
                <span class="stat-trend" style="color: <%= stats.activeTrend.isPositive ? 'inherit' : 'var(--admin-primary)' %>;">
                  <i class="fa-solid fa-arrow-<%= stats.activeTrend.isPositive ? 'up' : 'down' %>"></i> <%= stats.activeTrend.text %>
                </span>
              <% } %>
            </div>
            <span style="font-size: 0.72rem; color: var(--admin-text-muted);">from last month</span>
          </div>
        </div>

        <!-- Inactive Designs Card -->
        <div class="admin-summary-card">
          <div class="card-icon-badge"><i class="fa-solid fa-pause"></i></div>
          <div class="card-info-content">
            <div class="stat-title">Inactive Designs</div>
            <div style="display: flex; align-items: baseline;">
              <span class="stat-num"><%= typeof inactiveCount !== 'undefined' ? inactiveCount : 0 %></span>
              <% if (typeof stats !== 'undefined' && stats.inactiveTrend) { %>
                <span class="stat-trend" style="color: <%= stats.inactiveTrend.isPositive ? 'inherit' : 'var(--admin-primary)' %>;">
                  <i class="fa-solid fa-arrow-<%= stats.inactiveTrend.isPositive ? 'up' : 'down' %>"></i> <%= stats.inactiveTrend.text %>
                </span>
              <% } %>
            </div>
            <span style="font-size: 0.72rem; color: var(--admin-text-muted);">from last month</span>
          </div>
        </div>

        <!-- Categories Card -->
        <div class="admin-summary-card">
          <div class="card-icon-badge"><i class="fa-solid fa-tag"></i></div>
          <div class="card-info-content">
            <div class="stat-title">Categories</div>
            <div style="display: flex; align-items: baseline;">
              <span class="stat-num"><%= typeof categoryCount !== 'undefined' ? categoryCount : 0 %></span>
              <% if (typeof stats !== 'undefined' && stats.categoriesTrend) { %>
                <span class="stat-trend" style="color: <%= stats.categoriesTrend.isPositive ? 'inherit' : 'var(--admin-primary)' %>;">
                  <i class="fa-solid fa-arrow-<%= stats.categoriesTrend.isPositive ? 'up' : 'down' %>"></i> <%= stats.categoriesTrend.text %>
                </span>
              <% } %>
            </div>
            <span style="font-size: 0.72rem; color: var(--admin-text-muted);">from last month</span>
          </div>
        </div>
      </div>

      <!-- Filter Controls Bar Card -->
      <div class="admin-card-box" style="padding: 1rem 1.4rem; margin-bottom: 1.5rem;">
        <form action="/admin/designs" method="GET" style="display: flex; gap: 1rem; align-items: center; flex-wrap: wrap;">
          
          <!-- Search Input -->
          <div style="flex: 1; min-width: 280px; position: relative;">
            <i class="fa-solid fa-magnifying-glass" style="position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: var(--admin-text-muted); font-size: 0.88rem;"></i>
            <input type="text" name="search" value="<%= typeof search !== 'undefined' ? search : '' %>" placeholder="Search designs by name, category, SKU, tags..." style="width: 100%; height: 40px; border-radius: 8px; border: 1px solid var(--admin-border); padding-left: 2.5rem; font-size: 0.85rem;">
          </div>

          <!-- Category Filter -->
          <select name="category" onchange="this.form.submit()" style="height: 40px; border-radius: 8px; border: 1px solid var(--admin-border); padding: 0 1rem; font-size: 0.85rem; background: #FFFFFF; color: var(--admin-text-dark);">
            <option value="">All Categories</option>
            <% if (categories && categories.length > 0) { %>
              <% categories.forEach(c => { %>
                <option value="<%= c.slug %>" <%= (typeof selectedCategory !== 'undefined' && selectedCategory === c.slug) ? 'selected' : '' %>><%= c.name %></option>
              <% }) %>
            <% } %>
          </select>

          <!-- Status Filter -->
          <select name="status" onchange="this.form.submit()" style="height: 40px; border-radius: 8px; border: 1px solid var(--admin-border); padding: 0 1rem; font-size: 0.85rem; background: #FFFFFF; color: var(--admin-text-dark);">
            <option value="">All Status</option>
            <option value="active" <%= (typeof selectedStatus !== 'undefined' && selectedStatus === 'active') ? 'selected' : '' %>>Active</option>
            <option value="inactive" <%= (typeof selectedStatus !== 'undefined' && selectedStatus === 'inactive') ? 'selected' : '' %>>Inactive / Draft</option>
          </select>

          <!-- Standardized Sort Filter -->
          <%- include('../../partials/sort-dropdown', {
            id: 'admin_designs_sort_dd',
            label: 'Sort by:',
            actionType: 'submit',
            currentSort: typeof selectedSort !== 'undefined' ? selectedSort : 'newest',
            options: [
              { value: 'newest', label: 'Sort by Newest', iconType: 'latest' },
              { value: 'oldest', label: 'Sort by Oldest', iconType: 'oldest' },
              { value: 'price_low', label: 'Price: Low to High', iconType: 'price_low' },
              { value: 'price_high', label: 'Price: High to Low', iconType: 'price_high' },
              { value: 'popular', label: 'Most Downloaded', iconType: 'popular' }
            ]
          }) %>

          <!-- Reset Button -->
          <a href="/admin/designs" class="btn btn-outline" style="height: 40px; border-radius: 8px; font-size: 0.85rem; padding: 0 1rem; display: inline-flex; align-items: center; gap: 6px;">
            <i class="fa-solid fa-rotate-left"></i> Reset
          </a>

        </form>
      </div>

      <!-- Main Designs Table Card -->
      <div class="admin-card-box" style="padding: 0; overflow: hidden; margin-bottom: 1.5rem;">
        <table class="admin-table-styled">
          <thead>
            <tr>
              <th style="width: 38px; text-align: center;"><input type="checkbox" id="selectAllCheckbox" onchange="toggleSelectAllDesigns(this)"></th>
              <th style="width: 60px;">#</th>
              <th>Design Preview</th>
              <th>Design Name</th>
              <th>Category</th>
              <th>Format</th>
              <th>Price (₹)</th>
              <th>Status</th>
              <th>Downloads</th>
              <th>Date Added</th>
              <th style="text-align: right;">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (designs && designs.length > 0) { %>
              <% designs.forEach((d, idx) => { %>
                <% 
                  const catName = d.category_name || 'Floral';
                  let catClass = 'cat-tag-floral';
                  if (catName.includes('Animal')) catClass = 'cat-tag-animals';
                  else if (catName.includes('Blouse')) catClass = 'cat-tag-blouse';
                  else if (catName.includes('Monogram')) catClass = 'cat-tag-monogram';
                %>
                <tr id="designRow-<%= d.id %>">
                  <td style="text-align: center;"><input type="checkbox" class="design-checkbox" value="<%= d.id %>" onchange="updateSelectedCount()"></td>
                  <td><strong style="color: var(--admin-text-muted); font-size: 0.82rem;">#<%= d.id %></strong></td>
                  <td>
                    <div style="position: relative; width: 52px; height: 52px; display: inline-block;">
                      <% if (d.primary_image) { %>
                        <img id="designImg-<%= d.id %>" src="<%= d.thumbnail_image || d.primary_image %>" alt="<%= d.title %>" style="width: 52px; height: 52px; border-radius: 8px; object-fit: contain; background: #FAF6F0; border: 1px solid var(--admin-border);" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                        <div style="display: none; width: 52px; height: 52px; border-radius: 8px; background: #F8F9FA; border: 1px dashed var(--admin-border); flex-direction: column; align-items: center; justify-content: center; color: var(--admin-text-muted); font-size: 0.65rem; font-weight: 600; text-align: center; padding: 2px;" title="Image could not be loaded">
                          <i class="fa-regular fa-image" style="font-size: 0.82rem; margin-bottom: 2px; color: var(--admin-text-muted);"></i>
                          <span>No image</span>
                          <button type="button" data-id="<%= d.id %>" data-title="<%= d.title %>" onclick="openReplaceImageModal(this.dataset.id, this.dataset.title)" style="margin-top: 2px; font-size: 0.58rem; padding: 1px 4px; border-radius: 4px; background: var(--admin-primary); color: #fff; border: none; cursor: pointer;">Replace</button>
                        </div>
                      <% } else { %>
                        <div style="width: 52px; height: 52px; border-radius: 8px; background: #F8F9FA; border: 1px dashed var(--admin-border); display: flex; flex-direction: column; align-items: center; justify-content: center; color: var(--admin-text-muted); font-size: 0.65rem; font-weight: 600; text-align: center; padding: 2px;" title="No image uploaded">
                          <i class="fa-regular fa-image" style="font-size: 0.82rem; margin-bottom: 2px; color: var(--admin-text-muted);"></i>
                          <span>No image</span>
                          <button type="button" data-id="<%= d.id %>" data-title="<%= d.title %>" onclick="openReplaceImageModal(this.dataset.id, this.dataset.title)" style="margin-top: 2px; font-size: 0.58rem; padding: 1px 4px; border-radius: 4px; background: var(--admin-primary); color: #fff; border: none; cursor: pointer;">Add</button>
                        </div>
                      <% } %>
                    </div>
                  </td>
                  <td>
                    <strong style="display: block; font-size: 0.88rem; color: var(--admin-text-dark); margin-bottom: 1px;"><%= d.title %></strong>
                    <span style="font-size: 0.72rem; color: var(--admin-text-muted);"><%= d.sku || ('ARV-FL-00' + d.id) %></span>
                  </td>
                  <td>
                    <span class="cat-tag <%= catClass %>"><%= catName %></span>
                  </td>
                  <td>
                    <% const fmtList = d.formats ? d.formats.split(',').map(f => f.trim()).filter(Boolean) : []; %>
                    <% if (fmtList.length > 0) { %>
                      <% fmtList.forEach(fmt => { %>
                        <span class="fmt-pill"><%= fmt %></span>
                      <% }); %>
                    <% } else { %>
                      <span style="font-size: 0.75rem; color: var(--admin-text-muted);">None</span>
                    <% } %>
                  </td>
                  <td>
                    <strong style="display: inline-block; font-size: 0.88rem; color: var(--admin-text-dark);">₹<%= d.sale_price !== null && d.sale_price !== undefined ? d.sale_price : d.price %></strong>
                    <% if (d.sale_price && d.price > d.sale_price) { %>
                      <span style="font-size: 0.75rem; color: var(--admin-text-muted); text-decoration: line-through; margin-left: 4px;">₹<%= d.price %></span>
                      <span style="display: block; font-size: 0.68rem; color: #C62828; font-weight: 600;"><%= Math.round(((d.price - d.sale_price) / d.price) * 100) %>% OFF</span>
                    <% } else { %>
                      <span style="display: block; font-size: 0.68rem; color: var(--admin-text-muted); font-weight: 500;">Regular</span>
                    <% } %>
                  </td>
                  <td>
                    <label class="switch-toggle">
                      <input type="checkbox" <%= d.is_active ? 'checked' : '' %> onchange="toggleDesignStatus('<%= d.id %>', this)">
                      <span class="slider-round"></span>
                      <span id="statusLabel-<%= d.id %>" style="font-size: 0.78rem; font-weight: 600; color: <%= d.is_active ? '#2E7D32' : 'var(--admin-text-muted)' %>;"><%= d.is_active ? 'Active' : 'Inactive' %></span>
                    </label>
                  </td>
                  <td>
                    <span style="font-size: 0.82rem; color: var(--admin-text-dark); display: flex; align-items: center; gap: 4px;">
                      <i class="fa-solid fa-download" style="font-size: 0.75rem; color: var(--admin-primary);"></i> <%= d.download_count !== undefined && d.download_count !== null ? d.download_count : 0 %>
                    </span>
                  </td>
                  <td style="color: var(--admin-text-muted); font-size: 0.78rem;">
                    <%= typeof formatDateTime === 'function' ? formatDateTime(d.created_at) : (d.created_at || '-') %>
                  </td>
                  <td style="text-align: right;">
                    <div style="display: inline-flex; gap: 6px;">
                      <button type="button" data-id="<%= d.id %>" data-title="<%= d.title %>" onclick="openReplaceImageModal(this.dataset.id, this.dataset.title)" class="action-icon-btn" title="Replace Image"><i class="fa-solid fa-image"></i></button>
                      <button type="button" data-id="<%= d.id %>" data-title="<%= d.title %>" onclick="duplicateDesign(this.dataset.id, this.dataset.title)" class="action-icon-btn" title="Duplicate Design"><i class="fa-regular fa-copy"></i></button>
                      <a href="/admin/designs/edit/<%= d.id %>" class="action-icon-btn" title="Edit Design"><i class="fa-regular fa-pen-to-square"></i></a>
                      <a href="/design/<%= d.slug %>" target="_blank" class="action-icon-btn" title="View on Site"><i class="fa-regular fa-eye"></i></a>
                      <button type="button" data-id="<%= d.id %>" data-title="<%= d.title %>" onclick="confirmDeleteDesign(this.dataset.id, this.dataset.title)" class="action-icon-btn" style="color: #C62828; border: none; background: transparent; cursor: pointer;" title="Delete Design"><i class="fa-regular fa-trash-can"></i></button>
                    </div>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="11" style="text-align: center; padding: 2rem; color: var(--admin-text-muted);">
                  No embroidery designs found. Click "Add New Design" to create one.
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>

        <!-- Pagination Bar matching Reference -->
        <div style="padding: 1rem 1.4rem; background: #FAF6F0; border-top: 1px solid var(--admin-border); display: flex; align-items: center; justify-content: space-between;">
          <div style="font-size: 0.82rem; color: var(--admin-text-muted);">
            Showing <strong><%= designs ? designs.length : 0 %></strong> of <strong><%= typeof total !== 'undefined' ? total : (designs ? designs.length : 0) %></strong> designs
          </div>

          <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
            <div style="display: flex; gap: 6px;">
              <% if (currentPage > 1) { %>
                <a href="?page=<%= currentPage - 1 %>&search=<%= search %>&category=<%= selectedCategory %>&status=<%= selectedStatus %>&sort=<%= selectedSort %>" class="action-icon-btn" style="width: 32px; height: 32px;"><i class="fa-solid fa-chevron-left" style="font-size: 0.7rem;"></i></a>
              <% } %>

              <% for (let p = 1; p <= totalPages; p++) { %>
                <a href="?page=<%= p %>&search=<%= search %>&category=<%= selectedCategory %>&status=<%= selectedStatus %>&sort=<%= selectedSort %>" class="action-icon-btn" style="width: 32px; height: 32px; <%= p === currentPage ? 'background: var(--admin-primary); color: #FFFFFF; border-color: var(--admin-primary); font-weight: 700;' : '' %>"><%= p %></a>
              <% } %>

              <% if (currentPage < totalPages) { %>
                <a href="?page=<%= currentPage + 1 %>&search=<%= search %>&category=<%= selectedCategory %>&status=<%= selectedStatus %>&sort=<%= selectedSort %>" class="action-icon-btn" style="width: 32px; height: 32px;"><i class="fa-solid fa-chevron-right" style="font-size: 0.7rem;"></i></a>
              <% } %>
            </div>
          <% } %>
        </div>
      </div>

    </main>
  </div>
</div>

<!-- Delete Single Design Confirmation Modal -->
<div id="deleteDesignModal" style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); backdrop-filter: blur(3px); display: none; align-items: center; justify-content: center; z-index: 99999; padding: 1rem;">
  <div style="background: #FFFFFF; border-radius: 16px; padding: 1.8rem; width: 100%; max-width: 440px; box-shadow: 0 10px 40px rgba(0,0,0,0.2); position: relative; border: 1px solid var(--admin-border);">
    <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 1rem;">
      <div style="width: 42px; height: 42px; border-radius: 50%; background: #FFEBEE; color: #C62828; display: flex; align-items: center; justify-content: center; font-size: 1.2rem; flex-shrink: 0;">
        <i class="fa-regular fa-trash-can"></i>
      </div>
      <div>
        <h3 style="font-family: var(--font-heading); font-size: 1.25rem; font-weight: 700; color: var(--admin-text-dark); margin: 0 0 2px 0;">Delete Design?</h3>
        <span style="font-size: 0.8rem; color: var(--admin-text-muted);">Permanently remove design from system</span>
      </div>
    </div>

    <p id="deleteModalMessage" style="font-size: 0.88rem; color: var(--admin-text-dark); line-height: 1.5; margin-bottom: 1.5rem; background: #FAF6F0; padding: 10px 14px; border-radius: 10px; border-left: 3px solid #C62828;">
      Are you sure you want to permanently delete this design?
    </p>

    <div style="display: flex; gap: 10px; justify-content: flex-end;">
      <button type="button" onclick="closeDeleteModal()" class="btn btn-outline" style="height: 40px; padding: 0 1.2rem; border-radius: 8px; font-weight: 600; font-size: 0.88rem;">Cancel</button>
      <button type="button" id="confirmDeleteBtn" onclick="executeDeleteDesign()" class="btn" style="height: 40px; padding: 0 1.4rem; border-radius: 8px; font-weight: 700; font-size: 0.88rem; background: #C62828; color: #FFFFFF; border: none; cursor: pointer;">Delete Design</button>
    </div>
  </div>
</div>

<!-- Delete All Designs Confirmation Modal -->
<div id="deleteAllDesignsModal" style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); backdrop-filter: blur(3px); display: none; align-items: center; justify-content: center; z-index: 99999; padding: 1rem;">
  <div style="background: #FFFFFF; border-radius: 16px; padding: 1.8rem; width: 100%; max-width: 450px; box-shadow: 0 10px 40px rgba(0,0,0,0.2); position: relative; border: 1px solid var(--admin-border);">
    <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 1rem;">
      <div style="width: 42px; height: 42px; border-radius: 50%; background: #FFEBEE; color: #900C3F; display: flex; align-items: center; justify-content: center; font-size: 1.2rem; flex-shrink: 0;">
        <i class="fa-solid fa-trash-can"></i>
      </div>
      <div>
        <h3 style="font-family: var(--font-heading); font-size: 1.25rem; font-weight: 700; color: var(--admin-text-dark); margin: 0 0 2px 0;">Delete ALL Designs?</h3>
        <span style="font-size: 0.8rem; color: #C62828; font-weight: 600;">PERMANENT ACTION — CANNOT BE UNDONE</span>
      </div>
    </div>

    <p style="font-size: 0.88rem; color: var(--admin-text-dark); line-height: 1.5; margin-bottom: 1.5rem; background: #FFEBEE; padding: 12px 14px; border-radius: 10px; border-left: 4px solid #900C3F;">
      <strong>Warning:</strong> Are you sure you want to permanently delete <strong>ALL designs</strong> from the store? This will completely clear all designs, images, and design files permanently.
    </p>

    <div style="display: flex; gap: 10px; justify-content: flex-end;">
      <button type="button" onclick="closeDeleteAllModal()" class="btn btn-outline" style="height: 40px; padding: 0 1.2rem; border-radius: 8px; font-weight: 600; font-size: 0.88rem;">Cancel</button>
      <button type="button" id="confirmDeleteAllBtn" onclick="executeDeleteAllDesigns()" class="btn" style="height: 40px; padding: 0 1.4rem; border-radius: 8px; font-weight: 700; font-size: 0.88rem; background: #900C3F; color: #FFFFFF; border: none; cursor: pointer;">Yes, Delete All Designs</button>
    </div>
  </div>
</div>

<!-- Bulk Import Modal (3-Step Robust Importer) -->
<div id="bulkImportModal" style="display: none; position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0,0,0,0.65); backdrop-filter: blur(4px); z-index: 999999; align-items: center; justify-content: center; padding: 1.5rem;">
  <div style="background: #FFFFFF; border-radius: 16px; width: 100%; max-width: 960px; max-height: 92vh; display: flex; flex-direction: column; overflow: hidden; box-shadow: 0 20px 50px rgba(0,0,0,0.35);">
    
    <!-- Modal Header & Stepper -->
    <div style="padding: 1.2rem 1.6rem; border-bottom: 1px solid var(--admin-border); background: #FAF6F0;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
        <div>
          <h3 style="font-family: var(--font-heading); font-size: 1.25rem; font-weight: 700; color: var(--admin-text-dark); margin: 0 0 2px;">
            <i class="fa-solid fa-file-import" style="color: var(--admin-primary);"></i> Bulk Import Embroidery Designs
          </h3>
          <span style="font-size: 0.78rem; color: var(--admin-text-muted);">Safe, 3-step chunked import supporting up to 3,000 designs with zero timeouts</span>
        </div>
        <button type="button" onclick="closeBulkImportModal()" style="background: none; border: none; font-size: 1.5rem; color: var(--admin-text-muted); cursor: pointer; line-height: 1;">&times;</button>
      </div>

      <!-- Stepper Indicator -->
      <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 8px;">
        <div id="stepTab1" style="padding: 8px 12px; border-radius: 8px; background: var(--admin-primary); color: #FFF; font-size: 0.78rem; font-weight: 700; display: flex; align-items: center; gap: 6px;">
          <span style="background: rgba(255,255,255,0.25); border-radius: 50%; width: 20px; height: 20px; display: inline-flex; align-items: center; justify-content: center; font-size: 0.72rem;">1</span>
          Spreadsheet Data
        </div>
        <div id="stepTab2" style="padding: 8px 12px; border-radius: 8px; background: #ECEFF1; color: #546E7A; font-size: 0.78rem; font-weight: 700; display: flex; align-items: center; gap: 6px;">
          <span style="background: rgba(0,0,0,0.1); border-radius: 50%; width: 20px; height: 20px; display: inline-flex; align-items: center; justify-content: center; font-size: 0.72rem;">2</span>
          Assets & Matching
        </div>
        <div id="stepTab3" style="padding: 8px 12px; border-radius: 8px; background: #ECEFF1; color: #546E7A; font-size: 0.78rem; font-weight: 700; display: flex; align-items: center; gap: 6px;">
          <span style="background: rgba(0,0,0,0.1); border-radius: 50%; width: 20px; height: 20px; display: inline-flex; align-items: center; justify-content: center; font-size: 0.72rem;">3</span>
          Confirm & Import
        </div>
      </div>
    </div>

    <!-- Modal Body -->
    <div style="padding: 1.6rem; overflow-y: auto; flex: 1;">
      
      <!-- Error Banner -->
      <div id="importErrorAlert" style="display: none; background: #FFEBEE; border: 1px solid #FFCDD2; color: #C62828; padding: 0.9rem 1.2rem; border-radius: 10px; margin-bottom: 1.2rem; font-size: 0.85rem;">
        <div style="display: flex; gap: 8px; align-items: flex-start;">
          <i class="fa-solid fa-triangle-exclamation" style="font-size: 1.1rem; margin-top: 2px;"></i>
          <div style="flex: 1;" id="importErrorMessage"></div>
          <button type="button" onclick="document.getElementById('importErrorAlert').style.display='none'" style="background:none;border:none;color:#C62828;cursor:pointer;font-size:1.1rem;">&times;</button>
        </div>
      </div>

      <!-- ================= STEP 1: SPREADSHEET ================= -->
      <div id="step1View">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.2rem; background: #E3F2FD; border: 1px solid #BBDEFB; padding: 0.9rem 1.2rem; border-radius: 12px; color: #0D47A1;">
          <div style="font-size: 0.82rem; font-weight: 600;">
            <i class="fa-solid fa-download"></i> Use the official template for 100% reliable column matching.
          </div>
          <a href="/admin/designs/import-template" class="btn btn-outline btn-sm" style="background: #FFF; color: #0D47A1; border-color: #0D47A1; font-size: 0.78rem; border-radius: 8px; text-decoration: none; font-weight: 700;">
            <i class="fa-solid fa-file-excel"></i> Download Excel Template (.xlsx)
          </a>
        </div>

        <div style="border: 2px dashed var(--admin-primary); border-radius: 14px; padding: 2.2rem 1.5rem; text-align: center; background: #FAF0E8; margin-bottom: 1.2rem;">
          <i class="fa-solid fa-file-excel" style="font-size: 2.8rem; color: var(--admin-primary); margin-bottom: 0.6rem;"></i>
          <h4 style="font-size: 1rem; color: var(--admin-text-dark); margin: 0 0 6px; font-weight: 700;">Select Spreadsheet File</h4>
          <p style="font-size: 0.8rem; color: var(--admin-text-muted); margin: 0 0 1.2rem;">Upload your product catalog sheet (.xlsx, .xls, .csv). Assets are uploaded separately in Step 2.</p>
          <input type="file" id="step1SpreadsheetInput" accept=".xlsx,.xls,.csv" style="font-size: 0.85rem; max-width: 320px; display: inline-block;">
        </div>

        <div style="background: #F8F9FA; border-radius: 10px; padding: 1rem 1.2rem; font-size: 0.78rem; color: var(--admin-text-muted); line-height: 1.5;">
          <strong style="color: var(--admin-text-dark); display: block; margin-bottom: 4px;"><i class="fa-solid fa-circle-info"></i> Column Checklist:</strong>
          <span>Required: <code>Design Name</code>, <code>MRP (Original Price)</code>, <code>Selling Price</code>. Optional: <code>SKU</code>, <code>Category</code>, <code>Available Formats</code>, <code>Description</code>, <code>Tags</code>, <code>Status</code>, <code>Preview Image Filename</code>, <code>Machine ZIP Filename</code>.</span>
        </div>
      </div>

      <!-- ================= STEP 2: ASSETS & MATCHING ================= -->
      <div id="step2View" style="display: none;">
        <!-- Validation Summary Pills -->
        <div id="step2SummaryPills" style="display: flex; gap: 12px; margin-bottom: 1.2rem; flex-wrap: wrap;"></div>

        <!-- Spreadsheet Preview Table (collapsible/scrollable) -->
        <div style="border: 1px solid var(--admin-border); border-radius: 10px; margin-bottom: 1.4rem; overflow: hidden;">
          <div style="background: #FAF6F0; padding: 8px 14px; font-size: 0.8rem; font-weight: 700; color: var(--admin-text-dark); border-bottom: 1px solid var(--admin-border); display: flex; justify-content: space-between; align-items: center;">
            <span>Spreadsheet Row Preview (First 50 Rows)</span>
            <span id="previewRowsCountBadge" style="font-size: 0.74rem; color: var(--admin-text-muted);"></span>
          </div>
          <div style="max-height: 220px; overflow-y: auto;">
            <table class="admin-table" style="font-size: 0.76rem; margin: 0;">
              <thead>
                <tr style="background: #F5F0EB; position: sticky; top: 0; z-index: 5;">
                  <th style="width: 45px;">Row</th>
                  <th style="width: 80px;">Status</th>
                  <th>SKU</th>
                  <th>Design Name</th>
                  <th>Category</th>
                  <th>MRP / Sale</th>
                  <th>Validation Note</th>
                </tr>
              </thead>
              <tbody id="step2PreviewTbody"></tbody>
            </table>
          </div>
        </div>

        <!-- Asset Upload Section -->
        <div style="border: 1px solid #C8E6C9; background: #F1F8E9; border-radius: 12px; padding: 1.2rem; margin-bottom: 1.2rem;">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
            <strong style="font-size: 0.88rem; color: #2E7D32;">
              <i class="fa-solid fa-images"></i> Upload Product Assets (Chunked in Batches of 8)
            </strong>
            <span style="font-size: 0.74rem; color: #558B2F;">Uploads up to 3 parallel requests with retry & resume</span>
          </div>
          <p style="font-size: 0.78rem; color: #33691E; margin: 0 0 10px;">
            Select all your preview images (e.g. <code>AED-BLO-01.jpg</code>) and machine ZIP files (e.g. <code>AED-BLO-01.zip</code>). The system matches them to rows by SKU.
          </p>

          <div style="display: flex; gap: 10px; align-items: center; flex-wrap: wrap;">
            <input type="file" id="step2AssetFilesInput" multiple accept=".zip,.dst,.pes,.jef,.exp,.jpg,.jpeg,.png,.webp" style="font-size: 0.82rem; flex: 1;">
            <button type="button" id="startAssetUploadBtn" onclick="startChunkedAssetUpload()" class="btn btn-primary btn-sm" style="background: #2E7D32; border-color: #2E7D32; font-weight: 700; border-radius: 8px;">
              <i class="fa-solid fa-cloud-arrow-up"></i> Upload Selected Assets
            </button>
            <button type="button" id="cancelAssetUploadBtn" onclick="cancelAssetUpload()" class="btn btn-outline btn-sm" style="display: none; border-radius: 8px;">
              Cancel Upload
            </button>
          </div>

          <!-- Asset Upload Progress Bar -->
          <div id="assetUploadProgressContainer" style="display: none; margin-top: 12px;">
            <div style="display: flex; justify-content: space-between; font-size: 0.76rem; font-weight: 600; color: #2E7D32; margin-bottom: 4px;">
              <span id="assetUploadStatusText">Uploading batch 1...</span>
              <span id="assetUploadPercentText">0%</span>
            </div>
            <div style="width: 100%; height: 8px; background: #DCEDC8; border-radius: 4px; overflow: hidden;">
              <div id="assetProgressBar" style="width: 0%; height: 100%; background: #2E7D32; transition: width 0.25s ease;"></div>
            </div>
          </div>

          <!-- Asset Match Report Card -->
          <div id="assetMatchReportCard" style="display: none; margin-top: 12px; background: #FFF; border: 1px solid #C8E6C9; border-radius: 8px; padding: 10px 14px; font-size: 0.78rem;">
            <div style="display: flex; gap: 16px; flex-wrap: wrap; font-weight: 600;">
              <span style="color: #2E7D32;"><i class="fa-solid fa-circle-check"></i> Matched Images: <strong id="matchedImagesCount">0</strong></span>
              <span style="color: #1565C0;"><i class="fa-solid fa-file-zipper"></i> Matched ZIPs: <strong id="matchedFilesCount">0</strong></span>
              <span style="color: #E65100;"><i class="fa-solid fa-triangle-exclamation"></i> Unmatched Files: <strong id="unmatchedCount">0</strong></span>
            </div>
          </div>
        </div>
      </div>

      <!-- ================= STEP 3: CONFIRM & LIVE PROGRESS ================= -->
      <div id="step3View" style="display: none;">
        <!-- Pre-import confirmation checklist -->
        <div id="step3ConfirmBox" style="background: #FAF6F0; border: 1px solid var(--admin-border); border-radius: 12px; padding: 1.4rem; margin-bottom: 1.2rem;">
          <h4 style="font-size: 0.95rem; font-weight: 700; color: var(--admin-text-dark); margin: 0 0 10px;">
            Import Options & Safety Controls
          </h4>
          <div style="display: flex; flex-direction: column; gap: 10px;">
            <label style="font-size: 0.82rem; font-weight: 600; color: var(--admin-text-dark); cursor: pointer; display: flex; align-items: center; gap: 8px;">
              <input type="checkbox" id="skipErrorsCheckbox" checked>
              <span>Skip invalid rows with errors automatically (recommended)</span>
            </label>
            <label style="font-size: 0.82rem; font-weight: 600; color: #C62828; cursor: pointer; display: flex; align-items: center; gap: 8px;">
              <input type="checkbox" id="updateExistingCheckbox">
              <span>Update existing designs by SKU (if unticked, existing SKUs are skipped safely)</span>
            </label>
          </div>
        </div>

        <!-- Live Progress Section -->
        <div id="step3ProgressBox" style="display: none; background: #FFF; border: 1px solid var(--admin-border); border-radius: 12px; padding: 1.5rem; text-align: center;">
          <div style="font-size: 1.1rem; font-weight: 700; color: var(--admin-text-dark); margin-bottom: 8px;" id="importLiveStatusTitle">
            <i class="fa-solid fa-spinner fa-spin" style="color: var(--admin-primary);"></i> Importing Designs in Background...
          </div>
          <p style="font-size: 0.82rem; color: var(--admin-text-muted); margin: 0 0 14px;" id="importLiveStatusSub">
            0 / 0 rows processed
          </p>

          <div style="width: 100%; height: 12px; background: #ECEFF1; border-radius: 6px; overflow: hidden; margin-bottom: 14px;">
            <div id="importLiveProgressBar" style="width: 0%; height: 100%; background: var(--admin-primary); transition: width 0.3s ease;"></div>
          </div>

          <div style="display: flex; justify-content: center; gap: 20px; font-size: 0.8rem; font-weight: 600;">
            <span style="color: #2E7D32;">Imported: <strong id="liveImportedCount">0</strong></span>
            <span style="color: #F57C00;">Skipped: <strong id="liveSkippedCount">0</strong></span>
            <span style="color: #C62828;">Failed: <strong id="liveFailedCount">0</strong></span>
          </div>
        </div>

        <!-- Post-Import Result Summary Card -->
        <div id="step3ResultCard" style="display: none; background: #E8F5E9; border: 1px solid #A5D6A7; border-radius: 12px; padding: 1.4rem; margin-top: 1.2rem;">
          <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; flex-wrap: wrap; gap: 10px;">
            <strong style="font-size: 1rem; color: #1B5E20;">
              <i class="fa-solid fa-circle-check"></i> Import Job Finished!
            </strong>
            <div style="display: flex; gap: 8px;">
              <a id="downloadErrorReportBtn" href="#" class="btn btn-outline btn-sm" style="background: #FFF; border-color: #D32F2F; color: #D32F2F; font-size: 0.78rem; border-radius: 8px; text-decoration: none; font-weight: 600;">
                <i class="fa-solid fa-file-csv"></i> Download Error Report (CSV)
              </a>
              <button type="button" id="rollbackJobBtn" onclick="rollbackCurrentImport()" class="btn btn-outline btn-sm" style="background: #FFF; border-color: #C2185B; color: #C2185B; font-size: 0.78rem; border-radius: 8px; font-weight: 600;">
                <i class="fa-solid fa-rotate-left"></i> Rollback this Import
              </button>
            </div>
          </div>
          <div style="font-size: 0.82rem; color: #2E7D32;" id="step3ResultSummaryText"></div>
        </div>
      </div>

    </div>

    <!-- Modal Footer Navigation -->
    <div style="padding: 1rem 1.6rem; border-top: 1px solid var(--admin-border); display: flex; justify-content: space-between; align-items: center; background: #FAF6F0;">
      <button type="button" onclick="closeBulkImportModal()" class="btn btn-outline" style="border-radius: 8px; font-size: 0.85rem; background: #FFF;">
        Cancel / Close
      </button>

      <div style="display: flex; gap: 10px;">
        <button type="button" id="step1NextBtn" onclick="submitStep1Spreadsheet()" class="btn btn-primary" style="border-radius: 8px; font-size: 0.85rem; font-weight: 700; padding: 0.6rem 1.4rem;">
          Parse Spreadsheet <i class="fa-solid fa-arrow-right"></i>
        </button>

        <button type="button" id="step2NextBtn" onclick="goToStep3()" class="btn btn-primary" style="display: none; border-radius: 8px; font-size: 0.85rem; font-weight: 700; padding: 0.6rem 1.4rem;">
          Continue to Confirm <i class="fa-solid fa-arrow-right"></i>
        </button>

        <button type="button" id="step3StartBtn" onclick="submitStep3StartJob()" class="btn btn-primary" style="display: none; border-radius: 8px; font-size: 0.85rem; font-weight: 700; padding: 0.6rem 1.6rem; background: #2E7D32; border-color: #2E7D32;">
          <i class="fa-solid fa-rocket"></i> Start Background Import
        </button>

        <button type="button" id="finishRefreshBtn" onclick="finishAndReload()" class="btn btn-primary" style="display: none; border-radius: 8px; font-size: 0.85rem; font-weight: 700; padding: 0.6rem 1.6rem; background: #1B5E20; border-color: #1B5E20;">
          <i class="fa-solid fa-check-double"></i> Finish & Refresh Catalog
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Bulk import and design actions handled by /public/js/admin/designs.js -->

<!-- Replace Image Modal Component -->
<div id="replaceImageModal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.55); z-index: 99999; align-items: center; justify-content: center; backdrop-filter: blur(2px);">
  <div style="background: #FFFFFF; border-radius: 16px; width: 90%; max-width: 480px; box-shadow: 0 20px 40px rgba(0,0,0,0.2); overflow: hidden;">
    <div style="padding: 1.25rem 1.5rem; background: #FAF6F0; border-bottom: 1px solid var(--admin-border); display: flex; align-items: center; justify-content: space-between;">
      <h3 style="margin: 0; font-size: 1.05rem; color: var(--admin-text-dark); display: flex; align-items: center; gap: 8px;">
        <i class="fa-solid fa-image" style="color: var(--admin-primary);"></i> Replace Product Image
      </h3>
      <button type="button" onclick="closeReplaceImageModal()" style="background: none; border: none; font-size: 1.3rem; color: var(--admin-text-muted); cursor: pointer;">&times;</button>
    </div>
    <form id="replaceImageForm" onsubmit="submitReplaceImage(event)" enctype="multipart/form-data" style="padding: 1.5rem;">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" id="replaceImageDesignId" name="designId">
      
      <p id="replaceImageTitle" style="font-size: 0.88rem; color: var(--admin-text-dark); font-weight: 600; margin-bottom: 1.2rem;"></p>
      
      <div style="margin-bottom: 1.2rem;">
        <label style="display: block; font-size: 0.8rem; font-weight: 600; color: var(--admin-text-dark); margin-bottom: 6px;">Select New Image (PNG, JPG, WEBP)</label>
        <input type="file" id="replaceImageFileInput" name="image" accept=".png,.jpg,.jpeg,.webp,.avif" required onchange="previewSelectedReplaceImage(this)" style="display: block; width: 100%; padding: 8px; border: 1px solid var(--admin-border); border-radius: 8px; font-size: 0.85rem;">
      </div>

      <div id="replaceImagePreviewContainer" style="display: none; margin-bottom: 1.2rem; text-align: center;">
        <img id="replaceImagePreviewImg" src="" alt="Preview" style="max-width: 140px; max-height: 140px; border-radius: 8px; border: 1px solid var(--admin-border); object-fit: contain; background: #FAF6F0;">
      </div>

      <div style="display: flex; gap: 10px; justify-content: flex-end;">
        <button type="button" onclick="closeReplaceImageModal()" style="padding: 8px 16px; border-radius: 8px; border: 1px solid var(--admin-border); background: #FFFFFF; color: var(--admin-text-dark); font-size: 0.85rem; font-weight: 600; cursor: pointer;">Cancel</button>
        <button type="submit" id="replaceImageSubmitBtn" style="padding: 8px 20px; border-radius: 8px; border: none; background: var(--admin-primary); color: #FFFFFF; font-size: 0.85rem; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 6px;">
          <i class="fa-solid fa-cloud-arrow-up"></i> Upload & Replace
        </button>
      </div>
    </form>
  </div>
</div>

<!-- Bulk Image Upload Modal Component -->
<!-- Bulk Image Upload Modal Component (Reliable Chunked Upload Engine) -->
<div id="bulkImageUploadModal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.6); z-index: 99999; align-items: center; justify-content: center; backdrop-filter: blur(4px); padding: 1rem;">
  <div style="background: #FFFFFF; border-radius: 16px; width: 100%; max-width: 680px; max-height: 92vh; display: flex; flex-direction: column; box-shadow: 0 25px 50px rgba(0,0,0,0.25); overflow: hidden; border: 1px solid var(--admin-border);">
    
    <!-- Modal Header -->
    <div style="padding: 1.1rem 1.5rem; background: #FAF6F0; border-bottom: 1px solid var(--admin-border); display: flex; align-items: center; justify-content: space-between; flex-shrink: 0;">
      <h3 style="margin: 0; font-size: 1.1rem; color: var(--admin-text-dark); display: flex; align-items: center; gap: 10px; font-weight: 700;">
        <i class="fa-solid fa-images" style="color: var(--admin-primary);"></i> Bulk Restore / Re-upload Images
      </h3>
      <button type="button" onclick="closeBulkImageUploadModal()" style="background: none; border: none; font-size: 1.5rem; color: var(--admin-text-muted); cursor: pointer; line-height: 1; padding: 0 4px;" title="Close Modal">&times;</button>
    </div>

    <!-- Modal Body (Scrollable) -->
    <div style="padding: 1.5rem; overflow-y: auto; flex: 1; display: flex; flex-direction: column; gap: 1.2rem;">
      
      <!-- Matching Rules Guide Banner -->
      <div style="background: #F1F8E9; border: 1px solid #C5E1A5; border-radius: 10px; padding: 12px 14px; font-size: 0.82rem; color: #33691E; line-height: 1.45;">
        <div style="font-weight: 700; margin-bottom: 4px; display: flex; align-items: center; gap: 6px;">
          <i class="fa-solid fa-circle-info"></i> How Automatic Matching Works:
        </div>
        <div>
          Name files after product <strong>SKU</strong> (e.g. <code>AED-BLO-01.png</code>, <code>AED 1.png</code>), <strong>Product ID</strong> (e.g. <code>1.png</code>), or <strong>Title/Slug</strong>. Files are uploaded in reliable <strong>5-image chunks</strong> (up to 3 parallel requests) to avoid Hostinger timeouts.
        </div>
      </div>

      <!-- File Picker & Dropzone -->
      <div id="bulkImageFileSelectSection">
        <label style="display: block; font-size: 0.85rem; font-weight: 600; color: var(--admin-text-dark); margin-bottom: 6px;">
          Select Image Files (JPG, PNG, WEBP, AVIF — max 10MB per file)
        </label>
        <div style="border: 2px dashed var(--admin-border); border-radius: 12px; padding: 1.25rem; text-align: center; background: #FAF9F6; transition: border-color 0.2s;" id="bulkImageDropArea">
          <i class="fa-solid fa-cloud-arrow-up" style="font-size: 2rem; color: var(--admin-primary); margin-bottom: 8px;"></i>
          <p style="margin: 0 0 8px 0; font-size: 0.88rem; color: var(--admin-text-dark); font-weight: 600;">
            Click to browse or drag & drop image files here
          </p>
          <p style="margin: 0 0 12px 0; font-size: 0.78rem; color: var(--admin-text-muted);">
            Multiple files supported (e.g. 5, 102, or 500 images)
          </p>
          <input type="file" id="bulkImageFilesInput" name="images" accept=".png,.jpg,.jpeg,.webp,.avif" multiple onchange="handleBulkImageFilesSelected(this)" style="display: inline-block; font-size: 0.85rem; max-width: 320px;">
        </div>

        <!-- Optional Client Compression Toggle -->
        <div style="margin-top: 10px; display: flex; align-items: center; gap: 8px; font-size: 0.82rem; color: var(--admin-text-dark);">
          <input type="checkbox" id="bulkImageOptimizeToggle" checked style="cursor: pointer; width: 16px; height: 16px;">
          <label for="bulkImageOptimizeToggle" style="cursor: pointer; user-select: none;">
            <strong>Optimize images in browser before upload</strong> (resize > 1600px, 85% WebP/JPEG quality)
          </label>
        </div>
      </div>

      <!-- Pre-upload File Summary -->
      <div id="bulkImagePreUploadSummary" style="display: none; background: #FFFFFF; border: 1px solid var(--admin-border); border-radius: 10px; padding: 12px 14px; font-size: 0.83rem;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
          <span style="font-weight: 600; color: var(--admin-text-dark);">
            <i class="fa-solid fa-layer-group" style="color: var(--admin-primary);"></i> Selected: <span id="bulkPreSelectedCount">0</span> files (<span id="bulkPreSelectedSize">0 MB</span>)
          </span>
          <span id="bulkPreBatchesCount" style="color: var(--admin-text-muted); font-size: 0.78rem;">0 batches planned</span>
        </div>
        <div id="bulkPreValidationWarnings" style="display: none; margin-top: 8px; padding: 8px 10px; background: #FFF3E0; border: 1px solid #FFE0B2; border-radius: 6px; color: #E65100; font-size: 0.78rem;"></div>
      </div>

      <!-- Live Progress & Batch Status Section -->
      <div id="bulkImageProgressSection" style="display: none; background: #FFFFFF; border: 1px solid var(--admin-border); border-radius: 12px; padding: 1.25rem;">
        <!-- Animated Progress Bar -->
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px; font-size: 0.88rem; font-weight: 700; color: var(--admin-text-dark);">
          <span id="bulkImageProgressCounter">0 / 0 uploaded (0%)</span>
          <span id="bulkImageStatusBadge" style="font-size: 0.78rem; font-weight: 600; color: var(--admin-primary);">
            <i class="fa-solid fa-spinner fa-spin"></i> Processing...
          </span>
        </div>

        <div style="height: 12px; background: #ECEFF1; border-radius: 6px; overflow: hidden; margin-bottom: 12px; position: relative;">
          <div id="bulkImageProgressBar" style="height: 100%; width: 0%; background: linear-gradient(90deg, #B8402A, #E65100); border-radius: 6px; transition: width 0.25s ease;"></div>
        </div>

        <!-- Metric Counter Badges -->
        <div style="display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 12px; font-size: 0.8rem;">
          <div style="flex: 1; min-width: 110px; background: #E8F5E9; border: 1px solid #C8E6C9; border-radius: 8px; padding: 6px 10px; display: flex; align-items: center; justify-content: space-between;">
            <span style="color: #2E7D32; font-weight: 600;"><i class="fa-solid fa-link"></i> Linked</span>
            <strong id="bulkLinkedCount" style="color: #1B5E20; font-size: 0.95rem;">0</strong>
          </div>
          <div style="flex: 1; min-width: 110px; background: #FFF8E1; border: 1px solid #FFE082; border-radius: 8px; padding: 6px 10px; display: flex; align-items: center; justify-content: space-between;">
            <span style="color: #F57F17; font-weight: 600;"><i class="fa-solid fa-question"></i> Unmatched</span>
            <strong id="bulkUnmatchedCount" style="color: #E65100; font-size: 0.95rem;">0</strong>
          </div>
          <div style="flex: 1; min-width: 110px; background: #FFEBEE; border: 1px solid #FFCDD2; border-radius: 8px; padding: 6px 10px; display: flex; align-items: center; justify-content: space-between;">
            <span style="color: #C62828; font-weight: 600;"><i class="fa-solid fa-triangle-exclamation"></i> Failed</span>
            <strong id="bulkFailedCount" style="color: #B71C1C; font-size: 0.95rem;">0</strong>
          </div>
        </div>

        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
          <span style="font-size: 0.8rem; font-weight: 600; color: var(--admin-text-dark);">
            Per-File Status Log
          </span>
          <span id="bulkActiveWorkersText" style="font-size: 0.75rem; color: var(--admin-text-muted);">
            Active streams: 0 / 3
          </span>
        </div>

        <!-- Scrollable Per-File Live Status List -->
        <div id="bulkImageLiveList" style="max-height: 220px; overflow-y: auto; border: 1px solid var(--admin-border); border-radius: 8px; background: #FAFAFA; padding: 6px 8px; font-size: 0.8rem; display: flex; flex-direction: column; gap: 4px;">
          <!-- Dynamically populated -->
        </div>
      </div>

      <!-- Completion Report Card -->
      <div id="bulkImageReportCard" style="display: none; background: #FFFFFF; border: 1px solid var(--admin-border); border-radius: 12px; padding: 1.25rem;">
        <div id="bulkImageReportHeader" style="font-weight: 700; font-size: 0.95rem; margin-bottom: 8px; display: flex; align-items: center; gap: 8px;">
          <i class="fa-solid fa-circle-check" style="color: #2E7D32; font-size: 1.2rem;"></i> Upload Complete
        </div>
        <p id="bulkImageReportSummaryText" style="margin: 0 0 12px 0; font-size: 0.84rem; color: var(--admin-text-dark); line-height: 1.45;">
          All batches finished processing.
        </p>

        <!-- Unmatched list details if any -->
        <div id="bulkUnmatchedDetailsBox" style="display: none; margin-bottom: 12px; background: #FFF8E1; border: 1px solid #FFE082; border-radius: 8px; padding: 10px; font-size: 0.78rem;">
          <strong><i class="fa-solid fa-circle-info"></i> Unmatched Files:</strong>
          <div id="bulkUnmatchedNamesList" style="max-height: 90px; overflow-y: auto; margin-top: 4px; font-family: monospace; color: #5D4037;"></div>
        </div>

        <!-- Failed list details if any -->
        <div id="bulkFailedDetailsBox" style="display: none; margin-bottom: 12px; background: #FFEBEE; border: 1px solid #FFCDD2; border-radius: 8px; padding: 10px; font-size: 0.78rem;">
          <strong><i class="fa-solid fa-circle-exclamation"></i> Failed Files (with error reasons):</strong>
          <div id="bulkFailedReasonsList" style="max-height: 90px; overflow-y: auto; margin-top: 4px; font-family: monospace; color: #B71C1C;"></div>
        </div>

        <div style="display: flex; gap: 10px; flex-wrap: wrap;">
          <button type="button" onclick="downloadBulkUploadReportCsv()" class="btn btn-outline" style="height: 38px; padding: 0 14px; border-radius: 8px; font-size: 0.82rem; font-weight: 600; display: inline-flex; align-items: center; gap: 6px; cursor: pointer; border: 1px solid #1E88E5; color: #1E88E5; background: #FFF;">
            <i class="fa-solid fa-file-csv"></i> Download Report CSV
          </button>
          <button type="button" id="bulkRetryFailedBtn" onclick="retryFailedBulkImages()" class="btn" style="display: none; height: 38px; padding: 0 14px; border-radius: 8px; font-size: 0.82rem; font-weight: 600; display: inline-flex; align-items: center; gap: 6px; cursor: pointer; background: #C62828; color: #FFF; border: none;">
            <i class="fa-solid fa-rotate-right"></i> Retry Failed (<span id="bulkRetryBtnCount">0</span>)
          </button>
        </div>
      </div>

    </div>

    <!-- Modal Footer Controls -->
    <div style="padding: 1.1rem 1.5rem; background: #FAF6F0; border-top: 1px solid var(--admin-border); display: flex; align-items: center; justify-content: space-between; flex-shrink: 0; gap: 10px;">
      <div>
        <button type="button" id="bulkImageAbortBtn" onclick="abortBulkImageUpload()" style="display: none; padding: 8px 16px; border-radius: 8px; border: 1px solid #FFCDD2; background: #FFEBEE; color: #C62828; font-size: 0.85rem; font-weight: 600; cursor: pointer;">
          <i class="fa-solid fa-ban"></i> Cancel Upload
        </button>
      </div>

      <div style="display: flex; gap: 10px; align-items: center;">
        <button type="button" id="bulkImageCancelCloseBtn" onclick="closeBulkImageUploadModal()" style="padding: 8px 16px; border-radius: 8px; border: 1px solid var(--admin-border); background: #FFFFFF; color: var(--admin-text-dark); font-size: 0.85rem; font-weight: 600; cursor: pointer;">
          Cancel
        </button>
        <button type="button" id="bulkImageSubmitBtn" onclick="startChunkedBulkImageUpload()" style="padding: 8px 20px; border-radius: 8px; border: none; background: var(--admin-primary); color: #FFFFFF; font-size: 0.85rem; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 6px;">
          <i class="fa-solid fa-cloud-arrow-up"></i> Start Chunked Upload
        </button>
        <button type="button" id="bulkImageFinishRefreshBtn" onclick="finishBulkUploadAndRefresh()" style="display: none; padding: 8px 20px; border-radius: 8px; border: none; background: #2E7D32; color: #FFFFFF; font-size: 0.85rem; font-weight: 600; cursor: pointer;">
          <i class="fa-solid fa-check"></i> Done & Refresh Designs
        </button>
      </div>
    </div>

  </div>
</div>
<script>
  window.CSRF_TOKEN = '<%= csrfToken %>';
</script>
<script src="/public/js/admin/designs.js"></script>
<script src="/public/js/sort-dropdown.js"></script>
</body>
</html>
