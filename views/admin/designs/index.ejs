      <div id="bulkZipFileSelectSection">
        <label style="display: block; font-size: 0.85rem; font-weight: 600; color: var(--admin-text-dark); margin-bottom: 6px;">
          Select Machine Files (.ZIP, .RAR, .DST, .PES, .JEF, .EXP — configured limit: <span id="bulkZipMaxSizeLabel">100 MB</span> per file)
        </label>
        <div style="border: 2px dashed #81C784; border-radius: 12px; padding: 1.4rem; text-align: center; background: #F1F8E9; transition: border-color 0.2s;" id="bulkZipDropArea">
          <i class="fa-solid fa-file-zipper" style="font-size: 2.2rem; color: #2E7D32; margin-bottom: 8px;"></i>
          <p style="margin: 0 0 8px 0; font-size: 0.88rem; color: var(--admin-text-dark); font-weight: 600;">
            Click to browse or drag & drop machine files/archives here
          </p>
          <p style="margin: 0 0 12px 0; font-size: 0.78rem; color: var(--admin-text-muted);">
            Multiple files supported (e.g. 5, 50, or 102 ZIP packages)
          </p>
          <input type="file" id="bulkZipFilesInput" name="files" accept=".zip,.rar,.dst,.pes,.jef,.exp" multiple onchange="handleBulkZipFilesSelected(this)" style="display: inline-block; font-size: 0.85rem; max-width: 340px;">
        </div>
      </div>

      <!-- Pre-upload File Summary & Dry-Run Preview -->
      <div id="bulkZipPreUploadSummary" style="display: none; background: #FFFFFF; border: 1px solid var(--admin-border); border-radius: 10px; padding: 12px 14px; font-size: 0.83rem;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
          <span style="font-weight: 700; color: var(--admin-text-dark);">
            <i class="fa-solid fa-boxes-stacked" style="color: #2E7D32;"></i> Selected: <span id="bulkZipPreSelectedCount">0</span> files (<span id="bulkZipPreSelectedSize">0 MB</span>)
          </span>
          <span id="bulkZipPreChunkingPlan" style="color: var(--admin-text-muted); font-size: 0.78rem;">Chunking planned for files > 5MB</span>
        </div>

        <!-- Dry Run Match Preview Card -->
        <div id="bulkZipDryRunCard" style="background: #F9FBE7; border: 1px solid #E6EE9C; border-radius: 8px; padding: 10px 12px; margin-top: 6px;">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
            <strong style="color: #33691E; font-size: 0.82rem;">
              <i class="fa-solid fa-calculator"></i> Dry-Run Match Preview (Filename Check):
            </strong>
            <span id="bulkZipDryRunStatusText" style="font-size: 0.75rem; color: var(--admin-text-muted);">Checking names...</span>
          </div>
          <div style="display: flex; gap: 10px; flex-wrap: wrap; font-size: 0.78rem;">
            <span style="background: #E8F5E9; color: #1B5E20; padding: 3px 8px; border-radius: 6px; font-weight: 700;">
              <i class="fa-solid fa-check"></i> Will Link: <strong id="bulkZipDryMatchedCount">0</strong>
            </span>
            <span style="background: #FFF8E1; color: #E65100; padding: 3px 8px; border-radius: 6px; font-weight: 700;">
              <i class="fa-solid fa-question"></i> Unmatched: <strong id="bulkZipDryUnmatchedCount">0</strong>
            </span>
            <span style="background: #FFF3E0; color: #BF360C; padding: 3px 8px; border-radius: 6px; font-weight: 700;">
              <i class="fa-solid fa-code-compare"></i> Ambiguous: <strong id="bulkZipDryAmbiguousCount">0</strong>
            </span>
          </div>
          <div id="bulkZipDryRunWarning" style="display: none; margin-top: 6px; font-size: 0.75rem; color: #E65100;">
            <i class="fa-solid fa-circle-exclamation"></i> Tip: You can fix unmatched filenames now before initiating upload of large files.
          </div>
        </div>

        <div id="bulkZipPreValidationWarnings" style="display: none; margin-top: 8px; padding: 8px 10px; background: #FFEBEE; border: 1px solid #FFCDD2; border-radius: 6px; color: #C62828; font-size: 0.78rem;"></div>
      </div>

      <!-- Live Progress & Batch Status Section -->
      <div id="bulkZipProgressSection" style="display: none; background: #FFFFFF; border: 1px solid var(--admin-border); border-radius: 12px; padding: 1.25rem;">
        
        <!-- Overall Progress Counter & Status Badge -->
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px; font-size: 0.88rem; font-weight: 700; color: var(--admin-text-dark);">
          <span id="bulkZipOverallProgressCounter">0 / 0 uploaded (0%)</span>
          <span id="bulkZipStatusBadge" style="font-size: 0.78rem; font-weight: 600; color: #2E7D32;">
            <i class="fa-solid fa-spinner fa-spin"></i> Uploading...
          </span>
        </div>

        <!-- Overall Progress Bar -->
        <div style="height: 12px; background: #ECEFF1; border-radius: 6px; overflow: hidden; margin-bottom: 8px; position: relative;">
          <div id="bulkZipProgressBar" style="height: 100%; width: 0%; background: linear-gradient(90deg, #2E7D32, #43A047); border-radius: 6px; transition: width 0.25s ease;"></div>
        </div>

        <!-- Speed & ETA Estimate Indicator -->
        <div style="display: flex; justify-content: space-between; align-items: center; font-size: 0.75rem; color: var(--admin-text-muted); margin-bottom: 12px;">
          <span id="bulkZipSpeedEtaText">Calculating speed & time remaining...</span>
          <span id="bulkZipActiveStreamsText">Streams: 0 / 2</span>
        </div>

        <!-- Metric Counter Badges -->
        <div style="display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 12px; font-size: 0.8rem;">
          <div style="flex: 1; min-width: 110px; background: #E8F5E9; border: 1px solid #C8E6C9; border-radius: 8px; padding: 6px 10px; display: flex; align-items: center; justify-content: space-between;">
            <span style="color: #2E7D32; font-weight: 600;"><i class="fa-solid fa-link"></i> Linked</span>
            <strong id="bulkZipLinkedCount" style="color: #1B5E20; font-size: 0.95rem;">0</strong>
          </div>
          <div style="flex: 1; min-width: 110px; background: #FFF8E1; border: 1px solid #FFE082; border-radius: 8px; padding: 6px 10px; display: flex; align-items: center; justify-content: space-between;">
            <span style="color: #F57F17; font-weight: 600;"><i class="fa-solid fa-question"></i> Unmatched</span>
            <strong id="bulkZipUnmatchedCount" style="color: #E65100; font-size: 0.95rem;">0</strong>
          </div>
          <div style="flex: 1; min-width: 110px; background: #FFF3E0; border: 1px solid #FFE0B2; border-radius: 8px; padding: 6px 10px; display: flex; align-items: center; justify-content: space-between;">
            <span style="color: #E65100; font-weight: 600;"><i class="fa-solid fa-code-compare"></i> Ambiguous</span>
            <strong id="bulkZipAmbiguousCount" style="color: #BF360C; font-size: 0.95rem;">0</strong>
          </div>
          <div style="flex: 1; min-width: 110px; background: #FFEBEE; border: 1px solid #FFCDD2; border-radius: 8px; padding: 6px 10px; display: flex; align-items: center; justify-content: space-between;">
            <span style="color: #C62828; font-weight: 600;"><i class="fa-solid fa-triangle-exclamation"></i> Failed</span>
            <strong id="bulkZipFailedCount" style="color: #B71C1C; font-size: 0.95rem;">0</strong>
          </div>
        </div>

        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
          <span style="font-size: 0.8rem; font-weight: 600; color: var(--admin-text-dark);">
            Per-File Status Log
          </span>
          <span id="bulkZipCurrentActiveFileText" style="font-size: 0.74rem; color: #2E7D32;">
            Idle
          </span>
        </div>

        <!-- Scrollable Per-File Live Status List -->
        <div id="bulkZipLiveList" style="max-height: 220px; overflow-y: auto; border: 1px solid var(--admin-border); border-radius: 8px; background: #FAFAFA; padding: 6px 8px; font-size: 0.8rem; display: flex; flex-direction: column; gap: 4px;">
          <!-- Dynamically populated -->
        </div>
      </div>

      <!-- Completion Report Card -->
      <div id="bulkZipReportCard" style="display: none; background: #FFFFFF; border: 1px solid var(--admin-border); border-radius: 12px; padding: 1.25rem;">
        <div id="bulkZipReportHeader" style="font-weight: 700; font-size: 0.95rem; margin-bottom: 8px; display: flex; align-items: center; gap: 8px;">
          <i class="fa-solid fa-circle-check" style="color: #2E7D32; font-size: 1.2rem;"></i> Upload Complete
        </div>
        <p id="bulkZipReportSummaryText" style="margin: 0 0 12px 0; font-size: 0.84rem; color: var(--admin-text-dark); line-height: 1.45;">
          All machine files finished processing.
        </p>

        <!-- Ambiguous Matches Section -->
        <div id="bulkZipAmbiguousDetailsBox" style="display: none; margin-bottom: 12px; background: #FFF3E0; border: 1px solid #FFE0B2; border-radius: 8px; padding: 10px 12px; font-size: 0.78rem;">
          <div style="font-weight: 700; color: #BF360C; margin-bottom: 6px;">
            <i class="fa-solid fa-triangle-exclamation"></i> Ambiguous Files (Multiple products matched — pick the right one):
          </div>
          <div id="bulkZipAmbiguousList" style="max-height: 160px; overflow-y: auto; display: flex; flex-direction: column; gap: 8px;"></div>
        </div>

        <!-- Unmatched Files & Manual Linking Section -->
        <div id="bulkZipUnmatchedDetailsBox" style="display: none; margin-bottom: 12px; background: #FFF8E1; border: 1px solid #FFE082; border-radius: 8px; padding: 10px 12px; font-size: 0.78rem;">
          <div style="font-weight: 700; color: #E65100; margin-bottom: 6px;">
            <i class="fa-solid fa-circle-question"></i> Unmatched Files & Quick Link Suggestions:
          </div>
          <div id="bulkZipUnmatchedNamesList" style="max-height: 220px; overflow-y: auto; display: flex; flex-direction: column; gap: 8px;"></div>
        </div>

        <!-- Failed list details if any -->
        <div id="bulkZipFailedDetailsBox" style="display: none; margin-bottom: 12px; background: #FFEBEE; border: 1px solid #FFCDD2; border-radius: 8px; padding: 10px; font-size: 0.78rem;">
          <strong><i class="fa-solid fa-circle-exclamation"></i> Failed Files (with error reasons):</strong>
          <div id="bulkZipFailedReasonsList" style="max-height: 90px; overflow-y: auto; margin-top: 4px; font-family: monospace; color: #B71C1C;"></div>
        </div>

        <div style="display: flex; gap: 10px; flex-wrap: wrap;">
          <button type="button" onclick="downloadBulkZipUploadReportCsv()" class="btn btn-outline" style="height: 38px; padding: 0 14px; border-radius: 8px; font-size: 0.82rem; font-weight: 600; display: inline-flex; align-items: center; gap: 6px; cursor: pointer; border: 1px solid #1E88E5; color: #1E88E5; background: #FFF;">
            <i class="fa-solid fa-file-csv"></i> Download Report CSV
          </button>
          <button type="button" id="bulkZipRetryFailedBtn" onclick="retryFailedBulkZips()" class="btn" style="display: none; height: 38px; padding: 0 14px; border-radius: 8px; font-size: 0.82rem; font-weight: 600; display: inline-flex; align-items: center; gap: 6px; cursor: pointer; background: #C62828; color: #FFF; border: none;">
            <i class="fa-solid fa-rotate-right"></i> Retry Failed (<span id="bulkZipRetryBtnCount">0</span>)
          </button>
        </div>
      </div>

    </div>

    <!-- Modal Footer Controls -->
    <div style="padding: 1.1rem 1.5rem; background: #FAF6F0; border-top: 1px solid var(--admin-border); display: flex; align-items: center; justify-content: space-between; flex-shrink: 0; gap: 10px;">
      <div>
        <button type="button" id="bulkZipAbortBtn" onclick="abortBulkZipUpload()" style="display: none; padding: 8px 16px; border-radius: 8px; border: 1px solid #FFCDD2; background: #FFEBEE; color: #C62828; font-size: 0.85rem; font-weight: 600; cursor: pointer;">
          <i class="fa-solid fa-ban"></i> Cancel Upload
        </button>
      </div>

      <div style="display: flex; gap: 10px; align-items: center;">
        <button type="button" id="bulkZipCancelCloseBtn" onclick="closeBulkZipUploadModal()" style="padding: 8px 16px; border-radius: 8px; border: 1px solid var(--admin-border); background: #FFFFFF; color: var(--admin-text-dark); font-size: 0.85rem; font-weight: 600; cursor: pointer;">
          Cancel
        </button>
        <button type="button" id="bulkZipSubmitBtn" onclick="startChunkedBulkZipUpload()" style="padding: 8px 20px; border-radius: 8px; border: none; background: #2E7D32; color: #FFFFFF; font-size: 0.85rem; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 6px;">
          <i class="fa-solid fa-cloud-arrow-up"></i> Start Chunked Upload
        </button>
        <button type="button" id="bulkZipFinishRefreshBtn" onclick="finishBulkZipUploadAndRefresh()" style="display: none; padding: 8px 20px; border-radius: 8px; border: none; background: #1B5E20; color: #FFFFFF; font-size: 0.85rem; font-weight: 600; cursor: pointer;">
          <i class="fa-solid fa-check"></i> Done & Refresh Designs
        </button>
      </div>
    </div>

  </div>
</div>

<!-- Bulk Price Update Modal (Multi-step Safe Engine) -->
<div id="bulkPriceModal" style="display: none; position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0,0,0,0.65); backdrop-filter: blur(4px); z-index: 999999; align-items: center; justify-content: center; padding: 1.5rem;">
  <div style="background: #FFFFFF; border-radius: 16px; width: 100%; max-width: 980px; max-height: 94vh; display: flex; flex-direction: column; overflow: hidden; box-shadow: 0 20px 50px rgba(0,0,0,0.35);">
    
    <!-- Modal Header & Stepper -->
    <div style="padding: 1.2rem 1.6rem; border-bottom: 1px solid var(--admin-border); background: #FAF6F0; flex-shrink: 0;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
        <div>
          <h3 style="font-family: var(--font-heading); font-size: 1.3rem; font-weight: 700; color: var(--admin-text-dark); margin: 0 0 2px;">
            <i class="fa-solid fa-indian-rupee-sign" style="color: #D97706;"></i> Bulk Update Prices
          </h3>
          <span style="font-size: 0.8rem; color: var(--admin-text-muted);">
            Safely update prices across catalog in batches with instant preview, safety validation, and rollback undo
          </span>
        </div>
        <button type="button" onclick="closeBulkPriceModal()" style="background: none; border: none; font-size: 1.6rem; color: var(--admin-text-muted); cursor: pointer; line-height: 1;">&times;</button>
      </div>

      <!-- Stepper Indicator -->
      <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 8px;">
        <div id="stepPriceTab1" class="step-tab active" style="padding: 8px 12px; border-radius: 8px; background: #D97706; color: #FFF; font-size: 0.8rem; font-weight: 700; display: flex; align-items: center; gap: 8px; transition: all 0.2s;">
          <span style="background: rgba(255,255,255,0.25); border-radius: 50%; width: 22px; height: 22px; display: inline-flex; align-items: center; justify-content: center; font-size: 0.74rem;">1</span>
          1. Select Designs
        </div>
        <div id="stepPriceTab2" class="step-tab" style="padding: 8px 12px; border-radius: 8px; background: #ECEFF1; color: #546E7A; font-size: 0.8rem; font-weight: 700; display: flex; align-items: center; gap: 8px; transition: all 0.2s;">
          <span style="background: rgba(0,0,0,0.1); border-radius: 50%; width: 22px; height: 22px; display: inline-flex; align-items: center; justify-content: center; font-size: 0.74rem;">2</span>
          2. Choose Update Rule
        </div>
        <div id="stepPriceTab3" class="step-tab" style="padding: 8px 12px; border-radius: 8px; background: #ECEFF1; color: #546E7A; font-size: 0.8rem; font-weight: 700; display: flex; align-items: center; gap: 8px; transition: all 0.2s;">
          <span style="background: rgba(0,0,0,0.1); border-radius: 50%; width: 22px; height: 22px; display: inline-flex; align-items: center; justify-content: center; font-size: 0.74rem;">3</span>
          3. Preview & Confirm
        </div>
      </div>
    </div>

    <!-- Modal Body -->
    <div style="padding: 1.5rem; overflow-y: auto; flex: 1;">

      <!-- STEP 1: SELECT WHICH DESIGNS -->
      <div id="bulkPriceStep1">
        <h4 style="font-size: 1.05rem; font-weight: 700; color: var(--admin-text-dark); margin: 0 0 0.8rem;">
          Which designs do you want to update?
        </h4>

        <!-- Target Scope Options -->
        <div style="display: flex; flex-direction: column; gap: 10px; margin-bottom: 1.4rem;">
          <label style="display: flex; align-items: center; gap: 10px; padding: 12px 14px; border: 1px solid var(--admin-border); border-radius: 10px; cursor: pointer; background: #FAFAFA; transition: border-color 0.15s;">
            <input type="radio" name="priceScope" value="all" checked onchange="handlePriceScopeChange()">
            <div>
              <strong style="display: block; font-size: 0.9rem; color: var(--admin-text-dark);">All Designs</strong>
              <span style="font-size: 0.78rem; color: var(--admin-text-muted);">Apply price update across all active and draft designs in store.</span>
            </div>
          </label>

          <label id="scopeSelectedLabel" style="display: flex; align-items: center; gap: 10px; padding: 12px 14px; border: 1px solid var(--admin-border); border-radius: 10px; cursor: pointer; background: #FAFAFA; transition: border-color 0.15s;">
            <input type="radio" name="priceScope" value="selected" onchange="handlePriceScopeChange()">
            <div>
              <strong style="display: block; font-size: 0.9rem; color: var(--admin-text-dark);">
                Only Checked Table Rows (<span id="modalSelectedCount">0</span> selected)
              </strong>
              <span style="font-size: 0.78rem; color: var(--admin-text-muted);">Apply only to the rows ticked in the Manage Designs table.</span>
            </div>
          </label>

          <label style="display: flex; align-items: center; gap: 10px; padding: 12px 14px; border: 1px solid var(--admin-border); border-radius: 10px; cursor: pointer; background: #FAFAFA; transition: border-color 0.15s;">
            <input type="radio" name="priceScope" value="custom" onchange="handlePriceScopeChange()">
            <div>
              <strong style="display: block; font-size: 0.9rem; color: var(--admin-text-dark);">Filter by Category, Status, Format, Price Range, or SKU</strong>
              <span style="font-size: 0.78rem; color: var(--admin-text-muted);">Target specific subsets using combined custom rules.</span>
            </div>
          </label>
        </div>

        <!-- Custom Filter Controls (visible only when scope === 'custom') -->
        <div id="priceCustomFiltersBox" style="display: none; background: #FAF6F0; border: 1px solid var(--admin-border); border-radius: 12px; padding: 1.25rem; margin-bottom: 1.4rem;">
          
          <!-- Category Multi-Select -->
          <div style="margin-bottom: 1rem;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px;">
              <label style="font-size: 0.82rem; font-weight: 700; color: var(--admin-text-dark);">
                Category (Multi-Select):
              </label>
              <div style="font-size: 0.74rem;">
                <button type="button" onclick="toggleAllCategoryCheckboxes(true)" style="background: none; border: none; color: var(--admin-primary); font-weight: 600; cursor: pointer;">Select All</button>
                &nbsp;|&nbsp;
                <button type="button" onclick="toggleAllCategoryCheckboxes(false)" style="background: none; border: none; color: var(--admin-text-muted); cursor: pointer;">Clear</button>
              </div>
            </div>
            <div style="display: flex; flex-wrap: wrap; gap: 8px; max-height: 120px; overflow-y: auto; padding: 6px 0;">
              <% if (typeof categories !== 'undefined' && categories && categories.length > 0) { %>
                <% categories.forEach(c => { %>
                  <label style="display: inline-flex; align-items: center; gap: 5px; font-size: 0.78rem; background: #FFF; padding: 4px 10px; border-radius: 6px; border: 1px solid var(--admin-border); cursor: pointer;">
                    <input type="checkbox" class="price-cat-check" value="<%= c.id %>" onchange="debouncedFetchLiveCount()">
                    <span><%= c.name %></span>
                  </label>
                <% }) %>
              <% } %>
            </div>
          </div>

          <!-- Status & Formats Row -->
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 1rem;">
            <div>
              <label style="display: block; font-size: 0.82rem; font-weight: 700; color: var(--admin-text-dark); margin-bottom: 5px;">
                Design Status:
              </label>
              <select id="priceFilterStatus" onchange="debouncedFetchLiveCount()" style="width: 100%; height: 36px; border-radius: 8px; border: 1px solid var(--admin-border); padding: 0 10px; font-size: 0.84rem; background: #FFF;">
                <option value="all">All (Active & Draft)</option>
                <option value="active">Active Only</option>
                <option value="inactive">Draft / Inactive Only</option>
              </select>
            </div>

            <div>
              <label style="display: block; font-size: 0.82rem; font-weight: 700; color: var(--admin-text-dark); margin-bottom: 5px;">
                Embroidery Formats:
              </label>
              <div style="display: flex; gap: 8px; padding-top: 4px;">
                <% ['DST', 'PES', 'JEF', 'EXP'].forEach(fmt => { %>
                  <label style="display: inline-flex; align-items: center; gap: 4px; font-size: 0.8rem; background: #FFF; padding: 4px 8px; border-radius: 6px; border: 1px solid var(--admin-border); cursor: pointer;">
                    <input type="checkbox" class="price-fmt-check" value="<%= fmt %>" onchange="debouncedFetchLiveCount()">
                    <span><%= fmt %></span>
                  </label>
                <% }); %>
              </div>
            </div>
          </div>

          <!-- Price Range & Search/SKU Row -->
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
            <div>
              <label style="display: block; font-size: 0.82rem; font-weight: 700; color: var(--admin-text-dark); margin-bottom: 5px;">
                Current Price Range (₹):
              </label>
              <div style="display: flex; gap: 8px; align-items: center;">
                <input type="number" id="priceFilterMin" placeholder="Min ₹" min="0" oninput="debouncedFetchLiveCount()" style="width: 50%; height: 36px; border-radius: 8px; border: 1px solid var(--admin-border); padding: 0 10px; font-size: 0.84rem; background: #FFF;">
                <span style="color: var(--admin-text-muted);">-</span>
                <input type="number" id="priceFilterMax" placeholder="Max ₹" min="0" oninput="debouncedFetchLiveCount()" style="width: 50%; height: 36px; border-radius: 8px; border: 1px solid var(--admin-border); padding: 0 10px; font-size: 0.84rem; background: #FFF;">
              </div>
            </div>

            <div>
              <label style="display: block; font-size: 0.82rem; font-weight: 700; color: var(--admin-text-dark); margin-bottom: 5px;">
                SKU Range or Search Text:
              </label>
              <input type="text" id="priceFilterSkuText" placeholder="e.g. AED 1 - AED 50 or Blouse" oninput="debouncedFetchLiveCount()" style="width: 100%; height: 36px; border-radius: 8px; border: 1px solid var(--admin-border); padding: 0 10px; font-size: 0.84rem; background: #FFF;">
            </div>
          </div>

        </div>

        <!-- Live Target Count Banner -->
        <div style="background: #EFF6FF; border: 1px solid #BFDBFE; border-radius: 10px; padding: 12px 16px; display: flex; align-items: center; justify-content: space-between;">
          <div style="display: flex; align-items: center; gap: 10px; color: #1E40AF; font-size: 0.92rem; font-weight: 600;">
            <i class="fa-solid fa-calculator" style="font-size: 1.1rem;"></i>
            <span id="bulkPriceLiveCountLabel">This will update <strong id="bulkPriceLiveCountNum">...</strong> designs.</span>
          </div>
          <span class="badge" style="background: #1D4ED8; color: #FFF; font-size: 0.76rem; font-weight: 700; padding: 4px 10px; border-radius: 20px;">
            Live Target Count
          </span>
        </div>

      </div>

      <!-- STEP 2: CHOOSE THE UPDATE -->
      <div id="bulkPriceStep2" style="display: none;">
        
        <!-- Field Target Selector -->
        <div style="margin-bottom: 1.4rem;">
          <label style="display: block; font-size: 0.86rem; font-weight: 700; color: var(--admin-text-dark); margin-bottom: 8px;">
            1. Which price field(s) do you want to modify?
          </label>
          <div style="display: flex; gap: 12px; flex-wrap: wrap;">
            <label style="display: inline-flex; align-items: center; gap: 8px; padding: 8px 14px; border: 1px solid var(--admin-border); border-radius: 8px; cursor: pointer; background: #FAFAFA; font-size: 0.86rem;">
              <input type="radio" name="priceTargetField" value="sale_price" checked onchange="handleTargetFieldChange()">
              <strong>Selling Price (Discounted)</strong>
            </label>
            <label style="display: inline-flex; align-items: center; gap: 8px; padding: 8px 14px; border: 1px solid var(--admin-border); border-radius: 8px; cursor: pointer; background: #FAFAFA; font-size: 0.86rem;">
              <input type="radio" name="priceTargetField" value="price" onchange="handleTargetFieldChange()">
              <strong>MRP (Original Price)</strong>
            </label>
            <label style="display: inline-flex; align-items: center; gap: 8px; padding: 8px 14px; border: 1px solid var(--admin-border); border-radius: 8px; cursor: pointer; background: #FAFAFA; font-size: 0.86rem;">
              <input type="radio" name="priceTargetField" value="both" onchange="handleTargetFieldChange()">
              <strong>Both Selling Price & MRP</strong>
            </label>
          </div>
        </div>

        <!-- Method Selection -->
        <div style="margin-bottom: 1.4rem;">
          <label style="display: block; font-size: 0.86rem; font-weight: 700; color: var(--admin-text-dark); margin-bottom: 8px;">
            2. Choose Calculation Method:
          </label>

          <div style="display: flex; flex-direction: column; gap: 10px;">
            
            <!-- a) Fixed Price -->
            <label style="display: flex; align-items: center; justify-content: space-between; padding: 12px 14px; border: 1px solid var(--admin-border); border-radius: 10px; cursor: pointer; background: #FAFAFA;">
              <div style="display: flex; align-items: center; gap: 10px;">
                <input type="radio" name="priceMethod" value="fixed" checked onchange="handlePriceMethodChange()">
                <div>
                  <strong style="font-size: 0.88rem; color: var(--admin-text-dark);">Set a fixed price</strong>
                  <span style="display: block; font-size: 0.76rem; color: var(--admin-text-muted);">Example: Set Selling Price = ₹49 for all targeted designs</span>
                </div>
              </div>
              <div id="methodInputBoxFixed" style="display: flex; align-items: center; gap: 6px;">
                <span style="font-size: 0.88rem; font-weight: 600;">₹</span>
                <input type="number" id="fixedValInput" min="1" step="0.01" value="49" style="width: 100px; height: 34px; border-radius: 6px; border: 1px solid var(--admin-border); padding: 0 8px; font-weight: 600; font-size: 0.86rem;">
              </div>
            </label>

            <!-- b) Percentage Increase / Decrease -->
            <label style="display: flex; align-items: center; justify-content: space-between; padding: 12px 14px; border: 1px solid var(--admin-border); border-radius: 10px; cursor: pointer; background: #FAFAFA;">
              <div style="display: flex; align-items: center; gap: 10px;">
                <input type="radio" name="priceMethod" value="percentage" onchange="handlePriceMethodChange()">
                <div>
                  <strong style="font-size: 0.88rem; color: var(--admin-text-dark);">Increase / decrease by percentage</strong>
                  <span style="display: block; font-size: 0.76rem; color: var(--admin-text-muted);">Example: +10% to raise prices, or -15% for storewide sale</span>
                </div>
              </div>
              <div id="methodInputBoxPercentage" style="display: none; align-items: center; gap: 6px;">
                <input type="number" id="percentageValInput" step="0.1" value="10" placeholder="+10 or -15" style="width: 100px; height: 34px; border-radius: 6px; border: 1px solid var(--admin-border); padding: 0 8px; font-weight: 600; font-size: 0.86rem;">
                <span style="font-size: 0.88rem; font-weight: 600;">%</span>
              </div>
            </label>

            <!-- c) Amount Increase / Decrease -->
            <label style="display: flex; align-items: center; justify-content: space-between; padding: 12px 14px; border: 1px solid var(--admin-border); border-radius: 10px; cursor: pointer; background: #FAFAFA;">
              <div style="display: flex; align-items: center; gap: 10px;">
                <input type="radio" name="priceMethod" value="amount" onchange="handlePriceMethodChange()">
                <div>
                  <strong style="font-size: 0.88rem; color: var(--admin-text-dark);">Increase / decrease by flat amount</strong>
                  <span style="display: block; font-size: 0.76rem; color: var(--admin-text-muted);">Example: +₹5 or -₹10 adjustment</span>
                </div>
              </div>
              <div id="methodInputBoxAmount" style="display: none; align-items: center; gap: 6px;">
                <span style="font-size: 0.88rem; font-weight: 600;">₹</span>
                <input type="number" id="amountValInput" step="1" value="5" placeholder="+5 or -10" style="width: 100px; height: 34px; border-radius: 6px; border: 1px solid var(--admin-border); padding: 0 8px; font-weight: 600; font-size: 0.86rem;">
              </div>
            </label>

            <!-- d) Discount Off MRP -->
            <label id="methodDiscountLabel" style="display: flex; align-items: center; justify-content: space-between; padding: 12px 14px; border: 1px solid var(--admin-border); border-radius: 10px; cursor: pointer; background: #FAFAFA;">
              <div style="display: flex; align-items: center; gap: 10px;">
                <input type="radio" name="priceMethod" value="discount_off_mrp" onchange="handlePriceMethodChange()">
                <div>
                  <strong style="font-size: 0.88rem; color: var(--admin-text-dark);">Set discount % off MRP</strong>
                  <span style="display: block; font-size: 0.76rem; color: var(--admin-text-muted);">Keep original MRP and set Selling Price to X% off MRP (e.g. 20% OFF)</span>
                </div>
              </div>
              <div id="methodInputBoxDiscount" style="display: none; align-items: center; gap: 6px;">
                <input type="number" id="discountValInput" min="1" max="99" step="1" value="20" placeholder="20" style="width: 80px; height: 34px; border-radius: 6px; border: 1px solid var(--admin-border); padding: 0 8px; font-weight: 600; font-size: 0.86rem;">
                <span style="font-size: 0.88rem; font-weight: 600;">% off MRP</span>
              </div>
            </label>

            <!-- e) Upload Spreadsheet File -->
            <label style="display: flex; align-items: flex-start; justify-content: space-between; padding: 12px 14px; border: 1px solid var(--admin-border); border-radius: 10px; cursor: pointer; background: #FAFAFA;">
              <div style="display: flex; align-items: flex-start; gap: 10px;">
                <input type="radio" name="priceMethod" value="file" onchange="handlePriceMethodChange()" style="margin-top: 3px;">
                <div>
                  <strong style="font-size: 0.88rem; color: var(--admin-text-dark);">Upload CSV / XLSX Spreadsheet</strong>
                  <span style="display: block; font-size: 0.76rem; color: var(--admin-text-muted); margin-top: 2px;">
                    Set individual custom prices per design with column alias matching (SKU / Design Code, MRP, Selling Price)
                  </span>
                </div>
              </div>
              <div id="methodInputBoxFile" style="display: none; flex-direction: column; align-items: flex-end; gap: 4px;">
                <input type="file" id="priceSpreadsheetFile" accept=".csv, .xlsx, .xls" style="font-size: 0.78rem;">
                <span style="font-size: 0.7rem; color: var(--admin-text-muted);">Matches columns: SKU, MRP, Selling Price</span>
              </div>
            </label>

          </div>
        </div>

        <!-- Rounding & Min/Max Guard Controls -->
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px; background: #FAF6F0; border: 1px solid var(--admin-border); border-radius: 12px; padding: 1.25rem;">
          
          <div>
            <label style="display: block; font-size: 0.82rem; font-weight: 700; color: var(--admin-text-dark); margin-bottom: 5px;">
              Rounding Strategy:
            </label>
            <select id="priceRoundingOption" style="width: 100%; height: 36px; border-radius: 8px; border: 1px solid var(--admin-border); padding: 0 10px; font-size: 0.84rem; background: #FFF;">
              <option value="none">None (Standard 2 Decimals)</option>
              <option value="nearest_1">Nearest ₹1 (e.g. ₹50)</option>
              <option value="nearest_5">Nearest ₹5 (e.g. ₹45, ₹50)</option>
              <option value="end_with_9" selected>Psychological: End with 9 (e.g. ₹49, ₹99, ₹149)</option>
            </select>
          </div>

          <div>
            <label style="display: block; font-size: 0.82rem; font-weight: 700; color: var(--admin-text-dark); margin-bottom: 5px;">
              Safety Guards:
            </label>
            <label style="display: flex; align-items: center; gap: 6px; font-size: 0.8rem; margin-bottom: 6px; cursor: pointer;">
              <input type="checkbox" id="autoCapMrpOption" checked>
              <span>Auto-cap Selling Price to MRP if it exceeds MRP</span>
            </label>
            <label style="display: flex; align-items: center; gap: 6px; font-size: 0.8rem; cursor: pointer;">
              <input type="checkbox" id="enablePriceGuardOption" onchange="togglePriceGuardInputs()">
              <span>Apply only if result is within Min/Max limits</span>
            </label>
            <div id="priceGuardInputsRow" style="display: none; gap: 6px; margin-top: 6px; align-items: center;">
              <input type="number" id="guardMinVal" placeholder="Min ₹" min="1" style="width: 80px; height: 30px; border-radius: 6px; border: 1px solid var(--admin-border); padding: 0 6px; font-size: 0.78rem;">
              <span style="font-size: 0.78rem;">to</span>
              <input type="number" id="guardMaxVal" placeholder="Max ₹" min="1" style="width: 80px; height: 30px; border-radius: 6px; border: 1px solid var(--admin-border); padding: 0 6px; font-size: 0.78rem;">
            </div>
          </div>

        </div>

      </div>

      <!-- STEP 3: PREVIEW BEFORE APPLYING -->
      <div id="bulkPriceStep3" style="display: none;">
        
        <!-- Summary Stat Cards -->
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 10px; margin-bottom: 1.2rem;">
          <div style="background: #FAF6F0; border: 1px solid var(--admin-border); border-radius: 10px; padding: 10px 14px;">
            <span style="font-size: 0.72rem; text-transform: uppercase; color: var(--admin-text-muted); font-weight: 700;">TOTAL DESIGNS</span>
            <div id="previewTotalCount" style="font-size: 1.25rem; font-weight: 700; color: var(--admin-text-dark); margin-top: 2px;">0</div>
          </div>
          <div style="background: #FAF6F0; border: 1px solid var(--admin-border); border-radius: 10px; padding: 10px 14px;">
            <span style="font-size: 0.72rem; text-transform: uppercase; color: var(--admin-text-muted); font-weight: 700;">AVG SELLING PRICE</span>
            <div style="display: flex; align-items: baseline; gap: 6px; margin-top: 2px;">
              <span id="previewOldAvgPrice" style="font-size: 0.88rem; color: var(--admin-text-muted); text-decoration: line-through;">₹0</span>
              <span style="font-size: 0.8rem; color: var(--admin-text-muted);">→</span>
              <strong id="previewNewAvgPrice" style="font-size: 1.15rem; color: var(--admin-primary);">₹0</strong>
              <span id="previewPctChangeBadge" class="badge" style="font-size: 0.7rem; font-weight: 700; padding: 2px 6px; border-radius: 4px; background: #E8F5E9; color: #2E7D32;">+0%</span>
            </div>
          </div>
          <div style="background: #FAF6F0; border: 1px solid var(--admin-border); border-radius: 10px; padding: 10px 14px;">
            <span style="font-size: 0.72rem; text-transform: uppercase; color: var(--admin-text-muted); font-weight: 700;">READY TO UPDATE</span>
            <div id="previewValidCount" style="font-size: 1.25rem; font-weight: 700; color: #2E7D32; margin-top: 2px;">0</div>
          </div>
          <div id="previewErrorCard" style="display: none; background: #FFEBEE; border: 1px solid #FFCDD2; border-radius: 10px; padding: 10px 14px;">
            <span style="font-size: 0.72rem; text-transform: uppercase; color: #C62828; font-weight: 700;">ERRORS / INVALID</span>
            <div id="previewErrorCount" style="font-size: 1.25rem; font-weight: 700; color: #C62828; margin-top: 2px;">0</div>
          </div>
        </div>

        <!-- Filter Bar & Exclude Controls -->
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.8rem; gap: 10px; flex-wrap: wrap;">
          <div style="display: flex; gap: 8px; align-items: center;">
            <input type="text" id="previewSearchInput" placeholder="Filter preview by SKU or title..." oninput="handlePreviewFilter(this.value)" style="width: 260px; height: 34px; border-radius: 6px; border: 1px solid var(--admin-border); padding: 0 10px; font-size: 0.82rem;">
            <button type="button" onclick="excludeAllErrors()" id="excludeErrorsBtn" style="display: none; height: 34px; padding: 0 12px; border-radius: 6px; border: 1px solid #C62828; background: #FFEBEE; color: #C62828; font-size: 0.78rem; font-weight: 600; cursor: pointer;">
              <i class="fa-solid fa-filter-circle-xmark"></i> Exclude All Invalid Rows
            </button>
          </div>
          <div style="font-size: 0.78rem; color: var(--admin-text-muted);">
            Ticked rows (<strong id="previewSelectedCount">0</strong>) will be applied. Uncheck any row to exclude.
          </div>
        </div>

        <!-- Preview Table -->
        <div style="max-height: 44vh; overflow-y: auto; border: 1px solid var(--admin-border); border-radius: 10px;">
          <table style="width: 100%; border-collapse: collapse; font-size: 0.82rem;">
            <thead>
              <tr style="background: #F9FAFB; position: sticky; top: 0; z-index: 2; border-bottom: 1px solid var(--admin-border); text-align: left;">
                <th style="padding: 8px 10px; width: 36px; text-align: center;">
                  <input type="checkbox" id="previewSelectAllCheckbox" checked onchange="toggleSelectAllPreviewRows(this)">
                </th>
                <th style="padding: 8px 10px; width: 90px;">SKU</th>
                <th style="padding: 8px 10px;">Design Title</th>
                <th style="padding: 8px 10px;">Category</th>
                <th style="padding: 8px 10px; text-align: right;">Old MRP</th>
                <th style="padding: 8px 10px; text-align: right;">Old Price</th>
                <th style="padding: 8px 10px; text-align: right;">New MRP</th>
                <th style="padding: 8px 10px; text-align: right;">New Price</th>
                <th style="padding: 8px 10px; text-align: right;">Change</th>
                <th style="padding: 8px 10px; text-align: center; width: 100px;">Status</th>
              </tr>
            </thead>
            <tbody id="previewTableBody"></tbody>
          </table>
        </div>

        <div style="margin-top: 10px; font-size: 0.78rem; color: #555; background: #FFF8E1; border: 1px solid #FFE082; padding: 8px 12px; border-radius: 8px; display: flex; align-items: center; gap: 8px;">
          <i class="fa-solid fa-shield-halved" style="color: #F59E0B; font-size: 1rem;"></i>
          <span><strong>Safety Guarantee:</strong> Nothing is committed to the database until you click "Apply Price Update". All changes are recorded with full audit rollback.</span>
        </div>

      </div>

      <!-- STEP 4: APPLY PROGRESS & FINISH -->
      <div id="bulkPriceStep4" style="display: none; text-align: center; padding: 2.5rem 1rem;">
        
        <div id="bulkPriceProgressBox">
          <div style="width: 60px; height: 60px; border-radius: 50%; background: #EFF6FF; color: #2563EB; display: inline-flex; align-items: center; justify-content: center; font-size: 1.8rem; margin-bottom: 1.2rem;">
            <i class="fa-solid fa-arrows-rotate fa-spin"></i>
          </div>
          <h4 style="font-size: 1.2rem; font-weight: 700; color: var(--admin-text-dark); margin: 0 0 6px;">
            Applying Price Updates...
          </h4>
          <p id="bulkPriceProgressStatusText" style="color: var(--admin-text-muted); font-size: 0.88rem; margin: 0 0 1.5rem;">
            Updating database in safe transaction batches...
          </p>
          <div style="width: 100%; max-width: 480px; height: 10px; background: #E5E7EB; border-radius: 10px; overflow: hidden; margin: 0 auto;">
            <div id="bulkPriceProgressBar" style="width: 45%; height: 100%; background: #D97706; transition: width 0.3s;"></div>
          </div>
        </div>

        <div id="bulkPriceSuccessBox" style="display: none;">
          <div style="width: 68px; height: 68px; border-radius: 50%; background: #DCFCE7; color: #16A34A; display: inline-flex; align-items: center; justify-content: center; font-size: 2.2rem; margin-bottom: 1rem;">
            <i class="fa-solid fa-circle-check"></i>
          </div>
          <h4 style="font-size: 1.3rem; font-weight: 700; color: var(--admin-text-dark); margin: 0 0 6px;">
            Price Update Successful!
          </h4>
          <p id="bulkPriceSuccessText" style="color: var(--admin-text-dark); font-size: 0.92rem; margin: 0 0 1.5rem;">
            Updated prices for designs across catalog.
          </p>
          <div style="display: flex; justify-content: center; gap: 12px;">
            <a href="/admin/tools/price-history" class="btn btn-outline" style="height: 40px; padding: 0 1.2rem; border-radius: 8px; font-size: 0.86rem; font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; gap: 6px;">
              <i class="fa-solid fa-clock-rotate-left"></i> View Audit History
            </a>
            <button type="button" onclick="window.location.reload()" class="btn btn-primary" style="height: 40px; padding: 0 1.4rem; border-radius: 8px; font-size: 0.86rem; font-weight: 700; background: var(--admin-primary); color: #FFF; border: none; cursor: pointer;">
              Done & Refresh Designs
            </button>
          </div>
        </div>

      </div>

    </div>

    <!-- Modal Footer Controls -->
    <div id="bulkPriceFooter" style="padding: 1.1rem 1.6rem; background: #FAF6F0; border-top: 1px solid var(--admin-border); display: flex; align-items: center; justify-content: space-between; flex-shrink: 0;">
      <div>
        <button type="button" id="bulkPriceBackBtn" onclick="prevBulkPriceStep()" style="display: none; padding: 8px 16px; border-radius: 8px; border: 1px solid var(--admin-border); background: #FFF; color: var(--admin-text-dark); font-size: 0.85rem; font-weight: 600; cursor: pointer;">
          <i class="fa-solid fa-arrow-left"></i> Back
        </button>
      </div>

      <div style="display: flex; gap: 10px; align-items: center;">
        <button type="button" onclick="closeBulkPriceModal()" class="btn btn-outline" style="padding: 8px 16px; border-radius: 8px; font-size: 0.85rem; font-weight: 600;">
          Cancel
        </button>
        <button type="button" id="bulkPriceNextBtn" onclick="nextBulkPriceStep()" class="btn btn-primary" style="padding: 8px 20px; border-radius: 8px; font-size: 0.85rem; font-weight: 600; background: #D97706; color: #FFF; border: none; cursor: pointer; display: inline-flex; align-items: center; gap: 6px;">
          Next: Choose Update Rule <i class="fa-solid fa-arrow-right"></i>
        </button>
        <button type="button" id="bulkPriceApplyBtn" onclick="executeApplyPriceUpdate()" style="display: none; padding: 8px 24px; border-radius: 8px; font-size: 0.88rem; font-weight: 700; background: #16A34A; color: #FFF; border: none; cursor: pointer; display: inline-flex; align-items: center; gap: 8px;">
          <i class="fa-solid fa-check"></i> Apply Price Update
        </button>
      </div>
    </div>

  </div>
</div>

<!-- ======================================================================= -->
<!-- Bulk Stitch Count Update Modal (3-Step Safe Engine) -->
<!-- ======================================================================= -->
<div id="bulkStitchModal" style="display: none; position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0,0,0,0.65); backdrop-filter: blur(4px); z-index: 999999; align-items: center; justify-content: center; padding: 1.5rem;">
  <div style="background: #FFFFFF; border-radius: 16px; width: 100%; max-width: 980px; max-height: 94vh; display: flex; flex-direction: column; overflow: hidden; box-shadow: 0 20px 50px rgba(0,0,0,0.35);">
    
    <!-- Modal Header & Stepper -->
    <div style="padding: 1.2rem 1.6rem; border-bottom: 1px solid var(--admin-border); background: #FAF6F0; flex-shrink: 0;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
        <div>
          <h3 style="font-family: var(--font-heading); font-size: 1.3rem; font-weight: 700; color: var(--admin-text-dark); margin: 0 0 2px;">
            <i class="fa-solid fa-scissors" style="color: #6A1B9A;"></i> Bulk Update Stitch Count
          </h3>
          <span style="font-size: 0.8rem; color: var(--admin-text-muted);">
            Safely update Front, Back, Sleeve, and Total stitch counts via spreadsheet, rules, or automatic calculation with instant preview and rollback undo
          </span>
        </div>
        <button type="button" onclick="closeBulkStitchModal()" style="background: none; border: none; font-size: 1.6rem; color: var(--admin-text-muted); cursor: pointer; line-height: 1;">&times;</button>
      </div>

      <!-- Stepper Indicator -->
      <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 8px;">
        <div id="stepStitchTab1" class="step-tab active" style="padding: 8px 12px; border-radius: 8px; background: #4A148C; color: #FFF; font-size: 0.8rem; font-weight: 700; display: flex; align-items: center; gap: 8px; transition: all 0.2s;">
          <span style="background: rgba(255,255,255,0.25); border-radius: 50%; width: 22px; height: 22px; display: inline-flex; align-items: center; justify-content: center; font-size: 0.74rem;">1</span>
          1. Choose Method & Target
        </div>
        <div id="stepStitchTab2" class="step-tab" style="padding: 8px 12px; border-radius: 8px; background: #ECEFF1; color: #546E7A; font-size: 0.8rem; font-weight: 700; display: flex; align-items: center; gap: 8px; transition: all 0.2s;">
          <span style="background: rgba(0,0,0,0.1); border-radius: 50%; width: 22px; height: 22px; display: inline-flex; align-items: center; justify-content: center; font-size: 0.74rem;">2</span>
          2. Preview Changes
        </div>
        <div id="stepStitchTab3" class="step-tab" style="padding: 8px 12px; border-radius: 8px; background: #ECEFF1; color: #546E7A; font-size: 0.8rem; font-weight: 700; display: flex; align-items: center; gap: 8px; transition: all 0.2s;">
          <span style="background: rgba(0,0,0,0.1); border-radius: 50%; width: 22px; height: 22px; display: inline-flex; align-items: center; justify-content: center; font-size: 0.74rem;">3</span>
          3. Apply in Database
        </div>
      </div>
    </div>

    <!-- Modal Body -->
    <div style="padding: 1.5rem; overflow-y: auto; flex: 1;">
      <form id="bulkStitchForm" onsubmit="event.preventDefault();">

        <!-- STEP 1: METHOD & TARGET -->
        <div id="bulkStitchStep1">
          <h4 style="font-size: 1.05rem; font-weight: 700; color: var(--admin-text-dark); margin: 0 0 0.8rem;">
            Select Update Method
          </h4>

          <!-- Method Options -->
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 12px; margin-bottom: 1.5rem;">
            <label style="display: flex; gap: 12px; padding: 14px; border: 2px solid #E0E0E0; border-radius: 12px; cursor: pointer; background: #FAFAFA; transition: border-color 0.15s;" class="stitch-method-card">
              <input type="radio" name="stitchMethod" value="spreadsheet" checked onchange="handleStitchMethodChange()" style="margin-top: 3px;">
              <div>
                <strong style="display: block; font-size: 0.92rem; color: var(--admin-text-dark); margin-bottom: 2px;">
                  <i class="fa-solid fa-file-excel" style="color: #1B5E20;"></i> Upload Spreadsheet
                </strong>
                <span style="font-size: 0.78rem; color: var(--admin-text-muted);">
                  Upload .xlsx or .csv with columns: SKU, Front, Back, Sleeve, Total.
                </span>
              </div>
            </label>

            <label style="display: flex; gap: 12px; padding: 14px; border: 2px solid #E0E0E0; border-radius: 12px; cursor: pointer; background: #FAFAFA; transition: border-color 0.15s;" class="stitch-method-card">
              <input type="radio" name="stitchMethod" value="rule" onchange="handleStitchMethodChange()" style="margin-top: 3px;">
              <div>
                <strong style="display: block; font-size: 0.92rem; color: var(--admin-text-dark); margin-bottom: 2px;">
                  <i class="fa-solid fa-calculator" style="color: #6A1B9A;"></i> Apply Rule to Designs
                </strong>
                <span style="font-size: 0.78rem; color: var(--admin-text-muted);">
                  Set fixed count or increase/decrease by number/percent for chosen fields.
                </span>
              </div>
            </label>

            <label style="display: flex; gap: 12px; padding: 14px; border: 2px solid #E0E0E0; border-radius: 12px; cursor: pointer; background: #FAFAFA; transition: border-color 0.15s;" class="stitch-method-card">
              <input type="radio" name="stitchMethod" value="recalculate" onchange="handleStitchMethodChange()" style="margin-top: 3px;">
              <div>
                <strong style="display: block; font-size: 0.92rem; color: var(--admin-text-dark); margin-bottom: 2px;">
                  <i class="fa-solid fa-rotate" style="color: #0284C7;"></i> Recalculate Totals
                </strong>
                <span style="font-size: 0.78rem; color: var(--admin-text-muted);">
                  Recalculate Total = Front + Back + Sleeve across designs.
                </span>
              </div>
            </label>
          </div>

          <!-- Method A: Spreadsheet Configuration -->
          <div id="stitchMethodSpreadsheetBox" style="background: #FAF6F0; border: 1px solid var(--admin-border); border-radius: 12px; padding: 1.4rem; margin-bottom: 1.5rem;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; flex-wrap: wrap; gap: 10px;">
              <div>
                <strong style="font-size: 0.92rem; color: var(--admin-text-dark); display: block;">Select Excel or CSV File</strong>
                <span style="font-size: 0.78rem; color: var(--admin-text-muted);">Header aliases accepted: "Stitch Front", "Front Stitch", "stitch_count_front", "Back", "Sleeve", "Total", etc.</span>
              </div>
              <a href="/admin/designs/bulk-stitch/template" class="btn btn-outline btn-sm" style="background: #FFF; color: #1B5E20; border-color: #1B5E20; font-weight: 700; text-decoration: none; border-radius: 8px;">
                <i class="fa-solid fa-file-excel"></i> Download Template (.xlsx)
              </a>
            </div>

            <div style="border: 2px dashed #9C27B0; border-radius: 12px; padding: 1.5rem; text-align: center; background: #FFF; margin-bottom: 1rem;">
              <i class="fa-solid fa-cloud-arrow-up" style="font-size: 2.2rem; color: #7B1FA2; margin-bottom: 8px;"></i>
              <p style="margin: 0 0 6px 0; font-size: 0.88rem; font-weight: 600; color: var(--admin-text-dark);">
                Click to browse or drag & drop spreadsheet file
              </p>
              <p id="stitchSpreadsheetFileName" style="margin: 0 0 10px 0; font-size: 0.8rem; color: var(--admin-text-muted);">No file chosen</p>
              <input type="file" id="stitchSpreadsheetInput" accept=".xlsx,.xls,.csv" onchange="handleStitchFileSelected(this)" style="display: inline-block; font-size: 0.85rem; max-width: 320px;">
            </div>

            <!-- Empty cell behavior option -->
            <label style="display: flex; align-items: center; gap: 8px; font-size: 0.84rem; color: var(--admin-text-dark); cursor: pointer;">
              <input type="checkbox" id="treatEmptyAsClearCheckbox" style="width: 16px; height: 16px; accent-color: #6A1B9A;">
              <span><strong>Treat empty cells as clear / NULL</strong> (Default OFF: empty cells leave existing stitch values untouched)</span>
            </label>
          </div>

          <!-- Method B: Rule Configuration -->
          <div id="stitchMethodRuleBox" style="display: none; background: #FAF6F0; border: 1px solid var(--admin-border); border-radius: 12px; padding: 1.4rem; margin-bottom: 1.5rem;">
            <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 14px; margin-bottom: 1rem;">
              <div>
                <label style="display: block; font-size: 0.82rem; font-weight: 700; color: var(--admin-text-dark); margin-bottom: 6px;">Target Field</label>
                <select id="stitchRuleTargetField" style="width: 100%; height: 38px; border-radius: 8px; border: 1px solid var(--admin-border); padding: 0 10px; font-size: 0.85rem;">
                  <option value="stitch_count_front">Front Stitch Count</option>
                  <option value="stitch_count_back">Back Stitch Count</option>
                  <option value="stitch_count_sleeve">Sleeve Stitch Count</option>
                  <option value="stitch_count_total">Total Stitch Count (Manual Override)</option>
                  <option value="all">All Components (Front, Back, Sleeve)</option>
                </select>
              </div>

              <div>
                <label style="display: block; font-size: 0.82rem; font-weight: 700; color: var(--admin-text-dark); margin-bottom: 6px;">Operation</label>
                <select id="stitchRuleOperation" style="width: 100%; height: 38px; border-radius: 8px; border: 1px solid var(--admin-border); padding: 0 10px; font-size: 0.85rem;">
                  <option value="fixed">Set to Fixed Value</option>
                  <option value="increase_number">Increase by Number (+)</option>
                  <option value="decrease_number">Decrease by Number (-)</option>
                  <option value="increase_percent">Increase by Percentage (%)</option>
                  <option value="decrease_percent">Decrease by Percentage (%)</option>
                </select>
              </div>

              <div>
                <label style="display: block; font-size: 0.82rem; font-weight: 700; color: var(--admin-text-dark); margin-bottom: 6px;">Value</label>
                <input type="number" id="stitchRuleValue" min="0" max="10000000" placeholder="e.g. 12500" style="width: 100%; height: 38px; border-radius: 8px; border: 1px solid var(--admin-border); padding: 0 10px; font-size: 0.85rem;">
              </div>
            </div>
            <span style="font-size: 0.78rem; color: var(--admin-text-muted);">
              <i class="fa-solid fa-circle-info"></i> Whole numbers only (0 to 10,000,000). Total automatically recomputed unless Total itself is targeted.
            </span>
          </div>

          <!-- Method C: Recalculate Configuration -->
          <div id="stitchMethodRecalcBox" style="display: none; background: #FAF6F0; border: 1px solid var(--admin-border); border-radius: 12px; padding: 1.4rem; margin-bottom: 1.5rem;">
            <p style="font-size: 0.86rem; color: var(--admin-text-dark); margin: 0 0 10px;">
              Automatically computes <code>Total = Front + Back + Sleeve</code> for target designs. Empty values are treated as 0. If all 3 components are empty, Total remains NULL.
            </p>
            <label style="display: flex; align-items: center; gap: 8px; font-size: 0.84rem; color: var(--admin-text-dark); cursor: pointer;">
              <input type="checkbox" id="includeManualTotalsCheckbox" style="width: 16px; height: 16px; accent-color: #6A1B9A;">
              <span><strong>Include designs with manual total overrides</strong> (Default OFF: skips designs where admin manually typed total)</span>
            </label>
          </div>

          <!-- Targeting Scope Box (visible for Rule and Recalculate) -->
          <div id="stitchTargetingBox" style="display: none;">
            <h4 style="font-size: 1rem; font-weight: 700; color: var(--admin-text-dark); margin: 0 0 0.8rem;">
              Select Target Designs
            </h4>

            <div style="display: flex; flex-direction: column; gap: 10px; margin-bottom: 1.2rem;">
              <label style="display: flex; align-items: center; gap: 10px; padding: 12px 14px; border: 1px solid var(--admin-border); border-radius: 10px; cursor: pointer; background: #FAFAFA;">
                <input type="radio" name="stitchScope" value="all" checked onchange="handleStitchScopeChange()">
                <div>
                  <strong style="display: block; font-size: 0.88rem; color: var(--admin-text-dark);">All Designs</strong>
                  <span style="font-size: 0.76rem; color: var(--admin-text-muted);">Apply across entire catalog.</span>
                </div>
              </label>

              <label id="stitchScopeSelectedLabel" style="display: flex; align-items: center; gap: 10px; padding: 12px 14px; border: 1px solid var(--admin-border); border-radius: 10px; cursor: pointer; background: #FAFAFA;">
                <input type="radio" name="stitchScope" value="selected" onchange="handleStitchScopeChange()">
                <div>
                  <strong style="display: block; font-size: 0.88rem; color: var(--admin-text-dark);">
                    Only Checked Table Rows (<span id="stitchModalSelectedCount">0</span> selected)
                  </strong>
                  <span style="font-size: 0.76rem; color: var(--admin-text-muted);">Apply only to the rows ticked in the Manage Designs table.</span>
                </div>
              </label>

              <label style="display: flex; align-items: center; gap: 10px; padding: 12px 14px; border: 1px solid var(--admin-border); border-radius: 10px; cursor: pointer; background: #FAFAFA;">
                <input type="radio" name="stitchScope" value="custom" onchange="handleStitchScopeChange()">
                <div>
                  <strong style="display: block; font-size: 0.88rem; color: var(--admin-text-dark);">Filter by Category, Status, or Stitch Status</strong>
                  <span style="font-size: 0.76rem; color: var(--admin-text-muted);">Target a specific subset using filter criteria.</span>
                </div>
              </label>
            </div>

            <!-- Custom Filter Controls -->
            <div id="stitchCustomFiltersBox" style="display: none; background: #FAF6F0; border: 1px solid var(--admin-border); border-radius: 12px; padding: 1.2rem; margin-bottom: 1.2rem;">
              <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 12px;">
                <div>
                  <label style="display: block; font-size: 0.8rem; font-weight: 600; margin-bottom: 4px;">Category</label>
                  <select id="stitchFilterCategory" style="width: 100%; height: 36px; border-radius: 8px; border: 1px solid var(--admin-border); font-size: 0.82rem; padding: 0 8px;">
                    <option value="">All Categories</option>
                    <% if (categories && categories.length > 0) { %>
                      <% categories.forEach(c => { %>
                        <option value="<%= c.id %>"><%= c.name %></option>
                      <% }) %>
                    <% } %>
                  </select>
                </div>
                <div>
                  <label style="display: block; font-size: 0.8rem; font-weight: 600; margin-bottom: 4px;">Status</label>
                  <select id="stitchFilterStatus" style="width: 100%; height: 36px; border-radius: 8px; border: 1px solid var(--admin-border); font-size: 0.82rem; padding: 0 8px;">
                    <option value="all">All Status</option>
                    <option value="active">Active Only</option>
                    <option value="inactive">Inactive / Draft Only</option>
                  </select>
                </div>
                <div>
                  <label style="display: block; font-size: 0.8rem; font-weight: 600; margin-bottom: 4px;">Stitch Status</label>
                  <select id="stitchFilterStitchStatus" style="width: 100%; height: 36px; border-radius: 8px; border: 1px solid var(--admin-border); font-size: 0.82rem; padding: 0 8px;">
                    <option value="all">All</option>
                    <option value="missing">Missing Stitch Count Only</option>
                    <option value="has_stitch">Has Stitch Count</option>
                  </select>
                </div>
              </div>
            </div>
          </div>

        </div>

        <!-- STEP 2: PREVIEW CHANGES -->
        <div id="bulkStitchStep2" style="display: none;">
          <!-- Metric Badges Row -->
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 10px; margin-bottom: 1.2rem;">
            <div style="background: #FAF6F0; border: 1px solid var(--admin-border); border-radius: 10px; padding: 10px 14px; text-align: center;">
              <span style="font-size: 0.72rem; text-transform: uppercase; color: var(--admin-text-muted); font-weight: 700;">TOTAL ANALYZED</span>
              <div id="stitchPreviewTotalCount" style="font-size: 1.3rem; font-weight: 700; color: var(--admin-text-dark);">0</div>
            </div>
            <div style="background: #E8F5E9; border: 1px solid #C8E6C9; border-radius: 10px; padding: 10px 14px; text-align: center;">
              <span style="font-size: 0.72rem; text-transform: uppercase; color: #2E7D32; font-weight: 700;">WILL UPDATE</span>
              <div id="stitchPreviewValidCount" style="font-size: 1.3rem; font-weight: 700; color: #2E7D32;">0</div>
            </div>
            <div style="background: #FFEBEE; border: 1px solid #FFCDD2; border-radius: 10px; padding: 10px 14px; text-align: center;">
              <span style="font-size: 0.72rem; text-transform: uppercase; color: #C62828; font-weight: 700;">ERRORS</span>
              <div id="stitchPreviewErrorCount" style="font-size: 1.3rem; font-weight: 700; color: #C62828;">0</div>
            </div>
            <div style="background: #ECEFF1; border: 1px solid #CFD8DC; border-radius: 10px; padding: 10px 14px; text-align: center;">
              <span style="font-size: 0.72rem; text-transform: uppercase; color: #546E7A; font-weight: 700;">UNCHANGED</span>
              <div id="stitchPreviewUnchangedCount" style="font-size: 1.3rem; font-weight: 700; color: #546E7A;">0</div>
            </div>
          </div>

          <!-- Controls: Filter Pills & Search -->
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem; flex-wrap: wrap; gap: 10px;">
            <div style="display: flex; gap: 6px;">
              <button type="button" class="stitch-filter-pill active" data-filter="all" onclick="setStitchPreviewFilter('all')" style="padding: 4px 12px; border-radius: 20px; font-size: 0.78rem; font-weight: 600; border: none; background: #4A148C; color: #FFF; cursor: pointer;">All</button>
              <button type="button" class="stitch-filter-pill" data-filter="changed" onclick="setStitchPreviewFilter('changed')" style="padding: 4px 12px; border-radius: 20px; font-size: 0.78rem; font-weight: 600; border: none; background: #F5F5F5; color: #616161; cursor: pointer;">Changes Only</button>
              <button type="button" class="stitch-filter-pill" data-filter="errors" onclick="setStitchPreviewFilter('errors')" style="padding: 4px 12px; border-radius: 20px; font-size: 0.78rem; font-weight: 600; border: none; background: #F5F5F5; color: #616161; cursor: pointer;">Errors</button>
              <button type="button" class="stitch-filter-pill" data-filter="unchanged" onclick="setStitchPreviewFilter('unchanged')" style="padding: 4px 12px; border-radius: 20px; font-size: 0.78rem; font-weight: 600; border: none; background: #F5F5F5; color: #616161; cursor: pointer;">Unchanged</button>
            </div>

            <div style="display: flex; align-items: center; gap: 10px;">
              <span id="stitchExcludedNotice" style="font-size: 0.76rem; color: #C62828; font-weight: 600; display: none;"></span>
              <input type="text" placeholder="Filter preview by SKU or title..." oninput="handleStitchPreviewSearch(this.value)" style="height: 34px; padding: 0 10px; border-radius: 8px; border: 1px solid var(--admin-border); font-size: 0.82rem; width: 220px;">
            </div>
          </div>

          <!-- Preview Table Container -->
          <div style="border: 1px solid var(--admin-border); border-radius: 10px; overflow: hidden; margin-bottom: 1rem; max-height: 48vh; overflow-y: auto;">
            <table style="width: 100%; border-collapse: collapse; font-size: 0.82rem;">
              <thead>
                <tr style="background: #F9FAFB; position: sticky; top: 0; z-index: 2; border-bottom: 1px solid var(--admin-border); text-align: left;">
                  <th style="padding: 8px 10px; width: 40px; text-align: center;">Apply</th>
                  <th style="padding: 8px 10px;">Design / SKU</th>
                  <th style="padding: 8px 10px;">Front</th>
                  <th style="padding: 8px 10px;">Back</th>
                  <th style="padding: 8px 10px;">Sleeve</th>
                  <th style="padding: 8px 10px;">Total</th>
                  <th style="padding: 8px 10px; width: 90px; text-align: center;">Status</th>
                </tr>
              </thead>
              <tbody id="stitchPreviewTbody"></tbody>
            </table>
          </div>

          <!-- Pagination Bar -->
          <div style="display: flex; justify-content: space-between; align-items: center; font-size: 0.78rem; color: var(--admin-text-muted);">
            <span id="stitchPreviewPageInfo">Showing Page 1 of 1</span>
            <div style="display: flex; gap: 6px;">
              <button type="button" id="stitchPreviewPrevBtn" onclick="stitchPreviewPrevPage()" class="btn btn-outline" style="height: 28px; padding: 0 10px; font-size: 0.76rem; border-radius: 6px;">Previous</button>
              <button type="button" id="stitchPreviewNextBtn" onclick="stitchPreviewNextPage()" class="btn btn-outline" style="height: 28px; padding: 0 10px; font-size: 0.76rem; border-radius: 6px;">Next</button>
            </div>
          </div>
        </div>

        <!-- STEP 3: APPLY & LIVE PROGRESS -->
        <div id="bulkStitchStep3" style="display: none; padding: 1rem 0;">
          <div style="text-align: center; max-width: 500px; margin: 0 auto;">
            <div style="width: 64px; height: 64px; border-radius: 50%; background: #F3E5F5; color: #6A1B9A; display: inline-flex; align-items: center; justify-content: center; font-size: 1.8rem; margin-bottom: 1.2rem;">
              <i class="fa-solid fa-scissors"></i>
            </div>
            
            <h4 style="font-size: 1.2rem; font-weight: 700; color: var(--admin-text-dark); margin: 0 0 6px;">
              Applying Stitch Count Update
            </h4>
            <p id="stitchApplyProgressText" style="font-size: 0.88rem; color: var(--admin-text-muted); margin: 0 0 1.5rem;">
              Processing in single database transaction in batches of 500...
            </p>

            <!-- Progress Bar -->
            <div style="height: 12px; background: #ECEFF1; border-radius: 6px; overflow: hidden; margin-bottom: 8px; position: relative;">
              <div id="stitchApplyProgressBar" style="height: 100%; width: 10%; background: linear-gradient(90deg, #6A1B9A, #9C27B0); border-radius: 6px; transition: width 0.3s ease;"></div>
            </div>
            <div id="stitchApplyProgressPercent" style="font-size: 0.78rem; font-weight: 700; color: #6A1B9A; margin-bottom: 1.5rem;">10%</div>

            <!-- Success Box -->
            <div id="stitchApplySuccessBox" style="display: none; background: #E8F5E9; border: 1px solid #C8E6C9; border-radius: 12px; padding: 1.4rem; margin-bottom: 1.5rem;">
              <i class="fa-solid fa-circle-check" style="font-size: 2rem; color: #2E7D32; margin-bottom: 8px;"></i>
              <h5 style="font-size: 1.05rem; font-weight: 700; color: #1B5E20; margin: 0 0 6px;">Update Applied Successfully!</h5>
              <p id="stitchApplySuccessMessage" style="font-size: 0.86rem; color: #2E7D32; margin: 0 0 1.2rem;">All stitch counts updated and synchronized.</p>
              <div style="display: flex; gap: 10px; justify-content: center;">
                <a href="/admin/tools/stitch-history" class="btn btn-outline" style="height: 38px; padding: 0 14px; border-radius: 8px; font-size: 0.84rem; font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; gap: 6px;">
                  <i class="fa-solid fa-clock-rotate-left"></i> View Update History
                </a>
                <button type="button" id="stitchApplyDoneBtn" onclick="finishStitchUpdateAndRefresh()" class="btn btn-primary" style="height: 38px; padding: 0 16px; border-radius: 8px; font-size: 0.84rem; font-weight: 700; background: #2E7D32; border-color: #2E7D32; color: #FFF; cursor: pointer;">
                  Done & Refresh Designs
                </button>
              </div>
            </div>

            <!-- Error Box -->
            <div id="stitchApplyErrorBox" style="display: none; background: #FFEBEE; border: 1px solid #FFCDD2; border-radius: 12px; padding: 1.4rem; margin-bottom: 1.5rem; text-align: left;">
              <div style="display: flex; align-items: center; gap: 8px; color: #C62828; font-weight: 700; margin-bottom: 6px;">
                <i class="fa-solid fa-triangle-exclamation"></i> Transaction Failed & Rolled Back
              </div>
              <p id="stitchApplyErrorMessage" style="font-size: 0.84rem; color: #B71C1C; margin: 0 0 10px;">An error occurred.</p>
              <button type="button" onclick="stitchBackToStep1()" class="btn btn-outline btn-sm" style="border-radius: 6px;">Back to Step 1</button>
            </div>

          </div>
        </div>

      </form>
    </div>

    <!-- Modal Footers for each step -->
    <div id="stitchFooterStep1" style="padding: 1.1rem 1.6rem; background: #FAF6F0; border-top: 1px solid var(--admin-border); display: flex; align-items: center; justify-content: space-between; flex-shrink: 0;">
      <div></div>
      <div style="display: flex; gap: 10px;">
        <button type="button" onclick="closeBulkStitchModal()" class="btn btn-outline" style="padding: 8px 16px; border-radius: 8px; font-size: 0.85rem; font-weight: 600;">Cancel</button>
        <button type="button" id="stitchProceedPreviewBtn" onclick="proceedToStitchPreview()" class="btn btn-primary" style="padding: 8px 20px; border-radius: 8px; font-size: 0.85rem; font-weight: 600; background: #6A1B9A; border-color: #6A1B9A; color: #FFF; cursor: pointer; display: inline-flex; align-items: center; gap: 6px;">
          Next: Preview Changes <i class="fa-solid fa-arrow-right"></i>
        </button>
      </div>
    </div>

    <div id="stitchFooterStep2" style="display: none; padding: 1.1rem 1.6rem; background: #FAF6F0; border-top: 1px solid var(--admin-border); display: flex; align-items: center; justify-content: space-between; flex-shrink: 0;">
      <button type="button" onclick="stitchBackToStep1()" class="btn btn-outline" style="padding: 8px 16px; border-radius: 8px; font-size: 0.85rem; font-weight: 600;">
        <i class="fa-solid fa-arrow-left"></i> Back
      </button>
      <div style="display: flex; gap: 10px;">
        <button type="button" onclick="closeBulkStitchModal()" class="btn btn-outline" style="padding: 8px 16px; border-radius: 8px; font-size: 0.85rem; font-weight: 600;">Cancel</button>
        <button type="button" id="stitchProceedApplyBtn" onclick="proceedToStitchApply()" class="btn btn-primary" style="padding: 8px 24px; border-radius: 8px; font-size: 0.88rem; font-weight: 700; background: #2E7D32; border-color: #2E7D32; color: #FFF; cursor: pointer; display: inline-flex; align-items: center; gap: 8px;">
          <i class="fa-solid fa-check"></i> Apply Stitch Update
        </button>
      </div>
    </div>

    <div id="stitchFooterStep3" style="display: none; padding: 1.1rem 1.6rem; background: #FAF6F0; border-top: 1px solid var(--admin-border); display: flex; align-items: center; justify-content: flex-end; flex-shrink: 0;">
      <button type="button" onclick="closeBulkStitchModal()" class="btn btn-outline" style="padding: 8px 16px; border-radius: 8px; font-size: 0.85rem; font-weight: 600;">Close</button>
    </div>

  </div>
</div>

<!-- ============================================================== -->
<!-- MODAL: BULK REPLACE IMAGES BY CATEGORY (TASK 2)                 -->
<!-- ============================================================== -->
<div id="bulkReplaceImagesModal" style="display: none; position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0,0,0,0.65); backdrop-filter: blur(4px); -webkit-backdrop-filter: blur(4px); z-index: 999999; align-items: center; justify-content: center; padding: 1.5rem; box-sizing: border-box;" onclick="if (event.target === this) closeBulkReplaceImagesModal();">
  <div class="modal-box" style="max-width: 960px; width: 100%; max-height: 92vh; display: flex; flex-direction: column; padding: 0; border-radius: 16px; overflow: hidden; background: #FFFFFF; box-shadow: 0 25px 60px rgba(0,0,0,0.4); border: 1px solid var(--admin-border);">
    
    <!-- Modal Header & Stepper -->
    <div style="padding: 1.25rem 1.75rem; background: #FAF6F0; border-bottom: 1px solid var(--admin-border); flex-shrink: 0;">
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
        <div style="display: flex; align-items: center; gap: 10px;">
          <span style="display: inline-flex; width: 38px; height: 38px; border-radius: 10px; background: #E0F2FE; color: #0284C7; align-items: center; justify-content: center; font-size: 1.15rem;">
            <i class="fa-solid fa-arrow-right-arrow-left"></i>
          </span>
          <div>
            <h3 style="font-size: 1.2rem; font-weight: 700; color: var(--admin-text-dark); margin: 0;">Bulk Replace Images & ZIP Files by Category</h3>
            <p style="font-size: 0.8rem; color: var(--admin-text-muted); margin: 2px 0 0;">Select category & replacement folder (e.g. ARUVI BULK DESIGNS 2), preview matching products, replace images & ZIP packages with 7-day rollback</p>
          </div>
        </div>
        <button type="button" onclick="closeBulkReplaceImagesModal()" style="background: none; border: none; font-size: 1.5rem; cursor: pointer; color: var(--admin-text-muted);">&times;</button>
      </div>

      <!-- Stepper Badges -->
      <div style="display: flex; gap: 8px; flex-wrap: wrap;">
        <div id="bulkReplaceStepHeader1" class="step-pill active" style="padding: 6px 14px; border-radius: 20px; font-size: 0.78rem; font-weight: 600; background: #0284C7; color: #FFFFFF; display: inline-flex; align-items: center; gap: 6px;">
          <span>1</span> Category & Existing Group
        </div>
        <div id="bulkReplaceStepHeader2" class="step-pill" style="padding: 6px 14px; border-radius: 20px; font-size: 0.78rem; font-weight: 600; background: #E2E8F0; color: #475569; display: inline-flex; align-items: center; gap: 6px;">
          <span>2</span> Select New Files
        </div>
        <div id="bulkReplaceStepHeader3" class="step-pill" style="padding: 6px 14px; border-radius: 20px; font-size: 0.78rem; font-weight: 600; background: #E2E8F0; color: #475569; display: inline-flex; align-items: center; gap: 6px;">
          <span>3</span> Confirmation Summary
        </div>
        <div id="bulkReplaceStepHeader4" class="step-pill" style="padding: 6px 14px; border-radius: 20px; font-size: 0.78rem; font-weight: 600; background: #E2E8F0; color: #475569; display: inline-flex; align-items: center; gap: 6px;">
          <span>4</span> Apply & Report
        </div>
      </div>
    </div>

    <!-- Modal Body (Scrollable) -->
    <div style="padding: 1.5rem 1.75rem; overflow-y: auto; flex-grow: 1;">

      <!-- ============================================== -->
      <!-- STEP 1: CATEGORY & EXISTING FOLDER GROUP       -->
      <!-- ============================================== -->
      <div id="bulkReplaceStepBody1">
        <div style="margin-bottom: 1.25rem;">
          <label style="display: block; font-size: 0.88rem; font-weight: 700; color: var(--admin-text-dark); margin-bottom: 0.5rem;">
            1. Select Product Category:
          </label>
          <div style="font-size: 0.78rem; color: var(--admin-text-muted); margin-bottom: 8px;">
            Choose the category to inspect its existing file storage paths and folder groups.
          </div>
          <select id="bulkReplaceCategorySelect" class="form-control" onchange="window.bulkImageReplaceInstance.loadCategoryGroups(this.value)" style="font-size: 0.88rem; padding: 10px 14px; border-radius: 8px; width: 100%; max-width: 480px; background: #FFFFFF;">
            <% if (typeof categories !== 'undefined' && categories && categories.length > 0) { %>
              <% categories.forEach((c, idx) => { %>
                <option value="<%= c.id %>" data-slug="<%= c.slug %>" <%= idx === 0 ? 'selected' : '' %>><%= c.name %><%= (typeof c.design_count !== 'undefined' && c.design_count !== null) ? (' (' + c.design_count + ' designs)') : '' %></option>
              <% }) %>
            <% } %>
          </select>
        </div>

        <!-- Existing Folder / File Group Selector -->
        <div id="bulkReplaceGroupSection" style="margin-bottom: 1.5rem; background: #FAF9F6; border: 1px solid var(--admin-border); border-radius: 12px; padding: 1.25rem;">
          <label style="display: block; font-size: 0.88rem; font-weight: 700; color: var(--admin-text-dark); margin-bottom: 0.4rem;">
            <i class="fa-solid fa-folder-tree" style="color: #0284C7;"></i> 2. Existing Folder / File Group to Replace:
          </label>
          <p style="font-size: 0.78rem; color: var(--admin-text-muted); margin: 0 0 10px;">
            Identified by actual stored image and ZIP paths (e.g. <code>ARUVI BULK DESIGNS 2</code>). All old files in this group will be replaced.
          </p>

          <select id="bulkReplaceGroupSelect" class="form-control" onchange="window.bulkImageReplaceInstance.selectGroup(this.value)" style="font-size: 0.88rem; padding: 10px 14px; border-radius: 8px; width: 100%; background: #FFFFFF; font-weight: 600; color: var(--admin-text-dark);">
            <option value="">Scanning stored paths...</option>
          </select>

          <!-- Group Details Card -->
          <div id="existingGroupSummaryBadge" style="margin-top: 14px; background: #F0F9FF; border: 1px solid #BAE6FD; padding: 12px 16px; border-radius: 10px; display: flex; flex-wrap: wrap; gap: 16px; align-items: center; font-size: 0.84rem;">
            <span><i class="fa-solid fa-folder"></i> Folder: <strong id="groupDetailName" style="color: #0369A1;">-</strong></span>
            <span><i class="fa-solid fa-shirt"></i> Designs in Group: <strong id="groupDetailDesignsCount" style="color: #0284C7;">0</strong></span>
            <span><i class="fa-solid fa-image"></i> Existing Images: <strong id="groupDetailImagesCount" style="color: #512DA8;">0</strong></span>
            <span><i class="fa-solid fa-file-zipper"></i> Existing ZIPs: <strong id="groupDetailZipsCount" style="color: #00796B;">0</strong></span>
          </div>
        </div>
      </div>

      <!-- ============================================== -->
      <!-- STEP 2: SELECT NEW FILES                       -->
      <!-- ============================================== -->
      <div id="bulkReplaceStepBody2" style="display: none;">
        <div style="margin-bottom: 1.25rem;">
          <label style="display: block; font-size: 0.88rem; font-weight: 700; color: var(--admin-text-dark); margin-bottom: 0.4rem;">
            Select New Replacement Files:
          </label>
          <p style="font-size: 0.8rem; color: var(--admin-text-muted); margin: 0 0 12px;">
            Select replacement files directly (PNG, JPG, JPEG, WebP and ZIP). You do not need to select an entire folder.
          </p>

          <!-- Dropzone & Browse Button -->
          <div id="bulkReplaceDropZone" style="border: 2px dashed #0284C7; border-radius: 12px; padding: 2.25rem 1.5rem; text-align: center; background: #F0F9FF; transition: all 0.2s; cursor: pointer;" onclick="document.getElementById('bulkReplaceFileInput').click()">
            <i class="fa-solid fa-cloud-arrow-up" style="font-size: 2.6rem; color: #0284C7; margin-bottom: 10px;"></i>
            <div style="font-size: 1rem; font-weight: 600; color: #0369A1; margin-bottom: 4px;">
              Drag and drop replacement files directly here
            </div>
            <div style="font-size: 0.8rem; color: #64748B; margin-bottom: 16px;">
              or click <strong>Select Files</strong> to choose multiple images and ZIP packages
            </div>
            <button type="button" onclick="document.getElementById('bulkReplaceFileInput').click()" class="btn btn-primary" style="font-size: 0.86rem; padding: 8px 20px; border-radius: 8px; background: #0284C7; border-color: #0284C7; color: #FFF; display: inline-flex; align-items: center; gap: 8px;">
              <i class="fa-solid fa-file-circle-plus"></i> Select Files (.png, .jpg, .webp, .zip)
            </button>
          </div>
          <input type="file" id="bulkReplaceFileInput" multiple accept=".png,.jpg,.jpeg,.webp,.zip" style="display: none;">

          <!-- Selected Files Summary Badges -->
          <div id="selectedFilesSummaryBadge" style="display: none; margin-top: 14px; font-size: 0.84rem; font-weight: 600; color: #0284C7; background: #E0F2FE; border: 1px solid #BAE6FD; padding: 10px 16px; border-radius: 8px; flex-wrap: wrap; gap: 16px; align-items: center;">
            <span><i class="fa-solid fa-image"></i> Newly Selected Images: <strong id="selectedNewImagesCount">0</strong></span>
            <span><i class="fa-solid fa-file-zipper"></i> Newly Selected ZIPs: <strong id="selectedNewZipsCount">0</strong></span>
            <span><i class="fa-solid fa-layer-group"></i> Total Selected Files: <strong id="selectedNewTotalCount">0</strong></span>
          </div>
        </div>
      </div>

      <!-- ============================================== -->
      <!-- STEP 3: CONFIRMATION SUMMARY                   -->
      <!-- ============================================== -->
      <div id="bulkReplaceStepBody3" style="display: none;">
        <div style="max-width: 580px; margin: 0 auto; text-align: left;">
          <h4 style="font-size: 1.15rem; font-weight: 700; color: var(--admin-text-dark); margin: 0 0 8px; text-align: center;">
            <i class="fa-solid fa-clipboard-check" style="color: #0284C7;"></i> Confirmation Summary
          </h4>
          <p style="font-size: 0.82rem; color: var(--admin-text-muted); margin: 0 0 1.25rem; text-align: center;">
            Please review the replacement details below before replacing the existing files.
          </p>

          <div style="background: #FAF9F6; border: 1px solid var(--admin-border); border-radius: 12px; padding: 1.25rem 1.5rem; margin-bottom: 1.25rem;">
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 12px; padding-bottom: 12px; border-bottom: 1px solid #E2E8F0;">
              <div>
                <span style="font-size: 0.74rem; color: var(--admin-text-muted); text-transform: uppercase; font-weight: 600; display: block;">Selected Category</span>
                <strong id="confCategoryName" style="font-size: 0.95rem; color: var(--admin-text-dark);">-</strong>
              </div>
              <div>
                <span style="font-size: 0.74rem; color: var(--admin-text-muted); text-transform: uppercase; font-weight: 600; display: block;">Existing Folder / Group</span>
                <strong id="confGroupName" style="font-size: 0.95rem; color: #0284C7;">-</strong>
              </div>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 12px; padding-bottom: 12px; border-bottom: 1px solid #E2E8F0;">
              <div style="background: #FFF8E1; border: 1px solid #FFE082; padding: 10px; border-radius: 8px;">
                <div style="font-size: 0.74rem; color: #795548; font-weight: 600;">Existing Images in Group</div>
                <div id="confOldImagesCount" style="font-size: 1.2rem; font-weight: 700; color: #F57F17;">0</div>
                <div style="font-size: 0.7rem; color: #B71C1C; margin-top: 2px;">Will be removed</div>
              </div>
              <div style="background: #FFF8E1; border: 1px solid #FFE082; padding: 10px; border-radius: 8px;">
                <div style="font-size: 0.74rem; color: #795548; font-weight: 600;">Existing ZIPs in Group</div>
                <div id="confOldZipsCount" style="font-size: 1.2rem; font-weight: 700; color: #F57F17;">0</div>
                <div style="font-size: 0.7rem; color: #B71C1C; margin-top: 2px;">Will be removed</div>
              </div>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
              <div style="background: #E8F5E9; border: 1px solid #C8E6C9; padding: 10px; border-radius: 8px;">
                <div style="font-size: 0.74rem; color: #1B5E20; font-weight: 600;">New Images Selected</div>
                <div id="confNewImagesCount" style="font-size: 1.2rem; font-weight: 700; color: #2E7D32;">0</div>
                <div style="font-size: 0.7rem; color: #2E7D32; margin-top: 2px;">Will be active</div>
              </div>
              <div style="background: #E0F7FA; border: 1px solid #B2EBF2; padding: 10px; border-radius: 8px;">
                <div style="font-size: 0.74rem; color: #004D40; font-weight: 600;">New ZIPs Selected</div>
                <div id="confNewZipsCount" style="font-size: 1.2rem; font-weight: 700; color: #00796B;">0</div>
                <div style="font-size: 0.7rem; color: #00796B; margin-top: 2px;">Will be active</div>
              </div>
            </div>
          </div>

          <!-- Safety Notice -->
          <div style="padding: 10px 14px; background: #F0FDF4; border: 1px solid #BBF7D0; border-radius: 8px; font-size: 0.78rem; color: #166534; display: flex; align-items: flex-start; gap: 8px;">
            <i class="fa-solid fa-shield-halved" style="font-size: 1rem; color: #16A34A; margin-top: 2px;"></i>
            <div>
              <strong>Safe File Replacement:</strong> Product IDs, SKUs, titles, descriptions, pricing, stitch counts, orders, and customer download permissions will remain completely intact. 7-Day rollback is backed up automatically.
            </div>
          </div>
        </div>
      </div>

      <!-- ============================================== -->
      <!-- STEP 4: APPLY & REPORT                         -->
      <!-- ============================================== -->
      <div id="bulkReplaceStepBody4" style="display: none;">
        <!-- Upload Progress Section -->
        <div id="uploadProgressSection" style="text-align: center; padding: 2.5rem 1.5rem;">
          <div style="font-size: 1.15rem; font-weight: 700; color: var(--admin-text-dark); margin-bottom: 8px;">
            Replacing Files in Group...
          </div>
          <p id="bulkReplaceProgressStatus" style="font-size: 0.85rem; color: var(--admin-text-muted); margin-bottom: 1.5rem;">
            Uploading newly selected files in chunks (5 files per request)...
          </p>

          <div style="width: 100%; max-width: 500px; height: 16px; background: #E2E8F0; border-radius: 999px; margin: 0 auto 12px; overflow: hidden; position: relative;">
            <div id="bulkReplaceProgressBar" style="width: 0%; height: 100%; background: linear-gradient(90deg, #16A34A, #22C55E); transition: width 0.3s ease;"></div>
          </div>
          <div id="bulkReplaceProgressPercent" style="font-size: 0.95rem; font-weight: 700; color: #16A34A; margin-bottom: 1.5rem;">0%</div>

          <button type="button" onclick="window.bulkImageReplaceInstance.cancelUpload()" class="btn btn-outline" style="font-size: 0.82rem; padding: 6px 16px; border-radius: 8px; color: #C62828; border-color: #FFCDD2;">
            <i class="fa-solid fa-xmark"></i> Cancel
          </button>
        </div>

        <!-- Completion Report Section -->
        <div id="uploadReportSection" style="display: none; padding: 1.5rem 0.5rem; text-align: center;">
          <div style="width: 56px; height: 56px; border-radius: 50%; background: #E8F5E9; color: #2E7D32; display: inline-flex; align-items: center; justify-content: center; font-size: 2rem; margin-bottom: 0.75rem; box-shadow: 0 4px 14px rgba(46, 125, 50, 0.15);">
            <i class="fa-solid fa-circle-check"></i>
          </div>
          <h3 style="font-size: 1.35rem; font-weight: 700; color: var(--admin-text-dark); margin: 0 0 6px;">
            File Group Replacement Completed!
          </h3>
          <p id="reportGroupSummaryText" style="font-size: 0.88rem; color: var(--admin-text-muted); margin: 0 auto 1.5rem; max-width: 600px; line-height: 1.5;">
            Old files in this group have been removed, and the newly selected files are now active.
          </p>

          <!-- Report Stats (4-Column Centered Grid) -->
          <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; max-width: 580px; margin: 0 auto 1.5rem;">
            <div style="background: #E8F5E9; border: 1px solid #C8E6C9; padding: 12px 6px; border-radius: 10px; text-align: center;">
              <div id="reportCountReplacedImages" style="font-size: 1.4rem; font-weight: 700; color: #2E7D32;">0</div>
              <div style="font-size: 0.74rem; color: #1B5E20; font-weight: 600; margin-top: 3px;">Replaced Images</div>
            </div>
            <div style="background: #E0F7FA; border: 1px solid #B2EBF2; padding: 12px 6px; border-radius: 10px; text-align: center;">
              <div id="reportCountReplacedZips" style="font-size: 1.4rem; font-weight: 700; color: #00796B;">0</div>
              <div style="font-size: 0.74rem; color: #004D40; font-weight: 600; margin-top: 3px;">Replaced ZIPs</div>
            </div>
            <div style="background: #FFF8E1; border: 1px solid #FFE082; padding: 12px 6px; border-radius: 10px; text-align: center;">
              <div id="reportCountRemovedOld" style="font-size: 1.4rem; font-weight: 700; color: #F57F17;">0</div>
              <div style="font-size: 0.74rem; color: #795548; font-weight: 600; margin-top: 3px;">Old Files Removed</div>
            </div>
            <div style="background: #FFEBEE; border: 1px solid #FFCDD2; padding: 12px 6px; border-radius: 10px; text-align: center;">
              <div id="reportCountFailed" style="font-size: 1.4rem; font-weight: 700; color: #C62828;">0</div>
              <div style="font-size: 0.74rem; color: #B71C1C; font-weight: 600; margin-top: 3px;">Failed</div>
            </div>
          </div>

          <!-- Per-File Operation Log Table (Full Width) -->
          <div id="bulkReplaceFileLogContainer" style="margin: 0 0 1.5rem 0; text-align: left; background: #FFFFFF; border: 1px solid var(--admin-border); border-radius: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.04); overflow: hidden; width: 100%;">
            <div style="padding: 12px 18px; background: #FAF9F6; border-bottom: 1px solid var(--admin-border); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px;">
              <strong style="font-size: 0.88rem; color: var(--admin-text-dark); display: inline-flex; align-items: center; gap: 8px;">
                <i class="fa-solid fa-list-check" style="color: #0284C7;"></i> Per-File Operation Log (<span id="bulkReplaceFileLogCount">0</span> files)
              </strong>
              <span style="font-size: 0.76rem; color: #2E7D32; font-weight: 600; background: #E8F5E9; padding: 3px 10px; border-radius: 999px; border: 1px solid #C8E6C9; display: inline-flex; align-items: center; gap: 5px;">
                <i class="fa-solid fa-circle-check"></i> Verified storage & database activation
              </span>
            </div>
            <div style="max-height: 260px; overflow-y: auto;">
              <table style="width: 100%; border-collapse: collapse; font-size: 0.82rem;">
                <thead style="background: #F8FAFC; position: sticky; top: 0; z-index: 2; border-bottom: 1px solid #E2E8F0;">
                  <tr style="text-align: left; color: #475569;">
                    <th style="padding: 10px 14px; width: 45px; text-align: center;">#</th>
                    <th style="padding: 10px 14px;">File Name</th>
                    <th style="padding: 10px 14px; width: 110px;">Type</th>
                    <th style="padding: 10px 14px; width: 95px;">Size</th>
                    <th style="padding: 10px 14px; width: 125px;">Storage Status</th>
                    <th style="padding: 10px 14px; width: 125px;">Database Status</th>
                    <th style="padding: 10px 14px; width: 105px; text-align: center;">Result</th>
                  </tr>
                </thead>
                <tbody id="bulkReplaceFileLogTbody">
                  <!-- Dynamically populated in bulk-replace-images.js -->
                </tbody>
              </table>
            </div>
          </div>

          <!-- Actions Bar -->
          <div style="display: flex; gap: 10px; justify-content: center; align-items: center; flex-wrap: wrap; padding-top: 0.25rem;">
            <button type="button" id="bulkReplaceRetryFailedBtn" onclick="window.bulkImageReplaceInstance.retryFailed()" class="btn btn-warning" style="display: none; font-size: 0.85rem; padding: 9px 18px; border-radius: 8px; cursor: pointer; align-items: center; gap: 6px; background: #FFF8E1; color: #B45309; border: 1px solid #FDE68A; font-weight: 600;">
              <i class="fa-solid fa-arrows-rotate"></i> Retry Failed Files
            </button>
            <a id="bulkReplaceDownloadCsvBtn" href="#" class="btn btn-outline" style="font-size: 0.85rem; padding: 9px 18px; border-radius: 8px; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; font-weight: 600; color: #0284C7; border-color: #BAE6FD;">
              <i class="fa-solid fa-file-csv"></i> Download CSV Report
            </a>
            <button type="button" id="bulkReplaceUndoBtn" class="btn" style="display: none; font-size: 0.85rem; padding: 9px 18px; border-radius: 8px; background: #FFEBEE; color: #C62828; border: 1px solid #FFCDD2; cursor: pointer; align-items: center; gap: 6px; font-weight: 600;">
              <i class="fa-solid fa-rotate-left"></i> Undo This Replacement (7 Days)
            </button>
            <a href="/admin/tools/image-replace-history" class="btn btn-outline" style="font-size: 0.85rem; padding: 9px 18px; border-radius: 8px; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; font-weight: 600; color: #475569;">
              <i class="fa-solid fa-clock-rotate-left"></i> View History
            </a>
            <button type="button" onclick="window.location.reload()" class="btn btn-primary" style="font-size: 0.85rem; padding: 9px 24px; border-radius: 8px; background: #16A34A; border-color: #16A34A; color: #FFF; font-weight: 700; cursor: pointer; display: inline-flex; align-items: center; gap: 6px;">
              <i class="fa-solid fa-check"></i> Done & Refresh
            </button>
          </div>
        </div>
      </div>

    </div>

    <!-- Modal Footers for each step -->
    <!-- Step 1 Footer -->
    <div id="bulkReplaceStepFooter1" style="padding: 1rem 1.75rem; background: #FAF6F0; border-top: 1px solid var(--admin-border); display: flex; justify-content: flex-end; gap: 10px; flex-shrink: 0;">
      <button type="button" onclick="closeBulkReplaceImagesModal()" class="btn btn-outline" style="font-size: 0.85rem; padding: 8px 16px; border-radius: 8px;">Cancel</button>
      <button type="button" id="bulkReplaceScopeNextBtn" onclick="window.bulkImageReplaceInstance.proceedToStep2()" class="btn btn-primary" style="font-size: 0.85rem; padding: 8px 20px; border-radius: 8px; background: #0284C7; border-color: #0284C7; color: #FFF; display: inline-flex; align-items: center; gap: 6px; cursor: pointer;">
        Next: Select New Files <i class="fa-solid fa-arrow-right"></i>
      </button>
    </div>

    <!-- Step 2 Footer -->
    <div id="bulkReplaceStepFooter2" style="display: none; padding: 1rem 1.75rem; background: #FAF6F0; border-top: 1px solid var(--admin-border); display: flex; justify-content: space-between; gap: 10px; flex-shrink: 0;">
      <button type="button" onclick="window.bulkImageReplaceInstance.currentStep = 1; window.bulkImageReplaceInstance.updateStepView();" class="btn btn-outline" style="font-size: 0.85rem; padding: 8px 16px; border-radius: 8px;">
        <i class="fa-solid fa-arrow-left"></i> Back to Group
      </button>
      <div style="display: flex; gap: 10px;">
        <button type="button" onclick="closeBulkReplaceImagesModal()" class="btn btn-outline" style="font-size: 0.85rem; padding: 8px 16px; border-radius: 8px;">Cancel</button>
        <button type="button" id="bulkReplaceFilesNextBtn" disabled onclick="window.bulkImageReplaceInstance.proceedToStep3()" class="btn btn-primary" style="font-size: 0.85rem; padding: 8px 20px; border-radius: 8px; background: #0284C7; border-color: #0284C7; color: #FFF; display: inline-flex; align-items: center; gap: 6px; cursor: pointer;">
          Next: Review & Confirm <i class="fa-solid fa-arrow-right"></i>
        </button>
      </div>
    </div>

    <!-- Step 3 Footer -->
    <div id="bulkReplaceStepFooter3" style="display: none; padding: 1rem 1.75rem; background: #FAF6F0; border-top: 1px solid var(--admin-border); display: flex; justify-content: space-between; gap: 10px; flex-shrink: 0;">
      <button type="button" onclick="window.bulkImageReplaceInstance.currentStep = 2; window.bulkImageReplaceInstance.updateStepView();" class="btn btn-outline" style="font-size: 0.85rem; padding: 8px 16px; border-radius: 8px;">
        <i class="fa-solid fa-arrow-left"></i> Back to Files
      </button>
      <div style="display: flex; gap: 10px;">
        <button type="button" onclick="closeBulkReplaceImagesModal()" class="btn btn-outline" style="font-size: 0.85rem; padding: 8px 16px; border-radius: 8px;">Cancel</button>
        <button type="button" id="bulkReplaceConfirmBtn" onclick="window.bulkImageReplaceInstance.executeReplace()" class="btn btn-primary" style="font-size: 0.9rem; padding: 10px 24px; border-radius: 8px; background: #16A34A; border-color: #16A34A; color: #FFF; font-weight: 700; display: inline-flex; align-items: center; gap: 8px; cursor: pointer;">
          <i class="fa-solid fa-bolt"></i> Replace Files Now
        </button>
      </div>
    </div>

    <!-- Step 4 Footer -->
    <div id="bulkReplaceStepFooter4" style="display: none; padding: 1rem 1.75rem; background: #FAF6F0; border-top: 1px solid var(--admin-border); display: flex; justify-content: flex-end; gap: 10px; flex-shrink: 0;">
      <button type="button" onclick="closeBulkReplaceImagesModal()" class="btn btn-outline" style="font-size: 0.85rem; padding: 8px 16px; border-radius: 8px;">Close</button>
    </div>

  </div>
</div>

<script>
  window.CSRF_TOKEN = '<%= typeof csrfToken !== "undefined" ? csrfToken : "" %>';
</script>
<script src="/public/js/admin/designs.js?v=<%= Date.now() %>"></script>
<script src="/public/js/admin/bulk-stitch.js"></script>
<script src="/public/js/admin/bulk-replace-images.js?v=2"></script>
<script src="/public/js/sort-dropdown.js"></script>
</body>
</html>
