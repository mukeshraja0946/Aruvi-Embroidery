<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= design ? 'Edit Design' : 'Add New Design' %> - ARUVI Admin</title>
  <link rel="icon" type="image/jpeg" href="/public/images/logo.jpg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;1,400&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="/public/css/main.css">
  <link rel="stylesheet" href="/public/css/admin.css">
  <style>
    .form-section-card {
      background: #FFFFFF; border: 1px solid var(--admin-border); border-radius: 16px; padding: 1.6rem; margin-bottom: 1.5rem;
    }
    .form-section-card h3 {
      font-family: var(--font-heading); font-size: 1.15rem; font-weight: 700; color: var(--admin-text-dark); margin: 0 0 1.2rem;
    }
    .form-label-custom {
      display: block; font-size: 0.82rem; font-weight: 600; color: var(--admin-text-dark); margin-bottom: 6px;
    }
    .form-label-custom .req { color: var(--admin-primary); }
    .form-control-custom {
      width: 100%; height: 44px; border-radius: 10px; border: 1px solid var(--admin-border); padding: 0 1rem; font-size: 0.88rem; background: #FFFFFF; color: var(--admin-text-dark); transition: var(--transition);
    }
    .form-control-custom:focus { border-color: var(--admin-primary); outline: none; box-shadow: 0 0 0 3px rgba(184,64,42,0.1); }
    textarea.form-control-custom { height: auto; padding: 0.8rem 1rem; font-family: inherit; }

    /* Dropzone box */
    .dropzone-box {
      border: 2px dashed var(--admin-border); border-radius: 14px; padding: 1.8rem 1rem; text-align: center; background: #FAF6F0; cursor: pointer; transition: var(--transition);
    }
    .dropzone-box:hover { border-color: var(--admin-primary); background: #FAF0E8; }

    /* Tags Pill Box */
    .tag-pill {
      display: inline-flex; align-items: center; gap: 6px; background: #F4EFEA; color: var(--admin-text-dark); font-size: 0.78rem; font-weight: 500; padding: 4px 10px; border-radius: 14px; margin-right: 4px; margin-bottom: 4px;
    }
    .tag-pill i { cursor: pointer; color: var(--admin-text-muted); font-size: 0.7rem; }
    .tag-pill i:hover { color: var(--admin-primary); }

    /* Switch toggle mini */
    .switch-toggle { position: relative; display: inline-flex; align-items: center; gap: 10px; cursor: pointer; }
    .switch-toggle input { opacity: 0; width: 0; height: 0; }
    .slider-round { width: 42px; height: 22px; background-color: #CCC; transition: .3s; border-radius: 22px; position: relative; }
    .slider-round:before { position: absolute; content: ""; height: 16px; width: 16px; left: 3px; bottom: 3px; background-color: white; transition: .3s; border-radius: 50%; }
    input:checked + .slider-round { background-color: #4CAF50; }
    input:checked + .slider-round:before { transform: translateX(20px); }

    /* Main 2-column layout */
    .design-form-grid {
      display: grid;
      grid-template-columns: 1.35fr 0.85fr;
      gap: 1.8rem;
      align-items: flex-start;
    }
    @media (max-width: 992px) {
      .design-form-grid {
        grid-template-columns: 1fr !important;
      }
    }
  </style>
</head>
<body class="admin-body">

<div class="admin-wrapper">
  <!-- Top Header matching Reference -->
  <header class="admin-top-header">
    <a href="/admin" class="admin-header-brand">
      <% const currentLogo = (typeof siteSettings !== 'undefined' && siteSettings.logo_url) ? siteSettings.logo_url : '/public/images/logo.jpg'; %>
      <img src="<%= currentLogo %>" alt="ARUVI Admin Logo" style="max-height: 42px; width: auto; object-fit: contain;">
    </a>

    <!-- Global Search -->
    <div class="admin-search-bar">
      <i class="fa-solid fa-magnifying-glass"></i>
      <input type="text" placeholder="Search designs, orders, customers...">
    </div>

    <!-- Right User Header Icons -->
    <div class="admin-header-right">
      <a href="#" class="admin-icon-btn" title="Notifications">
        <i class="fa-regular fa-bell"></i>
        <span class="badge-count">3</span>
      </a>

      <div class="admin-user-menu">
        <div class="admin-user-avatar">A</div>
        <div class="admin-user-info">
          <strong>Admin</strong>
          <span>Administrator</span>
        </div>
        <i class="fa-solid fa-chevron-down" style="font-size: 0.75rem; color: var(--admin-text-muted); margin-left: 4px;"></i>
      </div>
    </div>
  </header>

  <!-- Admin Main Layout with Sidebar -->
  <div class="admin-main-container">
    <!-- Left Sidebar matching Reference -->
    <aside class="admin-sidebar">
      <ul class="sidebar-nav-list" style="margin-bottom: 1.2rem;">
        <li class="sidebar-nav-item">
          <a href="/admin">
            <span><i class="fa-solid fa-house"></i> Dashboard</span>
          </a>
        </li>
      </ul>

      <!-- DESIGNS Section -->
      <div class="admin-sidebar-section">
        <div class="sidebar-heading">DESIGNS</div>
        <ul class="sidebar-nav-list">
          <li class="sidebar-nav-item"><a href="/admin/designs"><span><i class="fa-solid fa-box-archive"></i> Manage Designs</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/designs/create" class="<%= !design ? 'active' : '' %>"><span><i class="fa-solid fa-circle-plus"></i> Add New Design</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/designs/bulk-details"><span><i class="fa-solid fa-file-pen"></i> Bulk Update Details</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/categories"><span><i class="fa-solid fa-border-all"></i> Categories</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/custom-orders"><span><i class="fa-solid fa-wand-magic-sparkles"></i> Custom Orders</span></a></li>
        </ul>
      </div>

      <!-- ORDERS Section -->
      <div class="admin-sidebar-section">
        <div class="sidebar-heading">ORDERS</div>
        <ul class="sidebar-nav-list">
          <li class="sidebar-nav-item"><a href="/admin/orders"><span><i class="fa-regular fa-newspaper"></i> All Orders</span></a></li>
          <li class="sidebar-nav-item">
            <a href="/admin/orders?status=pending">
              <span><i class="fa-regular fa-clock"></i> Pending Orders</span>
              <span class="sidebar-badge">5</span>
            </a>
          </li>
          <li class="sidebar-nav-item"><a href="/admin/orders?status=completed"><span><i class="fa-regular fa-circle-check"></i> Completed Orders</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/orders?status=cancelled"><span><i class="fa-regular fa-circle-xmark"></i> Cancelled Orders</span></a></li>
        </ul>
      </div>

      <!-- CUSTOMERS Section -->
      <div class="admin-sidebar-section">
        <div class="sidebar-heading">CUSTOMERS</div>
        <ul class="sidebar-nav-list">
          <li class="sidebar-nav-item"><a href="/admin/customers"><span><i class="fa-solid fa-users"></i> All Customers</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/messages"><span><i class="fa-regular fa-comment-dots"></i> Enquiries</span></a></li>
        </ul>
      </div>

      <!-- CONTENT Section -->
      <div class="admin-sidebar-section">
        <div class="sidebar-heading">CONTENT</div>
        <ul class="sidebar-nav-list">
          <li class="sidebar-nav-item"><a href="/admin/homepage"><span><i class="fa-solid fa-house-chimney"></i> Homepage</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/banners"><span><i class="fa-regular fa-image"></i> Banners</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/homepage#about"><span><i class="fa-regular fa-circle-info"></i> About Page</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/settings#contact"><span><i class="fa-solid fa-location-dot"></i> Contact Info</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/settings"><span><i class="fa-solid fa-gear"></i> Website Settings</span></a></li>
        </ul>
      </div>

      <div style="margin-top: auto; padding-top: 1rem; border-top: 1px solid var(--admin-border);">
        <a href="/admin/logout" style="display: flex; align-items: center; gap: 8px; color: var(--admin-primary); font-size: 0.85rem; font-weight: 600; text-decoration: none; padding: 0.5rem 0.8rem;">
          <i class="fa-solid fa-arrow-right-from-bracket"></i> Logout Admin
        </a>
      </div>
    </aside>

    <!-- Main Content Body -->
    <main class="admin-content-body">

      <!-- Breadcrumbs & Header -->
      <div style="margin-bottom: 1.8rem;">
        <div style="font-size: 0.8rem; color: var(--admin-text-muted); margin-bottom: 0.4rem;">
          <a href="/admin" style="color: var(--admin-text-muted); text-decoration: none;">Dashboard</a> &nbsp;>&nbsp; <a href="/admin/designs" style="color: var(--admin-text-muted); text-decoration: none;">Designs</a> &nbsp;>&nbsp; <span style="color: var(--admin-primary); font-weight: 600;"><%= design ? 'Edit Design' : 'Add New Design' %></span>
        </div>
        <h1 style="font-family: var(--font-heading); font-size: 2.2rem; font-weight: 700; color: var(--admin-text-dark); margin: 0 0 0.3rem;"><%= design ? 'Edit Design #' + design.id : 'Add New Design' %></h1>
        <p style="font-size: 0.88rem; color: var(--admin-text-muted); margin: 0;">Upload and add a new embroidery design. All details will be reflected on the website.</p>
      </div>

      <!-- Flash Messages -->
      <div id="formFlashMessage" style="display: none; margin-bottom: 1.5rem; border-radius: 10px; padding: 0.8rem 1.2rem; align-items: center; gap: 8px;"></div>

      <% if (flash && flash.success && flash.success.length > 0) { %>
        <div class="alert alert-success" style="margin-bottom: 1.5rem; border-radius: 10px; background: #E8F5E9; color: #2E7D32; padding: 0.8rem 1.2rem; display: flex; align-items: center; gap: 8px;">
          <i class="fa-solid fa-circle-check"></i> <%= flash.success[0] %>
        </div>
      <% } %>

      <% if (flash && flash.error && flash.error.length > 0) { %>
        <div class="alert alert-error" style="margin-bottom: 1.5rem; border-radius: 10px; background: #FFEBEE; color: #C62828; padding: 0.8rem 1.2rem; display: flex; align-items: center; gap: 8px;">
          <i class="fa-solid fa-circle-exclamation"></i> <%= flash.error[0] %>
        </div>
      <% } %>

      <!-- Main Form Grid (2 Columns: Left 60% Width, Right 40% Width) -->
      <form id="designForm" data-design-id="<%= design ? design.id : '' %>" action="<%= (design ? '/admin/designs/edit/' + design.id : '/admin/designs/create') + '?_csrf=' + (typeof csrfToken !== 'undefined' ? csrfToken : '') %>" method="POST" enctype="multipart/form-data">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="design-form-grid" style="display: grid; grid-template-columns: 1.35fr 0.85fr; gap: 1.8rem; align-items: flex-start;">
          
          <!-- LEFT COLUMN -->
          <div>
            <!-- Card 1: Basic Information -->
            <div class="form-section-card">
              <h3>Basic Information</h3>

              <!-- 2-Col: Design Name & SKU -->
              <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.2rem; margin-bottom: 1.2rem;">
                <div>
                  <label class="form-label-custom">Design Name <span class="req">*</span></label>
                  <input type="text" name="title" class="form-control-custom" value="<%= design ? design.title : '' %>" required placeholder="e.g. Rose Floral Design">
                </div>

                <div>
                  <label class="form-label-custom">Design Code / SKU <span class="req">*</span></label>
                  <div style="position: relative;">
                    <input type="text" name="sku" id="skuInput" class="form-control-custom" value="<%= design ? (design.sku || '') : (typeof defaultSku !== 'undefined' ? defaultSku : '') %>" required placeholder="e.g. AED-BLO-01">
                    <button type="button" onclick="forceAutoGenerateSku()" style="position: absolute; right: 8px; top: 50%; transform: translateY(-50%); background: #F4EFEA; border: 1px solid var(--admin-border); border-radius: 6px; padding: 4px 10px; color: var(--admin-primary); cursor: pointer; font-size: 0.75rem; font-weight: 600; display: flex; align-items: center; gap: 4px;" title="Auto-generate suggested SKU">
                      <i class="fa-solid fa-wand-magic-sparkles"></i> Auto
                    </button>
                  </div>
                  <span style="font-size: 0.72rem; color: var(--admin-text-muted); display: block; margin-top: 4px;">Auto-generated based on selected category. You can edit manually.</span>
                </div>
              </div>

              <!-- Category & Design Size (2-Col) -->
              <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.2rem; margin-bottom: 1.2rem;">
                <div>
                  <label class="form-label-custom">Category <span class="req">*</span></label>
                  <select name="category_id" id="categorySelect" class="form-control-custom" required onchange="onCategoryChange()">
                    <option value="">Select Category</option>
                    <% categories.forEach(cat => { %>
                      <option value="<%= cat.id %>" <%= (design && design.category_id == cat.id) ? 'selected' : '' %>>
                        <%= cat.name %>
                      </option>
                    <% }) %>
                  </select>
                </div>

                <div>
                  <label class="form-label-custom">Design Size</label>
                  <input type="text" name="dimensions" class="form-control-custom" value="<%= design && (design.dimensions || design.hoop_size) ? (design.dimensions || design.hoop_size) : '' %>" placeholder="e.g. 140mm x 180mm (5x7 inch)">
                  <span style="font-size: 0.72rem; color: var(--admin-text-muted); display: block; margin-top: 4px;">Garment size / hoop dimensions (e.g. 140mm x 180mm)</span>
                </div>
              </div>

              <!-- Detailed Description -->
              <div>
                <label class="form-label-custom">Detailed Description</label>
                <textarea name="description" id="designDescription" class="form-control-custom" rows="4" style="height: auto; min-height: 100px; resize: vertical;" placeholder="Detailed floral embroidery design suitable for blouse embroidery. Includes front, back, and sleeve design information..."><%= design && design.description ? design.description : '' %></textarea>
                <span style="font-size: 0.72rem; color: var(--admin-text-muted); display: block; margin-top: 4px;">Supports multiple paragraphs and line breaks. Displayed on the customer design page.</span>
              </div>
            </div>

            <!-- Card: Stitch Count -->
            <div class="form-section-card" id="stitchCountSection">
              <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.8rem;">
                <h3 style="margin: 0;"><i class="fa-solid fa-needle" style="color: var(--admin-primary); margin-right: 6px;"></i> Stitch Count</h3>
                <span style="font-size: 0.75rem; color: var(--admin-text-muted);">Whole numbers (0 to 10,000,000)</span>
              </div>
              <p style="font-size: 0.8rem; color: var(--admin-text-muted); margin: 0 0 1.2rem 0;">Enter section stitch counts. Total calculates live in Auto mode, or click Override to set a manual total.</p>

              <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 1.2rem;">
                <%
                  const fVal = design ? (design.stitch_count_front ?? design.frontStitchCount) : null;
                  const fDisplay = (fVal !== null && fVal !== undefined && Number(fVal) > 0) ? Number(fVal).toLocaleString() : '';
                  const fRaw = (fVal !== null && fVal !== undefined && Number(fVal) > 0) ? fVal : '';

                  const bVal = design ? (design.stitch_count_back ?? design.backStitchCount) : null;
                  const bDisplay = (bVal !== null && bVal !== undefined && Number(bVal) > 0) ? Number(bVal).toLocaleString() : '';
                  const bRaw = (bVal !== null && bVal !== undefined && Number(bVal) > 0) ? bVal : '';

                  const sVal = design ? (design.stitch_count_sleeve ?? design.sleeveStitchCount) : null;
                  const sDisplay = (sVal !== null && sVal !== undefined && Number(sVal) > 0) ? Number(sVal).toLocaleString() : '';
                  const sRaw = (sVal !== null && sVal !== undefined && Number(sVal) > 0) ? sVal : '';

                  const isManualInit = design && (design.stitch_total_manual === 1 || design.stitch_total_manual === '1' || design.stitchTotalManual === 1 || design.stitchTotalManual === '1');
                  let initTotal = null;
                  if (isManualInit) {
                    const rawMan = design ? (design.stitch_count_total ?? design.stitch_count ?? design.totalStitchCount) : null;
                    initTotal = (rawMan !== null && rawMan !== undefined && Number(rawMan) > 0) ? Number(rawMan) : null;
                  } else if (fRaw !== '' || bRaw !== '' || sRaw !== '') {
                    initTotal = (Number(fRaw) || 0) + (Number(bRaw) || 0) + (Number(sRaw) || 0);
                  }
                  const tDisplay = (initTotal !== null && initTotal > 0) ? Number(initTotal).toLocaleString() : '';
                  const tRaw = (initTotal !== null && initTotal > 0) ? initTotal : '';
                %>

                <!-- Front Stitch Count -->
                <div>
                  <label class="form-label-custom">Front</label>
                  <div style="position: relative; display: flex; align-items: center;">
                    <input type="text" inputmode="numeric" name="stitch_count_front" id="stitchFrontInput" class="form-control-custom stitch-comp-input" value="<%= fDisplay %>" placeholder="e.g. 12,000" style="padding-right: 32px;" oninput="handleStitchComponentInput('front')">
                    <button type="button" class="stitch-clear-btn" id="stitchFrontClearBtn" onclick="clearStitchField('front')" title="Clear Front Stitch Count" style="position: absolute; right: 8px; background: #F1F5F9; border: 1px solid #CBD5E1; color: #64748B; border-radius: 50%; width: 20px; height: 20px; display: <%= fDisplay ? 'flex' : 'none' %>; align-items: center; justify-content: center; cursor: pointer; font-size: 0.7rem; padding: 0; transition: all 0.15s;">
                      <i class="fa-solid fa-xmark"></i>
                    </button>
                  </div>
                  <input type="hidden" name="frontStitchCount" id="frontStitchCountHidden" value="<%= fRaw %>">
                  <div class="stitch-inline-error" id="stitchFrontError" style="display: none; color: #C62828; font-size: 0.72rem; margin-top: 3px; font-weight: 500;"></div>
                  <span style="font-size: 0.72rem; color: var(--admin-text-muted); display: block; margin-top: 4px;">Front neck / bodice</span>
                </div>

                <!-- Back Stitch Count -->
                <div>
                  <label class="form-label-custom">Back</label>
                  <div style="position: relative; display: flex; align-items: center;">
                    <input type="text" inputmode="numeric" name="stitch_count_back" id="stitchBackInput" class="form-control-custom stitch-comp-input" value="<%= bDisplay %>" placeholder="e.g. 7,500" style="padding-right: 32px;" oninput="handleStitchComponentInput('back')">
                    <button type="button" class="stitch-clear-btn" id="stitchBackClearBtn" onclick="clearStitchField('back')" title="Clear Back Stitch Count" style="position: absolute; right: 8px; background: #F1F5F9; border: 1px solid #CBD5E1; color: #64748B; border-radius: 50%; width: 20px; height: 20px; display: <%= bDisplay ? 'flex' : 'none' %>; align-items: center; justify-content: center; cursor: pointer; font-size: 0.7rem; padding: 0; transition: all 0.15s;">
                      <i class="fa-solid fa-xmark"></i>
                    </button>
                  </div>
                  <input type="hidden" name="backStitchCount" id="backStitchCountHidden" value="<%= bRaw %>">
                  <div class="stitch-inline-error" id="stitchBackError" style="display: none; color: #C62828; font-size: 0.72rem; margin-top: 3px; font-weight: 500;"></div>
                  <span style="font-size: 0.72rem; color: var(--admin-text-muted); display: block; margin-top: 4px;">Back neck pattern</span>
                </div>

                <!-- Sleeve Stitch Count -->
                <div>
                  <label class="form-label-custom">Sleeve</label>
                  <div style="position: relative; display: flex; align-items: center;">
                    <input type="text" inputmode="numeric" name="stitch_count_sleeve" id="stitchSleeveInput" class="form-control-custom stitch-comp-input" value="<%= sDisplay %>" placeholder="e.g. 5,300" style="padding-right: 32px;" oninput="handleStitchComponentInput('sleeve')">
                    <button type="button" class="stitch-clear-btn" id="stitchSleeveClearBtn" onclick="clearStitchField('sleeve')" title="Clear Sleeve Stitch Count" style="position: absolute; right: 8px; background: #F1F5F9; border: 1px solid #CBD5E1; color: #64748B; border-radius: 50%; width: 20px; height: 20px; display: <%= sDisplay ? 'flex' : 'none' %>; align-items: center; justify-content: center; cursor: pointer; font-size: 0.7rem; padding: 0; transition: all 0.15s;">
                      <i class="fa-solid fa-xmark"></i>
                    </button>
                  </div>
                  <input type="hidden" name="sleeveStitchCount" id="sleeveStitchCountHidden" value="<%= sRaw %>">
                  <div class="stitch-inline-error" id="stitchSleeveError" style="display: none; color: #C62828; font-size: 0.72rem; margin-top: 3px; font-weight: 500;"></div>
                  <span style="font-size: 0.72rem; color: var(--admin-text-muted); display: block; margin-top: 4px;">Sleeve / arm border</span>
                </div>

                <!-- Total Stitch Count (with Auto/Manual toggle) -->
                <div>
                  <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 4px;">
                    <label class="form-label-custom" style="margin: 0;">Total</label>
                    <button type="button" id="toggleStitchModeBtn" onclick="toggleStitchManualMode()" style="background: <%= isManualInit ? '#FEE2E2' : '#E0E7FF' %>; border: 1px solid <%= isManualInit ? '#FCA5A5' : '#C7D2FE' %>; cursor: pointer; display: inline-flex; align-items: center; gap: 4px; padding: 2px 8px; border-radius: 6px; font-size: 0.72rem; font-weight: 600; color: <%= isManualInit ? '#B91C1C' : '#3730A3' %>; transition: all 0.2s;" title="Toggle between Auto calculation and Manual override">
                      <i id="stitchModeIcon" class="fa-solid <%= isManualInit ? 'fa-pencil' : 'fa-wand-magic-sparkles' %>"></i>
                      <span id="stitchModeText"><%= isManualInit ? 'Manual' : 'Auto' %></span>
                      <span id="stitchModeActionHint" style="font-weight: 400; opacity: 0.85;">(<%= isManualInit ? 'Reset' : 'Override' %>)</span>
                    </button>
                  </div>

                  <div style="position: relative; display: flex; align-items: center;">
                    <input type="text" inputmode="numeric" name="stitch_count_total" id="stitchTotalInput" class="form-control-custom" <%= isManualInit ? '' : 'readonly' %> style="background: <%= isManualInit ? '#FFFFFF' : (initTotal !== null ? '#F4EBE1' : '#FAF6F0') %>; font-weight: 700; color: <%= isManualInit ? 'var(--admin-text-dark)' : (initTotal !== null ? 'var(--admin-primary)' : '#8C7E75') %>; <%= isManualInit ? '' : 'cursor: not-allowed;' %> padding-right: 32px;" placeholder="Empty / Auto" value="<%= tDisplay %>" oninput="handleStitchTotalManualInput()">
                    <button type="button" class="stitch-clear-btn" id="stitchTotalClearBtn" onclick="clearStitchField('total')" title="Clear Total Stitch Count" style="position: absolute; right: 8px; background: #F1F5F9; border: 1px solid #CBD5E1; color: #64748B; border-radius: 50%; width: 20px; height: 20px; display: <%= tDisplay ? 'flex' : 'none' %>; align-items: center; justify-content: center; cursor: pointer; font-size: 0.7rem; padding: 0; transition: all 0.15s;">
                      <i class="fa-solid fa-xmark"></i>
                    </button>
                  </div>
                  <input type="hidden" name="stitch_total_manual" id="stitchTotalManualHidden" value="<%= isManualInit ? '1' : '0' %>">
                  <input type="hidden" name="stitch_count" id="stitchCountTotalHidden" value="<%= tRaw %>">
                  <input type="hidden" name="totalStitchCount" id="totalStitchCountHidden" value="<%= tRaw %>">
                  
                  <div class="stitch-inline-error" id="stitchTotalError" style="display: none; color: #C62828; font-size: 0.72rem; margin-top: 3px; font-weight: 500;"></div>
                  <span id="stitchCountTotalStatus" style="font-size: 0.72rem; color: var(--admin-text-muted); display: block; margin-top: 4px;">
                    <% if (isManualInit && initTotal !== null) { %>
                      <span style="color: #B91C1C; font-weight: 600;"><i class="fa-solid fa-pen-to-square"></i> Manual Override: <%= Number(initTotal).toLocaleString() %></span>
                    <% } else if (initTotal !== null) { %>
                      <span style="color: #2E7D32; font-weight: 600;"><i class="fa-solid fa-circle-check"></i> Auto Total: <%= Number(initTotal).toLocaleString() %></span>
                    <% } else { %>
                      Front + Back + Sleeve
                    <% } %>
                  </span>
                </div>
              </div>
            </div>

            <!-- Card 2: Download Files (Multi-File Package) -->
            <div class="form-section-card" id="downloadFilesSection">
              <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.4rem;">
                <div style="display: flex; align-items: center; gap: 8px;">
                  <i class="fa-solid fa-folder-open" style="color: var(--admin-primary); font-size: 1.2rem;"></i>
                  <h3 style="margin: 0; font-size: 1.1rem; font-weight: 800;">Download Files (Paid Files)</h3>
                </div>
                <span style="font-size: 0.75rem; background: #E8F5E9; color: #2E7D32; font-weight: 700; padding: 3px 10px; border-radius: 12px;">
                  <i class="fa-solid fa-lock"></i> Private &amp; Secured
                </span>
              </div>
              <p style="font-size: 0.8rem; color: var(--admin-text-muted); margin: 0 0 1.2rem 0;">
                Customers who purchase this design get <strong>ALL</strong> files listed below. Supports multiple ZIP, RAR, DST, PES, JEF, EXP, and PNG files (up to 20 files, max 200 MB each).
              </p>

              <!-- Hidden input holding staged download files when creating a new design -->
              <input type="hidden" name="staged_files" id="stagedFilesInput" value="[]">

              <!-- Dropzone for Download Files -->
              <div id="downloadFilesDropzone" class="dropzone-box" style="border: 2px dashed var(--admin-border); border-radius: 14px; padding: 1.5rem 1rem; text-align: center; background: #FAF6F0; cursor: pointer; transition: all 0.2s ease;">
                <i class="fa-solid fa-cloud-arrow-up" style="font-size: 2.2rem; color: var(--admin-primary); margin-bottom: 0.4rem; display: block;"></i>
                <strong style="display: block; font-size: 0.95rem; color: var(--admin-text-dark); margin-bottom: 4px;">Drag &amp; Drop Download Files Here</strong>
                <span style="font-size: 0.78rem; color: var(--admin-text-muted); display: block; margin-bottom: 12px;">Supports multiple files: .zip, .rar, .dst, .pes, .jef, .exp, .png (Chunked 2MB upload)</span>
                <button type="button" class="btn" style="background: var(--admin-primary); color: #FFFFFF; font-weight: 700; border-radius: 8px; font-size: 0.82rem; padding: 8px 20px; border: none; cursor: pointer;" onclick="document.getElementById('multiDownloadFileInput').click()">
                  <i class="fa-solid fa-plus"></i> Choose Download Files
                </button>
                <input type="file" id="multiDownloadFileInput" multiple accept=".zip,.rar,.dst,.pes,.jef,.exp,.png" style="display: none;">
              </div>

              <!-- Upload Progress Box -->
              <div id="downloadUploadProgressBox" class="upload-progress-box" style="display: none; background: #FFFFFF; border: 1px solid var(--admin-border); border-radius: 12px; padding: 12px 16px; margin-top: 14px;">
                <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 6px;">
                  <strong id="downloadUploadStatusText" style="font-size: 0.82rem; color: var(--admin-text-dark);">Uploading chunked files...</strong>
                  <span id="downloadUploadPercent" style="font-size: 0.78rem; font-weight: 700; color: var(--admin-primary);">0%</span>
                </div>
                <div style="height: 6px; background: #F1E9E0; border-radius: 4px; overflow: hidden;">
                  <div id="downloadProgressBarInner" class="progress-bar-inner" style="height: 100%; width: 0%; background: var(--admin-primary); transition: width 0.2s ease;"></div>
                </div>
              </div>

              <!-- Duplicate Warning Alert Box -->
              <div id="duplicateChecksumWarning" style="display: none; background: #FFF8E1; border: 1px solid #FFE082; color: #8D6E63; padding: 10px 14px; border-radius: 10px; font-size: 0.82rem; margin-top: 12px;">
                <i class="fa-solid fa-triangle-exclamation" style="color: #F57C00; margin-right: 6px;"></i>
                <strong>Notice:</strong> One or more files have an identical checksum (duplicate content) already attached to this design.
              </div>

              <!-- Table of Uploaded Download Files -->
              <div style="overflow-x: auto; margin-top: 1.2rem;">
                <table class="file-list-table" id="downloadFilesTable" style="width: 100%; border-collapse: collapse;">
                  <thead>
                    <tr style="border-bottom: 1px solid var(--admin-border);">
                      <th style="padding: 8px 10px; font-size: 0.74rem; color: var(--admin-text-muted); text-align: left;">FILE</th>
                      <th style="padding: 8px 10px; font-size: 0.74rem; color: var(--admin-text-muted); text-align: left;">LABEL (EDITABLE)</th>
                      <th style="padding: 8px 10px; font-size: 0.74rem; color: var(--admin-text-muted); text-align: left;">FORMAT</th>
                      <th style="padding: 8px 10px; font-size: 0.74rem; color: var(--admin-text-muted); text-align: left;">SIZE</th>
                      <th style="padding: 8px 10px; font-size: 0.74rem; color: var(--admin-text-muted); text-align: right;">ACTIONS</th>
                    </tr>
                  </thead>
                  <tbody id="downloadFilesTableBody">
                    <%
                      const existingDownloadFiles = (design && design.download_files) ? design.download_files : [];
                    %>
                    <% if (existingDownloadFiles.length === 0) { %>
                      <tr id="noDownloadFilesRow">
                        <td colspan="5" style="text-align: center; padding: 2rem 1rem; color: var(--admin-text-muted); font-size: 0.85rem;">
                          <i class="fa-solid fa-file-circle-plus" style="font-size: 1.8rem; display: block; margin-bottom: 6px; opacity: 0.5;"></i>
                          No download files uploaded yet. Drag &amp; drop machine archives above.
                        </td>
                      </tr>
                    <% } else { %>
                      <% existingDownloadFiles.forEach((f, idx) => { %>
                        <%
                          const fExt = (f.file_format || (f.original_name ? f.original_name.split('.').pop() : (f.file_name ? f.file_name.split('.').pop() : 'ZIP'))).toUpperCase();
                          let badgeClass = 'fmt-badge-zip';
                          if (fExt === 'DST') badgeClass = 'fmt-badge-dst';
                          else if (fExt === 'PES') badgeClass = 'fmt-badge-pes';
                          else if (fExt === 'JEF') badgeClass = 'fmt-badge-jef';
                          else if (fExt === 'EXP') badgeClass = 'fmt-badge-exp';
                          else if (fExt === 'RAR') badgeClass = 'fmt-badge-rar';
                          else if (fExt === 'PNG') badgeClass = 'fmt-badge-png';
                          const sizeDisplay = f.file_size ? (f.file_size / (1024 * 1024) >= 1 ? (f.file_size / (1024 * 1024)).toFixed(1) + ' MB' : Math.max(1, Math.round(f.file_size / 1024)) + ' KB') : '—';
                          const dispName = f.original_name || f.file_name || ('file_' + f.id);
                        %>
                        <tr class="download-file-row" data-file-id="<%= f.id %>" data-sort="<%= f.sort_order || idx %>" style="border-bottom: 1px solid #F1E9E0;">
                          <td style="padding: 10px; font-weight: 600; color: var(--admin-text-dark); max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                            <i class="fa-solid fa-file-zipper" style="color: var(--admin-primary); margin-right: 6px;"></i>
                            <span title="<%= dispName %>"><%= dispName %></span>
                          </td>
                          <td style="padding: 10px;">
                            <input type="text" class="form-control-custom file-label-input" value="<%= f.label || '' %>" placeholder="e.g. 5x7 hoop, Front neck" style="height: 32px; font-size: 0.8rem; padding: 0 8px;" onchange="saveFileLabel('<%= design.id %>', '<%= f.id %>', this.value)">
                          </td>
                          <td style="padding: 10px;">
                            <span class="fmt-badge <%= badgeClass %>" style="padding: 2px 8px; border-radius: 6px; font-size: 0.7rem; font-weight: 800;"><%= fExt %></span>
                          </td>
                          <td style="padding: 10px; font-size: 0.8rem; color: var(--admin-text-muted);"><%= sizeDisplay %></td>
                          <td style="padding: 10px; text-align: right; white-space: nowrap;">
                            <div style="display: inline-flex; align-items: center; gap: 4px;">
                              <button type="button" class="btn btn-sm btn-move-up" onclick="moveFileRowUp(this)" title="Move Up" style="background: #F1E9E0; padding: 4px 8px; border-radius: 6px; border: none; cursor: pointer; font-size: 0.72rem;">
                                <i class="fa-solid fa-arrow-up"></i>
                              </button>
                              <button type="button" class="btn btn-sm btn-move-down" onclick="moveFileRowDown(this)" title="Move Down" style="background: #F1E9E0; padding: 4px 8px; border-radius: 6px; border: none; cursor: pointer; font-size: 0.72rem;">
                                <i class="fa-solid fa-arrow-down"></i>
                              </button>
                              <a href="/admin/api/designs/files/<%= f.id %>/download" class="btn btn-sm" title="Download (admin test)" style="background: #E3F2FD; color: #1565C0; padding: 4px 8px; border-radius: 6px; text-decoration: none; font-size: 0.72rem; font-weight: 600;">
                                <i class="fa-solid fa-download"></i>
                              </a>
                              <button type="button" class="btn btn-sm btn-replace-file" data-file-id="<%= f.id %>" onclick="replaceSingleDownloadFile('<%= f.id %>')" title="Replace File" style="background: #FFF3E0; color: #E65100; padding: 4px 8px; border-radius: 6px; border: none; cursor: pointer; font-size: 0.72rem; font-weight: 600;">
                                <i class="fa-solid fa-rotate"></i>
                              </button>
                              <button type="button" class="btn btn-sm btn-delete-file" data-file-id="<%= f.id %>" onclick="deleteDownloadFileRecord('<%= design.id %>', '<%= f.id %>', this)" title="Delete File" style="background: #FFEBEE; color: #C62828; padding: 4px 8px; border-radius: 6px; border: none; cursor: pointer; font-size: 0.72rem; font-weight: 600;">
                                <i class="fa-solid fa-trash-can"></i>
                              </button>
                            </div>
                          </td>
                        </tr>
                      <% }) %>
                    <% } %>
                  </tbody>
                </table>
              </div>

              <!-- Available Formats Section (Auto-Detected & Editable) -->
              <div style="background: #FAF6F0; border: 1px solid #EFE6D9; border-radius: 14px; padding: 1.1rem; margin-top: 1.4rem;">
                <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 6px;">
                  <div style="display: flex; align-items: center; gap: 8px;">
                    <i class="fa-solid fa-list-check" style="color: #5E35B1; font-size: 1rem;"></i>
                    <strong style="font-size: 0.88rem; font-weight: 800; color: #212529;">Available Formats</strong>
                  </div>
                  <span style="font-size: 0.72rem; color: var(--admin-text-muted);">Auto-detected &amp; editable</span>
                </div>
                <p style="font-size: 0.78rem; color: #7F8C8D; margin: 0 0 10px 0;">Auto-detected from file extensions and ZIP contents. You can edit this field freely.</p>

                <div id="detectedFormatsBadges" style="display: flex; gap: 8px; flex-wrap: wrap; align-items: center; margin-bottom: 10px;">
                  <% 
                    const rawFmts = (design && design.formats) ? design.formats.split(',').map(s=>s.trim().toUpperCase()).filter(Boolean) : ['DST', 'PES', 'JEF', 'EXP'];
                    const activeFmtArray = [...new Set(rawFmts)];
                  %>
                  <% activeFmtArray.forEach(fmt => { %>
                    <span class="detected-fmt-pill" style="background: #EDE7F6; color: #5E35B1; font-weight: 800; font-size: 0.76rem; padding: 4px 12px; border-radius: 6px; text-transform: uppercase;">
                      <%= fmt %>
                    </span>
                  <% }) %>
                </div>

                <div>
                  <label class="form-label-custom" style="font-size: 0.78rem;">Formats String (shown on storefront)</label>
                  <input type="text" name="formats" id="formatsInput" class="form-control-custom" value="<%= (design && design.formats) ? design.formats : 'DST, PES, JEF, EXP' %>" placeholder="e.g. DST, PES, JEF, EXP" style="height: 38px; font-size: 0.85rem;">
                </div>
              </div>
            </div>

            <!-- Card 3: Ratings & Review Metadata -->
            <div class="form-section-card">
              <h3>Ratings & Review Metadata</h3>

              <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.2rem;">
                <div>
                  <label class="form-label-custom">Displayed Rating (0.0 – 5.0)</label>
                  <input type="number" step="0.1" min="0" max="5" name="average_rating" class="form-control-custom" value="<%= design ? (design.average_rating !== undefined && design.average_rating !== null ? design.average_rating : 0) : 0 %>" placeholder="e.g. 4.8">
                  <span style="font-size: 0.72rem; color: var(--admin-text-muted); display: block; margin-top: 4px;">Controls customer page star rating score.</span>
                </div>

                <div>
                  <label class="form-label-custom">Review Count</label>
                  <input type="number" min="0" name="reviews_count" class="form-control-custom" value="<%= design ? (design.reviews_count !== undefined && design.reviews_count !== null ? design.reviews_count : 0) : 0 %>" placeholder="e.g. 0" required>
                  <span style="font-size: 0.72rem; color: var(--admin-text-muted); display: block; margin-top: 4px;">Number of customer reviews for this design.</span>
                </div>
              </div>
            </div>

            <!-- Card 4: Additional Options -->
            <div class="form-section-card">
              <h3>Additional Options</h3>

              <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.2rem;">
                <div>
                  <label class="switch-toggle">
                    <input type="checkbox" name="is_featured" value="1" <%= (design && design.is_featured) ? 'checked' : '' %>>
                    <span class="slider-round"></span>
                    <div>
                      <strong style="display: block; font-size: 0.82rem; color: var(--admin-text-dark);">Featured Design</strong>
                      <span style="font-size: 0.72rem; color: var(--admin-text-muted);">Show on homepage</span>
                    </div>
                  </label>
                </div>

                <div>
                  <label class="switch-toggle">
                    <input type="checkbox" name="is_trending" value="1" <%= (design && design.is_trending) ? 'checked' : '' %>>
                    <span class="slider-round"></span>
                    <div>
                      <strong style="display: block; font-size: 0.82rem; color: var(--admin-text-dark);">Trending Design</strong>
                      <span style="font-size: 0.72rem; color: var(--admin-text-muted);">Show in trending section</span>
                    </div>
                  </label>
                </div>
              </div>
            </div>

          </div>

          <!-- RIGHT COLUMN -->
          <div>
            <!-- Card 1: Preview Images (Public Customer Gallery) -->
            <div class="form-section-card" id="previewImagesSection">
              <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.4rem;">
                <div style="display: flex; align-items: center; gap: 8px;">
                  <i class="fa-regular fa-images" style="color: var(--admin-primary); font-size: 1.2rem;"></i>
                  <h3 style="margin: 0; font-size: 1.1rem; font-weight: 800;">Preview Images (Public Gallery)</h3>
                </div>
                <span style="font-size: 0.75rem; background: #E3F2FD; color: #1565C0; font-weight: 700; padding: 3px 10px; border-radius: 12px;">
                  <i class="fa-solid fa-globe"></i> Public View
                </span>
              </div>
              <p style="font-size: 0.8rem; color: var(--admin-text-muted); margin: 0 0 1.1rem 0;">
                Customer product page gallery images (PNG, JPG, WEBP). Select one as <strong>Primary</strong> for product cards. Reorder by dragging or arrow buttons.
              </p>

              <!-- Hidden input holding staged preview images when creating new design -->
              <input type="hidden" name="staged_images" id="stagedImagesInput" value="[]">

              <!-- Main Preview Image Box: Flexible height, object-fit: contain to show FULL portrait & landscape images without cropping -->
              <div id="mainPreviewBox" style="border-radius: 14px; overflow: hidden; border: 1px solid var(--admin-border); min-height: 220px; max-height: 420px; width: 100%; background: #FAF6F0; margin-bottom: 1.1rem; position: relative; display: flex; align-items: center; justify-content: center; padding: 10px;">
                <% if (design && design.primary_image) { %>
                  <img id="mainImagePreview" src="<%= design.primary_image %>" alt="Embroidery Design Preview" style="max-width: 100%; max-height: 400px; width: auto; height: auto; object-fit: contain; border-radius: 8px; box-shadow: 0 4px 14px rgba(0,0,0,0.06);">
                  <div id="noPreviewState" style="display: none; flex-direction: column; align-items: center; justify-content: center; padding: 2.5rem 1rem; color: var(--admin-text-muted);">
                    <i class="fa-regular fa-image" style="font-size: 2.5rem; margin-bottom: 0.5rem; opacity: 0.5; display: block;"></i>
                    <span style="font-size: 0.88rem; font-weight: 500;">No preview image uploaded</span>
                  </div>
                <% } else { %>
                  <img id="mainImagePreview" src="" alt="Embroidery Design Preview" style="display: none; max-width: 100%; max-height: 400px; width: auto; height: auto; object-fit: contain; border-radius: 8px; box-shadow: 0 4px 14px rgba(0,0,0,0.06);">
                  <div id="noPreviewState" style="display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 2.5rem 1rem; color: var(--admin-text-muted);">
                    <i class="fa-regular fa-image" style="font-size: 2.5rem; margin-bottom: 0.5rem; opacity: 0.5; display: block;"></i>
                    <span style="font-size: 0.88rem; font-weight: 500;">No preview image uploaded</span>
                  </div>
                <% } %>
              </div>

              <!-- Drag & Drop Zone for Preview Images -->
              <div id="previewImagesDropzone" class="dropzone-box" style="border: 2px dashed var(--admin-border); border-radius: 12px; padding: 1.2rem 1rem; text-align: center; background: #FAF6F0; cursor: pointer; transition: all 0.2s ease;">
                <i class="fa-solid fa-camera" style="font-size: 1.8rem; color: var(--admin-primary); margin-bottom: 4px; display: block;"></i>
                <strong style="display: block; font-size: 0.88rem; color: var(--admin-text-dark); margin-bottom: 2px;">Add Preview Images (Multiple)</strong>
                <span style="font-size: 0.74rem; color: var(--admin-text-muted); display: block; margin-bottom: 10px;">Drag PNG/JPG/WEBP or click to choose (Chunked upload)</span>
                <button type="button" class="btn" style="background: #1A252C; color: #FFFFFF; font-weight: 600; border-radius: 8px; font-size: 0.78rem; padding: 6px 16px; border: none; cursor: pointer;" onclick="document.getElementById('multiPreviewImageInput').click()">
                  <i class="fa-solid fa-plus"></i> Select Images
                </button>
                <input type="file" id="multiPreviewImageInput" multiple accept="image/png,image/jpeg,image/webp,.png,.jpg,.jpeg,.webp" style="display: none;" onchange="handlePreviewImagesSelect(this.files)">
              </div>

              <!-- Upload Progress Box for Preview Images -->
              <div id="previewUploadProgressBox" class="upload-progress-box" style="display: none; background: #FFFFFF; border: 1px solid var(--admin-border); border-radius: 10px; padding: 10px 14px; margin-top: 10px;">
                <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 6px;">
                  <strong id="previewUploadStatusText" style="font-size: 0.8rem; color: var(--admin-text-dark);">Uploading images...</strong>
                  <span id="previewUploadPercent" style="font-size: 0.76rem; font-weight: 700; color: var(--admin-primary);">0%</span>
                </div>
                <div style="height: 6px; background: #F1E9E0; border-radius: 4px; overflow: hidden;">
                  <div id="previewProgressBarInner" class="progress-bar-inner" style="height: 100%; width: 0%; background: var(--admin-primary); transition: width 0.2s ease;"></div>
                </div>
              </div>

              <!-- Thumbnails Grid with Primary selection & reorder controls -->
              <div id="previewImagesGrid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(95px, 1fr)); gap: 10px; margin-top: 14px;">
                <%
                  const existingPreviewImages = (design && design.images && design.images.length > 0) ? design.images : [];
                %>
                <% existingPreviewImages.forEach((img, idx) => { %>
                  <div class="preview-grid-card <%= img.is_primary ? 'is-primary-card' : '' %>" data-image-id="<%= img.id %>" data-sort="<%= img.display_order || idx %>" style="position: relative; border-radius: 10px; border: <%= img.is_primary ? '2px solid var(--admin-primary)' : '1px solid var(--admin-border)' %>; background: #FAF6F0; padding: 6px; text-align: center; box-shadow: 0 2px 6px rgba(0,0,0,0.03);">
                    <% if (img.is_primary) { %>
                      <span class="primary-badge-tag" style="position: absolute; top: -6px; left: 6px; background: var(--admin-primary); color: #FFF; font-size: 0.58rem; font-weight: 800; padding: 2px 6px; border-radius: 4px; text-transform: uppercase;">PRIMARY</span>
                    <% } %>
                    <img src="<%= img.image_url %>" onclick="setMainPreview('<%= img.image_url %>', this)" alt="Preview <%= idx + 1 %>" style="width: 100%; height: 70px; object-fit: contain; border-radius: 6px; background: #FFFFFF; cursor: pointer;">
                    
                    <div style="display: flex; align-items: center; justify-content: center; gap: 4px; margin-top: 6px;">
                      <button type="button" class="btn btn-sm" onclick="moveImageLeft(this)" title="Move Left" style="background: #EFE6D9; padding: 3px 6px; border-radius: 4px; border: none; cursor: pointer; font-size: 0.65rem;">
                        <i class="fa-solid fa-arrow-left"></i>
                      </button>
                      <button type="button" class="btn btn-sm <%= img.is_primary ? 'active-star' : '' %>" onclick="makePrimaryImageRecord('<%= design.id %>', '<%= img.id %>', this)" title="<%= img.is_primary ? 'Primary Image' : 'Set as Primary' %>" style="background: <%= img.is_primary ? '#FFD700' : '#EFE6D9' %>; color: <%= img.is_primary ? '#B86B35' : '#7F8C8D' %>; padding: 3px 6px; border-radius: 4px; border: none; cursor: pointer; font-size: 0.72rem;">
                        <i class="fa-solid fa-star"></i>
                      </button>
                      <button type="button" class="btn btn-sm" onclick="moveImageRight(this)" title="Move Right" style="background: #EFE6D9; padding: 3px 6px; border-radius: 4px; border: none; cursor: pointer; font-size: 0.65rem;">
                        <i class="fa-solid fa-arrow-right"></i>
                      </button>
                      <button type="button" class="btn btn-sm" onclick="deletePreviewImageRecord('<%= design.id %>', '<%= img.id %>', this)" title="Delete Image" style="background: #FFEBEE; color: #C62828; padding: 3px 6px; border-radius: 4px; border: none; cursor: pointer; font-size: 0.65rem;">
                        <i class="fa-solid fa-xmark"></i>
                      </button>
                    </div>
                  </div>
                <% }) %>
              </div>
            </div>

            <!-- Card 2: Pricing & Availability -->
            <div class="form-section-card">
              <h3>Pricing & Availability</h3>

              <!-- 3-Col: Original Price, Discount Price, Discount % -->
              <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1.0rem; margin-bottom: 1.2rem;">
                <div>
                  <label class="form-label-custom">Original Price / MRP (₹) <span class="req">*</span></label>
                  <input type="number" step="0.01" min="0" name="price" id="originalPrice" class="form-control-custom" value="<%= design ? design.price : '120' %>" required oninput="calcDiscount()">
                </div>

                <div>
                  <label class="form-label-custom">Final Selling Price (₹) <span class="req">*</span></label>
                  <input type="number" step="0.01" min="0" name="sale_price" id="discountPrice" class="form-control-custom" value="<%= design ? (design.sale_price !== null && design.sale_price !== undefined ? design.sale_price : design.price) : '45' %>" oninput="calcDiscount()">
                </div>

                <div>
                  <label class="form-label-custom">Discount (%)</label>
                  <div style="position: relative;">
                    <input type="text" id="discountPercent" class="form-control-custom" value="<%= (!design) ? '62.5%' : '' %>" readonly style="background: #FAF6F0;">
                    <i class="fa-solid fa-arrows-rotate" onclick="calcDiscount()" style="position: absolute; right: 10px; top: 50%; transform: translateY(-50%); font-size: 0.75rem; color: var(--admin-text-muted); cursor: pointer;" title="Recalculate"></i>
                  </div>
                </div>
              </div>

              <!-- 2-Col: Status & Download Count -->
              <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.2rem; align-items: center;">
                <div>
                  <label class="form-label-custom">Status</label>
                  <label class="switch-toggle">
                    <input type="checkbox" name="is_active" value="1" <%= (design && design.is_active) || (!design) ? 'checked' : '' %>>
                    <span class="slider-round"></span>
                    <span style="font-size: 0.82rem; font-weight: 500; color: var(--admin-text-dark);">Active (Visible on website)</span>
                  </label>
                </div>

                <div>
                  <label class="form-label-custom">Download Count</label>
                  <div style="position: relative;">
                    <input type="number" name="download_count" class="form-control-custom" value="<%= design ? (design.download_count !== undefined && design.download_count !== null ? design.download_count : (design.total_sales || 0)) : 0 %>">
                    <i class="fa-regular fa-circle-question" style="position: absolute; right: 10px; top: 50%; transform: translateY(-50%); font-size: 0.8rem; color: var(--admin-text-muted);" title="Tracked customer downloads count"></i>
                  </div>
                </div>
              </div>
            </div>

            <!-- Card 3: Tags (Optional) -->
            <div class="form-section-card">
              <h3>Tags (Optional)</h3>

              <input type="hidden" name="tags" id="tagsHiddenInput" value="<%= design ? (design.tags || '') : '' %>">
              <div id="tagPillsContainer" style="border: 1px solid var(--admin-border); border-radius: 10px; padding: 8px 10px; background: #FFFFFF; min-height: 44px; display: flex; flex-wrap: wrap; align-items: center; gap: 4px;">
                <!-- Tag Pills inserted dynamically via JS -->
                <input type="text" id="tagTextInput" placeholder="Type and press Enter to add tag..." style="border: none; outline: none; font-size: 0.8rem; background: transparent; flex: 1; min-width: 160px;" onkeydown="handleTagKeyDown(event)">
              </div>
            </div>

            <!-- Action Buttons Row -->
            <div style="display: flex; gap: 1rem; justify-content: flex-end; margin-top: 2rem;">
              <button type="submit" id="draftBtn" name="status_draft" value="1" class="btn btn-outline" style="height: 46px; border-radius: 10px; font-size: 0.88rem; font-weight: 600; padding: 0 1.4rem; background: #FFFFFF;">
                <i class="fa-regular fa-file"></i> Save as Draft
              </button>

              <button type="submit" id="publishBtn" class="btn btn-primary" style="height: 46px; border-radius: 10px; font-size: 0.88rem; font-weight: 600; padding: 0 1.6rem; display: inline-flex; align-items: center; gap: 8px;">
                <i class="fa-regular fa-paper-plane"></i> Publish Design
              </button>
            </div>

          </div>

        </div>
      </form>

    </main>
  </div>
</div>

<!-- Remove ZIP Package Confirmation Modal -->
<div id="removeZipModal" style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); backdrop-filter: blur(3px); display: none; align-items: center; justify-content: center; z-index: 99999; padding: 1rem;">
  <div style="background: #FFFFFF; border-radius: 16px; padding: 1.8rem; width: 100%; max-width: 440px; box-shadow: 0 10px 40px rgba(0,0,0,0.2); position: relative; border: 1px solid var(--admin-border);">
    <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 1rem;">
      <div style="width: 42px; height: 42px; border-radius: 50%; background: #FFEBEE; color: #C62828; display: flex; align-items: center; justify-content: center; font-size: 1.2rem; flex-shrink: 0;">
        <i class="fa-regular fa-trash-can"></i>
      </div>
      <div>
        <h3 style="font-family: var(--font-heading); font-size: 1.25rem; font-weight: 700; color: var(--admin-text-dark); margin: 0 0 2px 0;">Remove uploaded ZIP?</h3>
        <span style="font-size: 0.8rem; color: var(--admin-text-muted);">Remove machine file package</span>
      </div>
    </div>

    <p style="font-size: 0.88rem; color: var(--admin-text-dark); line-height: 1.5; margin-bottom: 1.5rem; background: #FAF6F0; padding: 10px 14px; border-radius: 10px; border-left: 3px solid #C62828;">
      All machine embroidery files inside this package will be removed.
    </p>

    <div style="display: flex; gap: 10px; justify-content: flex-end;">
      <button type="button" onclick="closeRemoveZipModal()" class="btn btn-outline" style="height: 40px; padding: 0 1.2rem; border-radius: 8px; font-weight: 600; font-size: 0.88rem;">Cancel</button>
      <button type="button" id="confirmRemoveZipBtn" onclick="executeRemoveZipPackage()" class="btn" style="height: 40px; padding: 0 1.4rem; border-radius: 8px; font-weight: 700; font-size: 0.88rem; background: #C62828; color: #FFFFFF; border: none; cursor: pointer;">Remove</button>
    </div>
  </div>
</div>

<!-- Replace ZIP Modal Component for Edit Page -->
<div id="replaceZipModal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.55); z-index: 99999; align-items: center; justify-content: center; backdrop-filter: blur(2px);">
  <div style="background: #FFFFFF; border-radius: 16px; width: 90%; max-width: 480px; box-shadow: 0 20px 40px rgba(0,0,0,0.2); overflow: hidden;">
    <div style="padding: 1.25rem 1.5rem; background: #FAF6F0; border-bottom: 1px solid var(--admin-border); display: flex; align-items: center; justify-content: space-between;">
      <h3 style="margin: 0; font-size: 1.05rem; color: var(--admin-text-dark); display: flex; align-items: center; gap: 8px;">
        <i class="fa-solid fa-file-zipper" style="color: #2E7D32;"></i> Replace Machine File (ZIP)
      </h3>
      <button type="button" onclick="closeReplaceZipModal()" style="background: none; border: none; font-size: 1.3rem; color: var(--admin-text-muted); cursor: pointer;">&times;</button>
    </div>
    <form id="replaceZipForm" onsubmit="submitReplaceZip(event)" enctype="multipart/form-data" style="padding: 1.5rem;">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" id="replaceZipDesignId" name="designId">
      
      <p id="replaceZipTitle" style="font-size: 0.88rem; color: var(--admin-text-dark); font-weight: 600; margin-bottom: 1.2rem;"></p>
      
      <div style="margin-bottom: 1.2rem;">
        <label style="display: block; font-size: 0.8rem; font-weight: 600; color: var(--admin-text-dark); margin-bottom: 6px;">
          Select Machine File (.ZIP, .RAR, .DST, .PES, .JEF, .EXP)
        </label>
        <input type="file" id="replaceZipFileInput" name="file" accept=".zip,.rar,.dst,.pes,.jef,.exp" required style="display: block; width: 100%; padding: 8px; border: 1px solid var(--admin-border); border-radius: 8px; font-size: 0.85rem;">
        <span style="font-size: 0.74rem; color: var(--admin-text-muted); display: block; margin-top: 4px;">
          Machine formats (.dst, .pes, .jef, .exp) inside ZIP will be auto-detected.
        </span>
      </div>

      <div style="display: flex; gap: 10px; justify-content: flex-end;">
        <button type="button" onclick="closeReplaceZipModal()" style="padding: 8px 16px; border-radius: 8px; border: 1px solid var(--admin-border); background: #FFFFFF; color: var(--admin-text-dark); font-size: 0.85rem; font-weight: 600; cursor: pointer;">Cancel</button>
        <button type="submit" id="replaceZipSubmitBtn" style="padding: 8px 20px; border-radius: 8px; border: none; background: #2E7D32; color: #FFFFFF; font-size: 0.85rem; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 6px;">
          <i class="fa-solid fa-cloud-arrow-up"></i> Upload & Replace ZIP
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  function openReplaceZipModal(designId, designTitle) {
    const modal = document.getElementById('replaceZipModal');
    const idInput = document.getElementById('replaceZipDesignId');
    const titleP = document.getElementById('replaceZipTitle');
    const fileInput = document.getElementById('replaceZipFileInput');
    if (!modal) return;
    if (idInput) idInput.value = designId || '';
    if (titleP) titleP.textContent = designTitle ? `Replace machine file for: "${designTitle}"` : `Replace machine file for Design #${designId}`;
    if (fileInput) fileInput.value = '';
    modal.style.display = 'flex';
  }

  function closeReplaceZipModal() {
    const modal = document.getElementById('replaceZipModal');
    if (modal) modal.style.display = 'none';
  }

  async function submitReplaceZip(e) {
    e.preventDefault();
    const idInput = document.getElementById('replaceZipDesignId');
    const fileInput = document.getElementById('replaceZipFileInput');
    const submitBtn = document.getElementById('replaceZipSubmitBtn');
    if (!idInput || !fileInput || !fileInput.files || fileInput.files.length === 0) return;

    const file = fileInput.files[0];
    const designId = idInput.value;
    const formData = new FormData();
    formData.append('file', file);
    formData.append('designId', designId);
    formData.append('_csrf', '<%= csrfToken %>');

    const origBtnHtml = submitBtn.innerHTML;
    submitBtn.disabled = true;
    submitBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Uploading...';

    try {
      const res = await fetch(`/admin/designs/replace-zip/${designId}`, {
        method: 'POST',
        headers: {
          'Accept': 'application/json',
          'X-CSRF-Token': '<%= csrfToken %>'
        },
        body: formData
      });
      const data = await res.json();
      if (!res.ok || !data.success) {
        throw new Error(data.message || 'Failed to replace machine file.');
      }
      closeReplaceZipModal();
      window.location.reload();
    } catch (err) {
      alert(`Replace ZIP Error: ${err.message}`);
    } finally {
      submitBtn.disabled = false;
      submitBtn.innerHTML = origBtnHtml;
    }
  }

  let tagList = [];

  function toggleFormatBox(fmt) {
    const chk = document.getElementById('chk' + fmt);
    const box = document.getElementById('box_' + fmt);
    if (box) {
      box.style.display = chk && chk.checked ? 'block' : 'none';
    }
  }

  function validateFormatFile(input, fmt) {
    if (input.files && input.files.length > 0) {
      const file = input.files[0];
      const ext = file.name.split('.').pop().toLowerCase();
      const allowedExts = [fmt.toLowerCase(), 'zip', 'rar', '7z'];
      if (!allowedExts.includes(ext)) {
        alert(`Invalid file extension .${ext}! For ${fmt} format, please upload a .${fmt.toLowerCase()} file or a .zip archive containing ${fmt} format.`);
        input.value = '';
      }
    }
  }

  let isSkuManuallyEdited = false;

  function autoGenerateSku(force = false) {
    const catSelect = document.getElementById('categorySelect');
    const skuInput = document.getElementById('skuInput');
    if (!catSelect || !skuInput) return;

    const catId = catSelect.value;
    if (!catId) return;

    const currentDesignId = '<%= design ? design.id : "" %>';
    fetch(`/admin/designs/next-sku?category_id=${catId}&current_id=${currentDesignId}`)
      .then(res => res.json())
      .then(data => {
        if (data.success && data.sku) {
          skuInput.value = data.sku;
          if (force) {
            isSkuManuallyEdited = false;
          }
        }
      })
      .catch(err => {
        console.warn('[autoGenerateSku Error]:', err);
      });
  }

  function forceAutoGenerateSku() {
    autoGenerateSku(true);
  }

  function onCategoryChange() {
    const skuInput = document.getElementById('skuInput');
    const currentVal = skuInput ? skuInput.value.trim() : '';
    // Standard SKU pattern like AED-BLO-01 or empty input can be safely updated
    const isStandardAedPattern = /^AED-[A-Z]{2,4}-\d+$/i.test(currentVal);

    if (!isSkuManuallyEdited || !currentVal || isStandardAedPattern) {
      autoGenerateSku(false);
    }
  }

  document.addEventListener('DOMContentLoaded', function() {
    calcDiscount();
    initTags();
    initDragAndDrop();
    initFormSubmit();
    autoCalculateTotalStitches();

    const skuInput = document.getElementById('skuInput');
    if (skuInput) {
      skuInput.addEventListener('input', function() {
        isSkuManuallyEdited = true;
      });
    }

    <% if (!design) { %>
      if (document.getElementById('categorySelect') && document.getElementById('categorySelect').value && !document.getElementById('skuInput').value) {
        autoGenerateSku();
      }
    <% } %>
  });

  // =========================================================================
  // MULTIPLE FILES PER DESIGN - CHUNKED UPLOAD & REORDERING
  // Handled idempotently by /public/js/admin/design-files.js
  // =========================================================================
  window.currentDesignId = '<%= design ? design.id : "" %>';
  let stagedPreviewImages = [];

  function getCsrfToken() {
    return document.querySelector('input[name="_csrf"]')?.value || '<%= typeof csrfToken !== "undefined" ? csrfToken : "" %>';
  }

  // Handle Preview Images Drag & Drop + Selection
  async function handlePreviewImagesSelect(files) {
    if (!files || files.length === 0) return;
    const fileList = Array.from(files);

    const currentCards = document.querySelectorAll('#previewImagesGrid .preview-grid-card').length;
    if (currentCards + fileList.length > 20) {
      alert('Maximum 20 preview images allowed per design.');
      return;
    }

    const pBox = document.getElementById('previewUploadProgressBox');
    const pText = document.getElementById('previewUploadStatusText');
    const pBar = document.getElementById('previewProgressBarInner');
    const pPct = document.getElementById('previewUploadPercent');
    if (pBox) pBox.style.display = 'block';

    for (let i = 0; i < fileList.length; i++) {
      const f = fileList[i];
      if (pText) pText.textContent = `Uploading ${f.name} (${i + 1}/${fileList.length})...`;
      if (pBar) pBar.style.width = '0%';
      if (pPct) pPct.textContent = '0%';

      try {
        const result = await uploadFileInChunks(f, 'preview', (pct) => {
          if (pBar) pBar.style.width = pct + '%';
          if (pPct) pPct.textContent = pct + '%';
        });

        if (!currentDesignId) {
          const isPrimary = stagedPreviewImages.length === 0;
          result.file.is_primary = isPrimary;
          stagedPreviewImages.push(result.file);
          document.getElementById('stagedImagesInput').value = JSON.stringify(stagedPreviewImages);
        }

        appendPreviewImageCard(result.file);
      } catch (err) {
        alert(`Error uploading "${f.name}": ${err.message}`);
      }
    }

    if (pBox) setTimeout(() => { pBox.style.display = 'none'; }, 1000);
    const pin = document.getElementById('multiPreviewImageInput');
    if (pin) pin.value = '';
  }

  function appendPreviewImageCard(imgInfo) {
    const grid = document.getElementById('previewImagesGrid');
    const imgId = imgInfo.id || ('staged_img_' + Date.now());
    const isPrim = Boolean(imgInfo.is_primary);

    const card = document.createElement('div');
    card.className = `preview-grid-card ${isPrim ? 'is-primary-card' : ''}`;
    card.dataset.imageId = imgId;
    card.style.cssText = `position: relative; border-radius: 10px; border: ${isPrim ? '2px solid var(--admin-primary)' : '1px solid var(--admin-border)'}; background: #FAF6F0; padding: 6px; text-align: center; box-shadow: 0 2px 6px rgba(0,0,0,0.03);`;
    card.innerHTML = `
      ${isPrim ? '<span class="primary-badge-tag" style="position: absolute; top: -6px; left: 6px; background: var(--admin-primary); color: #FFF; font-size: 0.58rem; font-weight: 800; padding: 2px 6px; border-radius: 4px; text-transform: uppercase;">PRIMARY</span>' : ''}
      <img src="${imgInfo.image_url}" onclick="setMainPreview('${imgInfo.image_url}', this)" alt="Preview" style="width: 100%; height: 70px; object-fit: contain; border-radius: 6px; background: #FFFFFF; cursor: pointer;">
      <div style="display: flex; align-items: center; justify-content: center; gap: 4px; margin-top: 6px;">
        <button type="button" class="btn btn-sm" onclick="moveImageLeft(this)" title="Move Left" style="background: #EFE6D9; padding: 3px 6px; border-radius: 4px; border: none; cursor: pointer; font-size: 0.65rem;">
          <i class="fa-solid fa-arrow-left"></i>
        </button>
        <button type="button" class="btn btn-sm ${isPrim ? 'active-star' : ''}" onclick="makePrimaryImageRecord('${currentDesignId}', '${imgId}', this)" title="${isPrim ? 'Primary Image' : 'Set as Primary'}" style="background: ${isPrim ? '#FFD700' : '#EFE6D9'}; color: ${isPrim ? '#B86B35' : '#7F8C8D'}; padding: 3px 6px; border-radius: 4px; border: none; cursor: pointer; font-size: 0.72rem;">
          <i class="fa-solid fa-star"></i>
        </button>
        <button type="button" class="btn btn-sm" onclick="moveImageRight(this)" title="Move Right" style="background: #EFE6D9; padding: 3px 6px; border-radius: 4px; border: none; cursor: pointer; font-size: 0.65rem;">
          <i class="fa-solid fa-arrow-right"></i>
        </button>
        <button type="button" class="btn btn-sm" onclick="deletePreviewImageRecord('${currentDesignId}', '${imgId}', this)" title="Delete Image" style="background: #FFEBEE; color: #C62828; padding: 3px 6px; border-radius: 4px; border: none; cursor: pointer; font-size: 0.65rem;">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>
    `;
    grid.appendChild(card);

    const mainImg = document.getElementById('mainImagePreview');
    const noState = document.getElementById('noPreviewState');
    if (mainImg) {
      if (isPrim || !mainImg.src || mainImg.style.display === 'none') {
        mainImg.src = imgInfo.image_url;
      }
      mainImg.style.display = 'block';
    }
    if (noState) noState.style.display = 'none';
  }

  async function makePrimaryImageRecord(designId, imageId, btn) {
    if (designId && !String(imageId).startsWith('staged_')) {
      const token = getCsrfToken();
      await fetch(`/admin/api/designs/${designId}/images/set-primary/${imageId}`, {
        method: 'POST',
        headers: { 'X-CSRF-Token': token }
      });
    } else {
      stagedPreviewImages.forEach(img => {
        img.is_primary = (img.id === imageId || img.file_id === imageId);
      });
      document.getElementById('stagedImagesInput').value = JSON.stringify(stagedPreviewImages);
    }

    document.querySelectorAll('#previewImagesGrid .preview-grid-card').forEach(c => {
      c.classList.remove('is-primary-card');
      c.style.border = '1px solid var(--admin-border)';
      const tag = c.querySelector('.primary-badge-tag');
      if (tag) tag.remove();
      const star = c.querySelector('.btn i.fa-star')?.parentElement;
      if (star) {
        star.style.background = '#EFE6D9';
        star.style.color = '#7F8C8D';
      }
    });

    const card = btn.closest('.preview-grid-card');
    if (card) {
      card.classList.add('is-primary-card');
      card.style.border = '2px solid var(--admin-primary)';
      const tag = document.createElement('span');
      tag.className = 'primary-badge-tag';
      tag.style.cssText = 'position: absolute; top: -6px; left: 6px; background: var(--admin-primary); color: #FFF; font-size: 0.58rem; font-weight: 800; padding: 2px 6px; border-radius: 4px; text-transform: uppercase;';
      tag.textContent = 'PRIMARY';
      card.appendChild(tag);
      btn.style.background = '#FFD700';
      btn.style.color = '#B86B35';

      const img = card.querySelector('img');
      if (img) setMainPreview(img.src);
    }
  }

  async function deletePreviewImageRecord(designId, imageId, btn) {
    if (!confirm('Are you sure you want to delete this preview image?')) return;
    if (designId && !String(imageId).startsWith('staged_')) {
      const token = getCsrfToken();
      const res = await fetch(`/admin/api/designs/${designId}/images/delete/${imageId}`, {
        method: 'POST',
        headers: { 'X-CSRF-Token': token }
      });
      const data = await res.json();
      if (!res.ok || !data.success) {
        alert(data.message || 'Error deleting image');
        return;
      }
    } else {
      stagedPreviewImages = stagedPreviewImages.filter(img => img.id !== imageId && img.file_id !== imageId);
      document.getElementById('stagedImagesInput').value = JSON.stringify(stagedPreviewImages);
    }

    const card = btn.closest('.preview-grid-card');
    if (card) card.remove();

    const remaining = document.querySelectorAll('#previewImagesGrid .preview-grid-card img');
    const mainImg = document.getElementById('mainImagePreview');
    const noState = document.getElementById('noPreviewState');
    if (remaining.length > 0 && mainImg) {
      mainImg.src = remaining[0].src;
    } else if (mainImg) {
      mainImg.src = '';
      mainImg.style.display = 'none';
      if (noState) noState.style.display = 'flex';
    }
  }

  function moveImageLeft(btn) {
    const card = btn.closest('.preview-grid-card');
    if (card && card.previousElementSibling && card.previousElementSibling.classList.contains('preview-grid-card')) {
      card.parentNode.insertBefore(card, card.previousElementSibling);
      persistImagesOrder();
    }
  }

  function moveImageRight(btn) {
    const card = btn.closest('.preview-grid-card');
    if (card && card.nextElementSibling && card.nextElementSibling.classList.contains('preview-grid-card')) {
      card.parentNode.insertBefore(card.nextElementSibling, card);
      persistImagesOrder();
    }
  }

  async function persistImagesOrder() {
    const cards = Array.from(document.querySelectorAll('#previewImagesGrid .preview-grid-card'));
    const order = cards.map(c => c.dataset.imageId).filter(id => id && !id.startsWith('staged_'));
    if (currentDesignId && order.length > 0) {
      const token = getCsrfToken();
      await fetch(`/admin/api/designs/${currentDesignId}/images/reorder`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': token
        },
        body: JSON.stringify({ order, _csrf: token })
      });
    }
  }

  function setMainPreview(url) {
    const mainImg = document.getElementById('mainImagePreview');
    const noState = document.getElementById('noPreviewState');
    if (mainImg) {
      mainImg.src = url;
      mainImg.style.display = 'block';
    }
    if (noState) noState.style.display = 'none';
  }

  function initDragAndDrop() {
    // Preview images dropzone
    const prevDrop = document.getElementById('previewImagesDropzone');
    if (prevDrop) {
      ['dragenter', 'dragover'].forEach(evt => {
        prevDrop.addEventListener(evt, (e) => {
          e.preventDefault();
          e.stopPropagation();
          prevDrop.style.borderColor = 'var(--admin-primary)';
          prevDrop.style.background = '#FAF0E8';
        }, false);
      });
      ['dragleave', 'drop'].forEach(evt => {
        prevDrop.addEventListener(evt, (e) => {
          e.preventDefault();
          e.stopPropagation();
          prevDrop.style.borderColor = 'var(--admin-border)';
          prevDrop.style.background = '#FAF6F0';
        }, false);
      });
      prevDrop.addEventListener('drop', (e) => {
        if (e.dataTransfer && e.dataTransfer.files) {
          handlePreviewImagesSelect(e.dataTransfer.files);
        }
      }, false);
    }
  }

  function calcDiscount() {
    const orig = parseFloat(document.getElementById('originalPrice').value) || 0;
    const disc = parseFloat(document.getElementById('discountPrice').value) || 0;
    if (orig > 0 && disc >= 0) {
      if (disc > orig) {
        document.getElementById('discountPercent').value = 'Invalid (Selling > MRP)';
        return;
      }
      const pct = ((orig - disc) / orig) * 100;
      if (pct === 0) {
        document.getElementById('discountPercent').value = '0%';
      } else {
        const formatted = (pct % 1 === 0) ? (pct + '%') : (pct.toFixed(1) + '%');
        document.getElementById('discountPercent').value = formatted;
      }
    } else {
      document.getElementById('discountPercent').value = '0%';
    }
  }

