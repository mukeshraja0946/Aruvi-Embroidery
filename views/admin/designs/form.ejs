  function executeRemoveZipPackage() {
    if (!pendingRemoveDesignId) {
      resetZipUploadUI();
      closeRemoveZipModal();
      return;
    }

    const btn = document.getElementById('confirmRemoveZipBtn');
    if (btn) { btn.disabled = true; btn.textContent = 'Removing...'; }

    const csrfToken = document.querySelector('input[name="_csrf"]')?.value || '';

    fetch('/admin/designs/delete-all-files/' + pendingRemoveDesignId + '?format=json', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Accept': 'application/json',
        'X-Requested-With': 'XMLHttpRequest',
        'X-CSRF-Token': csrfToken
      },
      body: JSON.stringify({ _csrf: csrfToken })
    })
    .then(res => res.json())
    .then(data => {
      closeRemoveZipModal();
      if (btn) { btn.disabled = false; btn.textContent = 'Remove'; }
      if (data.success) {
        resetZipUploadUI();
      } else {
        alert(data.message || 'Unable to remove ZIP package.');
      }
    })
    .catch(err => {
      console.error(err);
      closeRemoveZipModal();
      if (btn) { btn.disabled = false; btn.textContent = 'Remove'; }
      alert('Error removing ZIP package: ' + err.message);
    });
  }

