  function initFormSubmit() {
    const form = document.getElementById('designForm');
    const publishBtn = document.getElementById('publishBtn');
    const draftBtn = document.getElementById('draftBtn');
    if (!form || !publishBtn) return;

    form.addEventListener('submit', async function(e) {
      e.preventDefault();

      const submitter = e.submitter || document.activeElement;
      const isDraft = submitter && (submitter.name === 'status_draft' || submitter.id === 'draftBtn');
      const targetBtn = isDraft ? draftBtn : publishBtn;
      const originalHtml = targetBtn ? targetBtn.innerHTML : '';

      if (publishBtn) publishBtn.disabled = true;
      if (draftBtn) draftBtn.disabled = true;

      if (targetBtn) {
        targetBtn.innerHTML = isDraft 
          ? '<i class="fa-solid fa-spinner fa-spin"></i> Saving Draft...' 
          : '<i class="fa-solid fa-spinner fa-spin"></i> Publishing...';
      }

      let isSuccess = false;

      try {
        autoCalculateTotalStitches();
        const formData = new FormData(form);
        formData.append('is_ajax', '1');
        if (isDraft) {
          formData.set('status_draft', '1');
          formData.set('is_active', '0');
        } else {
          formData.delete('status_draft');
          formData.set('is_active', '1');
        }

        const csrfToken = document.querySelector('input[name="_csrf"]')?.value || '';
        let actionUrl = form.getAttribute('action') || window.location.pathname;
        if (!actionUrl.includes('format=json')) {
          actionUrl += (actionUrl.includes('?') ? '&' : '?') + 'format=json';
        }

        const response = await fetch(actionUrl, {
          method: 'POST',
          headers: {
            'Accept': 'application/json',
            'X-Requested-With': 'XMLHttpRequest',
            'X-CSRF-Token': csrfToken
          },
          body: formData
        });

        let data;
        const contentType = response.headers.get('content-type');
        if (contentType && contentType.includes('application/json')) {
          data = await response.json();
        } else {
          if (response.ok) {
            data = { success: true, message: 'Design saved successfully!' };
          } else {
            data = { success: false, message: response.status === 401 || response.status === 403 ? 'Admin session expired. Please log in again.' : `Server error (${response.status})` };
          }
        }

        if (response.ok && data && data.success) {
          isSuccess = true;
          if (targetBtn) {
            targetBtn.innerHTML = isDraft 
              ? '<i class="fa-solid fa-check"></i> Draft Saved ✓' 
              : '<i class="fa-solid fa-check"></i> Published ✓';
            targetBtn.style.background = '#2E7D32';
            targetBtn.style.borderColor = '#2E7D32';
          }

          // Immediately update form fields with confirmed persisted values from server
          if (data.design) {
            const fVal = data.design.frontStitchCount ?? data.design.stitch_count_front;
            const bVal = data.design.backStitchCount ?? data.design.stitch_count_back;
            const sVal = data.design.sleeveStitchCount ?? data.design.stitch_count_sleeve;
            const tVal = data.design.totalStitchCount ?? data.design.stitch_count;

            if (fVal !== undefined && fVal !== null && fVal !== '') {
              const el = document.getElementById('stitchFrontInput');
              if (el) el.value = Number(fVal).toLocaleString();
            }
            if (bVal !== undefined && bVal !== null && bVal !== '') {
              const el = document.getElementById('stitchBackInput');
              if (el) el.value = Number(bVal).toLocaleString();
            }
            if (sVal !== undefined && sVal !== null && sVal !== '') {
              const el = document.getElementById('stitchSleeveInput');
              if (el) el.value = Number(sVal).toLocaleString();
            }
            if (tVal !== undefined && tVal !== null && tVal !== '') {
              const el = document.getElementById('stitchCountTotalHidden');
              if (el) el.value = tVal;
            }
            autoCalculateTotalStitches();
          }

          const flashAlert = document.getElementById('formFlashMessage');
          if (flashAlert) {
            flashAlert.className = 'alert alert-success';
            flashAlert.style.background = '#E8F5E9';
            flashAlert.style.color = '#2E7D32';
            flashAlert.innerHTML = `<i class="fa-solid fa-circle-check"></i> ${data.message || 'Design published successfully!'}`;
            flashAlert.style.display = 'flex';
          }

          // If a new design was created, update action and navigate to edit page
          if (data.redirectUrl) {
            form.setAttribute('action', data.redirectUrl + '?_csrf=' + encodeURIComponent(csrfToken));
            if (window.history && window.history.replaceState) {
              window.history.replaceState(null, '', data.redirectUrl);
            }

            if (!window.location.pathname.includes('/edit/')) {
              setTimeout(() => {
                window.location.href = data.redirectUrl;
              }, 800);
            } else {
              setTimeout(() => {
                if (publishBtn) {
                  publishBtn.disabled = false;
                  publishBtn.innerHTML = '<i class="fa-regular fa-paper-plane"></i> Publish Design';
                  publishBtn.style.background = '';
                  publishBtn.style.borderColor = '';
                }
                if (draftBtn) {
                  draftBtn.disabled = false;
                  draftBtn.innerHTML = '<i class="fa-regular fa-file"></i> Save as Draft';
                  draftBtn.style.background = '';
                  draftBtn.style.borderColor = '';
                }
              }, 1500);
            }
          }
        } else {
          if (data && data.redirectUrl && (response.status === 401 || response.status === 403 || (data.message && data.message.includes('expired')))) {
            const flashAlert = document.getElementById('formFlashMessage');
            if (flashAlert) {
              flashAlert.className = 'alert alert-error';
              flashAlert.style.background = '#FFEBEE';
              flashAlert.style.color = '#C62828';
              flashAlert.innerHTML = `<i class="fa-solid fa-circle-exclamation"></i> ${data.message || 'Session expired. Redirecting to login...'}`;
              flashAlert.style.display = 'flex';
            }
            setTimeout(() => {
              window.location.href = data.redirectUrl;
            }, 1200);
            return;
          }
          const msg = (data && (data.message || data.error)) 
            ? (data.message || data.error) 
            : (response.status === 401 || response.status === 403 ? 'Admin session expired. Please log in again.' : `Server error (${response.status})`);
          throw new Error(msg);
        }
      } catch (err) {
        console.error('[PUBLISH FORM ERROR]:', err);
        const userFriendlyMsg = (err.name === 'TypeError' && String(err.message).toLowerCase() === 'failed to fetch')
          ? 'Unable to connect to the server. Please check that the backend server is running.'
          : err.message;

        const flashAlert = document.getElementById('formFlashMessage');
        if (flashAlert) {
          flashAlert.className = 'alert alert-error';
          flashAlert.style.background = '#FFEBEE';
          flashAlert.style.color = '#C62828';
          flashAlert.innerHTML = `<i class="fa-solid fa-circle-exclamation"></i> ${userFriendlyMsg}`;
          flashAlert.style.display = 'flex';
        } else {
          alert(`Unable to publish design: ${userFriendlyMsg}`);
        }
      } finally {
        if (!isSuccess) {
          if (publishBtn) publishBtn.disabled = false;
          if (draftBtn) draftBtn.disabled = false;
          if (targetBtn && originalHtml) targetBtn.innerHTML = originalHtml;
        }
      }
    });
  }

  function cleanStitchNumber(str) {
    if (str === undefined || str === null) return null;
    const clean = String(str).trim().replace(/,/g, '');
    if (clean === '') return null;
    if (!/^\d+$/.test(clean)) return NaN;
    return parseInt(clean, 10);
  }

  function validateStitchField(inputEl, errorEl, fieldName) {
    if (!inputEl) return { valid: true, value: null };
    const raw = inputEl.value.trim();
    if (raw === '') {
      if (errorEl) { errorEl.textContent = ''; errorEl.style.display = 'none'; }
      inputEl.style.borderColor = 'var(--admin-border)';
      return { valid: true, value: null };
    }
    const val = cleanStitchNumber(raw);
    if (isNaN(val)) {
      const msg = `${fieldName} must be a whole number only.`;
      if (errorEl) { errorEl.textContent = msg; errorEl.style.display = 'block'; }
      inputEl.style.borderColor = '#C62828';
      return { valid: false, error: msg, value: NaN };
    }
    if (val < 0 || val > 10000000) {
      const msg = `${fieldName} must be between 0 and 10,000,000.`;
      if (errorEl) { errorEl.textContent = msg; errorEl.style.display = 'block'; }
      inputEl.style.borderColor = '#C62828';
      return { valid: false, error: msg, value: val };
    }
    if (errorEl) { errorEl.textContent = ''; errorEl.style.display = 'none'; }
    inputEl.style.borderColor = 'var(--admin-border)';
    return { valid: true, value: val };
  }

  function toggleStitchManualMode() {
    const manualHidden = document.getElementById('stitchTotalManualHidden');
    const totalInput = document.getElementById('stitchTotalInput');
    const badgeText = document.getElementById('stitchModeText');
    const actionHint = document.getElementById('stitchModeActionHint');
    const modeIcon = document.getElementById('stitchModeIcon');
    const modeBtn = document.getElementById('toggleStitchModeBtn');
    const statusEl = document.getElementById('stitchCountTotalStatus');
    if (!manualHidden || !totalInput) return;

    const isCurrentlyManual = manualHidden.value === '1';
    const setManual = !isCurrentlyManual;

    manualHidden.value = setManual ? '1' : '0';

    if (setManual) {
      // Switch to MANUAL override mode
      totalInput.readOnly = false;
      totalInput.style.background = '#FFFFFF';
      totalInput.style.color = 'var(--admin-text-dark)';
      totalInput.style.cursor = 'text';
      totalInput.style.borderColor = '#C7D2FE';
      totalInput.focus();

      if (badgeText) badgeText.textContent = 'Manual';
      if (actionHint) actionHint.textContent = '(Reset)';
      if (modeIcon) { modeIcon.className = 'fa-solid fa-pencil'; }
      if (modeBtn) {
        modeBtn.style.background = '#FEE2E2';
        modeBtn.style.borderColor = '#FCA5A5';
        modeBtn.style.color = '#B91C1C';
        modeBtn.title = 'Click to reset back to Auto calculation';
      }
      if (statusEl) {
        const curVal = cleanStitchNumber(totalInput.value);
        statusEl.innerHTML = (curVal !== null && !isNaN(curVal))
          ? `<span style="color: #B91C1C; font-weight: 600;"><i class="fa-solid fa-pen-to-square"></i> Manual Override: ${curVal.toLocaleString()}</span>`
          : `<span style="color: #B91C1C; font-weight: 600;"><i class="fa-solid fa-pen-to-square"></i> Manual Override: Type any total</span>`;
      }
    } else {
      // Switch back to AUTO calculation mode
      totalInput.readOnly = true;
      totalInput.style.cursor = 'not-allowed';

      if (badgeText) badgeText.textContent = 'Auto';
      if (actionHint) actionHint.textContent = '(Override)';
      if (modeIcon) { modeIcon.className = 'fa-solid fa-wand-magic-sparkles'; }
      if (modeBtn) {
        modeBtn.style.background = '#E0E7FF';
        modeBtn.style.borderColor = '#C7D2FE';
        modeBtn.style.color = '#3730A3';
        modeBtn.title = 'Click to override auto-calculation manually';
      }
      recalculateAutoStitchTotal();
    }
  }

  function clearStitchField(field) {
    if (field === 'front') {
      const el = document.getElementById('stitchFrontInput');
      const h = document.getElementById('frontStitchCountHidden');
      const err = document.getElementById('stitchFrontError');
      const btn = document.getElementById('stitchFrontClearBtn');
      if (el) el.value = '';
      if (h) h.value = '';
      if (err) { err.textContent = ''; err.style.display = 'none'; }
      if (btn) btn.style.display = 'none';
      if (el) el.style.borderColor = 'var(--admin-border)';
      handleStitchComponentInput('front');
    } else if (field === 'back') {
      const el = document.getElementById('stitchBackInput');
      const h = document.getElementById('backStitchCountHidden');
      const err = document.getElementById('stitchBackError');
      const btn = document.getElementById('stitchBackClearBtn');
      if (el) el.value = '';
      if (h) h.value = '';
      if (err) { err.textContent = ''; err.style.display = 'none'; }
      if (btn) btn.style.display = 'none';
      if (el) el.style.borderColor = 'var(--admin-border)';
      handleStitchComponentInput('back');
    } else if (field === 'sleeve') {
      const el = document.getElementById('stitchSleeveInput');
      const h = document.getElementById('sleeveStitchCountHidden');
      const err = document.getElementById('stitchSleeveError');
      const btn = document.getElementById('stitchSleeveClearBtn');
      if (el) el.value = '';
      if (h) h.value = '';
      if (err) { err.textContent = ''; err.style.display = 'none'; }
      if (btn) btn.style.display = 'none';
      if (el) el.style.borderColor = 'var(--admin-border)';
      handleStitchComponentInput('sleeve');
    } else if (field === 'total') {
      const el = document.getElementById('stitchTotalInput');
      const h1 = document.getElementById('stitchCountTotalHidden');
      const h2 = document.getElementById('totalStitchCountHidden');
      const btn = document.getElementById('stitchTotalClearBtn');
      const err = document.getElementById('stitchTotalError');
      const manualH = document.getElementById('stitchTotalManualHidden');
      const statusEl = document.getElementById('stitchCountTotalStatus');
      if (el) el.value = '';
      if (h1) h1.value = '';
      if (h2) h2.value = '';
      if (btn) btn.style.display = 'none';
      if (err) { err.textContent = ''; err.style.display = 'none'; }
      if (el) el.style.borderColor = 'var(--admin-border)';

      if (manualH && manualH.value === '1') {
        if (statusEl) statusEl.innerHTML = `<span style="color: #B91C1C; font-weight: 600;"><i class="fa-solid fa-pen-to-square"></i> Manual Override: Empty</span>`;
      } else {
        clearStitchField('front');
        clearStitchField('back');
        clearStitchField('sleeve');
      }
    }
  }

  function handleStitchComponentInput(component) {
    const frontEl = document.getElementById('stitchFrontInput');
    const backEl = document.getElementById('stitchBackInput');
    const sleeveEl = document.getElementById('stitchSleeveInput');
    const frontErr = document.getElementById('stitchFrontError');
    const backErr = document.getElementById('stitchBackError');
    const sleeveErr = document.getElementById('stitchSleeveError');

    const frontHidden = document.getElementById('frontStitchCountHidden');
    const backHidden = document.getElementById('backStitchCountHidden');
    const sleeveHidden = document.getElementById('sleeveStitchCountHidden');

    const frontClear = document.getElementById('stitchFrontClearBtn');
    const backClear = document.getElementById('stitchBackClearBtn');
    const sleeveClear = document.getElementById('stitchSleeveClearBtn');

    if (component === 'front') {
      const fCheck = validateStitchField(frontEl, frontErr, 'Front');
      if (frontHidden) frontHidden.value = fCheck.valid && fCheck.value !== null ? fCheck.value : '';
      if (frontClear) frontClear.style.display = (frontEl && frontEl.value.trim()) ? 'flex' : 'none';
    } else if (component === 'back') {
      const bCheck = validateStitchField(backEl, backErr, 'Back');
      if (backHidden) backHidden.value = bCheck.valid && bCheck.value !== null ? bCheck.value : '';
      if (backClear) backClear.style.display = (backEl && backEl.value.trim()) ? 'flex' : 'none';
    } else if (component === 'sleeve') {
      const sCheck = validateStitchField(sleeveEl, sleeveErr, 'Sleeve');
      if (sleeveHidden) sleeveHidden.value = sCheck.valid && sCheck.value !== null ? sCheck.value : '';
      if (sleeveClear) sleeveClear.style.display = (sleeveEl && sleeveEl.value.trim()) ? 'flex' : 'none';
    }

    const manualHidden = document.getElementById('stitchTotalManualHidden');
    if (!manualHidden || manualHidden.value !== '1') {
      recalculateAutoStitchTotal();
    }
  }

  function handleStitchTotalManualInput() {
    const totalInput = document.getElementById('stitchTotalInput');
    const totalError = document.getElementById('stitchTotalError');
    const totalHidden = document.getElementById('stitchCountTotalHidden');
    const totalCamelHidden = document.getElementById('totalStitchCountHidden');
    const statusEl = document.getElementById('stitchCountTotalStatus');
    const totalClear = document.getElementById('stitchTotalClearBtn');
    if (!totalInput) return;

    if (totalClear) totalClear.style.display = totalInput.value.trim() ? 'flex' : 'none';

    const tCheck = validateStitchField(totalInput, totalError, 'Total');
    if (tCheck.valid && tCheck.value !== null) {
      if (totalHidden) totalHidden.value = tCheck.value;
      if (totalCamelHidden) totalCamelHidden.value = tCheck.value;
      if (statusEl) {
        statusEl.innerHTML = `<span style="color: #B91C1C; font-weight: 600;"><i class="fa-solid fa-pen-to-square"></i> Manual Override: ${tCheck.value.toLocaleString()}</span>`;
      }
    } else if (tCheck.valid && tCheck.value === null) {
      if (totalHidden) totalHidden.value = '';
      if (totalCamelHidden) totalCamelHidden.value = '';
      if (statusEl) {
        statusEl.innerHTML = `<span style="color: var(--admin-text-muted);">Empty</span>`;
      }
    }
  }

  function recalculateAutoStitchTotal() {
    const frontEl = document.getElementById('stitchFrontInput');
    const backEl = document.getElementById('stitchBackInput');
    const sleeveEl = document.getElementById('stitchSleeveInput');
    const totalInput = document.getElementById('stitchTotalInput');
    const totalHidden = document.getElementById('stitchCountTotalHidden');
    const totalCamelHidden = document.getElementById('totalStitchCountHidden');
    const statusEl = document.getElementById('stitchCountTotalStatus');
    const totalClear = document.getElementById('stitchTotalClearBtn');
    if (!totalInput) return;

    const f = cleanStitchNumber(frontEl ? frontEl.value : '');
    const b = cleanStitchNumber(backEl ? backEl.value : '');
    const s = cleanStitchNumber(sleeveEl ? sleeveEl.value : '');

    const fValid = f !== null && !isNaN(f) && f >= 0;
    const bValid = b !== null && !isNaN(b) && b >= 0;
    const sValid = s !== null && !isNaN(s) && s >= 0;

    const hasAny = fValid || bValid || sValid;

    if (hasAny) {
      const sum = (fValid ? f : 0) + (bValid ? b : 0) + (sValid ? s : 0);
      totalInput.value = sum.toLocaleString();
      if (totalHidden) totalHidden.value = sum;
      if (totalCamelHidden) totalCamelHidden.value = sum;
      totalInput.style.color = '#B86B35';
      totalInput.style.background = '#F4EBE1';
      totalInput.style.borderColor = '#B86B35';
      if (totalClear) totalClear.style.display = 'flex';
      if (statusEl) {
        statusEl.innerHTML = `<span style="color: #2E7D32; font-weight: 600;"><i class="fa-solid fa-circle-check"></i> Auto Total: ${sum.toLocaleString()}</span>`;
      }
    } else {
      totalInput.value = '';
      if (totalHidden) totalHidden.value = '';
      if (totalCamelHidden) totalCamelHidden.value = '';
      totalInput.style.color = '#8C7E75';
      totalInput.style.background = '#FAF6F0';
      totalInput.style.borderColor = 'var(--admin-border)';
      if (totalClear) totalClear.style.display = 'none';
      if (statusEl) {
        statusEl.innerHTML = `<span style="color: var(--admin-text-muted);">Front + Back + Sleeve</span>`;
      }
    }
  }

  // Alias for backward compatibility
  function autoCalculateTotalStitches() {
    const manualHidden = document.getElementById('stitchTotalManualHidden');
    if (!manualHidden || manualHidden.value !== '1') {
      recalculateAutoStitchTotal();
    }
  }
</script>

<script src="/js/admin/design-files.js"></script>

</body>
</html>

