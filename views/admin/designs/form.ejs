  function initTags() {
    const raw = document.getElementById('tagsHiddenInput').value || '';
    tagList = raw.split(',').map(t => t.trim()).filter(Boolean);
    renderTagPills();
  }

  function renderTagPills() {
    const container = document.getElementById('tagPillsContainer');
    const inputField = document.getElementById('tagTextInput');

    const existingPills = container.querySelectorAll('.tag-pill');
    existingPills.forEach(p => p.remove());

    tagList.forEach((tag, idx) => {
      const pill = document.createElement('span');
      pill.className = 'tag-pill';
      pill.innerHTML = `${tag} <i class="fa-solid fa-xmark" onclick="removeTag(${idx})"></i>`;
      container.insertBefore(pill, inputField);
    });

    document.getElementById('tagsHiddenInput').value = tagList.join(', ');
  }

  function handleTagKeyDown(e) {
    if (e.key === 'Enter' || e.key === ',') {
      e.preventDefault();
      const val = e.target.value.trim().replace(/,/g, '');
      if (val && !tagList.includes(val)) {
        tagList.push(val);
        renderTagPills();
      }
      e.target.value = '';
    }
  }

  function removeTag(index) {
    tagList.splice(index, 1);
    renderTagPills();
  }

  function handlePreviewImageSelect(input) {
    if (input.files && input.files[0]) {
      const file = input.files[0];
      const reader = new FileReader();
      reader.onload = function(e) {
        const mainImg = document.getElementById('mainImagePreview');
        const noState = document.getElementById('noPreviewState');
        if (mainImg) {
          mainImg.src = e.target.result;
          mainImg.style.display = 'block';
        }
        if (noState) {
          noState.style.display = 'none';
        }
      };
      reader.readAsDataURL(file);
    }
  }

