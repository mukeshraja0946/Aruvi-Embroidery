<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
  <title>Website Settings & Branding - ARUVI Admin</title>
  <link rel="icon" type="image/jpeg" href="<%= settings.favicon_url || '/public/images/logo.jpg' %>">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;1,400&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="/public/css/main.css">
  <link rel="stylesheet" href="/public/css/admin.css">
</head>
<body class="admin-body">

<div class="admin-wrapper">
  <!-- Top Header matching Reference -->
  <header class="admin-top-header">
    <a href="/admin" class="admin-header-brand">
      <% const currentLogo = (typeof siteSettings !== 'undefined' && siteSettings.logo_url) ? siteSettings.logo_url : ((typeof settings !== 'undefined' && settings.logo_url) ? settings.logo_url : '/public/images/logo.jpg'); %>
      <img src="<%= currentLogo %>" alt="ARUVI Admin Logo" style="max-height: 42px; width: auto; object-fit: contain;">
    </a>

    <!-- Global Search -->
    <div class="admin-search-bar">
      <i class="fa-solid fa-magnifying-glass"></i>
      <input type="text" placeholder="Search designs, orders, customers...">
    </div>

    <!-- Right User Header Icons -->
    <div class="admin-header-right">
      <a href="#" class="admin-icon-btn" title="Notifications">
        <i class="fa-regular fa-bell"></i>
        <span class="badge-count">3</span>
      </a>

      <div class="admin-user-menu">
        <div class="admin-user-avatar">A</div>
        <div class="admin-user-info">
          <strong>Admin</strong>
          <span>Administrator</span>
        </div>
        <i class="fa-solid fa-chevron-down" style="font-size: 0.75rem; color: var(--admin-text-muted); margin-left: 4px;"></i>
      </div>
    </div>
  </header>

  <!-- Admin Main Layout with Sidebar -->
  <div class="admin-main-container">
    <!-- Left Sidebar matching Reference -->
    <aside class="admin-sidebar">
      <ul class="sidebar-nav-list" style="margin-bottom: 1.2rem;">
        <li class="sidebar-nav-item">
          <a href="/admin">
            <span><i class="fa-solid fa-house"></i> Dashboard</span>
          </a>
        </li>
      </ul>

      <!-- DESIGNS Section -->
      <div class="admin-sidebar-section">
        <div class="sidebar-heading">DESIGNS</div>
        <ul class="sidebar-nav-list">
          <li class="sidebar-nav-item"><a href="/admin/designs"><span><i class="fa-solid fa-box-archive"></i> Manage Designs</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/designs/create"><span><i class="fa-solid fa-circle-plus"></i> Add New Design</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/categories"><span><i class="fa-solid fa-border-all"></i> Categories</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/custom-orders"><span><i class="fa-solid fa-wand-magic-sparkles"></i> Custom Orders</span></a></li>
        </ul>
      </div>

      <!-- ORDERS Section -->
      <div class="admin-sidebar-section">
        <div class="sidebar-heading">ORDERS</div>
        <ul class="sidebar-nav-list">
          <li class="sidebar-nav-item"><a href="/admin/orders"><span><i class="fa-regular fa-newspaper"></i> All Orders</span></a></li>
          <li class="sidebar-nav-item">
            <a href="/admin/orders?status=pending">
              <span><i class="fa-regular fa-clock"></i> Pending Orders</span>
              <span class="sidebar-badge">5</span>
            </a>
          </li>
          <li class="sidebar-nav-item"><a href="/admin/orders?status=completed"><span><i class="fa-regular fa-circle-check"></i> Completed Orders</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/orders?status=cancelled"><span><i class="fa-regular fa-circle-xmark"></i> Cancelled Orders</span></a></li>
        </ul>
      </div>

      <!-- CUSTOMERS Section -->
      <div class="admin-sidebar-section">
        <div class="sidebar-heading">CUSTOMERS</div>
        <ul class="sidebar-nav-list">
          <li class="sidebar-nav-item"><a href="/admin/customers"><span><i class="fa-solid fa-users"></i> All Customers</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/messages"><span><i class="fa-regular fa-comment-dots"></i> Enquiries</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/email-campaigns"><span><i class="fa-solid fa-paper-plane"></i> Email Campaigns 📧</span></a></li>
        </ul>
      </div>

          <!-- CONTENT Section -->
          <div class="admin-sidebar-section">
            <div class="sidebar-heading">CONTENT & SETTINGS</div>
            <ul class="sidebar-nav-list">
              <li class="sidebar-nav-item"><a href="/admin/homepage"><span><i class="fa-solid fa-house-chimney"></i> Homepage</span></a></li>
              <li class="sidebar-nav-item"><a href="/admin/banners"><span><i class="fa-regular fa-image"></i> Banners</span></a></li>
              <li class="sidebar-nav-item"><a href="/admin/settings#upi-details"><span><i class="fa-solid fa-qrcode"></i> UPI Details</span></a></li>
              <li class="sidebar-nav-item"><a href="/admin/settings#contact"><span><i class="fa-solid fa-location-dot"></i> Contact Info</span></a></li>
              <li class="sidebar-nav-item"><a href="/admin/settings" class="active"><span><i class="fa-solid fa-gear"></i> Website Settings</span></a></li>
            </ul>
          </div>

      <div style="margin-top: auto; padding-top: 1rem; border-top: 1px solid var(--admin-border);">
        <a href="/admin/logout" style="display: flex; align-items: center; gap: 8px; color: var(--admin-primary); font-size: 0.85rem; font-weight: 600; text-decoration: none; padding: 0.5rem 0.8rem;">
          <i class="fa-solid fa-arrow-right-from-bracket"></i> Logout Admin
        </a>
      </div>
    </aside>

    <!-- Main Content Body -->
    <main class="admin-content-body">

      <!-- Breadcrumbs & Header -->
      <div style="margin-bottom: 1.8rem;">
        <div style="font-size: 0.8rem; color: var(--admin-text-muted); margin-bottom: 0.4rem;">
          <a href="/admin" style="color: var(--admin-text-muted); text-decoration: none;">Dashboard</a> &nbsp;>&nbsp; <span style="color: var(--admin-primary); font-weight: 600;">Website Settings</span>
        </div>
        <h1 style="font-family: var(--font-heading); font-size: 2.2rem; font-weight: 700; color: var(--admin-text-dark); margin: 0 0 0.3rem;">Website Settings & Branding</h1>
        <p style="font-size: 0.88rem; color: var(--admin-text-muted); margin: 0;">Manage store branding, logos, contact details and social media links. Uploaded logos sync globally across all pages.</p>
      </div>

      <% const msgFlash = (typeof flash !== 'undefined' ? flash : (typeof _flash !== 'undefined' ? _flash : {})); %>
      <% if (msgFlash.success && msgFlash.success.length > 0) { %>
        <div id="adminToastPopup" style="position: fixed; top: 25px; right: 25px; background: #1B5E20; color: white; padding: 1.1rem 1.8rem; border-radius: 14px; box-shadow: 0 12px 30px rgba(0,0,0,0.25); z-index: 999999; display: flex; align-items: center; gap: 12px; font-weight: 600; font-size: 1rem; border: 2px solid #81C784;">
          <i class="fa-solid fa-circle-check" style="font-size: 1.5rem; color: #66BB6A;"></i>
          <span><%= msgFlash.success[0] %></span>
          <button type="button" onclick="this.parentElement.remove()" style="background: none; border: none; color: white; margin-left: 15px; cursor: pointer; font-size: 1.3rem;">&times;</button>
        </div>
        <script>
          setTimeout(() => {
            const popup = document.getElementById('adminToastPopup');
            if (popup) popup.style.display = 'none';
          }, 4500);
        </script>
        <div class="alert alert-success" style="margin-bottom: 1.5rem; border-radius: 10px;">
          <i class="fa-solid fa-circle-check"></i> <%= msgFlash.success[0] %>
        </div>
      <% } %>

      <form action="/admin/settings?_csrf=<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" method="POST" enctype="multipart/form-data">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <!-- Card 1: Branding & Logo Management (Requirement 5 & 6) -->
        <div class="admin-card-box" style="margin-bottom: 1.8rem; padding: 1.8rem;">
          <div style="border-bottom: 1px solid var(--admin-border); padding-bottom: 0.8rem; margin-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: center;">
            <div>
              <h3 style="font-family: var(--font-heading); font-size: 1.2rem; font-weight: 700; color: var(--admin-text-dark); margin: 0 0 4px;">Logo & Branding Management</h3>
              <span style="font-size: 0.78rem; color: var(--admin-text-muted);">Centralized logo source. Uploading a logo updates all customer & admin pages automatically.</span>
            </div>
            <span style="background: #E8F5E9; color: #2E7D32; padding: 3px 10px; border-radius: 12px; font-size: 0.75rem; font-weight: 600;"><i class="fa-solid fa-rotate"></i> Global Auto-Sync Enabled</span>
          </div>

          <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1.8rem;">
            <!-- Main Website Logo Upload -->
            <div style="background: #FAF6F0; border: 1px solid var(--admin-border); border-radius: 14px; padding: 1.4rem; text-align: center;">
              <strong style="display: block; font-size: 0.9rem; color: var(--admin-text-dark); margin-bottom: 0.5rem;">Main Website Logo</strong>
              
              <div class="logo-preview">
                <img id="mainLogoPreview" src="<%= settings.logo_url || '/public/images/logo.jpg' %>" alt="Main Website Logo">
              </div>

              <input type="file" name="logo_image" id="logoInput" accept="image/png, image/jpeg, image/jpg, image/webp, image/svg+xml" style="display: none;" onchange="previewImg(this, 'mainLogoPreview')">
              
              <div style="display: flex; gap: 10px; justify-content: center; align-items: center; margin-top: 0.5rem;">
                <button type="button" onclick="document.getElementById('logoInput').click()" class="btn btn-primary btn-sm" style="font-size: 0.78rem; border-radius: 8px;">
                  <i class="fa-solid fa-upload"></i> Replace Logo
                </button>
                <label style="display: inline-flex; align-items: center; gap: 4px; font-size: 0.75rem; color: var(--admin-primary); cursor: pointer;">
                  <input type="checkbox" name="remove_logo" value="1"> Reset Default
                </label>
              </div>
            </div>

            <!-- Mobile Navigation Logo Upload -->
            <div style="background: #FAF6F0; border: 1px solid var(--admin-border); border-radius: 14px; padding: 1.4rem; text-align: center;">
              <strong style="display: block; font-size: 0.9rem; color: var(--admin-text-dark); margin-bottom: 0.5rem;">Mobile Navigation Logo</strong>
              
              <div class="logo-preview">
                <img id="mobileLogoPreview" src="<%= settings.mobile_logo_url || settings.logo_url || '/public/images/logo.jpg' %>" alt="Mobile Navigation Logo">
              </div>

              <input type="file" name="mobile_logo_image" id="mobileLogoInput" accept="image/png, image/jpeg, image/jpg, image/webp, image/svg+xml" style="display: none;" onchange="previewImg(this, 'mobileLogoPreview')">
              
              <div style="display: flex; gap: 10px; justify-content: center; align-items: center; margin-top: 0.5rem;">
                <button type="button" onclick="document.getElementById('mobileLogoInput').click()" class="btn btn-outline btn-sm" style="font-size: 0.78rem; border-radius: 8px; background: #FFF;">
                  <i class="fa-solid fa-upload"></i> Upload Mobile Logo
                </button>
                <label style="display: inline-flex; align-items: center; gap: 4px; font-size: 0.75rem; color: var(--admin-primary); cursor: pointer;">
                  <input type="checkbox" name="remove_mobile_logo" value="1"> Reset Default
                </label>
              </div>
            </div>

            <!-- Favicon Upload -->
            <div style="background: #FAF6F0; border: 1px solid var(--admin-border); border-radius: 14px; padding: 1.4rem; text-align: center;">
              <strong style="display: block; font-size: 0.9rem; color: var(--admin-text-dark); margin-bottom: 0.5rem;">Browser Favicon (.ICO, .PNG)</strong>
              
              <div class="logo-preview">
                <img id="faviconPreview" src="<%= settings.favicon_url || '/public/images/logo.jpg' %>" alt="Favicon" style="max-height: 48px;">
              </div>

              <input type="file" name="favicon_image" id="faviconInput" accept="image/png, image/jpeg, image/jpg, image/x-icon, image/svg+xml" style="display: none;" onchange="previewImg(this, 'faviconPreview')">
              
              <div style="display: flex; gap: 10px; justify-content: center; align-items: center; margin-top: 0.5rem;">
                <button type="button" onclick="document.getElementById('faviconInput').click()" class="btn btn-outline btn-sm" style="font-size: 0.78rem; border-radius: 8px; background: #FFF;">
                  <i class="fa-solid fa-upload"></i> Upload Favicon
                </button>
                <label style="display: inline-flex; align-items: center; gap: 4px; font-size: 0.75rem; color: var(--admin-primary); cursor: pointer;">
                  <input type="checkbox" name="remove_favicon" value="1"> Reset Default
                </label>
              </div>
            </div>
          </div>
        </div>

        <!-- Card 2: Store Information -->
        <div class="admin-card-box" style="margin-bottom: 1.8rem; padding: 1.8rem;">
          <h3 style="font-family: var(--font-heading); font-size: 1.2rem; font-weight: 700; color: var(--admin-text-dark); margin: 0 0 1.2rem;">Store & Contact Information</h3>

          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.4rem; margin-bottom: 1.2rem;">
            <div>
              <label class="form-label-custom" style="display: block; font-size: 0.82rem; font-weight: 600; margin-bottom: 6px;">Shop Name *</label>
              <input type="text" name="shop_name" class="form-control" value="<%= settings.shop_name || 'ARUVI EMBROIDERY STUDIO' %>" required>
            </div>

            <div>
              <label class="form-label-custom" style="display: block; font-size: 0.82rem; font-weight: 600; margin-bottom: 6px;">Brand Tagline *</label>
              <input type="text" name="tagline" class="form-control" value="<%= settings.tagline || 'Where Threads Tell Stories' %>" required>
            </div>
          </div>

          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.4rem; margin-bottom: 1.2rem;" id="contact">
            <div>
              <label class="form-label-custom" style="display: block; font-size: 0.82rem; font-weight: 600; margin-bottom: 6px;">Contact Email *</label>
              <input type="email" name="contact_email" class="form-control" value="<%= settings.contact_email || 'aruviembroidery@gmail.com' %>" required>
            </div>

            <div>
              <label class="form-label-custom" style="display: block; font-size: 0.82rem; font-weight: 600; margin-bottom: 6px;">Contact Phone</label>
              <input type="text" name="contact_phone" class="form-control" value="<%= (typeof settings !== 'undefined' && settings.contact_phone !== undefined) ? settings.contact_phone : '' %>" placeholder="e.g. +91 98765 43210">
            </div>
          </div>

          <div style="margin-bottom: 1.2rem;">
            <label class="form-label-custom" style="display: block; font-size: 0.82rem; font-weight: 600; margin-bottom: 6px;">Studio Location Address</label>
            <textarea name="address" rows="3" class="form-control" placeholder="e.g. Erode, Tamil Nadu, 638001, India"><%= (typeof settings !== 'undefined' && settings.address !== undefined) ? settings.address : '' %></textarea>
          </div>
        </div>

        <!-- Card 3: UPI Payment Details for QR Code -->
        <div class="admin-card-box" id="upi-details" style="margin-bottom: 1.8rem; padding: 1.8rem;">
          <h3 style="font-family: var(--font-heading); font-size: 1.2rem; font-weight: 700; color: var(--admin-text-dark); margin: 0 0 0.4rem;">
            <i class="fa-solid fa-qrcode" style="color: var(--primary);"></i> UPI Payment Details (for Checkout QR Code)
          </h3>
          <p style="font-size: 0.82rem; color: var(--admin-text-muted); margin-bottom: 1.2rem;">
            These details generate the dynamic UPI QR code on the customer checkout page for direct instant payments (GPay, PhonePe, Paytm, BHIM).
          </p>

          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.4rem;">
            <div>
              <label class="form-label-custom" style="display: block; font-size: 0.82rem; font-weight: 600; margin-bottom: 6px;">UPI ID / VPA *</label>
              <input type="text" name="upi_id" class="form-control" value="<%= (typeof settings !== 'undefined' && settings.upi_id) ? settings.upi_id : (settings.upiId || 'aruviembroidery@upi') %>" placeholder="e.g. aruviembroidery@upi or 9876543210@paytm" required>
            </div>

            <div>
              <label class="form-label-custom" style="display: block; font-size: 0.82rem; font-weight: 600; margin-bottom: 6px;">UPI Merchant / Payee Name *</label>
              <input type="text" name="upi_name" class="form-control" value="<%= (typeof settings !== 'undefined' && settings.upi_name) ? settings.upi_name : (settings.upiMerchantName || 'ARUVI EMBROIDERY STUDIO') %>" placeholder="e.g. ARUVI EMBROIDERY STUDIO" required>
            </div>
          </div>
        </div>

        <!-- Card 4: Social Media Profiles -->
        <div class="admin-card-box" style="margin-bottom: 1.8rem; padding: 1.8rem;">
          <h3 style="font-family: var(--font-heading); font-size: 1.2rem; font-weight: 700; color: var(--admin-text-dark); margin: 0 0 1.2rem;">Social Media Links</h3>

          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.4rem;">
            <div>
              <label class="form-label-custom" style="display: block; font-size: 0.88rem; font-weight: 600; margin-bottom: 6px;"><i class="fa-brands fa-facebook" style="color: #1877F2; font-size: 1.25rem; vertical-align: middle; margin-right: 4px;"></i> Facebook URL</label>
              <input type="url" name="facebook_url" class="form-control" value="<%= settings.facebook_url || 'https://facebook.com/aruviembroidery' %>">
            </div>

            <div>
              <label class="form-label-custom" style="display: block; font-size: 0.88rem; font-weight: 600; margin-bottom: 6px;"><i class="fa-brands fa-instagram" style="color: #E1306C; font-size: 1.25rem; vertical-align: middle; margin-right: 4px;"></i> Instagram URL</label>
              <input type="url" name="instagram_url" class="form-control" value="<%= settings.instagram_url || 'https://instagram.com/aruviembroidery' %>">
            </div>

            <div>
              <label class="form-label-custom" style="display: block; font-size: 0.88rem; font-weight: 600; margin-bottom: 6px;"><i class="fa-brands fa-pinterest" style="color: #E60023; font-size: 1.25rem; vertical-align: middle; margin-right: 4px;"></i> Pinterest URL</label>
              <input type="url" name="pinterest_url" class="form-control" value="<%= settings.pinterest_url || 'https://pinterest.com/aruviembroidery' %>" placeholder="https://pinterest.com/yourprofile">
            </div>

            <div>
              <label class="form-label-custom" style="display: block; font-size: 0.88rem; font-weight: 600; margin-bottom: 6px;"><i class="fa-brands fa-youtube" style="color: #FF0000; font-size: 1.25rem; vertical-align: middle; margin-right: 4px;"></i> YouTube URL</label>
              <input type="url" name="youtube_url" class="form-control" value="<%= settings.youtube_url || 'https://youtube.com/aruviembroidery' %>">
            </div>
          </div>
        </div>

        <div style="display: flex; justify-content: flex-end;">
          <button type="submit" class="btn btn-primary btn-lg" style="height: 48px; border-radius: 10px; font-weight: 600; padding: 0 2rem; display: inline-flex; align-items: center; gap: 8px;">
            <i class="fa-solid fa-floppy-disk"></i> Save & Synchronize Branding
          </button>
        </div>

      </form>

    </main>
  </div>
</div>

<script>
  function previewImg(input, targetId) {
    if (input.files && input.files[0]) {
      const reader = new FileReader();
      reader.onload = function(e) {
        document.getElementById(targetId).src = e.target.result;
      };
      reader.readAsDataURL(input.files[0]);
    }
  }
</script>

</body>
</html>
