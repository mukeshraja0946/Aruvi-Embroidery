<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
  <title>Website Settings & Branding - ARUVI Admin</title>
  <link rel="icon" type="image/jpeg" href="<%= settings.favicon_url || '/public/images/logo.jpg' %>">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;1,400&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="/public/css/main.css">
  <link rel="stylesheet" href="/public/css/admin.css">
</head>
<body class="admin-body">

<div class="admin-wrapper">
  <!-- Top Header matching Reference -->
  <header class="admin-top-header">
    <a href="/admin" class="admin-header-brand">
      <% const currentLogo = (typeof siteSettings !== 'undefined' && siteSettings.logo_url) ? siteSettings.logo_url : ((typeof settings !== 'undefined' && settings.logo_url) ? settings.logo_url : '/public/images/logo.jpg'); %>
      <img src="<%= currentLogo %>" alt="ARUVI Admin Logo" style="max-height: 42px; width: auto; object-fit: contain;">
    </a>

    <!-- Global Search -->
    <div class="admin-search-bar">
      <i class="fa-solid fa-magnifying-glass"></i>
      <input type="text" placeholder="Search designs, orders, customers...">
    </div>

    <!-- Right User Header Icons -->
    <div class="admin-header-right">
      <a href="/admin/orders?status=pending" class="admin-icon-btn" title="Pending Orders">
        <i class="fa-regular fa-bell"></i>
        <% if (typeof adminNavBadges !== 'undefined' && adminNavBadges.notificationsCount > 0) { %>
          <span class="badge-count"><%= adminNavBadges.notificationsCount %></span>
        <% } %>
      </a>

      <div class="admin-user-menu">
        <div class="admin-user-avatar">A</div>
        <div class="admin-user-info">
          <strong>Admin</strong>
          <span>Administrator</span>
        </div>
        <i class="fa-solid fa-chevron-down" style="font-size: 0.75rem; color: var(--admin-text-muted); margin-left: 4px;"></i>
      </div>
    </div>
  </header>

  <!-- Admin Main Layout with Sidebar -->
  <div class="admin-main-container">
    <!-- Left Sidebar matching Reference -->
    <aside class="admin-sidebar">
      <ul class="sidebar-nav-list" style="margin-bottom: 1.2rem;">
        <li class="sidebar-nav-item">
          <a href="/admin">
            <span><i class="fa-solid fa-house"></i> Dashboard</span>
          </a>
        </li>
      </ul>

      <!-- DESIGNS Section -->
      <div class="admin-sidebar-section">
        <div class="sidebar-heading">DESIGNS</div>
        <ul class="sidebar-nav-list">
          <li class="sidebar-nav-item"><a href="/admin/designs"><span><i class="fa-solid fa-box-archive"></i> Manage Designs</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/designs/create"><span><i class="fa-solid fa-circle-plus"></i> Add New Design</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/categories"><span><i class="fa-solid fa-border-all"></i> Categories</span></a></li>
          <li class="sidebar-nav-item">
            <a href="/admin/custom-orders">
              <span><i class="fa-solid fa-wand-magic-sparkles"></i> Custom Orders</span>
              <% if (typeof adminNavBadges !== 'undefined' && adminNavBadges.pendingCustomOrders > 0) { %>
                <span class="sidebar-badge"><%= adminNavBadges.pendingCustomOrders %></span>
              <% } %>
            </a>
          </li>
        </ul>
      </div>

      <!-- ORDERS Section -->
      <div class="admin-sidebar-section">
        <div class="sidebar-heading">ORDERS</div>
        <ul class="sidebar-nav-list">
          <li class="sidebar-nav-item"><a href="/admin/orders"><span><i class="fa-regular fa-newspaper"></i> All Orders</span></a></li>
          <li class="sidebar-nav-item">
            <a href="/admin/orders?status=pending">
              <span><i class="fa-regular fa-clock"></i> Pending Orders</span>
              <% if (typeof adminNavBadges !== 'undefined' && adminNavBadges.pendingOrders > 0) { %>
                <span class="sidebar-badge"><%= adminNavBadges.pendingOrders %></span>
              <% } %>
            </a>
          </li>
          <li class="sidebar-nav-item"><a href="/admin/orders?status=completed"><span><i class="fa-regular fa-circle-check"></i> Completed Orders</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/orders?status=cancelled"><span><i class="fa-regular fa-circle-xmark"></i> Cancelled Orders</span></a></li>
        </ul>
      </div>

      <!-- CUSTOMERS Section -->
      <div class="admin-sidebar-section">
        <div class="sidebar-heading">CUSTOMERS</div>
        <ul class="sidebar-nav-list">
          <li class="sidebar-nav-item"><a href="/admin/customers"><span><i class="fa-solid fa-users"></i> All Customers</span></a></li>
          <li class="sidebar-nav-item">
            <a href="/admin/messages">
              <span><i class="fa-regular fa-comment-dots"></i> Enquiries</span>
              <% if (typeof adminNavBadges !== 'undefined' && adminNavBadges.unreadMessages > 0) { %>
                <span class="sidebar-badge"><%= adminNavBadges.unreadMessages %></span>
              <% } %>
            </a>
          </li>
          <li class="sidebar-nav-item"><a href="/admin/reviews"><span><i class="fa-regular fa-star"></i> Manage Reviews</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/email-campaigns"><span><i class="fa-solid fa-paper-plane"></i> Email Campaigns 📧</span></a></li>
        </ul>
      </div>

          <!-- CONTENT Section -->
          <div class="admin-sidebar-section">
            <div class="sidebar-heading">CONTENT & SETTINGS</div>
            <ul class="sidebar-nav-list">
              <li class="sidebar-nav-item"><a href="/admin/homepage"><span><i class="fa-solid fa-house-chimney"></i> Homepage</span></a></li>
              <li class="sidebar-nav-item"><a href="/admin/banners"><span><i class="fa-regular fa-image"></i> Banners</span></a></li>
              <li class="sidebar-nav-item"><a href="/admin/settings#design-settings"><span><i class="fa-solid fa-palette"></i> Design Page</span></a></li>
              <li class="sidebar-nav-item"><a href="/admin/settings" class="active"><span><i class="fa-solid fa-gear"></i> Website Settings</span></a></li>
            </ul>
          </div>

      <div style="margin-top: auto; padding-top: 1rem; border-top: 1px solid var(--admin-border);">
        <a href="/admin/logout" style="display: flex; align-items: center; gap: 8px; color: var(--admin-primary); font-size: 0.85rem; font-weight: 600; text-decoration: none; padding: 0.5rem 0.8rem;">
          <i class="fa-solid fa-arrow-right-from-bracket"></i> Logout Admin
        </a>
      </div>
    </aside>

    <!-- Main Content Body -->
    <main class="admin-content-body">

      <!-- Breadcrumbs & Header -->
      <div style="margin-bottom: 1.8rem;">
        <div style="font-size: 0.8rem; color: var(--admin-text-muted); margin-bottom: 0.4rem;">
          <a href="/admin" style="color: var(--admin-text-muted); text-decoration: none;">Dashboard</a> &nbsp;>&nbsp; <span style="color: var(--admin-primary); font-weight: 600;">Website Settings</span>
        </div>
        <h1 style="font-family: var(--font-heading); font-size: 2.2rem; font-weight: 700; color: var(--admin-text-dark); margin: 0 0 0.3rem;">Website Settings & Branding</h1>
        <p style="font-size: 0.88rem; color: var(--admin-text-muted); margin: 0;">Manage store branding, logos, contact details and social media links. Uploaded logos sync globally across all pages.</p>
      </div>

      <% const msgFlash = (typeof flash !== 'undefined' ? flash : (typeof _flash !== 'undefined' ? _flash : {})); %>
      <% if (msgFlash.success && msgFlash.success.length > 0) { %>
        <div id="adminToastPopup" style="position: fixed; top: 25px; right: 25px; background: #1B5E20; color: white; padding: 1.1rem 1.8rem; border-radius: 14px; box-shadow: 0 12px 30px rgba(0,0,0,0.25); z-index: 999999; display: flex; align-items: center; gap: 12px; font-weight: 600; font-size: 1rem; border: 2px solid #81C784;">
          <i class="fa-solid fa-circle-check" style="font-size: 1.5rem; color: #66BB6A;"></i>
          <span><%= msgFlash.success[0] %></span>
          <button type="button" onclick="this.parentElement.remove()" style="background: none; border: none; color: white; margin-left: 15px; cursor: pointer; font-size: 1.3rem;">&times;</button>
        </div>
        <script>
          setTimeout(() => {
            const popup = document.getElementById('adminToastPopup');
            if (popup) popup.style.display = 'none';
          }, 4500);
        </script>
        <div class="alert alert-success" style="margin-bottom: 1.5rem; border-radius: 10px;">
          <i class="fa-solid fa-circle-check"></i> <%= msgFlash.success[0] %>
        </div>
      <% } %>

      <% if (msgFlash.error && msgFlash.error.length > 0) { %>
        <div class="alert alert-danger" style="margin-bottom: 1.5rem; border-radius: 10px; background: #FFEBEE; color: #C62828; border: 1px solid #FFCDD2; padding: 1rem 1.2rem; display: flex; align-items: center; gap: 10px;">
          <i class="fa-solid fa-triangle-exclamation" style="font-size: 1.2rem;"></i>
          <span><%= msgFlash.error[0] %></span>
        </div>
      <% } %>

      <form action="/admin/settings?_csrf=<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" method="POST" enctype="multipart/form-data">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <!-- Card 1: Branding & Logo Management (Requirement 5 & 6) -->
        <div class="admin-card-box" style="margin-bottom: 1.8rem; padding: 1.8rem;">
          <div style="border-bottom: 1px solid var(--admin-border); padding-bottom: 0.8rem; margin-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: center;">
            <div>
              <h3 style="font-family: var(--font-heading); font-size: 1.2rem; font-weight: 700; color: var(--admin-text-dark); margin: 0 0 4px;">Logo & Branding Management</h3>
              <span style="font-size: 0.78rem; color: var(--admin-text-muted);">Centralized logo source. Uploading a logo updates all customer & admin pages automatically.</span>
            </div>
            <span style="background: #E8F5E9; color: #2E7D32; padding: 3px 10px; border-radius: 12px; font-size: 0.75rem; font-weight: 600;"><i class="fa-solid fa-rotate"></i> Global Auto-Sync Enabled</span>
          </div>

          <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1.8rem;">
            <!-- Main Website Logo Upload -->
            <div style="background: #FAF6F0; border: 1px solid var(--admin-border); border-radius: 14px; padding: 1.4rem; text-align: center;">
              <strong style="display: block; font-size: 0.9rem; color: var(--admin-text-dark); margin-bottom: 0.5rem;">Main Website Logo</strong>
              
              <div class="logo-preview">
                <img id="mainLogoPreview" src="<%= settings.logo_url || '/public/images/logo.jpg' %>" alt="Main Website Logo">
              </div>

              <input type="file" name="logo_image" id="logoInput" accept="image/png, image/jpeg, image/jpg, image/webp, image/svg+xml" style="display: none;" onchange="previewImg(this, 'mainLogoPreview')">
              
              <div style="display: flex; gap: 10px; justify-content: center; align-items: center; margin-top: 0.5rem;">
                <button type="button" onclick="document.getElementById('logoInput').click()" class="btn btn-primary btn-sm" style="font-size: 0.78rem; border-radius: 8px;">
                  <i class="fa-solid fa-upload"></i> Replace Logo
                </button>
                <label style="display: inline-flex; align-items: center; gap: 4px; font-size: 0.75rem; color: var(--admin-primary); cursor: pointer;">
                  <input type="checkbox" name="remove_logo" value="1"> Reset Default
                </label>
              </div>
            </div>

            <!-- Mobile Navigation Logo Upload -->
            <div style="background: #FAF6F0; border: 1px solid var(--admin-border); border-radius: 14px; padding: 1.4rem; text-align: center;">
              <strong style="display: block; font-size: 0.9rem; color: var(--admin-text-dark); margin-bottom: 0.5rem;">Mobile Navigation Logo</strong>
              
              <div class="logo-preview">
                <img id="mobileLogoPreview" src="<%= settings.mobile_logo_url || settings.logo_url || '/public/images/logo.jpg' %>" alt="Mobile Navigation Logo">
              </div>

              <input type="file" name="mobile_logo_image" id="mobileLogoInput" accept="image/png, image/jpeg, image/jpg, image/webp, image/svg+xml" style="display: none;" onchange="previewImg(this, 'mobileLogoPreview')">
              
              <div style="display: flex; gap: 10px; justify-content: center; align-items: center; margin-top: 0.5rem;">
                <button type="button" onclick="document.getElementById('mobileLogoInput').click()" class="btn btn-outline btn-sm" style="font-size: 0.78rem; border-radius: 8px; background: #FFF;">
                  <i class="fa-solid fa-upload"></i> Upload Mobile Logo
                </button>
                <label style="display: inline-flex; align-items: center; gap: 4px; font-size: 0.75rem; color: var(--admin-primary); cursor: pointer;">
                  <input type="checkbox" name="remove_mobile_logo" value="1"> Reset Default
                </label>
              </div>
            </div>

            <!-- Favicon Upload -->
            <div style="background: #FAF6F0; border: 1px solid var(--admin-border); border-radius: 14px; padding: 1.4rem; text-align: center;">
              <strong style="display: block; font-size: 0.9rem; color: var(--admin-text-dark); margin-bottom: 0.5rem;">Browser Favicon (.ICO, .PNG)</strong>
              
              <div class="logo-preview">
                <img id="faviconPreview" src="<%= settings.favicon_url || '/public/images/logo.jpg' %>" alt="Favicon" style="max-height: 48px;">
              </div>

              <input type="file" name="favicon_image" id="faviconInput" accept="image/png, image/jpeg, image/jpg, image/x-icon, image/svg+xml" style="display: none;" onchange="previewImg(this, 'faviconPreview')">
              
              <div style="display: flex; gap: 10px; justify-content: center; align-items: center; margin-top: 0.5rem;">
                <button type="button" onclick="document.getElementById('faviconInput').click()" class="btn btn-outline btn-sm" style="font-size: 0.78rem; border-radius: 8px; background: #FFF;">
                  <i class="fa-solid fa-upload"></i> Upload Favicon
                </button>
                <label style="display: inline-flex; align-items: center; gap: 4px; font-size: 0.75rem; color: var(--admin-primary); cursor: pointer;">
                  <input type="checkbox" name="remove_favicon" value="1"> Reset Default
                </label>
              </div>
            </div>
          </div>
        </div>

        <!-- Card 2: Store Information -->
        <div class="admin-card-box" style="margin-bottom: 1.8rem; padding: 1.8rem;">
          <h3 style="font-family: var(--font-heading); font-size: 1.2rem; font-weight: 700; color: var(--admin-text-dark); margin: 0 0 1.2rem;">Store & Contact Information</h3>

          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.4rem; margin-bottom: 1.2rem;">
            <div>
              <label class="form-label-custom" style="display: block; font-size: 0.82rem; font-weight: 600; margin-bottom: 6px;">Shop Name *</label>
              <input type="text" name="shop_name" class="form-control" value="<%= settings.shop_name || 'ARUVI EMBROIDERY STUDIO' %>" required>
            </div>

            <div>
              <label class="form-label-custom" style="display: block; font-size: 0.82rem; font-weight: 600; margin-bottom: 6px;">Brand Tagline *</label>
              <input type="text" name="tagline" class="form-control" value="<%= settings.tagline || 'Where Threads Tell Stories' %>" required>
            </div>
          </div>

          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.4rem; margin-bottom: 1.2rem;" id="contact">
            <div>
              <label class="form-label-custom" style="display: block; font-size: 0.82rem; font-weight: 600; margin-bottom: 6px;">Contact Email *</label>
              <input type="email" name="contact_email" class="form-control" value="<%= settings.contact_email || 'aruviembroidery@gmail.com' %>" required>
            </div>

            <div>
              <label class="form-label-custom" style="display: block; font-size: 0.82rem; font-weight: 600; margin-bottom: 6px;">Contact Phone</label>
              <input type="text" name="contact_phone" class="form-control" value="<%= (typeof settings !== 'undefined' && settings.contact_phone !== undefined) ? settings.contact_phone : '' %>" placeholder="e.g. +91 98765 43210">
            </div>
          </div>

          <div style="margin-bottom: 1.2rem;">
            <label class="form-label-custom" style="display: block; font-size: 0.82rem; font-weight: 600; margin-bottom: 6px;">Studio Location Address</label>
            <textarea name="address" rows="3" class="form-control" placeholder="e.g. Erode, Tamil Nadu, 638001, India"><%= (typeof settings !== 'undefined' && settings.address !== undefined) ? settings.address : '' %></textarea>
          </div>

          <div style="background: #FAF6F0; border: 1px solid var(--admin-border); border-radius: 12px; padding: 1.2rem; margin-top: 1rem;">
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.8rem; flex-wrap: wrap; gap: 10px;">
              <div>
                <strong style="display: block; font-size: 0.9rem; color: var(--admin-text-dark);">Contact Page Location Card & Map</strong>
                <span style="font-size: 0.78rem; color: var(--admin-text-muted);">Enable or disable the "Our Location" card with map on the Contact Us page (Default: OFF).</span>
              </div>
              <label style="position: relative; display: inline-flex; align-items: center; cursor: pointer; gap: 8px;">
                <input type="checkbox" name="show_contact_map" value="1" <%= (typeof settings !== 'undefined' && settings.show_contact_map === '1') ? 'checked' : '' %> style="width: 18px; height: 18px;">
                <span style="font-size: 0.85rem; font-weight: 600;">Show location/map</span>
              </label>
            </div>
            <div>
              <label class="form-label-custom" style="display: block; font-size: 0.82rem; font-weight: 600; margin-bottom: 6px;">Short Address Line (shows only if filled)</label>
              <input type="text" name="contact_address_line" class="form-control" value="<%= (typeof settings !== 'undefined' && settings.contact_address_line) ? settings.contact_address_line : '' %>" placeholder="e.g. Erode, Tamil Nadu, India">
            </div>
          </div>
        </div>

        <!-- Card 3: UPI Payment Details for QR Code -->
        <div class="admin-card-box" id="upi-details" style="margin-bottom: 1.8rem; padding: 1.8rem;">
          <h3 style="font-family: var(--font-heading); font-size: 1.2rem; font-weight: 700; color: var(--admin-text-dark); margin: 0 0 0.4rem;">
            <i class="fa-solid fa-qrcode" style="color: var(--primary);"></i> UPI Payment Details (for Checkout QR Code)
          </h3>
          <p style="font-size: 0.82rem; color: var(--admin-text-muted); margin-bottom: 1.2rem;">
            These details generate the dynamic UPI QR code on the customer checkout page for direct instant payments (GPay, PhonePe, Paytm, BHIM).
          </p>

          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.4rem;">
            <div>
              <label class="form-label-custom" style="display: block; font-size: 0.82rem; font-weight: 600; margin-bottom: 6px;">UPI ID / VPA *</label>
              <input type="text" name="upi_id" class="form-control" value="<%= (typeof settings !== 'undefined' && settings.upi_id) ? settings.upi_id : (settings.upiId || 'aruviembroidery@upi') %>" placeholder="e.g. aruviembroidery@upi or 9876543210@paytm" required>
            </div>

            <div>
              <label class="form-label-custom" style="display: block; font-size: 0.82rem; font-weight: 600; margin-bottom: 6px;">UPI Merchant / Payee Name *</label>
              <input type="text" name="upi_name" class="form-control" value="<%= (typeof settings !== 'undefined' && settings.upi_name) ? settings.upi_name : (settings.upiMerchantName || 'ARUVI EMBROIDERY STUDIO') %>" placeholder="e.g. ARUVI EMBROIDERY STUDIO" required>
            </div>
        </div>

        <!-- Card: Payment Gateway (Razorpay) -->
        <div class="admin-card-box" id="payment-settings" style="margin-bottom: 1.8rem; padding: 1.8rem;">
          <div style="border-bottom: 1px solid var(--admin-border); padding-bottom: 0.8rem; margin-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
            <div>
              <h3 style="font-family: var(--font-heading); font-size: 1.2rem; font-weight: 700; color: var(--admin-text-dark); margin: 0 0 4px;">
                <i class="fa-solid fa-credit-card" style="color: var(--primary);"></i> Online Payment Gateway (Razorpay)
              </h3>
              <span style="font-size: 0.78rem; color: var(--admin-text-muted);">
                Configure official Razorpay API credentials for customer cards, UPI, net banking, and wallets.
              </span>
            </div>
            <div>
              <% if (typeof rzpConfig !== 'undefined' && rzpConfig.isConfigured) { %>
                <span id="rzpStatusBadge" style="background: <%= rzpConfig.mode === 'live' ? '#E8F5E9' : '#FFF3E0' %>; color: <%= rzpConfig.mode === 'live' ? '#2E7D32' : '#E65100' %>; padding: 5px 14px; border-radius: 12px; font-size: 0.78rem; font-weight: 700; display: inline-flex; align-items: center; gap: 6px;">
                  <i class="fa-solid fa-circle-check"></i> <%= rzpConfig.mode === 'live' ? 'LIVE MODE ACTIVE' : 'TEST / SANDBOX MODE' %>
                </span>
              <% } else { %>
                <span id="rzpStatusBadge" style="background: #FFEBEE; color: #C62828; padding: 5px 14px; border-radius: 12px; font-size: 0.78rem; font-weight: 700; display: inline-flex; align-items: center; gap: 6px;">
                  <i class="fa-solid fa-triangle-exclamation"></i> NOT CONFIGURED
                </span>
              <% } %>
            </div>
          </div>

          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.4rem; margin-bottom: 1.4rem;">
            <div>
              <label class="form-label-custom" style="display: block; font-size: 0.84rem; font-weight: 600; margin-bottom: 6px;">
                Razorpay Key ID *
              </label>
              <input type="text" name="razorpay_key_id" id="rzp_key_id" class="form-control" value="<%= (typeof settings !== 'undefined' && settings.razorpay_key_id) ? settings.razorpay_key_id : '' %>" placeholder="e.g. rzp_test_... or rzp_live_...">
              <small style="display: block; font-size: 0.74rem; color: var(--admin-text-muted); margin-top: 4px;">
                Test Key starts with <code>rzp_test_</code>, Live Key starts with <code>rzp_live_</code>.
              </small>
            </div>

            <div>
              <label class="form-label-custom" style="display: block; font-size: 0.84rem; font-weight: 600; margin-bottom: 6px;">
                Razorpay Key Secret *
              </label>
              <input type="password" name="razorpay_key_secret" id="rzp_key_secret" class="form-control" value="<%= (typeof settings !== 'undefined' && settings.razorpay_key_secret_masked) ? settings.razorpay_key_secret_masked : '' %>" placeholder="•••••••••••• (Leave as is to preserve current secret)">
              <small style="display: block; font-size: 0.74rem; color: var(--admin-text-muted); margin-top: 4px;">
                Stored securely encrypted with AES-256. Leave masked dots to keep existing secret.
              </small>
            </div>

            <div>
              <label class="form-label-custom" style="display: block; font-size: 0.84rem; font-weight: 600; margin-bottom: 6px;">
                Payment Environment Mode
              </label>
              <select name="razorpay_mode" id="rzp_mode" class="form-control" style="height: 42px; border-radius: 8px; border: 1px solid var(--admin-border); padding: 0 0.8rem; font-size: 0.85rem; width: 100%; background: #FFF;">
                <option value="test" <%= (typeof settings !== 'undefined' && settings.razorpay_mode === 'test') ? 'selected' : '' %>>Test Mode (Sandbox / Testing)</option>
                <option value="live" <%= (typeof settings !== 'undefined' && settings.razorpay_mode === 'live') ? 'selected' : '' %>>Live Mode (Real Customer Payments)</option>
              </select>
              <small style="display: block; font-size: 0.74rem; color: var(--admin-text-muted); margin-top: 4px;">
                Controls whether test or live checkout is launched.
              </small>
            </div>

            <div>
              <label class="form-label-custom" style="display: block; font-size: 0.84rem; font-weight: 600; margin-bottom: 6px;">
                Webhook Secret (Optional)
              </label>
              <input type="password" name="razorpay_webhook_secret" id="rzp_webhook_secret" class="form-control" value="<%= (typeof settings !== 'undefined' && settings.razorpay_webhook_secret_masked) ? settings.razorpay_webhook_secret_masked : '' %>" placeholder="Webhook Secret for payment.captured">
              <small style="display: block; font-size: 0.74rem; color: var(--admin-text-muted); margin-top: 4px;">
                Webhook URL: <code>https://aruviembroidery.com/api/payment/webhook</code>
              </small>
            </div>
          </div>

          <div style="background: #FAF6F0; border: 1px solid var(--admin-border); border-radius: 10px; padding: 1rem 1.25rem; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px;">
            <div>
              <button type="button" onclick="testRazorpayConnection()" id="testRzpBtn" class="btn btn-outline btn-sm" style="height: 38px; border-radius: 8px; font-weight: 700; display: inline-flex; align-items: center; gap: 8px; border: 1.5px solid #2E7D32; color: #1B5E20; background: #FFF; cursor: pointer;">
                <i class="fa-solid fa-plug-circle-check"></i> Test Connection
              </button>
              <span id="testRzpStatusText" style="margin-left: 12px; font-size: 0.84rem; font-weight: 600;"></span>
            </div>
            <span style="font-size: 0.76rem; color: var(--admin-text-muted);">
              Verifies API authorization with Razorpay servers without charging anything.
            </span>
          </div>
        </div>

        <!-- Card 4: Social Media Profiles -->
        <div id="social-links" class="admin-card-box" style="margin-bottom: 1.8rem; padding: 1.8rem;">
          <div style="border-bottom: 1px solid var(--admin-border); padding-bottom: 0.8rem; margin-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: center;">
            <div>
              <h3 style="font-family: var(--font-heading); font-size: 1.2rem; font-weight: 700; color: var(--admin-text-dark); margin: 0 0 4px;">Social Media Links</h3>
              <span style="font-size: 0.78rem; color: var(--admin-text-muted);">Manage social profile links. Icons appear in the customer website footer in real-time. Leave any field blank to hide that icon.</span>
            </div>
            <span style="background: #E8F5E9; color: #2E7D32; padding: 3px 10px; border-radius: 12px; font-size: 0.75rem; font-weight: 600;"><i class="fa-solid fa-link"></i> Live Footer Sync</span>
          </div>

          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.4rem;">
            <div>
              <label class="form-label-custom" style="display: block; font-size: 0.88rem; font-weight: 600; margin-bottom: 6px;"><i class="fa-brands fa-facebook" style="color: #1877F2; font-size: 1.25rem; vertical-align: middle; margin-right: 4px;"></i> Facebook URL</label>
              <input type="url" name="facebook_url" class="form-control" value="<%= (typeof settings !== 'undefined' && settings.facebook_url !== undefined && settings.facebook_url !== null) ? settings.facebook_url : '' %>" placeholder="https://facebook.com/aruviembroidery">
              <small style="display: block; font-size: 0.74rem; color: var(--admin-text-muted); margin-top: 4px;">Leave blank to hide Facebook icon from footer.</small>
            </div>

            <div>
              <label class="form-label-custom" style="display: block; font-size: 0.88rem; font-weight: 600; margin-bottom: 6px;"><i class="fa-brands fa-instagram" style="color: #E1306C; font-size: 1.25rem; vertical-align: middle; margin-right: 4px;"></i> Instagram URL</label>
              <input type="url" name="instagram_url" class="form-control" value="<%= (typeof settings !== 'undefined' && settings.instagram_url !== undefined && settings.instagram_url !== null) ? settings.instagram_url : '' %>" placeholder="https://instagram.com/aruviembroidery">
              <small style="display: block; font-size: 0.74rem; color: var(--admin-text-muted); margin-top: 4px;">Leave blank to hide Instagram icon from footer.</small>
            </div>

            <div>
              <label class="form-label-custom" style="display: block; font-size: 0.88rem; font-weight: 600; margin-bottom: 6px;"><i class="fa-brands fa-pinterest" style="color: #E60023; font-size: 1.25rem; vertical-align: middle; margin-right: 4px;"></i> Pinterest URL</label>
              <input type="url" name="pinterest_url" class="form-control" value="<%= (typeof settings !== 'undefined' && settings.pinterest_url !== undefined && settings.pinterest_url !== null) ? settings.pinterest_url : '' %>" placeholder="https://pinterest.com/aruviembroidery">
              <small style="display: block; font-size: 0.74rem; color: var(--admin-text-muted); margin-top: 4px;">Must point to a Pinterest profile/board. Leave blank to hide.</small>
            </div>

            <div>
              <label class="form-label-custom" style="display: block; font-size: 0.88rem; font-weight: 600; margin-bottom: 6px;"><i class="fa-brands fa-youtube" style="color: #FF0000; font-size: 1.25rem; vertical-align: middle; margin-right: 4px;"></i> YouTube URL</label>
              <input type="url" name="youtube_url" class="form-control" value="<%= (typeof settings !== 'undefined' && settings.youtube_url !== undefined && settings.youtube_url !== null) ? settings.youtube_url : '' %>" placeholder="https://youtube.com/@aruviembroidery">
              <small style="display: block; font-size: 0.74rem; color: var(--admin-text-muted); margin-top: 4px;">Leave blank to hide YouTube icon from footer.</small>
            </div>
          </div>
        <!-- Card 5: Machine Files & ZIP Upload Settings -->
        <div id="zip-settings" class="admin-card-box" style="margin-bottom: 1.8rem; padding: 1.8rem;">
          <div style="border-bottom: 1px solid var(--admin-border); padding-bottom: 0.8rem; margin-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: center;">
            <div>
              <h3 style="font-family: var(--font-heading); font-size: 1.2rem; font-weight: 700; color: var(--admin-text-dark); margin: 0 0 4px;">Machine Files & ZIP Upload Settings</h3>
              <span style="font-size: 0.78rem; color: var(--admin-text-muted);">Configure upload thresholds and automatic format detection policies for machine embroidery ZIP packages.</span>
            </div>
            <span style="background: #E3F2FD; color: #1565C0; padding: 3px 10px; border-radius: 12px; font-size: 0.75rem; font-weight: 600;"><i class="fa-solid fa-file-zipper"></i> ZIP Engine</span>
          </div>

          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.4rem; margin-bottom: 1.2rem;">
            <div>
              <label class="form-label-custom" style="display: block; font-size: 0.88rem; font-weight: 600; margin-bottom: 6px;">
                <i class="fa-solid fa-cloud-arrow-up" style="color: var(--admin-primary); margin-right: 4px;"></i> Max Allowed File Size per Upload (MB)
              </label>
              <input type="number" name="max_file_size_mb" class="form-control" value="<%= (typeof settings !== 'undefined' && settings.max_file_size_mb) ? settings.max_file_size_mb : '200' %>" min="1" max="1000" required>
              <small style="display: block; font-size: 0.74rem; color: var(--admin-text-muted); margin-top: 4px;">Configures maximum allowed file size per file across chunked uploaders (default: 200 MB).</small>
            </div>

            <div>
              <label class="form-label-custom" style="display: block; font-size: 0.88rem; font-weight: 600; margin-bottom: 6px;">
                <i class="fa-solid fa-shield-halved" style="color: #2E7D32; margin-right: 4px;"></i> Customer Download Limit per File
              </label>
              <input type="number" name="download_limit_per_file" class="form-control" value="<%= (typeof settings !== 'undefined' && settings.download_limit_per_file !== undefined) ? settings.download_limit_per_file : '0' %>" min="0" max="1000" required>
              <small style="display: block; font-size: 0.74rem; color: var(--admin-text-muted); margin-top: 4px;">Maximum times a buyer can download each file (0 = unlimited downloads).</small>
            </div>
          </div>

          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.4rem;">
            <div>
              <label class="form-label-custom" style="display: block; font-size: 0.88rem; font-weight: 600; margin-bottom: 6px;">
                <i class="fa-solid fa-hard-drive" style="color: var(--admin-primary); margin-right: 4px;"></i> Bulk ZIP Upload Max Size (MB)
              </label>
              <input type="number" name="max_upload_zip_size_mb" class="form-control" value="<%= (typeof settings !== 'undefined' && settings.max_upload_zip_size_mb) ? settings.max_upload_zip_size_mb : '100' %>" min="5" max="500" required>
              <small style="display: block; font-size: 0.74rem; color: var(--admin-text-muted); margin-top: 4px;">Configures maximum allowed file size per ZIP package in bulk upload (default: 100 MB).</small>
            </div>

            <div>
              <label class="form-label-custom" style="display: block; font-size: 0.88rem; font-weight: 600; margin-bottom: 6px;">
                <i class="fa-solid fa-wand-magic-sparkles" style="color: #5E35B1; margin-right: 4px;"></i> Format Auto-Detection Policy
              </label>
              <select name="auto_detect_formats_policy" class="form-control" style="height: 42px; border-radius: 8px; border: 1px solid var(--admin-border); padding: 0 0.8rem; font-size: 0.85rem; width: 100%; background: #FFF;">
                <option value="fill_if_empty" <%= (typeof settings !== 'undefined' && settings.auto_detect_formats_policy === 'overwrite') ? '' : 'selected' %>>Only fill when empty (Preserve manual formats)</option>
                <option value="overwrite" <%= (typeof settings !== 'undefined' && settings.auto_detect_formats_policy === 'overwrite') ? 'selected' : '' %>>Overwrite design formats with detected ZIP formats</option>
              </select>
              <small style="display: block; font-size: 0.74rem; color: var(--admin-text-muted); margin-top: 4px;">Controls whether detected formats (.DST, .PES, .JEF, .EXP) overwrite existing design formats.</small>
            </div>
          </div>
        <!-- Card 6: About Page Content & Statistics Management -->
        <div id="about-settings" class="admin-card-box" style="margin-bottom: 1.8rem; padding: 1.8rem;">
          <div style="border-bottom: 1px solid var(--admin-border); padding-bottom: 0.8rem; margin-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: center;">
            <div>
              <h3 style="font-family: var(--font-heading); font-size: 1.2rem; font-weight: 700; color: var(--admin-text-dark); margin: 0 0 4px;">About Page Content & Statistics</h3>
              <span style="font-size: 0.78rem; color: var(--admin-text-muted);">Manage Our Story, Mission/Vision/Values, and choose between live database auto-calculation or manual stat values.</span>
            </div>
            <span style="background: #FFF3E0; color: #E65100; padding: 3px 10px; border-radius: 12px; font-size: 0.75rem; font-weight: 600;"><i class="fa-solid fa-circle-info"></i> About Page</span>
          </div>

          <!-- Hero & Story Content -->
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.4rem; margin-bottom: 1.4rem;">
            <div>
              <label class="form-label-custom" style="display: block; font-size: 0.88rem; font-weight: 600; margin-bottom: 6px;">Hero Title</label>
              <input type="text" name="about_hero_title" class="form-control" value="<%= (typeof settings !== 'undefined' && settings.about_hero_title) ? settings.about_hero_title : 'About ARUVI' %>">
            </div>
            <div>
              <label class="form-label-custom" style="display: block; font-size: 0.88rem; font-weight: 600; margin-bottom: 6px;">Hero Subtitle</label>
              <input type="text" name="about_hero_subtitle" class="form-control" value="<%= (typeof settings !== 'undefined' && settings.about_hero_subtitle) ? settings.about_hero_subtitle : 'Crafting Beautiful Designs for Your Creative Journey' %>">
            </div>
          </div>

          <div style="margin-bottom: 1.4rem;">
            <label class="form-label-custom" style="display: block; font-size: 0.88rem; font-weight: 600; margin-bottom: 6px;">Hero Description</label>
            <textarea name="about_hero_description" class="form-control" rows="2" style="height: auto; padding: 0.8rem;"><%= (typeof settings !== 'undefined' && settings.about_hero_description) ? settings.about_hero_description : 'At ARUVI Embroidery Studio, we create high-quality machine embroidery designs that bring your ideas to life. Our designs are crafted with precision, creativity, and a passion for embroidery, helping individuals and businesses create beautiful, professional embroidery projects.' %></textarea>
          </div>

          <div style="display: grid; grid-template-columns: 1fr; gap: 1.4rem; margin-bottom: 1.4rem;">
            <div>
              <label class="form-label-custom" style="display: block; font-size: 0.88rem; font-weight: 600; margin-bottom: 6px;">Our Story Heading</label>
              <input type="text" name="about_story_title" class="form-control" value="<%= (typeof settings !== 'undefined' && settings.about_story_title) ? settings.about_story_title : 'A Passion for Embroidery' %>">
            </div>
            <div>
              <label class="form-label-custom" style="display: block; font-size: 0.88rem; font-weight: 600; margin-bottom: 6px;">Our Story Paragraph 1</label>
              <textarea name="about_story_p1" class="form-control" rows="2" style="height: auto; padding: 0.8rem;"><%= (typeof settings !== 'undefined' && settings.about_story_p1) ? settings.about_story_p1 : 'ARUVI Embroidery Studio started with a simple idea — to make high-quality embroidery designs accessible to everyone. What began as a passion for creativity and design has now grown into a trusted platform for thousands of embroidery enthusiasts around the world.' %></textarea>
            </div>
            <div>
              <label class="form-label-custom" style="display: block; font-size: 0.88rem; font-weight: 600; margin-bottom: 6px;">Our Story Paragraph 2</label>
              <textarea name="about_story_p2" class="form-control" rows="2" style="height: auto; padding: 0.8rem;"><%= (typeof settings !== 'undefined' && settings.about_story_p2) ? settings.about_story_p2 : 'We believe embroidery is more than just a craft — it\'s a way to express creativity, culture, and individuality. Our mission is to provide unique, high-quality, and easy-to-use machine embroidery designs that help you bring your creative ideas to life.' %></textarea>
            </div>

            <div style="background: #FAF6F0; border: 1px solid var(--admin-border); border-radius: 12px; padding: 1.2rem; margin-top: 0.5rem;">
              <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.8rem; flex-wrap: wrap; gap: 10px;">
                <div>
                  <strong style="display: block; font-size: 0.9rem; color: var(--admin-text-dark);">About Page Story Image</strong>
                  <span style="font-size: 0.78rem; color: var(--admin-text-muted);">Enable or disable the story image below the story text (Default: OFF).</span>
                </div>
                <label style="position: relative; display: inline-flex; align-items: center; cursor: pointer; gap: 8px;">
                  <input type="checkbox" name="show_about_story_image" value="1" <%= (typeof settings !== 'undefined' && settings.show_about_story_image === '1') ? 'checked' : '' %> style="width: 18px; height: 18px;">
                  <span style="font-size: 0.85rem; font-weight: 600;">Show story image</span>
                </label>
              </div>
              <div style="display: flex; align-items: center; gap: 16px; flex-wrap: wrap;">
                <% if (typeof settings !== 'undefined' && settings.about_story_image) { %>
                  <div style="width: 100px; height: 70px; border-radius: 8px; overflow: hidden; border: 1px solid var(--admin-border);">
                    <img id="aboutStoryPreview" src="<%= settings.about_story_image %>" alt="Story Image" style="width: 100%; height: 100%; object-fit: cover;">
                  </div>
                <% } else { %>
                  <div style="width: 100px; height: 70px; border-radius: 8px; overflow: hidden; border: 1px solid var(--admin-border); background: #eee; display: flex; align-items: center; justify-content: center; font-size: 0.75rem; color: #888;">
                    No Image
                  </div>
                <% } %>
                <div style="flex: 1; min-width: 200px;">
                  <input type="file" name="about_story_image" id="aboutStoryInput" accept="image/*" class="form-control" style="padding: 6px;" onchange="previewImg(this, 'aboutStoryPreview')">
                  <small style="display: block; font-size: 0.75rem; color: var(--admin-text-muted); margin-top: 4px;">Upload custom story image (JPG, PNG, WEBP).</small>
                </div>
              </div>
            </div>
          </div>

          <!-- Stats Calculation Mode -->
          <div style="background: #FAF6F0; border: 1px solid var(--admin-border); border-radius: 12px; padding: 1.2rem; margin-bottom: 1.4rem;">
            <label class="form-label-custom" style="display: block; font-size: 0.92rem; font-weight: 700; color: var(--admin-text-dark); margin-bottom: 8px;">
              <i class="fa-solid fa-chart-simple" style="color: var(--admin-primary); margin-right: 6px;"></i> Statistics Calculation Mode
            </label>
            <div style="display: flex; gap: 24px; align-items: center; margin-bottom: 1rem;">
              <label style="display: inline-flex; align-items: center; gap: 8px; font-size: 0.88rem; cursor: pointer;">
                <input type="radio" name="about_stats_mode" value="auto" <%= (!settings.about_stats_mode || settings.about_stats_mode === 'auto') ? 'checked' : '' %>>
                <strong>Auto-calculate from real database data (Recommended)</strong>
              </label>
              <label style="display: inline-flex; align-items: center; gap: 8px; font-size: 0.88rem; cursor: pointer;">
                <input type="radio" name="about_stats_mode" value="manual" <%= (settings.about_stats_mode === 'manual') ? 'checked' : '' %>>
                <strong>Manual values</strong>
              </label>
            </div>
            <small style="display: block; font-size: 0.78rem; color: var(--admin-text-muted); margin-bottom: 1rem;">
              When set to "Auto-calculate", numbers are computed directly from real registered customers, active designs, real approved review ratings, and unique order countries.
            </small>

            <!-- Manual Stat Inputs -->
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
              <div>
                <label style="font-size: 0.8rem; font-weight: 600; display: block; margin-bottom: 4px;">Stat 1: Number & Label</label>
                <div style="display: flex; gap: 8px;">
                  <input type="text" name="about_stat1_num" class="form-control" value="<%= settings.about_stat1_num || '10,000+' %>" placeholder="10,000+">
                  <input type="text" name="about_stat1_label" class="form-control" value="<%= settings.about_stat1_label || 'Happy Customers' %>" placeholder="Happy Customers">
                </div>
              </div>
              <div>
                <label style="font-size: 0.8rem; font-weight: 600; display: block; margin-bottom: 4px;">Stat 2: Number & Label</label>
                <div style="display: flex; gap: 8px;">
                  <input type="text" name="about_stat2_num" class="form-control" value="<%= settings.about_stat2_num || '5,000+' %>" placeholder="5,000+">
                  <input type="text" name="about_stat2_label" class="form-control" value="<%= settings.about_stat2_label || 'Unique Designs' %>" placeholder="Unique Designs">
                </div>
              </div>
              <div>
                <label style="font-size: 0.8rem; font-weight: 600; display: block; margin-bottom: 4px;">Stat 3: Number & Label</label>
                <div style="display: flex; gap: 8px;">
                  <input type="text" name="about_stat3_num" class="form-control" value="<%= settings.about_stat3_num || '50+' %>" placeholder="50+">
                  <input type="text" name="about_stat3_label" class="form-control" value="<%= settings.about_stat3_label || 'Countries Worldwide' %>" placeholder="Countries Worldwide">
                </div>
              </div>
              <div>
                <label style="font-size: 0.8rem; font-weight: 600; display: block; margin-bottom: 4px;">Stat 4: Number & Label</label>
                <div style="display: flex; gap: 8px;">
                  <input type="text" name="about_stat4_num" class="form-control" value="<%= settings.about_stat4_num || '4.9/5' %>" placeholder="4.9/5">
                  <input type="text" name="about_stat4_label" class="form-control" value="<%= settings.about_stat4_label || 'Customer Rating' %>" placeholder="Customer Rating">
                </div>
              </div>
            </div>
          </div>

          <!-- Mission, Vision, Values -->
          <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1.2rem;">
            <div>
              <label class="form-label-custom" style="display: block; font-size: 0.85rem; font-weight: 600; margin-bottom: 4px;">Mission Title & Text</label>
              <input type="text" name="about_mission_title" class="form-control" value="<%= settings.about_mission_title || 'Our Mission' %>" style="margin-bottom: 6px;">
              <textarea name="about_mission_text" class="form-control" rows="2" style="height: auto; padding: 0.6rem;"><%= settings.about_mission_text || 'To deliver high-quality, creative, and reliable embroidery designs that inspire and support embroidery creators worldwide.' %></textarea>
            </div>
            <div>
              <label class="form-label-custom" style="display: block; font-size: 0.85rem; font-weight: 600; margin-bottom: 4px;">Vision Title & Text</label>
              <input type="text" name="about_vision_title" class="form-control" value="<%= settings.about_vision_title || 'Our Vision' %>" style="margin-bottom: 6px;">
              <textarea name="about_vision_text" class="form-control" rows="2" style="height: auto; padding: 0.6rem;"><%= settings.about_vision_text || 'To become a global leader in machine embroidery designs, known for quality, creativity, and excellent customer support.' %></textarea>
            </div>
            <div>
              <label class="form-label-custom" style="display: block; font-size: 0.85rem; font-weight: 600; margin-bottom: 4px;">Values Title & Text</label>
              <input type="text" name="about_values_title" class="form-control" value="<%= settings.about_values_title || 'Our Values' %>" style="margin-bottom: 6px;">
              <textarea name="about_values_text" class="form-control" rows="2" style="height: auto; padding: 0.6rem;"><%= settings.about_values_text || 'Quality, Creativity, Customer Satisfaction and Continuous Innovation.' %></textarea>
            </div>
          </div>
        </div>

        <!-- Card 7: Design Page Settings -->
        <div id="design-settings" class="admin-card-box" style="margin-bottom: 1.8rem; padding: 1.8rem;">
          <div style="border-bottom: 1px solid var(--admin-border); padding-bottom: 0.8rem; margin-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: center;">
            <div>
              <h3 style="font-family: var(--font-heading); font-size: 1.2rem; font-weight: 700; color: var(--admin-text-dark); margin: 0 0 4px;">Design Page Settings</h3>
              <span style="font-size: 0.78rem; color: var(--admin-text-muted);">Configure optional sections on design detail pages. When enabled, only real approved reviews and real database designs are shown (no dummy data).</span>
            </div>
            <span style="background: #E8F5E9; color: #2E7D32; padding: 3px 10px; border-radius: 12px; font-size: 0.75rem; font-weight: 600;"><i class="fa-solid fa-gem"></i> Detail Page</span>
          </div>

          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.4rem;">
            <div style="background: #FAF6F0; border: 1px solid var(--admin-border); border-radius: 12px; padding: 1.2rem;">
              <label style="display: flex; align-items: center; justify-content: space-between; cursor: pointer;">
                <div>
                  <strong style="display: block; font-size: 0.92rem; color: var(--admin-text-dark); margin-bottom: 4px;">Show Reviews</strong>
                  <span style="display: block; font-size: 0.76rem; color: var(--admin-text-muted);">Displays verified customer reviews for this specific design (default: OFF).</span>
                </div>
                <input type="checkbox" name="show_design_reviews" value="1" <%= (typeof settings !== 'undefined' && settings.show_design_reviews === '1') ? 'checked' : '' %> style="width: 20px; height: 20px; cursor: pointer; accent-color: var(--admin-primary);">
              </label>
            </div>

            <div style="background: #FAF6F0; border: 1px solid var(--admin-border); border-radius: 12px; padding: 1.2rem;">
              <label style="display: flex; align-items: center; justify-content: space-between; cursor: pointer;">
                <div>
                  <strong style="display: block; font-size: 0.92rem; color: var(--admin-text-dark); margin-bottom: 4px;">Show Related Designs</strong>
                  <span style="display: block; font-size: 0.76rem; color: var(--admin-text-muted);">Displays real related designs from the same category from the database (default: OFF).</span>
                </div>
                <input type="checkbox" name="show_design_related" value="1" <%= (typeof settings !== 'undefined' && settings.show_design_related === '1') ? 'checked' : '' %> style="width: 20px; height: 20px; cursor: pointer; accent-color: var(--admin-primary);">
              </label>
            </div>

            <div style="background: #FAF6F0; border: 1px solid var(--admin-border); border-radius: 12px; padding: 1.2rem;">
              <label style="display: flex; align-items: center; justify-content: space-between; cursor: pointer;">
                <div>
                  <strong style="display: block; font-size: 0.92rem; color: var(--admin-text-dark); margin-bottom: 4px;">
                    <i class="fa-solid fa-download" style="color: var(--admin-primary); margin-right: 5px;"></i> Show Preview Download Button
                  </strong>
                  <span style="display: block; font-size: 0.76rem; color: var(--admin-text-muted);">Shows the public PNG preview download pill on the main product image and lightbox (default: ON).</span>
                </div>
                <input type="checkbox" name="show_preview_download_button" value="1" <%= (typeof settings === 'undefined' || settings.show_preview_download_button !== '0') ? 'checked' : '' %> style="width: 20px; height: 20px; cursor: pointer; accent-color: var(--admin-primary);">
              </label>
            </div>

            <div style="background: #FAF6F0; border: 1px solid var(--admin-border); border-radius: 12px; padding: 1.2rem;">
              <label style="display: flex; align-items: center; justify-content: space-between; cursor: pointer;">
                <div>
                  <strong style="display: block; font-size: 0.92rem; color: var(--admin-text-dark); margin-bottom: 4px;">
                    <i class="fa-solid fa-lock" style="color: #6A1B9A; margin-right: 5px;"></i> Require Login to Download Previews
                  </strong>
                  <span style="display: block; font-size: 0.76rem; color: var(--admin-text-muted);">When checked, visitors must be logged into a customer account to download previews (default: OFF).</span>
                </div>
                <input type="checkbox" name="require_login_preview_download" value="1" <%= (typeof settings !== 'undefined' && settings.require_login_preview_download === '1') ? 'checked' : '' %> style="width: 20px; height: 20px; cursor: pointer; accent-color: var(--admin-primary);">
              </label>
            </div>

            <div style="background: #FAF6F0; border: 1px solid var(--admin-border); border-radius: 12px; padding: 1.2rem; grid-column: span 2;">
              <label style="display: flex; align-items: center; justify-content: space-between; cursor: pointer;">
                <div>
                  <strong style="display: block; font-size: 0.92rem; color: var(--admin-text-dark); margin-bottom: 4px;">
                    <i class="fa-solid fa-stamp" style="color: #007791; margin-right: 5px;"></i> Add Aruvi Watermark to Preview Images
                  </strong>
                  <span style="display: block; font-size: 0.76rem; color: var(--admin-text-muted);">Automatically stamps the Aruvi brand watermark when generating preview downloads and bulk replacing images (default: ON).</span>
                </div>
                <input type="checkbox" name="watermark_preview_images" value="1" <%= (typeof settings === 'undefined' || settings.watermark_preview_images !== '0') ? 'checked' : '' %> style="width: 20px; height: 20px; cursor: pointer; accent-color: var(--admin-primary);">
              </label>
            </div>
          </div>
        </div>

        <!-- Card 7b: Stitch Count Display & Formatting -->
        <div id="stitch-settings" class="admin-card-box" style="margin-bottom: 1.8rem; padding: 1.8rem;">
          <div style="border-bottom: 1px solid var(--admin-border); padding-bottom: 0.8rem; margin-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
            <div>
              <h3 style="font-family: var(--font-heading); font-size: 1.2rem; font-weight: 700; color: var(--admin-text-dark); margin: 0 0 4px;">
                <i class="fa-solid fa-layer-group" style="color: var(--admin-primary); margin-right: 6px;"></i> Stitch Count Display & Labels
              </h3>
              <span style="font-size: 0.78rem; color: var(--admin-text-muted);">Configure thousands separators (Indian vs International), row labels on customer detail page, and card visibility.</span>
            </div>
            <span style="background: #EFEBE9; color: #4E342E; padding: 3px 10px; border-radius: 12px; font-size: 0.75rem; font-weight: 600;"><i class="fa-solid fa-sliders"></i> Stitch Engine</span>
          </div>

          <!-- General Format & Cards Display -->
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.4rem; margin-bottom: 1.4rem;">
            <div style="background: #FAF6F0; border: 1px solid var(--admin-border); border-radius: 12px; padding: 1.2rem;">
              <label class="form-label-custom" style="display: block; font-size: 0.86rem; font-weight: 700; color: var(--admin-text-dark); margin-bottom: 6px;">
                <i class="fa-solid fa-calculator" style="color: var(--admin-primary); margin-right: 4px;"></i> Number Formatting (Thousands Separators)
              </label>
              <select name="stitch_number_format" class="form-control" style="height: 42px; border-radius: 8px; border: 1px solid var(--admin-border); padding: 0 0.8rem; font-size: 0.85rem; width: 100%; background: #FFF;">
                <option value="indian" <%= (!settings.stitch_number_format || settings.stitch_number_format === 'indian') ? 'selected' : '' %>>Indian Format (e.g. 1,24,580)</option>
                <option value="international" <%= (settings.stitch_number_format === 'international') ? 'selected' : '' %>>International Format (e.g. 124,580)</option>
              </select>
              <small style="display: block; font-size: 0.74rem; color: var(--admin-text-muted); margin-top: 4px;">Applies to detail page specs, listing card badges, and admin tables.</small>
            </div>

            <div style="background: #FAF6F0; border: 1px solid var(--admin-border); border-radius: 12px; padding: 1.2rem; display: flex; flex-direction: column; justify-content: center;">
              <label style="display: flex; align-items: center; justify-content: space-between; cursor: pointer;">
                <div>
                  <strong style="display: block; font-size: 0.92rem; color: var(--admin-text-dark); margin-bottom: 4px;">Show Total Stitches on Cards</strong>
                  <span style="display: block; font-size: 0.76rem; color: var(--admin-text-muted);">Renders a stitch badge on catalog & category product cards (default: OFF).</span>
                </div>
                <input type="checkbox" name="show_stitch_on_cards" value="1" <%= (typeof settings !== 'undefined' && settings.show_stitch_on_cards === '1') ? 'checked' : '' %> style="width: 20px; height: 20px; cursor: pointer; accent-color: var(--admin-primary);">
              </label>
            </div>
          </div>

          <!-- Detail Page Rows & Labels -->
          <div style="background: #FAF6F0; border: 1px solid var(--admin-border); border-radius: 12px; padding: 1.4rem;">
            <strong style="display: block; font-size: 0.92rem; color: var(--admin-text-dark); margin-bottom: 4px;">
              <i class="fa-solid fa-table-list" style="color: var(--admin-primary); margin-right: 4px;"></i> Customer Detail Page Rows & Custom Labels
            </strong>
            <p style="font-size: 0.78rem; color: var(--admin-text-muted); margin-bottom: 1.2rem;">
              Rows only appear on the customer detail page when the design has a positive value. You can rename labels or toggle individual rows off globally.
            </p>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.2rem;">
              <!-- Front -->
              <div style="background: #FFF; border: 1px solid var(--admin-border); border-radius: 10px; padding: 1rem;">
                <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px;">
                  <span style="font-weight: 700; font-size: 0.85rem; color: var(--admin-text-dark);">Front Stitches</span>
                  <label style="display: inline-flex; align-items: center; gap: 6px; font-size: 0.8rem; cursor: pointer;">
                    <input type="checkbox" name="show_stitch_front" value="1" <%= (typeof settings === 'undefined' || settings.show_stitch_front !== '0') ? 'checked' : '' %> style="accent-color: var(--admin-primary);">
                    <span>Enabled</span>
                  </label>
                </div>
                <label style="display: block; font-size: 0.75rem; color: var(--admin-text-muted); margin-bottom: 4px;">Label Text</label>
                <input type="text" name="label_stitch_front" class="form-control" value="<%= (typeof settings !== 'undefined' && settings.label_stitch_front) ? settings.label_stitch_front : 'Stitch Count (Front)' %>">
              </div>

              <!-- Back -->
              <div style="background: #FFF; border: 1px solid var(--admin-border); border-radius: 10px; padding: 1rem;">
                <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px;">
                  <span style="font-weight: 700; font-size: 0.85rem; color: var(--admin-text-dark);">Back Stitches</span>
                  <label style="display: inline-flex; align-items: center; gap: 6px; font-size: 0.8rem; cursor: pointer;">
                    <input type="checkbox" name="show_stitch_back" value="1" <%= (typeof settings === 'undefined' || settings.show_stitch_back !== '0') ? 'checked' : '' %> style="accent-color: var(--admin-primary);">
                    <span>Enabled</span>
                  </label>
                </div>
                <label style="display: block; font-size: 0.75rem; color: var(--admin-text-muted); margin-bottom: 4px;">Label Text</label>
                <input type="text" name="label_stitch_back" class="form-control" value="<%= (typeof settings !== 'undefined' && settings.label_stitch_back) ? settings.label_stitch_back : 'Stitch Count (Back)' %>">
              </div>

              <!-- Sleeve -->
              <div style="background: #FFF; border: 1px solid var(--admin-border); border-radius: 10px; padding: 1rem;">
                <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px;">
                  <span style="font-weight: 700; font-size: 0.85rem; color: var(--admin-text-dark);">Sleeve Stitches</span>
                  <label style="display: inline-flex; align-items: center; gap: 6px; font-size: 0.8rem; cursor: pointer;">
                    <input type="checkbox" name="show_stitch_sleeve" value="1" <%= (typeof settings === 'undefined' || settings.show_stitch_sleeve !== '0') ? 'checked' : '' %> style="accent-color: var(--admin-primary);">
                    <span>Enabled</span>
                  </label>
                </div>
                <label style="display: block; font-size: 0.75rem; color: var(--admin-text-muted); margin-bottom: 4px;">Label Text</label>
                <input type="text" name="label_stitch_sleeve" class="form-control" value="<%= (typeof settings !== 'undefined' && settings.label_stitch_sleeve) ? settings.label_stitch_sleeve : 'Stitch Count (Sleeve)' %>">
              </div>

              <!-- Total -->
              <div style="background: #FFF; border: 1px solid var(--admin-border); border-radius: 10px; padding: 1rem;">
                <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px;">
                  <span style="font-weight: 700; font-size: 0.85rem; color: var(--admin-text-dark);">Total Stitches</span>
                  <label style="display: inline-flex; align-items: center; gap: 6px; font-size: 0.8rem; cursor: pointer;">
                    <input type="checkbox" name="show_stitch_total" value="1" <%= (typeof settings === 'undefined' || settings.show_stitch_total !== '0') ? 'checked' : '' %> style="accent-color: var(--admin-primary);">
                    <span>Enabled</span>
                  </label>
                </div>
                <label style="display: block; font-size: 0.75rem; color: var(--admin-text-muted); margin-bottom: 4px;">Label Text</label>
                <input type="text" name="label_stitch_total" class="form-control" value="<%= (typeof settings !== 'undefined' && settings.label_stitch_total) ? settings.label_stitch_total : 'Total Stitch Count' %>">
              </div>
            </div>
          </div>
        </div>

        <!-- Card 8: Trust / Feature Cards (Shared across Home, Custom Order & About) -->
        <div id="feature-cards-settings" class="admin-card-box" style="margin-bottom: 1.8rem; padding: 1.8rem;">
          <div style="border-bottom: 1px solid var(--admin-border); padding-bottom: 0.8rem; margin-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px;">
            <div>
              <h3 style="font-family: var(--font-heading); font-size: 1.2rem; font-weight: 700; color: var(--admin-text-dark); margin: 0 0 4px;">Trust & Feature Cards</h3>
              <span style="font-size: 0.78rem; color: var(--admin-text-muted);">Shared 4-card trust bar across Homepage, Custom Order, and About pages. All text wraps gracefully on mobile without cutting off.</span>
            </div>
            <span style="background: #E8F5E9; color: #2E7D32; padding: 3px 10px; border-radius: 12px; font-size: 0.75rem; font-weight: 600;"><i class="fa-solid fa-rotate"></i> Synchronized Across Pages</span>
          </div>

          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 1.2rem;">
            <!-- Card 1 -->
            <div style="background: #FAF6F0; border: 1px solid var(--admin-border); border-radius: 12px; padding: 1.2rem;">
              <strong style="display: block; font-size: 0.88rem; color: var(--admin-primary); margin-bottom: 8px;"><i class="fa-solid fa-award"></i> Card 1</strong>
              <div style="margin-bottom: 8px;">
                <label style="display: block; font-size: 0.76rem; font-weight: 600; margin-bottom: 4px;">Title</label>
                <input type="text" name="feature_card1_title" class="form-control" value="<%= (typeof settings !== 'undefined' && settings.feature_card1_title) ? settings.feature_card1_title : 'Premium Quality' %>">
              </div>
              <div style="margin-bottom: 8px;">
                <label style="display: block; font-size: 0.76rem; font-weight: 600; margin-bottom: 4px;">Subtitle</label>
                <input type="text" name="feature_card1_subtitle" class="form-control" value="<%= (typeof settings !== 'undefined' && settings.feature_card1_subtitle) ? settings.feature_card1_subtitle : 'Crafted with precision' %>">
              </div>
              <div>
                <label style="display: block; font-size: 0.76rem; font-weight: 600; margin-bottom: 4px;">FontAwesome Icon Class</label>
                <input type="text" name="feature_card1_icon" class="form-control" value="<%= (typeof settings !== 'undefined' && settings.feature_card1_icon) ? settings.feature_card1_icon : 'fa-solid fa-award' %>">
              </div>
            </div>

            <!-- Card 2 -->
            <div style="background: #FAF6F0; border: 1px solid var(--admin-border); border-radius: 12px; padding: 1.2rem;">
              <strong style="display: block; font-size: 0.88rem; color: var(--admin-primary); margin-bottom: 8px;"><i class="fa-solid fa-download"></i> Card 2</strong>
              <div style="margin-bottom: 8px;">
                <label style="display: block; font-size: 0.76rem; font-weight: 600; margin-bottom: 4px;">Title</label>
                <input type="text" name="feature_card2_title" class="form-control" value="<%= (typeof settings !== 'undefined' && settings.feature_card2_title) ? settings.feature_card2_title : 'Instant Download' %>">
              </div>
              <div style="margin-bottom: 8px;">
                <label style="display: block; font-size: 0.76rem; font-weight: 600; margin-bottom: 4px;">Subtitle</label>
                <input type="text" name="feature_card2_subtitle" class="form-control" value="<%= (typeof settings !== 'undefined' && settings.feature_card2_subtitle) ? settings.feature_card2_subtitle : 'Get files immediately' %>">
              </div>
              <div>
                <label style="display: block; font-size: 0.76rem; font-weight: 600; margin-bottom: 4px;">FontAwesome Icon Class</label>
                <input type="text" name="feature_card2_icon" class="form-control" value="<%= (typeof settings !== 'undefined' && settings.feature_card2_icon) ? settings.feature_card2_icon : 'fa-solid fa-download' %>">
              </div>
            </div>

            <!-- Card 3 -->
            <div style="background: #FAF6F0; border: 1px solid var(--admin-border); border-radius: 12px; padding: 1.2rem;">
              <strong style="display: block; font-size: 0.88rem; color: var(--admin-primary); margin-bottom: 8px;"><i class="fa-solid fa-shield-halved"></i> Card 3</strong>
              <div style="margin-bottom: 8px;">
                <label style="display: block; font-size: 0.76rem; font-weight: 600; margin-bottom: 4px;">Title</label>
                <input type="text" name="feature_card3_title" class="form-control" value="<%= (typeof settings !== 'undefined' && settings.feature_card3_title) ? settings.feature_card3_title : '100% Tested' %>">
              </div>
              <div style="margin-bottom: 8px;">
                <label style="display: block; font-size: 0.76rem; font-weight: 600; margin-bottom: 4px;">Subtitle</label>
                <input type="text" name="feature_card3_subtitle" class="form-control" value="<%= (typeof settings !== 'undefined' && settings.feature_card3_subtitle) ? settings.feature_card3_subtitle : 'Quality assured designs' %>">
              </div>
              <div>
                <label style="display: block; font-size: 0.76rem; font-weight: 600; margin-bottom: 4px;">FontAwesome Icon Class</label>
                <input type="text" name="feature_card3_icon" class="form-control" value="<%= (typeof settings !== 'undefined' && settings.feature_card3_icon) ? settings.feature_card3_icon : 'fa-solid fa-shield-halved' %>">
              </div>
            </div>

            <!-- Card 4 -->
            <div style="background: #FAF6F0; border: 1px solid var(--admin-border); border-radius: 12px; padding: 1.2rem;">
              <strong style="display: block; font-size: 0.88rem; color: var(--admin-primary); margin-bottom: 8px;"><i class="fa-solid fa-headset"></i> Card 4</strong>
              <div style="margin-bottom: 8px;">
                <label style="display: block; font-size: 0.76rem; font-weight: 600; margin-bottom: 4px;">Title</label>
                <input type="text" name="feature_card4_title" class="form-control" value="<%= (typeof settings !== 'undefined' && settings.feature_card4_title) ? settings.feature_card4_title : 'Dedicated Support' %>">
              </div>
              <div style="margin-bottom: 8px;">
                <label style="display: block; font-size: 0.76rem; font-weight: 600; margin-bottom: 4px;">Subtitle</label>
                <input type="text" name="feature_card4_subtitle" class="form-control" value="<%= (typeof settings !== 'undefined' && settings.feature_card4_subtitle) ? settings.feature_card4_subtitle : "We're here to help you" %>">
              </div>
              <div>
                <label style="display: block; font-size: 0.76rem; font-weight: 600; margin-bottom: 4px;">FontAwesome Icon Class</label>
                <input type="text" name="feature_card4_icon" class="form-control" value="<%= (typeof settings !== 'undefined' && settings.feature_card4_icon) ? settings.feature_card4_icon : 'fa-solid fa-headset' %>">
              </div>
            </div>
          </div>
        </div>

        <div style="display: flex; justify-content: flex-end;">
          <button type="submit" class="btn btn-primary btn-lg" style="height: 48px; border-radius: 10px; font-weight: 600; padding: 0 2rem; display: inline-flex; align-items: center; gap: 8px;">
            <i class="fa-solid fa-floppy-disk"></i> Save & Synchronize Branding
          </button>
        </div>

      </form>

    </main>
  </div>
</div>

<script>
  function previewImg(input, targetId) {
    if (input.files && input.files[0]) {
      const reader = new FileReader();
      reader.onload = function(e) {
        document.getElementById(targetId).src = e.target.result;
      };
      reader.readAsDataURL(input.files[0]);
    }
  }

  async function testRazorpayConnection() {
    const btn = document.getElementById('testRzpBtn');
    const statusText = document.getElementById('testRzpStatusText');
    const keyId = document.getElementById('rzp_key_id')?.value.trim();
    const keySecret = document.getElementById('rzp_key_secret')?.value.trim();

    btn.disabled = true;
    btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Testing Connection...';
    statusText.textContent = '';

    try {
      const res = await fetch('/admin/api/test-razorpay', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify({ key_id: keyId, key_secret: keySecret })
      });
      const data = await res.json();

      btn.disabled = false;
      btn.innerHTML = '<i class="fa-solid fa-plug-circle-check"></i> Test Connection';

      if (data.success) {
        statusText.style.color = '#2E7D32';
        statusText.innerHTML = `<i class="fa-solid fa-circle-check"></i> ${data.message}`;
      } else {
        statusText.style.color = '#C62828';
        statusText.innerHTML = `<i class="fa-solid fa-circle-xmark"></i> ${data.message || 'Connection failed'}`;
      }
    } catch (err) {
      btn.disabled = false;
      btn.innerHTML = '<i class="fa-solid fa-plug-circle-check"></i> Test Connection';
      statusText.style.color = '#C62828';
      statusText.innerHTML = `<i class="fa-solid fa-circle-xmark"></i> Connection test failed: ${err.message}`;
    }
  }
</script>

</body>
</html>
