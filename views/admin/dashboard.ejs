<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Dashboard - ARUVI EMBROIDERY STUDIO</title>
  <link rel="icon" type="image/jpeg" href="/public/images/logo.jpg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;1,400&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="/public/css/main.css">
  <link rel="stylesheet" href="/public/css/admin.css">
  <!-- Chart.js CDN -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body class="admin-body">

<div class="admin-wrapper">
  <!-- Top Navigation Bar matching Reference -->
  <header class="admin-top-header">
    <a href="/admin" class="admin-header-brand">
      <% const currentLogo = (typeof siteSettings !== 'undefined' && siteSettings.logo_url) ? siteSettings.logo_url : '/public/images/logo.jpg'; %>
      <img src="<%= currentLogo %>" alt="ARUVI Admin Logo" style="max-height: 42px; width: auto; object-fit: contain;">
    </a>

    <!-- Global Search -->
    <div class="admin-search-bar">
      <i class="fa-solid fa-magnifying-glass"></i>
      <input type="text" placeholder="Search orders, designs, customers...">
    </div>

    <!-- Right User Header Icons -->
    <div class="admin-header-right">
      <a href="/admin/messages" class="admin-icon-btn" title="Notifications">
        <i class="fa-regular fa-bell"></i>
        <% if (typeof adminNavBadges !== 'undefined' && adminNavBadges.unreadNotifications > 0) { %>
          <span class="badge-count"><%= adminNavBadges.unreadNotifications %></span>
        <% } %>
      </a>

      <div class="admin-user-menu">
        <div class="admin-user-avatar">A</div>
        <div class="admin-user-info">
          <strong>Admin</strong>
          <span>Administrator</span>
        </div>
        <i class="fa-solid fa-chevron-down" style="font-size: 0.75rem; color: var(--admin-text-muted); margin-left: 4px;"></i>
      </div>
    </div>
  </header>

  <!-- Admin Main Layout with Sidebar -->
  <div class="admin-main-container">
    <!-- Left Sidebar matching Reference -->
    <aside class="admin-sidebar">
      <!-- Active Item: Dashboard -->
      <ul class="sidebar-nav-list" style="margin-bottom: 1.2rem;">
        <li class="sidebar-nav-item">
          <a href="/admin" class="active">
            <span><i class="fa-solid fa-house"></i> Dashboard</span>
          </a>
        </li>
      </ul>

      <!-- DESIGNS Section -->
      <div class="admin-sidebar-section">
        <div class="sidebar-heading">DESIGNS</div>
        <ul class="sidebar-nav-list">
          <li class="sidebar-nav-item"><a href="/admin/designs"><span><i class="fa-solid fa-box-archive"></i> Manage Designs</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/designs/create"><span><i class="fa-solid fa-circle-plus"></i> Add New Design</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/categories"><span><i class="fa-solid fa-border-all"></i> Categories</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/custom-orders"><span><i class="fa-solid fa-wand-magic-sparkles"></i> Custom Orders</span></a></li>
        </ul>
      </div>

      <!-- ORDERS Section -->
      <div class="admin-sidebar-section">
        <div class="sidebar-heading">ORDERS</div>
        <ul class="sidebar-nav-list">
          <li class="sidebar-nav-item"><a href="/admin/orders"><span><i class="fa-regular fa-newspaper"></i> All Orders</span></a></li>
          <li class="sidebar-nav-item">
            <a href="/admin/orders?status=pending">
              <span><i class="fa-regular fa-clock"></i> Pending Orders</span>
              <% if (typeof adminNavBadges !== 'undefined' && adminNavBadges.pendingOrders > 0) { %>
                <span class="sidebar-badge"><%= adminNavBadges.pendingOrders %></span>
              <% } %>
            </a>
          </li>
          <li class="sidebar-nav-item"><a href="/admin/orders?status=completed"><span><i class="fa-regular fa-circle-check"></i> Completed Orders</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/orders?status=cancelled"><span><i class="fa-regular fa-circle-xmark"></i> Cancelled Orders</span></a></li>
        </ul>
      </div>

      <!-- CUSTOMERS Section -->
      <div class="admin-sidebar-section">
        <div class="sidebar-heading">CUSTOMERS</div>
        <ul class="sidebar-nav-list">
          <li class="sidebar-nav-item"><a href="/admin/customers"><span><i class="fa-solid fa-users"></i> All Customers</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/messages"><span><i class="fa-regular fa-comment-dots"></i> Enquiries</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/email-campaigns"><span><i class="fa-solid fa-paper-plane"></i> Email Campaigns 📧</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/reviews"><span><i class="fa-regular fa-star"></i> Reviews</span></a></li>
        </ul>
      </div>

      <!-- CONTENT Section -->
      <div class="admin-sidebar-section">
        <div class="sidebar-heading">CONTENT</div>
        <ul class="sidebar-nav-list">
          <li class="sidebar-nav-item"><a href="/admin/homepage"><span><i class="fa-solid fa-house-chimney"></i> Homepage</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/banners"><span><i class="fa-regular fa-image"></i> Banners</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/settings"><span><i class="fa-solid fa-gear"></i> Website Settings</span></a></li>
        </ul>
      </div>

      <!-- STORAGE & RECOVERY Section -->
      <div class="admin-sidebar-section">
        <div class="sidebar-heading">STORAGE & RECOVERY</div>
        <ul class="sidebar-nav-list">
          <li class="sidebar-nav-item"><a href="/admin/tools/system-health"><span><i class="fa-solid fa-heart-pulse"></i> System Health</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/tools/missing-files"><span><i class="fa-solid fa-triangle-exclamation"></i> Missing Files</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/tools/bulk-image-relink"><span><i class="fa-solid fa-images"></i> Bulk Image Relink</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/tools/bulk-file-relink"><span><i class="fa-solid fa-file-zipper"></i> Bulk File Relink</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/tools/backup"><span><i class="fa-solid fa-database"></i> Backup & Storage</span></a></li>
        </ul>
      </div>

      <div style="margin-top: auto; padding-top: 1rem; border-top: 1px solid var(--admin-border);">
        <a href="/admin/logout" style="display: flex; align-items: center; gap: 8px; color: var(--admin-primary); font-size: 0.85rem; font-weight: 600; text-decoration: none; padding: 0.5rem 0.8rem;">
          <i class="fa-solid fa-arrow-right-from-bracket"></i> Logout Admin
        </a>
      </div>
    </aside>

    <!-- Main Content Body -->
    <main class="admin-content-body">

      <% if (typeof paymentConfig !== 'undefined' && !paymentConfig.isConfigured) { %>
        <div style="background: #FEE2E2; border: 1px solid #F87171; border-radius: 10px; padding: 1rem 1.25rem; margin-bottom: 1.5rem; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem;">
          <div style="display: flex; align-items: center; gap: 0.75rem;">
            <div style="width: 38px; height: 38px; background: #EF4444; color: #FFFFFF; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.2rem; flex-shrink: 0;">
              <i class="fa-solid fa-triangle-exclamation"></i>
            </div>
            <div>
              <strong style="color: #991B1B; font-size: 0.95rem;">Payment Gateway Warning: Razorpay keys are missing or incomplete</strong>
              <div style="color: #B91C1C; font-size: 0.82rem; margin-top: 2px;">
                Customers cannot complete online payments at checkout until Razorpay Key ID and Key Secret are configured.
              </div>
            </div>
          </div>
          <div style="display: flex; gap: 0.5rem;">
            <a href="/admin/settings#payment-settings" class="btn btn-primary" style="font-size: 0.82rem; padding: 0.45rem 0.9rem; text-decoration: none; background: #DC2626; border-color: #DC2626; color: #fff; font-weight: 600; border-radius: 6px;">
              <i class="fa-solid fa-gear" style="margin-right: 5px;"></i> Configure Payments
            </a>
          </div>
        </div>
      <% } %>

      <% if (typeof healthScan !== 'undefined' && !healthScan.healthy && healthScan.totalIssues > 0) { %>
        <div style="background: #FFF8E1; border: 1px solid #FFE082; border-radius: 10px; padding: 1rem 1.25rem; margin-bottom: 1.5rem; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem;">
          <div style="display: flex; align-items: center; gap: 0.75rem;">
            <div style="width: 38px; height: 38px; background: #FFC107; color: #5D4037; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.2rem;">
              <i class="fa-solid fa-triangle-exclamation"></i>
            </div>
            <div>
              <strong style="color: #795548; font-size: 0.95rem;">Storage Health Warning: <%= healthScan.totalIssues %> designs have missing files</strong>
              <div style="color: #8D6E63; font-size: 0.8rem;">
                Detected <%= healthScan.missingImagesCount %> missing preview images and <%= healthScan.missingFilesCount %> missing machine files.
              </div>
            </div>
          </div>
          <div style="display: flex; gap: 0.5rem;">
            <a href="/admin/tools/missing-files" class="btn btn-outline" style="font-size: 0.8rem; padding: 0.4rem 0.8rem; border-color: #FFA000; color: #795548; text-decoration: none;">
              Review Missing Files
            </a>
            <a href="/admin/tools/bulk-image-relink" class="btn btn-primary" style="font-size: 0.8rem; padding: 0.4rem 0.8rem; text-decoration: none; background: #795548; border-color: #795548;">
              Bulk Relink Tool
            </a>
          </div>
        </div>
      <% } %>

      <!-- Hero Welcome Banner -->
      <div class="admin-welcome-hero">
        <div class="welcome-hero-text">
          <span style="font-size: 0.72rem; letter-spacing: 1.5px; font-weight: 700; color: var(--admin-primary); text-transform: uppercase;">LIVE STORE DASHBOARD</span>
          <h1>Admin Overview</h1>
          <p>Real-time data from your store database.<br>Live products, paid revenues, orders and customer activities.</p>
        </div>
      </div>

      <!-- 5 Stat Summary Cards Row -->
      <div class="admin-stats-row" style="grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));">
        <!-- Total Products Card -->
        <div class="admin-summary-card">
          <div class="card-icon-badge"><i class="fa-solid fa-box-archive"></i></div>
          <div class="card-info-content">
            <div class="stat-title">Total Products</div>
            <div style="display: flex; align-items: baseline;">
              <span class="stat-num"><%= stats.totalDesigns || 0 %></span>
              <span class="stat-trend" style="color: <%= stats.designsTrend.isPositive ? 'inherit' : 'var(--admin-primary)' %>;">
                <i class="fa-solid fa-arrow-<%= stats.designsTrend.isPositive ? 'up' : 'down' %>"></i> <%= stats.designsTrend.text %>
              </span>
            </div>
            <span style="font-size: 0.72rem; color: var(--admin-text-muted);">active in catalog</span>
          </div>
        </div>

        <!-- Total Orders Card -->
        <div class="admin-summary-card">
          <div class="card-icon-badge"><i class="fa-solid fa-bag-shopping"></i></div>
          <div class="card-info-content">
            <div class="stat-title">Total Orders</div>
            <div style="display: flex; align-items: baseline;">
              <span class="stat-num"><%= stats.totalOrders || 0 %></span>
              <span class="stat-trend" style="color: <%= stats.ordersTrend.isPositive ? 'inherit' : 'var(--admin-primary)' %>;">
                <i class="fa-solid fa-arrow-<%= stats.ordersTrend.isPositive ? 'up' : 'down' %>"></i> <%= stats.ordersTrend.text %>
              </span>
            </div>
            <span style="font-size: 0.72rem; color: var(--admin-text-muted);">all-time orders</span>
          </div>
        </div>

        <!-- Total Revenue Card (SUM of paid orders only) -->
        <div class="admin-summary-card">
          <div class="card-icon-badge"><i class="fa-solid fa-indian-rupee-sign"></i></div>
          <div class="card-info-content">
            <div class="stat-title">Paid Revenue</div>
            <div style="display: flex; align-items: baseline;">
              <span class="stat-num">₹<%= parseFloat(stats.totalSales || 0).toLocaleString('en-IN', { maximumFractionDigits: 2 }) %></span>
              <span class="stat-trend" style="color: <%= stats.salesTrend.isPositive ? 'inherit' : 'var(--admin-primary)' %>;">
                <i class="fa-solid fa-arrow-<%= stats.salesTrend.isPositive ? 'up' : 'down' %>"></i> <%= stats.salesTrend.text %>
              </span>
            </div>
            <span style="font-size: 0.72rem; color: var(--admin-text-muted);">paid orders only</span>
          </div>
        </div>

        <!-- Total Customers Card -->
        <div class="admin-summary-card">
          <div class="card-icon-badge"><i class="fa-solid fa-users"></i></div>
          <div class="card-info-content">
            <div class="stat-title">Total Customers</div>
            <div style="display: flex; align-items: baseline;">
              <span class="stat-num"><%= stats.totalCustomers || 0 %></span>
              <span class="stat-trend" style="color: <%= stats.customersTrend.isPositive ? 'inherit' : 'var(--admin-primary)' %>;">
                <i class="fa-solid fa-arrow-<%= stats.customersTrend.isPositive ? 'up' : 'down' %>"></i> <%= stats.customersTrend.text %>
              </span>
            </div>
            <span style="font-size: 0.72rem; color: var(--admin-text-muted);">registered customers</span>
          </div>
        </div>

        <!-- Custom Requests Card -->
        <div class="admin-summary-card">
          <div class="card-icon-badge"><i class="fa-solid fa-wand-magic-sparkles"></i></div>
          <div class="card-info-content">
            <div class="stat-title">Custom Requests</div>
            <div style="display: flex; align-items: baseline;">
              <span class="stat-num"><%= (stats.customRequests && stats.customRequests.total !== undefined) ? stats.customRequests.total : 0 %></span>
              <% const pendingCount = (stats.customRequests && stats.customRequests.pending) ? stats.customRequests.pending : 0; %>
              <span class="stat-trend" style="color: <%= pendingCount > 0 ? '#F57F17' : '#2E7D32' %>;">
                <%= pendingCount %> pending
              </span>
            </div>
            <span style="font-size: 0.72rem; color: var(--admin-text-muted);">custom motifs</span>
          </div>
        </div>
      </div>

      <!-- Charts Section (2 Columns: Sales Overview & Top Categories Donut) -->
      <div class="admin-charts-row">
        <!-- Card 1: Sales Overview Area Chart -->
        <div class="admin-card-box">
          <div class="card-header-flex">
            <h3>Sales Overview</h3>
            <span style="font-size: 0.8rem; color: var(--admin-text-muted);">Last 6 Months (Paid Orders)</span>
          </div>
          <div style="height: 240px; position: relative;">
            <canvas id="salesOverviewChart"></canvas>
          </div>
        </div>

        <!-- Card 2: Top Categories Donut Chart (Percentage share by items sold per category) -->
        <div class="admin-card-box">
          <div class="card-header-flex">
            <h3>Top Categories</h3>
            <span style="font-size: 0.8rem; color: var(--admin-text-muted);">Share of Items Sold</span>
          </div>
          
          <% const hasCategorySales = stats.topCategories && stats.topCategories.length > 0; %>
          <% const totalSoldSum = hasCategorySales ? stats.topCategories.reduce((s, c) => s + c.count, 0) : 0; %>

          <div style="display: flex; align-items: center; gap: 1.2rem; height: 240px;">
            <% if (hasCategorySales && totalSoldSum > 0) { %>
              <!-- Donut Canvas Container -->
              <div style="width: 160px; height: 160px; position: relative; flex-shrink: 0; margin: 0 auto;">
                <canvas id="topCategoriesChart"></canvas>
                <!-- Center Text -->
                <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); text-align: center; pointer-events: none;">
                  <div style="font-size: 1.4rem; font-family: var(--font-heading); font-weight: 700; color: var(--admin-text-dark); line-height: 1;"><%= totalSoldSum %></div>
                  <div style="font-size: 0.68rem; color: var(--admin-text-muted);">Items Sold</div>
                </div>
              </div>

              <!-- Real Category Legend Stack -->
              <div style="display: flex; flex-direction: column; gap: 8px; flex: 1; font-size: 0.8rem; max-height: 220px; overflow-y: auto;">
                <% const catPalette = ['#B8402A', '#2196F3', '#4CAF50', '#FF9800', '#9C27B0', '#00BCD4']; %>
                <% stats.topCategories.forEach((cat, idx) => { %>
                  <div style="display: flex; align-items: center; justify-content: space-between;">
                    <div style="display: flex; align-items: center; gap: 8px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                      <span style="width: 10px; height: 10px; border-radius: 50%; background: <%= catPalette[idx % catPalette.length] %>; flex-shrink: 0;"></span>
                      <span style="font-weight: 500;"><%= cat.name %></span>
                    </div>
                    <strong><%= cat.count %> <span style="font-weight: 400; color: var(--admin-text-muted); font-size: 0.75rem;">(<%= cat.percentage %>%)</span></strong>
                  </div>
                <% }); %>
              </div>
            <% } else { %>
              <!-- Friendly Empty State -->
              <div style="width: 100%; text-align: center; color: var(--admin-text-muted); padding: 2rem;">
                <div style="width: 52px; height: 52px; border-radius: 50%; background: #FAF6F0; color: var(--admin-text-muted); display: inline-flex; align-items: center; justify-content: center; font-size: 1.4rem; margin-bottom: 0.6rem; border: 1px solid var(--admin-border);">
                  <i class="fa-solid fa-chart-pie"></i>
                </div>
                <div style="font-weight: 600; color: var(--admin-text-dark); font-size: 0.95rem;">No category sales yet</div>
                <p style="font-size: 0.8rem; margin: 4px 0 0;">Sold items will reflect percentage shares per category automatically.</p>
              </div>
            <% } %>
          </div>
        </div>
      </div>

      <!-- Bottom Grid: Recent Orders, Top Selling Designs, Admin Activity Log -->
      <div class="admin-bottom-grid" style="grid-template-columns: 1.4fr 1fr; margin-bottom: 1.8rem;">
        
        <!-- Column 1: Recent Orders -->
        <div class="admin-card-box">
          <div class="card-header-flex">
            <h3>Recent Orders</h3>
            <a href="/admin/orders" class="view-all-link">View All &rarr;</a>
          </div>

          <table class="admin-table-styled">
            <thead>
              <tr>
                <th>Order #</th>
                <th>Customer</th>
                <th>Design</th>
                <th>Amount</th>
                <th>Status</th>
                <th>Date</th>
              </tr>
            </thead>
            <tbody>
              <% if (stats.recentOrders && stats.recentOrders.length > 0) { %>
                <% stats.recentOrders.forEach(ord => { %>
                  <tr>
                    <td><a href="/admin/orders/<%= ord.id %>" style="color: var(--admin-primary); font-weight: 700; text-decoration: none;"><%= ord.order_number || ('#' + ord.id) %></a></td>
                    <td><%= ord.customer_name || 'Guest Customer' %></td>
                    <td>
                      <div style="display: flex; align-items: center; gap: 6px;">
                        <img src="<%= ord.item_image || '/public/images/hero_embroidery.jpg' %>" alt="Design" style="width: 26px; height: 26px; border-radius: 4px; object-fit: cover;">
                        <span style="font-size: 0.8rem; max-width: 140px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"><%= ord.item_title || 'Design File' %></span>
                      </div>
                    </td>
                    <td><strong>₹<%= (typeof formatINR === 'function' ? formatINR(ord.final_amount) : ord.final_amount) || 0 %></strong></td>
                    <td>
                      <span style="background: <%= ord.status === 'completed' || ord.status === 'paid' ? '#E8F5E9' : (ord.status === 'pending' ? '#FFF8E1' : '#FFEBEE') %>; color: <%= ord.status === 'completed' || ord.status === 'paid' ? '#2E7D32' : (ord.status === 'pending' ? '#F57F17' : '#C62828') %>; padding: 2px 8px; border-radius: 12px; font-size: 0.72rem; font-weight: 600; text-transform: capitalize;">
                        <%= ord.status %>
                      </span>
                    </td>
                    <td style="color: var(--admin-text-muted); font-size: 0.76rem; white-space: nowrap;">
                      <%= typeof formatDateTime === 'function' ? formatDateTime(ord.created_at) : (ord.created_at ? new Date(ord.created_at).toLocaleDateString('en-GB') : '-') %>
                    </td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="6" style="text-align: center; padding: 2.5rem 1rem; color: var(--admin-text-muted);">
                    <i class="fa-regular fa-clipboard" style="font-size: 1.8rem; margin-bottom: 0.5rem; display: block;"></i>
                    No orders placed yet. Real orders from the storefront will appear here.
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>

        <!-- Column 2: Top Selling Designs -->
        <div class="admin-card-box">
          <div class="card-header-flex">
            <h3>Top Selling Products</h3>
            <a href="/admin/designs" class="view-all-link">View All &rarr;</a>
          </div>

          <div style="display: flex; flex-direction: column; gap: 10px;">
            <% if (stats.topSellingDesigns && stats.topSellingDesigns.length > 0) { %>
              <% stats.topSellingDesigns.forEach((des, idx) => { %>
                <div style="display: flex; align-items: center; gap: 10px; padding: 6px 0; border-bottom: 1px solid var(--admin-border);">
                  <span style="width: 22px; height: 22px; border-radius: 50%; background: <%= idx === 0 ? '#F6E5E0' : '#F4EFEA' %>; color: <%= idx === 0 ? 'var(--admin-primary)' : 'var(--admin-text-dark)' %>; display: flex; align-items: center; justify-content: center; font-size: 0.75rem; font-weight: 700;"><%= idx + 1 %></span>
                  <img src="<%= des.image_url || '/public/images/hero_embroidery.jpg' %>" alt="<%= des.title %>" style="width: 42px; height: 42px; border-radius: 8px; object-fit: cover;">
                  <div style="flex: 1;">
                    <strong style="display: block; font-size: 0.85rem; color: var(--admin-text-dark);"><%= des.title %></strong>
                    <span style="font-size: 0.72rem; color: var(--admin-text-muted);"><%= des.sales_count || 0 %> sales &bull; ₹<%= des.sale_price || des.price %></span>
                  </div>
                </div>
              <% }) %>
            <% } else { %>
              <div style="padding: 2.5rem 1rem; text-align: center; color: var(--admin-text-muted);">
                <i class="fa-solid fa-box-open" style="font-size: 1.8rem; margin-bottom: 0.5rem; display: block;"></i>
                No product sales recorded yet.
              </div>
            <% } %>
          </div>
        </div>

      </div>

      <!-- Real Admin Activity Log Section -->
      <div class="admin-card-box" style="margin-bottom: 2rem;">
        <div class="card-header-flex">
          <h3>Recent Admin Activity Log</h3>
          <span style="font-size: 0.8rem; color: var(--admin-text-muted);">Audit Trail</span>
        </div>

        <table class="admin-table-styled">
          <thead>
            <tr>
              <th style="width: 140px;">Action</th>
              <th style="width: 120px;">Admin</th>
              <th style="width: 120px;">Entity</th>
              <th>Details</th>
              <th style="width: 180px; text-align: right;">Timestamp</th>
            </tr>
          </thead>
          <tbody>
            <% if (stats.recentActivity && stats.recentActivity.length > 0) { %>
              <% stats.recentActivity.forEach(act => { %>
                <tr>
                  <td><strong style="color: var(--admin-primary); font-size: 0.82rem;"><%= act.action %></strong></td>
                  <td><span style="font-size: 0.82rem; font-weight: 500;"><%= act.admin_name || 'Admin' %></span></td>
                  <td><span style="background: #FAF6F0; border: 1px solid var(--admin-border); padding: 2px 8px; border-radius: 4px; font-size: 0.75rem;"><%= act.entity_type %></span></td>
                  <td style="font-size: 0.8rem; color: var(--admin-text-dark);"><%= act.details || '-' %></td>
                  <td style="text-align: right; color: var(--admin-text-muted); font-size: 0.76rem; white-space: nowrap;">
                    <%= typeof formatDateTime === 'function' ? formatDateTime(act.created_at) : new Date(act.created_at).toLocaleString() %>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr>
                <td colspan="5" style="text-align: center; padding: 2rem; color: var(--admin-text-muted);">
                  No administrative actions logged yet. Actions performed in the admin panel will appear here.
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>

    </main>
  </div>
</div>

<!-- Dynamic Chart initialization script -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    // 1. Sales Overview Area Chart
    const salesCanvas = document.getElementById('salesOverviewChart');
    if (salesCanvas) {
      const ctxSales = salesCanvas.getContext('2d');
      const gradient = ctxSales.createLinearGradient(0, 0, 0, 200);
      gradient.addColorStop(0, 'rgba(184, 64, 42, 0.35)');
      gradient.addColorStop(1, 'rgba(184, 64, 42, 0.01)');

      const monthLabels = <%- JSON.stringify(stats.monthLabels || ['May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct']) %>;
      const monthlySalesData = <%- JSON.stringify(stats.monthlySales || [0, 0, 0, 0, 0, 0]) %>;

      new Chart(ctxSales, {
        type: 'line',
        data: {
          labels: monthLabels,
          datasets: [{
            label: 'Paid Sales (₹)',
            data: monthlySalesData,
            borderColor: '#B8402A',
            borderWidth: 2.5,
            backgroundColor: gradient,
            fill: true,
            tension: 0.4,
            pointBackgroundColor: '#B8402A',
            pointRadius: 4
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: { legend: { display: false } },
          scales: {
            x: { grid: { display: false } },
            y: {
              beginAtZero: true,
              ticks: {
                callback: function(val) {
                  return val === 0 ? '₹0' : (val >= 1000 ? '₹' + (val / 1000).toFixed(0) + 'K' : '₹' + val);
                }
              }
            }
          }
        }
      });
    }

    // 2. Top Categories Donut Chart (Percentage share by items sold per category)
    const catCanvas = document.getElementById('topCategoriesChart');
    <% if (hasCategorySales && totalSoldSum > 0) { %>
      if (catCanvas) {
        const ctxCat = catCanvas.getContext('2d');
        const catLabels = <%- JSON.stringify(stats.topCategories.map(c => c.name)) %>;
        const catData = <%- JSON.stringify(stats.topCategories.map(c => c.count)) %>;
        const catColors = ['#B8402A', '#2196F3', '#4CAF50', '#FF9800', '#9C27B0', '#00BCD4'];

        new Chart(ctxCat, {
          type: 'doughnut',
          data: {
            labels: catLabels,
            datasets: [{
              data: catData,
              backgroundColor: catColors.slice(0, catLabels.length),
              borderWidth: 0,
              cutout: '74%'
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { display: false } }
          }
        });
      }
    <% } %>
  });
</script>

</body>
</html>
