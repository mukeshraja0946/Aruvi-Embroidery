<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Dashboard - ARUVI EMBROIDERY STUDIO</title>
  <link rel="icon" type="image/jpeg" href="/public/images/logo.jpg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;1,400&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="/public/css/main.css">
  <link rel="stylesheet" href="/public/css/admin.css">
  <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
  <!-- Chart.js CDN -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <style>
    /* Reset Data Button & Header Badges */
    .btn-reset-data-outline {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      background: #FFFFFF;
      color: #DC2626;
      border: 1.5px solid #DC2626;
      border-radius: 8px;
      padding: 0.5rem 1rem;
      font-size: 0.84rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
      box-shadow: 0 1px 3px rgba(220, 38, 38, 0.08);
    }
    .btn-reset-data-outline:hover {
      background: #DC2626;
      color: #FFFFFF;
      box-shadow: 0 4px 12px rgba(220, 38, 38, 0.25);
      transform: translateY(-1px);
    }
    .btn-reset-data-outline:active {
      transform: translateY(0);
    }

    .badge-test-mode {
      background: #FEF3C7;
      color: #92400E;
      border: 1px solid #FCD34D;
      font-size: 0.68rem;
      font-weight: 700;
      padding: 2px 7px;
      border-radius: 6px;
      display: inline-flex;
      align-items: center;
      gap: 4px;
      letter-spacing: 0.5px;
    }

    /* Modal Backdrop & Container */
    .admin-modal-backdrop {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      background: rgba(15, 23, 42, 0.65);
      backdrop-filter: blur(4px);
      z-index: 999999;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1.25rem;
    }
    .admin-modal-card {
      background: #FFFFFF;
      border-radius: 14px;
      max-width: 680px;
      width: 100%;
      max-height: 90vh;
      overflow-y: auto;
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
      border: 1px solid var(--admin-border);
      display: flex;
      flex-direction: column;
    }
    .admin-modal-header {
      padding: 1.2rem 1.5rem;
      border-bottom: 1px solid var(--admin-border);
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: sticky;
      top: 0;
      background: #FFFFFF;
      z-index: 10;
    }
    .modal-icon-badge {
      width: 42px;
      height: 42px;
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.2rem;
      flex-shrink: 0;
    }
    .modal-close-btn {
      background: transparent;
      border: none;
      font-size: 1.6rem;
      color: var(--admin-text-muted);
      cursor: pointer;
      line-height: 1;
      padding: 4px 8px;
      border-radius: 6px;
      transition: background 0.15s ease;
    }
    .modal-close-btn:hover {
      background: #F3F4F6;
      color: var(--admin-text-dark);
    }

    /* Step Indicators */
    .modal-steps-indicator {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0.9rem 1.5rem;
      background: #FAF9F6;
      border-bottom: 1px solid var(--admin-border);
    }
    .step-badge {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 0.8rem;
      color: var(--admin-text-muted);
      font-weight: 500;
    }
    .step-circle {
      width: 22px;
      height: 22px;
      border-radius: 50%;
      background: #E5E7EB;
      color: #6B7280;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.72rem;
      font-weight: 700;
    }
    .step-badge.active {
      color: var(--admin-primary);
      font-weight: 700;
    }
    .step-badge.active .step-circle {
      background: var(--admin-primary);
      color: #FFFFFF;
    }
    .step-badge.completed .step-circle {
      background: #10B981;
      color: #FFFFFF;
    }
    .step-connector {
      flex: 1;
      height: 2px;
      background: #E5E7EB;
      margin: 0 10px;
    }

    /* Modal Step Body */
    .modal-step-body {
      padding: 1.5rem;
    }
    .reset-options-list {
      display: flex;
      flex-direction: column;
      gap: 12px;
      margin-bottom: 1.5rem;
    }
    .reset-option-card {
      border: 1px solid var(--admin-border);
      border-radius: 10px;
      padding: 12px 14px;
      background: #FFFFFF;
      transition: border-color 0.15s ease;
    }
    .reset-option-card:hover {
      border-color: #CBD5E1;
    }
    .reset-option-card.danger-section {
      border-color: #FECACA;
      background: #FEF2F2;
    }
    .reset-option-header {
      display: flex;
      align-items: flex-start;
      gap: 12px;
      cursor: pointer;
      user-select: none;
    }
    .reset-checkbox {
      width: 17px;
      height: 17px;
      accent-color: var(--admin-primary);
      margin-top: 2px;
      cursor: pointer;
    }
    .reset-option-title {
      font-size: 0.9rem;
      font-weight: 700;
      color: var(--admin-text-dark);
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .badge-count-pill {
      font-size: 0.72rem;
      padding: 2px 8px;
      border-radius: 12px;
      background: #F3F4F6;
      color: #4B5563;
      font-weight: 600;
    }
    .reset-option-desc {
      font-size: 0.78rem;
      color: var(--admin-text-muted);
      margin-top: 3px;
      line-height: 1.4;
    }
    .reset-sub-options {
      margin-top: 10px;
      padding-top: 10px;
      border-top: 1px solid #F1F5F9;
      padding-left: 29px;
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .reset-radio-label, .reset-checkbox-label {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 0.82rem;
      color: var(--admin-text-dark);
      cursor: pointer;
    }
    .reset-radio-label input, .reset-checkbox-label input {
      accent-color: var(--admin-primary);
      cursor: pointer;
    }

    /* Modal Footer */
    .modal-footer-actions {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 10px;
      margin-top: 1rem;
      padding-top: 1rem;
      border-top: 1px solid var(--admin-border);
    }
    .btn-danger-reset {
      background: #DC2626;
      color: #FFFFFF;
      border: none;
      padding: 0.65rem 1.4rem;
      border-radius: 8px;
      font-weight: 700;
      font-size: 0.88rem;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      transition: all 0.2s ease;
    }
    .btn-danger-reset:hover:not(:disabled) {
      background: #B91C1C;
      box-shadow: 0 4px 12px rgba(220, 38, 38, 0.35);
    }
    .btn-danger-reset:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }

    /* Preview & Financial Box */
    .reset-preview-summary-box {
      background: #FAF9F6;
      border: 1px solid var(--admin-border);
      border-radius: 10px;
      padding: 14px 16px;
      margin-bottom: 1rem;
    }
    .reset-preview-list {
      margin: 0;
      padding-left: 18px;
      font-size: 0.84rem;
      color: var(--admin-text-dark);
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .reset-preview-financial-box {
      background: #F0FDF4;
      border: 1px solid #BBF7D0;
      border-radius: 10px;
      padding: 12px 16px;
      margin-bottom: 1rem;
    }
    .live-paid-alert-box {
      background: #FEF2F2;
      border: 1.5px solid #FCA5A5;
      border-radius: 10px;
      padding: 14px 16px;
      margin: 1rem 0;
    }

    /* Step 3 Box */
    .confirm-security-box {
      text-align: center;
      padding: 1rem 0.5rem;
      position: relative;
    }
    .security-shield-icon {
      width: 52px;
      height: 52px;
      border-radius: 50%;
      background: #FEE2E2;
      color: #DC2626;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 1.6rem;
      margin-bottom: 0.75rem;
    }
    .form-group-confirm {
      text-align: left;
    }
    .admin-input-styled {
      width: 100%;
      padding: 0.65rem 0.9rem;
      border: 1px solid var(--admin-border);
      border-radius: 8px;
      font-size: 0.9rem;
      outline: none;
      transition: border-color 0.2s ease;
      box-sizing: border-box;
    }
    .admin-input-styled:focus {
      border-color: var(--admin-primary);
    }
    .executing-spinner-overlay {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(255, 255, 255, 0.95);
      border-radius: 10px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      z-index: 20;
    }

    /* Toast */
    .admin-reset-toast {
      position: fixed;
      bottom: 24px;
      right: 24px;
      z-index: 9999999;
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 12px 18px;
      border-radius: 10px;
      font-size: 0.88rem;
      font-weight: 600;
      box-shadow: 0 10px 25px rgba(0,0,0,0.15);
      opacity: 0;
      transform: translateY(15px);
      transition: all 0.25s ease;
    }
    .admin-reset-toast.visible {
      opacity: 1;
      transform: translateY(0);
    }
    .admin-reset-toast.toast-success {
      background: #065F46;
      color: #FFFFFF;
    }
    .admin-reset-toast.toast-error {
      background: #991B1B;
      color: #FFFFFF;
    }
  </style>
</head>
<body class="admin-body">

<div class="admin-wrapper">
  <!-- Top Navigation Bar matching Reference -->
  <header class="admin-top-header">
    <a href="/admin" class="admin-header-brand">
      <% const currentLogo = (typeof siteSettings !== 'undefined' && siteSettings.logo_url) ? siteSettings.logo_url : '/public/images/logo.jpg'; %>
      <img src="<%= currentLogo %>" alt="ARUVI Admin Logo" style="max-height: 42px; width: auto; object-fit: contain;">
    </a>

    <!-- Global Search -->
    <div class="admin-search-bar">
      <i class="fa-solid fa-magnifying-glass"></i>
      <input type="text" placeholder="Search orders, designs, customers...">
    </div>

    <!-- Right User Header Icons -->
    <div class="admin-header-right">
      <a href="/admin/messages" class="admin-icon-btn" title="Notifications">
        <i class="fa-regular fa-bell"></i>
        <% if (typeof adminNavBadges !== 'undefined' && adminNavBadges.unreadNotifications > 0) { %>
          <span class="badge-count"><%= adminNavBadges.unreadNotifications %></span>
        <% } %>
      </a>

      <div class="admin-user-menu">
        <div class="admin-user-avatar">A</div>
        <div class="admin-user-info">
          <strong>Admin</strong>
          <span>Administrator</span>
        </div>
        <i class="fa-solid fa-chevron-down" style="font-size: 0.75rem; color: var(--admin-text-muted); margin-left: 4px;"></i>
      </div>
    </div>
  </header>

  <!-- Admin Main Layout with Sidebar -->
  <div class="admin-main-container">
    <!-- Left Sidebar matching Reference -->
    <aside class="admin-sidebar">
      <!-- Active Item: Dashboard -->
      <ul class="sidebar-nav-list" style="margin-bottom: 1.2rem;">
        <li class="sidebar-nav-item">
          <a href="/admin" class="active">
            <span><i class="fa-solid fa-house"></i> Dashboard</span>
          </a>
        </li>
      </ul>

      <!-- DESIGNS Section -->
      <div class="admin-sidebar-section">
        <div class="sidebar-heading">DESIGNS</div>
        <ul class="sidebar-nav-list">
          <li class="sidebar-nav-item"><a href="/admin/designs"><span><i class="fa-solid fa-box-archive"></i> Manage Designs</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/designs/create"><span><i class="fa-solid fa-circle-plus"></i> Add New Design</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/categories"><span><i class="fa-solid fa-border-all"></i> Categories</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/custom-orders"><span><i class="fa-solid fa-wand-magic-sparkles"></i> Custom Orders</span></a></li>
        </ul>
      </div>

      <!-- ORDERS Section -->
      <div class="admin-sidebar-section">
        <div class="sidebar-heading">ORDERS</div>
        <ul class="sidebar-nav-list">
          <li class="sidebar-nav-item"><a href="/admin/orders"><span><i class="fa-regular fa-newspaper"></i> All Orders</span></a></li>
          <li class="sidebar-nav-item">
            <a href="/admin/orders?status=pending">
              <span><i class="fa-regular fa-clock"></i> Pending Orders</span>
              <% if (typeof adminNavBadges !== 'undefined' && adminNavBadges.pendingOrders > 0) { %>
                <span class="sidebar-badge"><%= adminNavBadges.pendingOrders %></span>
              <% } %>
            </a>
          </li>
          <li class="sidebar-nav-item"><a href="/admin/orders?status=completed"><span><i class="fa-regular fa-circle-check"></i> Completed Orders</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/orders?status=cancelled"><span><i class="fa-regular fa-circle-xmark"></i> Cancelled Orders</span></a></li>
        </ul>
      </div>

      <!-- CUSTOMERS Section -->
      <div class="admin-sidebar-section">
        <div class="sidebar-heading">CUSTOMERS</div>
        <ul class="sidebar-nav-list">
          <li class="sidebar-nav-item"><a href="/admin/customers"><span><i class="fa-solid fa-users"></i> All Customers</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/messages"><span><i class="fa-regular fa-comment-dots"></i> Enquiries</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/email-campaigns"><span><i class="fa-solid fa-paper-plane"></i> Email Campaigns 📧</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/reviews"><span><i class="fa-regular fa-star"></i> Reviews</span></a></li>
        </ul>
      </div>

      <!-- CONTENT Section -->
      <div class="admin-sidebar-section">
        <div class="sidebar-heading">CONTENT</div>
        <ul class="sidebar-nav-list">
          <li class="sidebar-nav-item"><a href="/admin/homepage"><span><i class="fa-solid fa-house-chimney"></i> Homepage</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/banners"><span><i class="fa-regular fa-image"></i> Banners</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/settings"><span><i class="fa-solid fa-gear"></i> Website Settings</span></a></li>
        </ul>
      </div>

      <!-- STORAGE & RECOVERY Section -->
      <div class="admin-sidebar-section">
        <div class="sidebar-heading">STORAGE & RECOVERY</div>
        <ul class="sidebar-nav-list">
          <li class="sidebar-nav-item"><a href="/admin/tools/system-health"><span><i class="fa-solid fa-heart-pulse"></i> System Health</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/tools/missing-files"><span><i class="fa-solid fa-triangle-exclamation"></i> Missing Files</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/tools/bulk-image-relink"><span><i class="fa-solid fa-images"></i> Bulk Image Relink</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/tools/bulk-file-relink"><span><i class="fa-solid fa-file-zipper"></i> Bulk File Relink</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/tools/backup"><span><i class="fa-solid fa-database"></i> Backup & Storage</span></a></li>
        </ul>
      </div>

      <div style="margin-top: auto; padding-top: 1rem; border-top: 1px solid var(--admin-border);">
        <a href="/admin/logout" style="display: flex; align-items: center; gap: 8px; color: var(--admin-primary); font-size: 0.85rem; font-weight: 600; text-decoration: none; padding: 0.5rem 0.8rem;">
          <i class="fa-solid fa-arrow-right-from-bracket"></i> Logout Admin
        </a>
      </div>
    </aside>

    <!-- Main Content Body -->
    <main class="admin-content-body">

      <!-- Database Schema Safety Warning Banner -->
      <% if (typeof schemaAlert !== 'undefined' && !schemaAlert.isHealthy) { %>
        <div style="background: #FEF2F2; border: 1px solid #F87171; border-radius: 10px; padding: 1rem 1.25rem; margin-bottom: 1.5rem; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem;">
          <div style="display: flex; align-items: center; gap: 0.75rem;">
            <div style="width: 38px; height: 38px; background: #DC2626; color: #FFFFFF; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.2rem; flex-shrink: 0;">
              <i class="fa-solid fa-triangle-exclamation"></i>
            </div>
            <div>
              <strong style="color: #991B1B; font-size: 0.95rem;">Database Schema Warning: Pending Migrations or Missing Schema Detected</strong>
              <div style="color: #B91C1C; font-size: 0.82rem; margin-top: 2px;">
                <% if (schemaAlert.missingSummary) { %>
                  Pending updates: <strong><%= schemaAlert.missingSummary %></strong>.
                <% } else { %>
                  Pending database schema migrations need to be applied.
                <% } %>
                Click &ldquo;Fix Schema in System Health&rdquo; to apply them safely without touching existing data.
              </div>
            </div>
          </div>
          <div style="display: flex; gap: 0.5rem;">
            <a href="/admin/tools/system-health" class="btn btn-primary" style="font-size: 0.82rem; padding: 0.45rem 0.9rem; text-decoration: none; background: #DC2626; border-color: #DC2626; color: #fff; font-weight: 600; border-radius: 6px;">
              <i class="fa-solid fa-bolt" style="margin-right: 5px;"></i> Fix Schema in System Health
            </a>
          </div>
        </div>
      <% } %>

      <% if (typeof paymentConfig !== 'undefined' && !paymentConfig.isConfigured) { %>
        <div style="background: #FEE2E2; border: 1px solid #F87171; border-radius: 10px; padding: 1rem 1.25rem; margin-bottom: 1.5rem; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem;">
          <div style="display: flex; align-items: center; gap: 0.75rem;">
            <div style="width: 38px; height: 38px; background: #EF4444; color: #FFFFFF; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.2rem; flex-shrink: 0;">
              <i class="fa-solid fa-triangle-exclamation"></i>
            </div>
            <div>
              <strong style="color: #991B1B; font-size: 0.95rem;">Payment Gateway Warning: Razorpay keys are missing or incomplete</strong>
              <div style="color: #B91C1C; font-size: 0.82rem; margin-top: 2px;">
                Customers cannot complete online payments at checkout until Razorpay Key ID and Key Secret are configured.
              </div>
            </div>
          </div>
          <div style="display: flex; gap: 0.5rem;">
            <a href="/admin/settings#payment-settings" class="btn btn-primary" style="font-size: 0.82rem; padding: 0.45rem 0.9rem; text-decoration: none; background: #DC2626; border-color: #DC2626; color: #fff; font-weight: 600; border-radius: 6px;">
              <i class="fa-solid fa-gear" style="margin-right: 5px;"></i> Configure Payments
            </a>
          </div>
        </div>
      <% } %>

      <% if (typeof healthScan !== 'undefined' && !healthScan.healthy && healthScan.totalIssues > 0) { %>
        <div style="background: #FFF8E1; border: 1px solid #FFE082; border-radius: 10px; padding: 1rem 1.25rem; margin-bottom: 1.5rem; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem;">
          <div style="display: flex; align-items: center; gap: 0.75rem;">
            <div style="width: 38px; height: 38px; background: #FFC107; color: #5D4037; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.2rem;">
              <i class="fa-solid fa-triangle-exclamation"></i>
            </div>
            <div>
              <strong style="color: #795548; font-size: 0.95rem;">Storage Health Warning: <%= healthScan.totalIssues %> designs have missing files</strong>
              <div style="color: #8D6E63; font-size: 0.8rem;">
                Detected <%= healthScan.missingImagesCount %> missing preview images and <%= healthScan.missingFilesCount %> missing machine files.
              </div>
            </div>
          </div>
          <div style="display: flex; gap: 0.5rem;">
            <a href="/admin/tools/missing-files" class="btn btn-outline" style="font-size: 0.8rem; padding: 0.4rem 0.8rem; border-color: #FFA000; color: #795548; text-decoration: none;">
              Review Missing Files
            </a>
            <a href="/admin/tools/bulk-image-relink" class="btn btn-primary" style="font-size: 0.8rem; padding: 0.4rem 0.8rem; text-decoration: none; background: #795548; border-color: #795548;">
              Bulk Relink Tool
            </a>
          </div>
        </div>
      <% } %>

      <!-- Hero Welcome Banner -->
      <div class="admin-welcome-hero" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
        <div class="welcome-hero-text">
          <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 4px;">
            <span style="font-size: 0.72rem; letter-spacing: 1.5px; font-weight: 700; color: var(--admin-primary); text-transform: uppercase;">LIVE STORE DASHBOARD</span>
            <% if (typeof paymentConfig !== 'undefined' && paymentConfig && (paymentConfig.mode === 'test' || (paymentConfig.keyId && paymentConfig.keyId.startsWith('rzp_test_')))) { %>
              <span class="badge-test-mode" title="Razorpay is operating in TEST mode. Payments will not process real funds.">
                <i class="fa-solid fa-flask"></i> TEST MODE
              </span>
            <% } %>
          </div>
          <h1>Admin Overview</h1>
          <p>Real-time data from your store database.<br>Live products, paid revenues, orders and customer activities.</p>
        </div>

        <div class="hero-actions-group" style="display: flex; align-items: center; gap: 12px; flex-wrap: wrap;">
          <!-- Include Test Data Toggle -->
          <label class="test-data-toggle" style="display: inline-flex; align-items: center; gap: 8px; font-size: 0.8rem; font-weight: 600; color: var(--admin-text-dark); cursor: pointer; background: #FFFFFF; padding: 6px 12px; border-radius: 8px; border: 1px solid var(--admin-border); user-select: none;" title="Toggle between real store data only and including test-mode transactions">
            <input type="checkbox" id="toggleIncludeTestData" <%= (typeof includeTestData !== 'undefined' && includeTestData) ? 'checked' : '' %> style="cursor: pointer; width: 15px; height: 15px; accent-color: var(--admin-primary);">
            <span>Include Test Data</span>
          </label>

          <!-- Reset Data Button (Red outline with reset icon) -->
          <button type="button" id="btnOpenResetModal" class="btn-reset-data-outline" title="Selectively clear test data, demo designs, and operational counters">
            <i class="fa-solid fa-arrow-rotate-left"></i>
            <span>Reset Data</span>
          </button>
        </div>
      </div>

      <!-- 5 Stat Summary Cards Row -->
      <div class="admin-stats-row" style="grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));">
        <!-- Total Products Card -->
        <div class="admin-summary-card">
          <div class="card-icon-badge"><i class="fa-solid fa-box-archive"></i></div>
          <div class="card-info-content">
            <div class="stat-title">Total Products</div>
            <div style="display: flex; align-items: baseline; gap: 6px;">
              <span class="stat-num"><%= (stats.designsBreakdown ? stats.designsBreakdown.total : stats.totalDesigns) || 0 %></span>
              <% if (stats.designsTrend && stats.designsTrend.text) { %>
                <span class="stat-trend" style="color: <%= stats.designsTrend.isPositive ? 'inherit' : 'var(--admin-primary)' %>;">
                  <% if (stats.designsTrend.text === 'New') { %>
                    <span style="background: #E8F5E9; color: #2E7D32; font-size: 0.68rem; padding: 1px 6px; border-radius: 4px; font-weight: 700;">New</span>
                  <% } else { %>
                    <i class="fa-solid fa-arrow-<%= stats.designsTrend.isPositive ? 'up' : 'down' %>"></i> <%= stats.designsTrend.text %>
                  <% } %>
                </span>
              <% } %>
            </div>
            <span style="font-size: 0.72rem; color: var(--admin-text-muted);">
              <% if (stats.designsBreakdown) { %>
                <%= stats.designsBreakdown.active %> active &bull; <%= stats.designsBreakdown.inactive %> inactive
              <% } else { %>
                active in catalog
              <% } %>
            </span>
          </div>
        </div>

        <!-- Total Orders Card -->
        <div class="admin-summary-card">
          <div class="card-icon-badge"><i class="fa-solid fa-bag-shopping"></i></div>
          <div class="card-info-content">
            <div class="stat-title">Total Orders</div>
            <div style="display: flex; align-items: baseline; gap: 6px;">
              <span class="stat-num"><%= stats.totalOrders || 0 %></span>
              <% if (stats.ordersTrend && stats.ordersTrend.text) { %>
                <span class="stat-trend" style="color: <%= stats.ordersTrend.isPositive ? 'inherit' : 'var(--admin-primary)' %>;">
                  <% if (stats.ordersTrend.text === 'New') { %>
                    <span style="background: #E8F5E9; color: #2E7D32; font-size: 0.68rem; padding: 1px 6px; border-radius: 4px; font-weight: 700;">New</span>
                  <% } else { %>
                    <i class="fa-solid fa-arrow-<%= stats.ordersTrend.isPositive ? 'up' : 'down' %>"></i> <%= stats.ordersTrend.text %>
                  <% } %>
                </span>
              <% } %>
            </div>
            <span style="font-size: 0.72rem; color: var(--admin-text-muted);">
              <%= (typeof includeTestData !== 'undefined' && includeTestData) ? 'all orders (including test)' : 'real orders only' %>
            </span>
          </div>
        </div>

        <!-- Total Revenue Card (SUM of paid orders only) -->
        <div class="admin-summary-card">
          <div class="card-icon-badge"><i class="fa-solid fa-indian-rupee-sign"></i></div>
          <div class="card-info-content">
            <div class="stat-title">Paid Revenue</div>
            <div style="display: flex; align-items: baseline; gap: 6px;">
              <span class="stat-num">₹<%= parseFloat(stats.totalSales || 0).toLocaleString('en-IN', { maximumFractionDigits: 2 }) %></span>
              <% if (stats.salesTrend && stats.salesTrend.text) { %>
                <span class="stat-trend" style="color: <%= stats.salesTrend.isPositive ? 'inherit' : 'var(--admin-primary)' %>;">
                  <% if (stats.salesTrend.text === 'New') { %>
                    <span style="background: #E8F5E9; color: #2E7D32; font-size: 0.68rem; padding: 1px 6px; border-radius: 4px; font-weight: 700;">New</span>
                  <% } else { %>
                    <i class="fa-solid fa-arrow-<%= stats.salesTrend.isPositive ? 'up' : 'down' %>"></i> <%= stats.salesTrend.text %>
                  <% } %>
                </span>
              <% } %>
            </div>
            <span style="font-size: 0.72rem; color: var(--admin-text-muted);">
              <%= (typeof includeTestData !== 'undefined' && includeTestData) ? 'all paid (including test)' : 'paid orders only' %>
            </span>
          </div>
        </div>

        <!-- Total Customers Card -->
        <div class="admin-summary-card">
          <div class="card-icon-badge"><i class="fa-solid fa-users"></i></div>
          <div class="card-info-content">
            <div class="stat-title">Total Customers</div>
            <div style="display: flex; align-items: baseline; gap: 6px;">
              <span class="stat-num"><%= stats.totalCustomers || 0 %></span>
              <% if (stats.customersTrend && stats.customersTrend.text) { %>
                <span class="stat-trend" style="color: <%= stats.customersTrend.isPositive ? 'inherit' : 'var(--admin-primary)' %>;">
                  <% if (stats.customersTrend.text === 'New') { %>
                    <span style="background: #E8F5E9; color: #2E7D32; font-size: 0.68rem; padding: 1px 6px; border-radius: 4px; font-weight: 700;">New</span>
                  <% } else { %>
                    <i class="fa-solid fa-arrow-<%= stats.customersTrend.isPositive ? 'up' : 'down' %>"></i> <%= stats.customersTrend.text %>
                  <% } %>
                </span>
              <% } %>
            </div>
            <span style="font-size: 0.72rem; color: var(--admin-text-muted);">registered customers</span>
          </div>
        </div>

        <!-- Custom Requests Card -->
        <div class="admin-summary-card">
          <div class="card-icon-badge"><i class="fa-solid fa-wand-magic-sparkles"></i></div>
          <div class="card-info-content">
            <div class="stat-title">Custom Requests</div>
            <div style="display: flex; align-items: baseline; gap: 6px;">
              <span class="stat-num"><%= (stats.customRequests && stats.customRequests.total !== undefined) ? stats.customRequests.total : 0 %></span>
              <% const pendingCount = (stats.customRequests && stats.customRequests.pending) ? stats.customRequests.pending : 0; %>
              <span class="stat-trend" style="color: <%= pendingCount > 0 ? 'var(--admin-primary)' : '#2E7D32' %>;">
                <%= pendingCount %> pending
              </span>
            </div>
            <span style="font-size: 0.72rem; color: var(--admin-text-muted);">custom motifs</span>
          </div>
        </div>
      </div>

      <!-- Charts Section (2 Columns: Sales Overview & Top Categories Donut) -->
      <div class="admin-charts-row">
        <!-- Card 1: Sales Overview Area Chart -->
        <div class="admin-card-box">
          <div class="card-header-flex">
            <h3>Sales Overview</h3>
            <span style="font-size: 0.8rem; color: var(--admin-text-muted);">Last 6 Months (Paid Orders)</span>
          </div>
          <div style="height: 240px; position: relative;">
            <canvas id="salesOverviewChart"></canvas>
          </div>
        </div>

        <!-- Card 2: Top Categories Donut Chart (Percentage share by items sold per category) -->
        <div class="admin-card-box">
          <div class="card-header-flex">
            <h3>Top Categories</h3>
            <span style="font-size: 0.8rem; color: var(--admin-text-muted);">Share of Items Sold</span>
          </div>
          
          <% const hasCategorySales = stats.topCategories && stats.topCategories.length > 0; %>
          <% const totalSoldSum = hasCategorySales ? stats.topCategories.reduce((s, c) => s + c.count, 0) : 0; %>

          <div style="display: flex; align-items: center; gap: 1.2rem; height: 240px;">
            <% if (hasCategorySales && totalSoldSum > 0) { %>
              <!-- Donut Canvas Container -->
              <div style="width: 160px; height: 160px; position: relative; flex-shrink: 0; margin: 0 auto;">
                <canvas id="topCategoriesChart"></canvas>
                <!-- Center Text -->
                <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); text-align: center; pointer-events: none;">
                  <div style="font-size: 1.4rem; font-family: var(--font-heading); font-weight: 700; color: var(--admin-text-dark); line-height: 1;"><%= totalSoldSum %></div>
                  <div style="font-size: 0.68rem; color: var(--admin-text-muted);">Items Sold</div>
                </div>
              </div>

              <!-- Real Category Legend Stack -->
              <div style="display: flex; flex-direction: column; gap: 8px; flex: 1; font-size: 0.8rem; max-height: 220px; overflow-y: auto;">
                <% const catPalette = ['#B8402A', '#2196F3', '#4CAF50', '#FF9800', '#9C27B0', '#00BCD4']; %>
                <% stats.topCategories.forEach((cat, idx) => { %>
                  <div style="display: flex; align-items: center; justify-content: space-between;">
                    <div style="display: flex; align-items: center; gap: 8px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                      <span style="width: 10px; height: 10px; border-radius: 50%; background: <%= catPalette[idx % catPalette.length] %>; flex-shrink: 0;"></span>
                      <span style="font-weight: 500;"><%= cat.name %></span>
                    </div>
                    <strong><%= cat.count %> <span style="font-weight: 400; color: var(--admin-text-muted); font-size: 0.75rem;">(<%= cat.percentage %>%)</span></strong>
                  </div>
                <% }); %>
              </div>
            <% } else { %>
              <!-- Friendly Empty State -->
              <div style="width: 100%; text-align: center; color: var(--admin-text-muted); padding: 2rem;">
                <div style="width: 52px; height: 52px; border-radius: 50%; background: #FAF6F0; color: var(--admin-text-muted); display: inline-flex; align-items: center; justify-content: center; font-size: 1.4rem; margin-bottom: 0.6rem; border: 1px solid var(--admin-border);">
                  <i class="fa-solid fa-chart-pie"></i>
                </div>
                <div style="font-weight: 600; color: var(--admin-text-dark); font-size: 0.95rem;">No category sales yet</div>
                <p style="font-size: 0.8rem; margin: 4px 0 0;">Sold items will reflect percentage shares per category automatically.</p>
              </div>
            <% } %>
          </div>
        </div>
      </div>

      <!-- Bottom Grid: Recent Orders, Top Selling Designs, Admin Activity Log -->
      <div class="admin-bottom-grid" style="grid-template-columns: 1.4fr 1fr; margin-bottom: 1.8rem;">
        
        <!-- Column 1: Recent Orders -->
        <div class="admin-card-box">
          <div class="card-header-flex">
            <h3>Recent Orders</h3>
            <a href="/admin/orders" class="view-all-link">View All &rarr;</a>
          </div>

          <table class="admin-table-styled">
            <thead>
              <tr>
                <th>Order #</th>
                <th>Customer</th>
                <th>Design</th>
                <th>Amount</th>
                <th>Status</th>
                <th>Date</th>
              </tr>
            </thead>
            <tbody>
              <% if (stats.recentOrders && stats.recentOrders.length > 0) { %>
                <% stats.recentOrders.forEach(ord => { %>
                  <tr>
                    <td><a href="/admin/orders/<%= ord.id %>" style="color: var(--admin-primary); font-weight: 700; text-decoration: none;"><%= ord.order_number || ('#' + ord.id) %></a></td>
                    <td><%= ord.customer_name || 'Guest Customer' %></td>
                    <td>
                      <div style="display: flex; align-items: center; gap: 6px;">
                        <img src="<%= ord.item_image || '/public/images/hero_embroidery.jpg' %>" alt="Design" style="width: 26px; height: 26px; border-radius: 4px; object-fit: cover;">
                        <span style="font-size: 0.8rem; max-width: 140px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"><%= ord.item_title || 'Design File' %></span>
                      </div>
                    </td>
                    <td><strong>₹<%= (typeof formatINR === 'function' ? formatINR(ord.final_amount) : ord.final_amount) || 0 %></strong></td>
                    <td>
                      <span style="background: <%= ord.status === 'completed' || ord.status === 'paid' ? '#E8F5E9' : (ord.status === 'pending' ? '#FFF8E1' : '#FFEBEE') %>; color: <%= ord.status === 'completed' || ord.status === 'paid' ? '#2E7D32' : (ord.status === 'pending' ? '#F57F17' : '#C62828') %>; padding: 2px 8px; border-radius: 12px; font-size: 0.72rem; font-weight: 600; text-transform: capitalize;">
                        <%= ord.status %>
                      </span>
                    </td>
                    <td style="color: var(--admin-text-muted); font-size: 0.76rem; white-space: nowrap;">
                      <%= typeof formatDateTime === 'function' ? formatDateTime(ord.created_at) : (ord.created_at ? new Date(ord.created_at).toLocaleDateString('en-GB') : '-') %>
                    </td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="6" style="text-align: center; padding: 2.5rem 1rem; color: var(--admin-text-muted);">
                    <i class="fa-regular fa-clipboard" style="font-size: 1.8rem; margin-bottom: 0.5rem; display: block;"></i>
                    No orders placed yet. Real orders from the storefront will appear here.
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>

        <!-- Column 2: Top Selling Designs -->
        <div class="admin-card-box">
          <div class="card-header-flex">
            <h3>Top Selling Products</h3>
            <a href="/admin/designs" class="view-all-link">View All &rarr;</a>
          </div>

          <div style="display: flex; flex-direction: column; gap: 10px;">
            <% if (stats.topSellingDesigns && stats.topSellingDesigns.length > 0) { %>
              <% stats.topSellingDesigns.forEach((des, idx) => { %>
                <div style="display: flex; align-items: center; gap: 10px; padding: 6px 0; border-bottom: 1px solid var(--admin-border);">
                  <span style="width: 22px; height: 22px; border-radius: 50%; background: <%= idx === 0 ? '#F6E5E0' : '#F4EFEA' %>; color: <%= idx === 0 ? 'var(--admin-primary)' : 'var(--admin-text-dark)' %>; display: flex; align-items: center; justify-content: center; font-size: 0.75rem; font-weight: 700;"><%= idx + 1 %></span>
                  <img src="<%= des.image_url || '/public/images/hero_embroidery.jpg' %>" alt="<%= des.title %>" style="width: 42px; height: 42px; border-radius: 8px; object-fit: cover;">
                  <div style="flex: 1;">
                    <strong style="display: block; font-size: 0.85rem; color: var(--admin-text-dark);"><%= des.title %></strong>
                    <span style="font-size: 0.72rem; color: var(--admin-text-muted);"><%= des.sales_count || 0 %> sales &bull; ₹<%= des.sale_price || des.price %></span>
                  </div>
                </div>
              <% }) %>
            <% } else { %>
              <div style="padding: 2.5rem 1rem; text-align: center; color: var(--admin-text-muted);">
                <i class="fa-solid fa-box-open" style="font-size: 1.8rem; margin-bottom: 0.5rem; display: block;"></i>
                No product sales recorded yet.
              </div>
            <% } %>
          </div>
        </div>

      </div>

      <!-- Real Admin Activity Log Section -->
      <div class="admin-card-box" style="margin-bottom: 2rem;">
        <div class="card-header-flex">
          <h3>Recent Admin Activity Log</h3>
          <span style="font-size: 0.8rem; color: var(--admin-text-muted);">Audit Trail</span>
        </div>

        <table class="admin-table-styled">
          <thead>
            <tr>
              <th style="width: 140px;">Action</th>
              <th style="width: 120px;">Admin</th>
              <th style="width: 120px;">Entity</th>
              <th>Details</th>
              <th style="width: 180px; text-align: right;">Timestamp</th>
            </tr>
          </thead>
          <tbody>
            <% if (stats.recentActivity && stats.recentActivity.length > 0) { %>
              <% stats.recentActivity.forEach(act => { %>
                <tr>
                  <td><strong style="color: var(--admin-primary); font-size: 0.82rem;"><%= act.action %></strong></td>
                  <td><span style="font-size: 0.82rem; font-weight: 500;"><%= act.admin_name || 'Admin' %></span></td>
                  <td><span style="background: #FAF6F0; border: 1px solid var(--admin-border); padding: 2px 8px; border-radius: 4px; font-size: 0.75rem;"><%= act.entity_type %></span></td>
                  <td style="font-size: 0.8rem; color: var(--admin-text-dark);"><%= act.details || '-' %></td>
                  <td style="text-align: right; color: var(--admin-text-muted); font-size: 0.76rem; white-space: nowrap;">
                    <%= typeof formatDateTime === 'function' ? formatDateTime(act.created_at) : new Date(act.created_at).toLocaleString() %>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr>
                <td colspan="5" style="text-align: center; padding: 2rem; color: var(--admin-text-muted);">
                  No administrative actions logged yet. Actions performed in the admin panel will appear here.
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>

    </main>
  </div>
</div>

<!-- Dynamic Chart initialization script -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    // 1. Sales Overview Area Chart
    const salesCanvas = document.getElementById('salesOverviewChart');
    if (salesCanvas) {
      const ctxSales = salesCanvas.getContext('2d');
      const gradient = ctxSales.createLinearGradient(0, 0, 0, 200);
      gradient.addColorStop(0, 'rgba(184, 64, 42, 0.35)');
      gradient.addColorStop(1, 'rgba(184, 64, 42, 0.01)');

      const monthLabels = <%- JSON.stringify(stats.monthLabels || ['May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct']) %>;
      const monthlySalesData = <%- JSON.stringify(stats.monthlySales || [0, 0, 0, 0, 0, 0]) %>;

      new Chart(ctxSales, {
        type: 'line',
        data: {
          labels: monthLabels,
          datasets: [{
            label: 'Paid Sales (₹)',
            data: monthlySalesData,
            borderColor: '#B8402A',
            borderWidth: 2.5,
            backgroundColor: gradient,
            fill: true,
            tension: 0.4,
            pointBackgroundColor: '#B8402A',
            pointRadius: 4
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: { legend: { display: false } },
          scales: {
            x: { grid: { display: false } },
            y: {
              beginAtZero: true,
              ticks: {
                callback: function(val) {
                  return val === 0 ? '₹0' : (val >= 1000 ? '₹' + (val / 1000).toFixed(0) + 'K' : '₹' + val);
                }
              }
            }
          }
        }
      });
    }

    // 2. Top Categories Donut Chart (Percentage share by items sold per category)
    const catCanvas = document.getElementById('topCategoriesChart');
    <% if (hasCategorySales && totalSoldSum > 0) { %>
      if (catCanvas) {
        const ctxCat = catCanvas.getContext('2d');
        const catLabels = <%- JSON.stringify(stats.topCategories.map(c => c.name)) %>;
        const catData = <%- JSON.stringify(stats.topCategories.map(c => c.count)) %>;
        const catColors = ['#B8402A', '#2196F3', '#4CAF50', '#FF9800', '#9C27B0', '#00BCD4'];

        new Chart(ctxCat, {
          type: 'doughnut',
          data: {
            labels: catLabels,
            datasets: [{
              data: catData,
              backgroundColor: catColors.slice(0, catLabels.length),
              borderWidth: 0,
              cutout: '74%'
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { display: false } }
          }
        });
      }
    <% } %>
  });
</script>

<!-- Reset Data Modal (Admin Only, Multi-Step Safety Flow) -->
<div id="resetDataModal" class="admin-modal-backdrop" style="display: none;">
  <div class="admin-modal-card">
    <!-- Modal Header -->
    <div class="admin-modal-header">
      <div style="display: flex; align-items: center; gap: 10px;">
        <div class="modal-icon-badge" style="background: #FEE2E2; color: #DC2626;">
          <i class="fa-solid fa-arrow-rotate-left"></i>
        </div>
        <div>
          <h3 style="margin: 0; font-size: 1.25rem; font-weight: 700; color: var(--admin-text-dark);">Reset Store Data</h3>
          <span style="font-size: 0.78rem; color: var(--admin-text-muted);">Remove test & dummy data to display only authentic store metrics</span>
        </div>
      </div>
      <button type="button" id="closeResetModalBtn" class="modal-close-btn">&times;</button>
    </div>

    <!-- Step Progress Bar -->
    <div class="modal-steps-indicator">
      <div id="stepBadge1" class="step-badge active">
        <span class="step-circle">1</span>
        <span class="step-label">Select Items</span>
      </div>
      <div class="step-connector"></div>
      <div id="stepBadge2" class="step-badge">
        <span class="step-circle">2</span>
        <span class="step-label">Preview Impact</span>
      </div>
      <div class="step-connector"></div>
      <div id="stepBadge3" class="step-badge">
        <span class="step-circle">3</span>
        <span class="step-label">Confirm & Backup</span>
      </div>
    </div>

    <!-- Step 1: Select Items -->
    <div id="resetStep1" class="modal-step-body">
      <p style="font-size: 0.85rem; color: var(--admin-text-muted); margin-bottom: 1rem;">
        Select the specific categories of test/sample data you want to clear. <strong>Nothing is selected by default.</strong> A full database backup is created automatically before any deletion.
      </p>

      <div class="reset-options-list">
        <!-- A) Test Orders & Payments -->
        <div class="reset-option-card">
          <label class="reset-option-header">
            <input type="checkbox" id="chkEnableOrders" class="reset-checkbox">
            <div class="reset-option-info">
              <div class="reset-option-title">
                Test Orders & Payments
                <span class="badge-count-pill"><span id="cntTotalOrders">0</span> orders</span>
              </div>
              <div class="reset-option-desc">Remove order records, purchased items, payments, and customer download logs.</div>
            </div>
          </label>

          <div id="ordersOptionsWrapper" class="reset-sub-options" style="display: none;">
            <div style="font-size: 0.78rem; font-weight: 700; color: var(--admin-text-dark); margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.5px;">Choose order deletion scope:</div>
            
            <label class="reset-radio-label">
              <input type="radio" name="resetOrdersScope" value="test_mode" checked>
              <span>Only test-mode payments & orders (<span id="cntTestModeOrders">0</span> test orders)</span>
            </label>

            <label class="reset-radio-label">
              <input type="radio" name="resetOrdersScope" value="unpaid_pending">
              <span>Only unpaid or pending orders (<span id="cntUnpaidOrders">0</span> pending)</span>
            </label>

            <label class="reset-radio-label">
              <input type="radio" name="resetOrdersScope" value="all">
              <span>All orders (includes test & live; live requires confirmation)</span>
            </label>

            <label class="reset-radio-label">
              <input type="radio" name="resetOrdersScope" value="before_date">
              <span>Orders created before a specific date</span>
            </label>

            <div id="ordersDateWrapper" style="display: none; margin-left: 1.5rem; margin-top: 6px;">
              <input type="date" id="resetOrdersDateInput" class="admin-input-styled" style="width: auto;">
            </div>

            <div style="margin-top: 10px; padding-top: 8px; border-top: 1px dashed var(--admin-border);">
              <label class="reset-checkbox-label">
                <input type="checkbox" id="resetRestartOrderNumbers">
                <span style="font-size: 0.82rem; font-weight: 500;">Restart order numbers from #1 (resets table AUTO_INCREMENT if all orders cleared)</span>
              </label>
            </div>
          </div>
        </div>

        <!-- B) Test Customers -->
        <div class="reset-option-card">
          <label class="reset-option-header">
            <input type="checkbox" id="resetClearCustomers" class="reset-checkbox">
            <div class="reset-option-info">
              <div class="reset-option-title">
                Test Customers
                <span class="badge-count-pill"><span id="cntTestCustomers">0</span> accounts</span>
              </div>
              <div class="reset-option-desc">
                Remove customer profiles with no completed paid orders. <strong>Admin accounts (<span id="cntAdminCustomers">1</span>) are strictly protected and NEVER deleted.</strong>
              </div>
            </div>
          </label>
        </div>

        <!-- C) Operational Data -->
        <div class="reset-option-card">
          <label class="reset-option-header">
            <input type="checkbox" id="resetClearOperational" class="reset-checkbox">
            <div class="reset-option-info">
              <div class="reset-option-title">
                Engagement & Operational Data
              </div>
              <div class="reset-option-desc">
                Clear custom order requests (<span id="cntCustomOrders">0</span>), enquiries (<span id="cntContactMessages">0</span>), reviews (<span id="cntReviews">0</span>), wishlists (<span id="cntWishlists">0</span>), carts (<span id="cntCarts">0</span>), reset coupon usage counts (<span id="cntCoupons">0</span>), newsletter subscribers (<span id="cntSubscribers">0</span>), and campaign logs (<span id="cntEmailLogs">0</span>).
              </div>
            </div>
          </label>
        </div>

        <!-- D) Statistics Counters & Logs -->
        <div class="reset-option-card">
          <label class="reset-option-header">
            <input type="checkbox" id="resetClearStats" class="reset-checkbox">
            <div class="reset-option-info">
              <div class="reset-option-title">
                Statistics Counters & System Logs
              </div>
              <div class="reset-option-desc">
                Reset design download counters to 0 (<span id="cntDownloads">0</span> downloads), clear activity logs (<span id="cntActivityLogs">0</span>), import logs (<span id="cntImportJobs">0</span>), and bulk stitch/price update logs (<span id="cntStitchPriceLogs">0</span>).
              </div>
            </div>
          </label>
        </div>

        <!-- E) Dummy / Demo Designs -->
        <div class="reset-option-card">
          <label class="reset-option-header">
            <input type="checkbox" id="resetClearDemoDesigns" class="reset-checkbox">
            <div class="reset-option-info">
              <div class="reset-option-title">
                Dummy / Demo Designs
                <span class="badge-count-pill"><span id="cntDemoDesigns">0</span> demo designs</span>
              </div>
              <div class="reset-option-desc">
                Only removes designs flagged <code>is_demo = 1</code>. <strong>NEVER deletes real catalog designs, categories, settings, banners, pages, or menus.</strong>
              </div>
            </div>
          </label>
        </div>

        <!-- F) DANGER SECTION: Delete All Designs -->
        <div class="reset-option-card danger-section">
          <div class="danger-section-header" style="display: flex; align-items: center; gap: 8px;">
            <i class="fa-solid fa-triangle-exclamation" style="color: #DC2626;"></i>
            <strong style="color: #991B1B; font-size: 0.9rem;">DANGER SECTION: Delete ALL Catalog Designs & Files</strong>
          </div>
          <p style="font-size: 0.78rem; color: #991B1B; margin: 4px 0 8px;">
            Permanently removes all <span id="cntDangerAllDesigns">0</span> designs, previews, and machine files from the store catalog. OFF by default.
          </p>
          <label class="reset-checkbox-label">
            <input type="checkbox" id="resetClearAllDesignsDanger">
            <span style="font-weight: 600; color: #DC2626;">Enable "Delete ALL designs" option</span>
          </label>

          <div id="dangerConfirmWrapper" style="display: none; margin-top: 8px; padding: 8px 12px; background: #FEE2E2; border-radius: 6px; border: 1px solid #FCA5A5;">
            <label class="reset-checkbox-label" style="font-size: 0.8rem; color: #991B1B; font-weight: 700;">
              <input type="checkbox" id="confirmDangerDesigns">
              <span>I explicitly confirm I want to wipe all catalog designs and machine files.</span>
            </label>
          </div>
        </div>
      </div>

      <div class="modal-footer-actions">
        <button type="button" id="btnCancelReset" class="btn btn-outline">Cancel</button>
        <button type="button" id="btnToStep2" class="btn btn-primary" disabled>
          Review Impact & Preview &rarr;
        </button>
      </div>
    </div>

    <!-- Step 2: Preview Impact -->
    <div id="resetStep2" class="modal-step-body" style="display: none;">
      <div id="resetPreviewContent"></div>

      <!-- Live Paid Order Warning Alert (Red Banner) -->
      <div id="livePaidWarningContainer" class="live-paid-alert-box" style="display: none;">
        <div style="display: flex; gap: 10px; align-items: flex-start;">
          <i class="fa-solid fa-triangle-exclamation" style="font-size: 1.25rem; color: #DC2626; margin-top: 2px;"></i>
          <div>
            <strong id="livePaidWarningText" style="color: #991B1B; font-size: 0.9rem; display: block; margin-bottom: 4px;">
              Warning: Selected scope includes REAL paid orders.
            </strong>
            <span style="font-size: 0.8rem; color: #7F1D1D;">
              Live orders represent authentic financial transactions. Deleting them affects financial records.
            </span>
            <div style="margin-top: 8px;">
              <label class="reset-checkbox-label" style="font-weight: 700; color: #DC2626;">
                <input type="checkbox" id="deleteRealPaidOrdersCheck">
                <span>Delete real paid orders too (I confirm this financial impact)</span>
              </label>
            </div>
          </div>
        </div>
      </div>

      <div class="modal-footer-actions">
        <button type="button" id="btnBackToStep1" class="btn btn-outline">&larr; Back to Options</button>
        <button type="button" id="btnToStep3" class="btn btn-primary" disabled>
          Proceed to Security Confirmation &rarr;
        </button>
      </div>
    </div>

    <!-- Step 3: Security & Confirm -->
    <div id="resetStep3" class="modal-step-body" style="display: none;">
      <div class="confirm-security-box">
        <div class="security-shield-icon">
          <i class="fa-solid fa-shield-halved"></i>
        </div>
        <h4 style="margin: 0 0 6px; font-size: 1.05rem; color: var(--admin-text-dark);">
          Super Administrator Authorization Required
        </h4>
        <p style="font-size: 0.82rem; color: var(--admin-text-muted); margin: 0 0 1rem;">
          To prevent accidental execution, you must verify your identity and confirm this action.
          An automated pre-reset backup (SQL dump + CSV export) will be created immediately before deleting.
        </p>

        <div id="confirmErrorMessage" class="alert alert-danger" style="display: none; margin-bottom: 1rem; font-size: 0.85rem;"></div>

        <div class="form-group-confirm">
          <label style="display: block; font-size: 0.85rem; font-weight: 600; color: var(--admin-text-dark); margin-bottom: 4px;">
            1. Type <span style="background: #FEE2E2; color: #DC2626; padding: 2px 6px; border-radius: 4px; font-family: monospace; font-weight: 700;">RESET</span> to confirm:
          </label>
          <input type="text" id="confirmResetTextInput" class="admin-input-styled" placeholder="Type RESET here" autocomplete="off" style="font-family: monospace; font-weight: 700; text-transform: uppercase;">
        </div>

        <div class="form-group-confirm" style="margin-top: 12px;">
          <label style="display: block; font-size: 0.85rem; font-weight: 600; color: var(--admin-text-dark); margin-bottom: 4px;">
            2. Enter your Admin Account Password:
          </label>
          <input type="password" id="adminPasswordInput" class="admin-input-styled" placeholder="Admin password" autocomplete="current-password">
        </div>

        <div style="margin-top: 14px; padding: 10px 12px; background: #FAF9F6; border: 1px solid var(--admin-border); border-radius: 8px;">
          <label class="reset-checkbox-label" style="font-size: 0.83rem; font-weight: 600; color: var(--admin-text-dark);">
            <input type="checkbox" id="confirmUnderstandCheck">
            <span>I understand this cannot be undone and will permanently remove selected data.</span>
          </label>
        </div>

        <!-- Spinner while running -->
        <div id="resetExecutingSpinner" class="executing-spinner-overlay" style="display: none;">
          <i class="fa-solid fa-spinner fa-spin fa-2x" style="color: #DC2626;"></i>
          <span style="font-weight: 600; font-size: 0.9rem; margin-top: 8px;">Creating pre-reset backup & executing transaction...</span>
        </div>
      </div>

      <div class="modal-footer-actions">
        <button type="button" id="btnBackToStep2" class="btn btn-outline">&larr; Back to Preview</button>
        <button type="button" id="btnExecuteReset" class="btn btn-danger-reset" disabled>
          <i class="fa-solid fa-trash-can"></i> Permanently Reset Data
        </button>
      </div>
    </div>

    <!-- Step 4: Success Result -->
    <div id="resetStepResult" class="modal-step-body" style="display: none; text-align: center; padding: 2rem 1rem;">
      <div style="width: 64px; height: 64px; border-radius: 50%; background: #E8F5E9; color: #2E7D32; display: inline-flex; align-items: center; justify-content: center; font-size: 1.8rem; margin-bottom: 1rem;">
        <i class="fa-solid fa-circle-check"></i>
      </div>
      <h3 style="font-size: 1.3rem; font-weight: 700; color: var(--admin-text-dark); margin: 0 0 8px;">Store Reset Complete</h3>
      <p id="resetSuccessMessage" style="font-size: 0.9rem; color: var(--admin-text-muted); max-width: 460px; margin: 0 auto 1.5rem;">
        Data has been safely cleared and an automated backup was created.
      </p>

      <div style="display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; margin-bottom: 1.5rem;">
        <a id="btnDownloadBackupSql" href="#" class="btn btn-outline" style="display: none; align-items: center; gap: 6px; font-size: 0.85rem;">
          <i class="fa-solid fa-download"></i> Download Backup (SQL)
        </a>
        <a id="btnDownloadBackupCsv" href="#" class="btn btn-outline" style="display: none; align-items: center; gap: 6px; font-size: 0.85rem;">
          <i class="fa-solid fa-file-csv"></i> Download CSV Summary
        </a>
      </div>

      <div>
        <button type="button" id="btnReloadDashboard" class="btn btn-primary" style="padding: 0.65rem 1.8rem;">
          <i class="fa-solid fa-rotate"></i> Reload Live Dashboard
        </button>
      </div>
    </div>
  </div>
</div>

<script src="/public/js/admin/dashboard-reset.js"></script>

</body>
</html>
