<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Categories - ARUVI Admin</title>
  <link rel="icon" type="image/jpeg" href="/public/images/logo.jpg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;1,400&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="/public/css/main.css">
  <link rel="stylesheet" href="/public/css/admin.css">
  <style>
    /* Category Tag Badges */
    .cat-tag { display: inline-block; padding: 3px 10px; border-radius: 12px; font-size: 0.72rem; font-weight: 600; }
    .cat-tag-floral { background: #FFEBEE; color: #C62828; }
    .cat-tag-animals { background: #E3F2FD; color: #1565C0; }
    .cat-tag-blouse { background: #F3E5F5; color: #7B1FA2; }
    .cat-tag-monogram { background: #FFF8E1; color: #F57F17; }
    .cat-tag-kids { background: #E8F5E9; color: #2E7D32; }
    .cat-tag-traditional { background: #FBE9E7; color: #D84315; }
    .cat-tag-border { background: #E0F2F1; color: #00695C; }

    /* Switch Toggle */
    .switch-toggle { position: relative; display: inline-flex; align-items: center; gap: 8px; cursor: pointer; }
    .switch-toggle input { opacity: 0; width: 0; height: 0; }
    .slider-round { width: 36px; height: 20px; background-color: #CCC; transition: .3s; border-radius: 20px; position: relative; }
    .slider-round:before { position: absolute; content: ""; height: 14px; width: 14px; left: 3px; bottom: 3px; background-color: white; transition: .3s; border-radius: 50%; }
    input:checked + .slider-round { background-color: #4CAF50; }
    input:checked + .slider-round:before { transform: translateX(16px); }

    .action-icon-btn {
      width: 32px; height: 32px; border-radius: 8px; border: 1px solid var(--admin-border); background: #FFFFFF; color: var(--admin-text-dark); display: inline-flex; align-items: center; justify-content: center; font-size: 0.82rem; text-decoration: none; transition: var(--transition);
    }
    .action-icon-btn:hover { border-color: var(--admin-primary); color: var(--admin-primary); background: #FAF6F0; }
  </style>
</head>
<body class="admin-body">

<div class="admin-wrapper">
  <!-- Top Header matching Master Manage Designs UI -->
  <header class="admin-top-header">
    <a href="/admin" class="admin-header-brand">
      <% const currentLogo = (typeof siteSettings !== 'undefined' && siteSettings.logo_url) ? siteSettings.logo_url : '/public/images/logo.jpg'; %>
      <img src="<%= currentLogo %>" alt="ARUVI Admin Logo" style="max-height: 42px; width: auto; object-fit: contain;">
    </a>

    <!-- Global Search -->
    <div class="admin-search-bar">
      <i class="fa-solid fa-magnifying-glass"></i>
      <input type="text" placeholder="Search designs, orders, customers...">
    </div>

    <!-- Right User Header Icons -->
    <div class="admin-header-right">
      <a href="#" class="admin-icon-btn" title="Notifications">
        <i class="fa-regular fa-bell"></i>
        <span class="badge-count">3</span>
      </a>

      <div class="admin-user-menu">
        <div class="admin-user-avatar">A</div>
        <div class="admin-user-info">
          <strong>Admin</strong>
          <span>Administrator</span>
        </div>
        <i class="fa-solid fa-chevron-down" style="font-size: 0.75rem; color: var(--admin-text-muted); margin-left: 4px;"></i>
      </div>
    </div>
  </header>

  <!-- Admin Main Layout with Sidebar -->
  <div class="admin-main-container">
    <!-- Left Sidebar matching Master Manage Designs UI -->
    <aside class="admin-sidebar">
      <ul class="sidebar-nav-list" style="margin-bottom: 1.2rem;">
        <li class="sidebar-nav-item">
          <a href="/admin">
            <span><i class="fa-solid fa-house"></i> Dashboard</span>
          </a>
        </li>
      </ul>

      <!-- DESIGNS Section -->
      <div class="admin-sidebar-section">
        <div class="sidebar-heading">DESIGNS</div>
        <ul class="sidebar-nav-list">
          <li class="sidebar-nav-item"><a href="/admin/designs"><span><i class="fa-solid fa-box-archive"></i> Manage Designs</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/designs/create"><span><i class="fa-solid fa-circle-plus"></i> Add New Design</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/categories" class="active"><span><i class="fa-solid fa-border-all"></i> Categories</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/custom-orders"><span><i class="fa-solid fa-wand-magic-sparkles"></i> Custom Orders</span></a></li>
        </ul>
      </div>

      <!-- ORDERS Section -->
      <div class="admin-sidebar-section">
        <div class="sidebar-heading">ORDERS</div>
        <ul class="sidebar-nav-list">
          <li class="sidebar-nav-item"><a href="/admin/orders"><span><i class="fa-regular fa-newspaper"></i> All Orders</span></a></li>
          <li class="sidebar-nav-item">
            <a href="/admin/orders?status=pending">
              <span><i class="fa-regular fa-clock"></i> Pending Orders</span>
              <span class="sidebar-badge">5</span>
            </a>
          </li>
          <li class="sidebar-nav-item"><a href="/admin/orders?status=completed"><span><i class="fa-regular fa-circle-check"></i> Completed Orders</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/orders?status=cancelled"><span><i class="fa-regular fa-circle-xmark"></i> Cancelled Orders</span></a></li>
        </ul>
      </div>

      <!-- CUSTOMERS Section -->
      <div class="admin-sidebar-section">
        <div class="sidebar-heading">CUSTOMERS</div>
        <ul class="sidebar-nav-list">
          <li class="sidebar-nav-item"><a href="/admin/customers"><span><i class="fa-solid fa-users"></i> All Customers</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/messages"><span><i class="fa-regular fa-comment-dots"></i> Enquiries</span></a></li>
        </ul>
      </div>

      <!-- CONTENT Section -->
      <div class="admin-sidebar-section">
        <div class="sidebar-heading">CONTENT</div>
        <ul class="sidebar-nav-list">
          <li class="sidebar-nav-item"><a href="/admin/homepage"><span><i class="fa-solid fa-house-chimney"></i> Homepage</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/banners"><span><i class="fa-regular fa-image"></i> Banners</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/homepage#about"><span><i class="fa-regular fa-circle-info"></i> About Page</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/settings#contact"><span><i class="fa-solid fa-location-dot"></i> Contact Info</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/settings"><span><i class="fa-solid fa-gear"></i> Website Settings</span></a></li>
        </ul>
      </div>

      <div style="margin-top: auto; padding-top: 1rem; border-top: 1px solid var(--admin-border);">
        <a href="/admin/logout" style="display: flex; align-items: center; gap: 8px; color: var(--admin-primary); font-size: 0.85rem; font-weight: 600; text-decoration: none; padding: 0.5rem 0.8rem;">
          <i class="fa-solid fa-arrow-right-from-bracket"></i> Logout Admin
        </a>
      </div>
    </aside>

    <!-- Main Content Body matching Manage Designs Grid -->
    <main class="admin-content-body">

      <!-- Breadcrumbs & Header Row -->
      <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1.8rem;">
        <div>
          <div style="font-size: 0.8rem; color: var(--admin-text-muted); margin-bottom: 0.4rem;">
            <a href="/admin" style="color: var(--admin-text-muted); text-decoration: none;">Dashboard</a> &nbsp;>&nbsp; <span style="color: var(--admin-primary); font-weight: 600;">Categories</span>
          </div>
          <h1 style="font-family: var(--font-heading); font-size: 2.2rem; font-weight: 700; color: var(--admin-text-dark); margin: 0 0 0.3rem;">Categories</h1>
          <p style="font-size: 0.88rem; color: var(--admin-text-muted); margin: 0;">Create, edit and organize embroidery design categories.</p>
        </div>

        <button type="button" onclick="openAddCategoryModal()" class="btn btn-primary" style="height: 44px; padding: 0 1.4rem; border-radius: 10px; font-size: 0.9rem; font-weight: 600; display: inline-flex; align-items: center; gap: 8px;">
          <i class="fa-solid fa-plus"></i> Add Category
        </button>
      </div>

      <% if (flash && flash.success && flash.success.length > 0) { %>
        <div id="adminToastPopup" style="position: fixed; top: 25px; right: 25px; background: #1B5E20; color: white; padding: 1.1rem 1.8rem; border-radius: 14px; box-shadow: 0 12px 30px rgba(0,0,0,0.25); z-index: 999999; display: flex; align-items: center; gap: 12px; font-weight: 600; font-size: 1rem; border: 2px solid #81C784;">
          <i class="fa-solid fa-circle-check" style="font-size: 1.5rem; color: #66BB6A;"></i>
          <span><%= flash.success[0] %></span>
          <button type="button" onclick="this.parentElement.remove()" style="background: none; border: none; color: white; margin-left: 15px; cursor: pointer; font-size: 1.3rem;">&times;</button>
        </div>
        <script>
          setTimeout(() => {
            const popup = document.getElementById('adminToastPopup');
            if (popup) popup.style.display = 'none';
          }, 4500);
        </script>
        <div class="alert alert-success" style="margin-bottom: 1.5rem; border-radius: 10px;">
          <i class="fa-solid fa-circle-check"></i> <%= flash.success[0] %>
        </div>
      <% } %>

      <!-- 4 Stat Summary Cards Row matching Manage Designs Master UI -->
      <div class="admin-stats-row" style="margin-bottom: 1.8rem;">
        <!-- Total Categories Card -->
        <div class="admin-summary-card">
          <div class="card-icon-badge"><i class="fa-solid fa-border-all"></i></div>
          <div class="card-info-content">
            <div class="stat-title">Total Categories</div>
            <div style="display: flex; align-items: baseline;">
              <span class="stat-num"><%= categories ? categories.length : 8 %></span>
              <span class="stat-trend"><i class="fa-solid fa-arrow-up"></i> 8%</span>
            </div>
            <span style="font-size: 0.72rem; color: var(--admin-text-muted);">from last month</span>
          </div>
        </div>

        <!-- Active Categories Card -->
        <div class="admin-summary-card">
          <div class="card-icon-badge"><i class="fa-regular fa-eye"></i></div>
          <div class="card-info-content">
            <div class="stat-title">Active Categories</div>
            <div style="display: flex; align-items: baseline;">
              <span class="stat-num"><%= categories ? categories.length : 8 %></span>
              <span class="stat-trend"><i class="fa-solid fa-arrow-up"></i> 10%</span>
            </div>
            <span style="font-size: 0.72rem; color: var(--admin-text-muted);">from last month</span>
          </div>
        </div>

        <!-- Inactive Categories Card -->
        <div class="admin-summary-card">
          <div class="card-icon-badge"><i class="fa-solid fa-pause"></i></div>
          <div class="card-info-content">
            <div class="stat-title">Inactive Categories</div>
            <div style="display: flex; align-items: baseline;">
              <span class="stat-num">0</span>
              <span class="stat-trend" style="color: var(--admin-text-muted);">0%</span>
            </div>
            <span style="font-size: 0.72rem; color: var(--admin-text-muted);">from last month</span>
          </div>
        </div>

        <!-- Total Designs Card -->
        <div class="admin-summary-card">
          <div class="card-icon-badge"><i class="fa-solid fa-box-archive"></i></div>
          <div class="card-info-content">
            <div class="stat-title">Total Designs</div>
            <div style="display: flex; align-items: baseline;">
              <span class="stat-num">520</span>
              <span class="stat-trend"><i class="fa-solid fa-arrow-up"></i> 12%</span>
            </div>
            <span style="font-size: 0.72rem; color: var(--admin-text-muted);">from last month</span>
          </div>
        </div>
      </div>

      <!-- Filter Controls Bar Card -->
      <div class="admin-card-box" style="padding: 1rem 1.4rem; margin-bottom: 1.5rem;">
        <form action="/admin/categories" method="GET" style="display: flex; gap: 1rem; align-items: center; flex-wrap: wrap;">
          
          <!-- Search Input -->
          <div style="flex: 1; min-width: 280px; position: relative;">
            <i class="fa-solid fa-magnifying-glass" style="position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: var(--admin-text-muted); font-size: 0.88rem;"></i>
            <input type="text" name="search" placeholder="Search categories by name or keyword..." style="width: 100%; height: 40px; border-radius: 8px; border: 1px solid var(--admin-border); padding-left: 2.5rem; font-size: 0.85rem;">
          </div>

          <!-- Status Filter -->
          <select name="status" style="height: 40px; border-radius: 8px; border: 1px solid var(--admin-border); padding: 0 1rem; font-size: 0.85rem; background: #FFFFFF; color: var(--admin-text-dark);">
            <option value="">All Status</option>
            <option value="active">Active</option>
            <option value="inactive">Inactive</option>
          </select>

          <!-- Sort Filter -->
          <select name="sort" style="height: 40px; border-radius: 8px; border: 1px solid var(--admin-border); padding: 0 1rem; font-size: 0.85rem; background: #FFFFFF; color: var(--admin-text-dark);">
            <option value="newest">Sort by Newest</option>
            <option value="name">Sort by Name</option>
            <option value="count">Sort by Design Count</option>
          </select>

          <!-- Reset Button -->
          <a href="/admin/categories" class="btn btn-outline" style="height: 40px; border-radius: 8px; font-size: 0.85rem; padding: 0 1rem; display: inline-flex; align-items: center; gap: 6px; background: #FFF;">
            <i class="fa-solid fa-rotate-left"></i> Reset
          </a>

        </form>
      </div>

      <!-- Main Categories Table Card matching Master Manage Designs UI -->
      <div class="admin-card-box" style="padding: 0; overflow: hidden; margin-bottom: 1.5rem;">
        <table class="admin-table-styled">
          <thead>
            <tr>
              <th style="width: 38px; text-align: center;"><input type="checkbox"></th>
              <th style="width: 60px;">#</th>
              <th>Category Image</th>
              <th>Category Name</th>
              <th>Slug</th>
              <th>Design Count</th>
              <th>Status</th>
              <th>Date Added</th>
              <th style="text-align: right;">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (categories && categories.length > 0) { %>
              <% categories.forEach((cat, idx) => { %>
                <% 
                  const codeNum = 101 + idx;
                  let catClass = 'cat-tag-floral';
                  if (cat.name.includes('Animal')) catClass = 'cat-tag-animals';
                  else if (cat.name.includes('Blouse')) catClass = 'cat-tag-blouse';
                  else if (cat.name.includes('Monogram')) catClass = 'cat-tag-monogram';
                  else if (cat.name.includes('Kids')) catClass = 'cat-tag-kids';
                  else if (cat.name.includes('Traditional')) catClass = 'cat-tag-traditional';
                  else if (cat.name.includes('Border')) catClass = 'cat-tag-border';
                %>
                <tr>
                  <td style="text-align: center;"><input type="checkbox"></td>
                  <td><strong style="color: var(--admin-text-muted); font-size: 0.82rem;">#<%= codeNum %></strong></td>
                  <td>
                    <img src="<%= cat.image_url || '/public/images/cat_floral.jpg' %>" alt="<%= cat.name %>" style="width: 44px; height: 44px; border-radius: 50%; object-fit: cover; border: 1px solid var(--admin-border);">
                  </td>
                  <td>
                    <strong style="display: block; font-size: 0.92rem; color: var(--admin-text-dark); margin-bottom: 2px;"><%= cat.name %></strong>
                    <span class="cat-tag <%= catClass %>"><%= cat.name %></span>
                  </td>
                  <td>
                    <code style="font-size: 0.78rem; background: #FAF6F0; padding: 2px 8px; border-radius: 4px; border: 1px solid var(--admin-border);"><%= cat.slug %></code>
                  </td>
                  <td>
                    <strong style="font-size: 0.88rem; color: var(--admin-primary);"><%= cat.description || (cat.design_count || 300) + '+ Designs' %></strong>
                  </td>
                  <td>
                    <label class="switch-toggle">
                      <input type="checkbox" checked>
                      <span class="slider-round"></span>
                      <span style="font-size: 0.78rem; font-weight: 600; color: #2E7D32;">Active</span>
                    </label>
                  </td>
                  <td style="color: var(--admin-text-muted); font-size: 0.78rem;">
                    01 Oct 2026
                  </td>
                  <td style="text-align: right;">
                    <div style="display: inline-flex; gap: 6px;">
                      <button type="button" onclick="openEditCategoryModal(<%= JSON.stringify(cat) %>)" class="action-icon-btn" title="Edit Category"><i class="fa-regular fa-pen-to-square"></i></button>
                      <a href="/category/<%= cat.slug %>" target="_blank" class="action-icon-btn" title="View on Site"><i class="fa-regular fa-eye"></i></a>
                      <form action="/admin/categories/delete/<%= cat.id %>" method="POST" style="display: inline;">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <button type="submit" class="action-icon-btn" style="color: #C62828;" title="Delete Category"><i class="fa-regular fa-trash-can"></i></button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="9" style="text-align: center; padding: 2rem; color: var(--admin-text-muted);">
                  No categories found. Click "+ Add Category" to create one.
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>

        <!-- Pagination Bar matching Master Manage Designs UI -->
        <div style="padding: 1rem 1.4rem; background: #FAF6F0; border-top: 1px solid var(--admin-border); display: flex; align-items: center; justify-content: space-between;">
          <div style="font-size: 0.82rem; color: var(--admin-text-muted);">
            Showing 1 to <%= categories ? categories.length : 8 %> of <strong><%= categories ? categories.length : 8 %></strong> categories
          </div>

          <div style="display: flex; gap: 6px;">
            <a href="#" class="action-icon-btn" style="width: 32px; height: 32px;"><i class="fa-solid fa-chevron-left" style="font-size: 0.7rem;"></i></a>
            <a href="#" class="action-icon-btn" style="width: 32px; height: 32px; background: var(--admin-primary); color: #FFFFFF; border-color: var(--admin-primary); font-weight: 700;">1</a>
            <a href="#" class="action-icon-btn" style="width: 32px; height: 32px;"><i class="fa-solid fa-chevron-right" style="font-size: 0.7rem;"></i></a>
          </div>
        </div>
      </div>

    </main>
  </div>
</div>

<!-- Add/Edit Category Modal matching Master Manage Designs UI -->
<div id="categoryModal" style="position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 9999; display: none; align-items: center; justify-content: center; backdrop-filter: blur(3px);">
  <div style="background: #FFFFFF; border-radius: 18px; max-width: 520px; width: 90%; padding: 2.2rem; box-shadow: 0 20px 40px rgba(0,0,0,0.15); border: 1px solid var(--admin-border);">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.4rem; padding-bottom: 0.8rem; border-bottom: 1px solid var(--admin-border);">
      <h3 id="modalTitle" style="font-family: var(--font-heading); font-size: 1.4rem; font-weight: 700; color: var(--admin-text-dark); margin: 0;">Add New Category</h3>
      <i class="fa-solid fa-xmark" onclick="closeCategoryModal()" style="cursor: pointer; font-size: 1.1rem; color: var(--admin-text-muted);"></i>
    </div>

    <form id="categoryForm" action="/admin/categories/create?_csrf=<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>" method="POST" enctype="multipart/form-data">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div style="margin-bottom: 1.1rem;">
        <label style="display: block; font-size: 0.82rem; font-weight: 600; color: var(--admin-text-dark); margin-bottom: 6px;">Category Name <span style="color: var(--admin-primary);">*</span></label>
        <input type="text" id="catName" name="name" class="form-control" placeholder="e.g. Floral Designs" required style="height: 42px; border-radius: 8px;">
      </div>

      <div style="margin-bottom: 1.1rem;">
        <label style="display: block; font-size: 0.82rem; font-weight: 600; color: var(--admin-text-dark); margin-bottom: 6px;">Slug</label>
        <input type="text" id="catSlug" name="slug" class="form-control" placeholder="e.g. floral-designs" style="height: 42px; border-radius: 8px;">
      </div>

      <div style="margin-bottom: 1.1rem;">
        <label style="display: block; font-size: 0.82rem; font-weight: 600; color: var(--admin-text-dark); margin-bottom: 6px;">Design Count Label</label>
        <input type="text" id="catDesc" name="description" class="form-control" placeholder="e.g. 500+ Designs" style="height: 42px; border-radius: 8px;">
      </div>

      <div style="margin-bottom: 1.2rem;">
        <label style="display: block; font-size: 0.82rem; font-weight: 600; color: var(--admin-text-dark); margin-bottom: 6px;">Category Image</label>
        <input type="file" name="image" class="form-control" accept="image/*" style="height: 42px; border-radius: 8px;">
      </div>

      <div style="margin-bottom: 1.5rem;">
        <label class="switch-toggle">
          <input type="checkbox" name="is_active" checked>
          <span class="slider-round"></span>
          <span style="font-size: 0.85rem; font-weight: 500; color: var(--admin-text-dark);">Active Category</span>
        </label>
      </div>

      <div style="display: flex; gap: 1rem; justify-content: flex-end;">
        <button type="button" onclick="closeCategoryModal()" class="btn btn-outline" style="height: 44px; border-radius: 10px; font-weight: 600; background: #FFF; padding: 0 1.2rem;">Cancel</button>
        <button type="submit" class="btn btn-primary" style="height: 44px; border-radius: 10px; font-weight: 600; padding: 0 1.5rem;">Save Category</button>
      </div>
    </form>
  </div>
</div>

<script>
  function openAddCategoryModal() {
    document.getElementById('modalTitle').innerText = 'Add New Category';
    document.getElementById('categoryForm').action = '/admin/categories/create?_csrf=' + encodeURIComponent('<%= typeof csrfToken !== "undefined" ? csrfToken : "" %>');
    document.getElementById('catName').value = '';
    document.getElementById('catSlug').value = '';
    document.getElementById('catDesc').value = '';
    document.getElementById('categoryModal').style.display = 'flex';
  }

  function openEditCategoryModal(cat) {
    document.getElementById('modalTitle').innerText = 'Edit Category #' + cat.id;
    document.getElementById('categoryForm').action = '/admin/categories/edit/' + cat.id + '?_csrf=' + encodeURIComponent('<%= typeof csrfToken !== "undefined" ? csrfToken : "" %>');
    document.getElementById('catName').value = cat.name || '';
    document.getElementById('catSlug').value = cat.slug || '';
    document.getElementById('catDesc').value = cat.description || '';
    document.getElementById('categoryModal').style.display = 'flex';
  }

  function closeCategoryModal() {
    document.getElementById('categoryModal').style.display = 'none';
  }
</script>

</body>
</html>
