<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Custom Orders - ARUVI Admin</title>
  <link rel="icon" type="image/jpeg" href="/public/images/logo.jpg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;1,400&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="/public/css/main.css">
  <link rel="stylesheet" href="/public/css/admin.css">
  <style>
    .action-icon-btn {
      width: 32px; height: 32px; border-radius: 8px; border: 1px solid var(--admin-border); background: #FFFFFF; color: var(--admin-text-dark); display: inline-flex; align-items: center; justify-content: center; font-size: 0.82rem; text-decoration: none; transition: var(--transition); cursor: pointer;
    }
    .action-icon-btn:hover { border-color: var(--admin-primary); color: var(--admin-primary); background: #FAF6F0; }
    .badge-status-pill {
      display: inline-block; padding: 3px 8px; border-radius: 20px; font-size: 0.72rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.4px;
    }
    .badge-status-new { background: #E3F2FD; color: #1565C0; border: 1px solid #BBDEFB; }
    .badge-status-in_review { background: #FFF8E1; color: #E65100; border: 1px solid #FFE082; }
    .badge-status-quoted { background: #F3E5F5; color: #6A1B9A; border: 1px solid #E1BEE7; }
    .badge-status-accepted { background: #E0F2F1; color: #00695C; border: 1px solid #B2DFDB; }
    .badge-status-completed { background: #E8F5E9; color: #2E7D32; border: 1px solid #C8E6C9; }
    .badge-status-rejected { background: #FFEBEE; color: #C62828; border: 1px solid #FFCDD2; }
    
    /* Modal styles */
    .custom-modal-overlay {
      position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.55); z-index: 9999; display: none; align-items: center; justify-content: center; padding: 1rem;
    }
    .custom-modal-card {
      background: #FFFFFF; border-radius: 14px; max-width: 680px; width: 100%; max-height: 90vh; overflow-y: auto; box-shadow: 0 20px 40px rgba(0,0,0,0.2); border: 1px solid var(--admin-border);
    }
  </style>
</head>
<body class="admin-body">

<div class="admin-wrapper">
  <!-- Top Header matching Master Manage Designs UI -->
  <header class="admin-top-header">
    <a href="/admin" class="admin-header-brand">
      <% const currentLogo = (typeof siteSettings !== 'undefined' && siteSettings.logo_url) ? siteSettings.logo_url : '/public/images/logo.jpg'; %>
      <img src="<%= currentLogo %>" alt="ARUVI Admin Logo" style="max-height: 42px; width: auto; object-fit: contain;">
    </a>

    <!-- Global Search -->
    <div class="admin-search-bar">
      <i class="fa-solid fa-magnifying-glass"></i>
      <input type="text" placeholder="Search designs, orders, customers...">
    </div>

    <!-- Right User Header Icons -->
    <div class="admin-header-right">
      <a href="/admin/messages" class="admin-icon-btn" title="Enquiries">
        <i class="fa-regular fa-bell"></i>
        <% if (typeof adminNavBadges !== 'undefined' && adminNavBadges.unreadMessages > 0) { %>
          <span class="badge-count"><%= adminNavBadges.unreadMessages %></span>
        <% } %>
      </a>

      <div class="admin-user-menu">
        <div class="admin-user-avatar">A</div>
        <div class="admin-user-info">
          <strong>Admin</strong>
          <span>Administrator</span>
        </div>
        <i class="fa-solid fa-chevron-down" style="font-size: 0.75rem; color: var(--admin-text-muted); margin-left: 4px;"></i>
      </div>
    </div>
  </header>

  <!-- Admin Main Layout with Sidebar -->
  <div class="admin-main-container">
    <!-- Left Sidebar matching Master Manage Designs UI -->
    <aside class="admin-sidebar">
      <ul class="sidebar-nav-list" style="margin-bottom: 1.2rem;">
        <li class="sidebar-nav-item">
          <a href="/admin">
            <span><i class="fa-solid fa-house"></i> Dashboard</span>
          </a>
        </li>
      </ul>

      <!-- DESIGNS Section -->
      <div class="admin-sidebar-section">
        <div class="sidebar-heading">DESIGNS</div>
        <ul class="sidebar-nav-list">
          <li class="sidebar-nav-item"><a href="/admin/designs"><span><i class="fa-solid fa-box-archive"></i> Manage Designs</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/designs/create"><span><i class="fa-solid fa-circle-plus"></i> Add New Design</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/categories"><span><i class="fa-solid fa-border-all"></i> Categories</span></a></li>
          <li class="sidebar-nav-item">
            <a href="/admin/custom-orders" class="active">
              <span><i class="fa-solid fa-wand-magic-sparkles"></i> Custom Orders</span>
              <% if (typeof adminNavBadges !== 'undefined' && adminNavBadges.pendingCustomOrders > 0) { %>
                <span class="sidebar-badge"><%= adminNavBadges.pendingCustomOrders %></span>
              <% } %>
            </a>
          </li>
        </ul>
      </div>

      <!-- ORDERS Section -->
      <div class="admin-sidebar-section">
        <div class="sidebar-heading">ORDERS</div>
        <ul class="sidebar-nav-list">
          <li class="sidebar-nav-item"><a href="/admin/orders"><span><i class="fa-regular fa-newspaper"></i> All Orders</span></a></li>
          <li class="sidebar-nav-item">
            <a href="/admin/orders?status=pending">
              <span><i class="fa-regular fa-clock"></i> Pending Orders</span>
              <% if (typeof adminNavBadges !== 'undefined' && adminNavBadges.pendingOrders > 0) { %>
                <span class="sidebar-badge"><%= adminNavBadges.pendingOrders %></span>
              <% } %>
            </a>
          </li>
          <li class="sidebar-nav-item"><a href="/admin/orders?status=completed"><span><i class="fa-regular fa-circle-check"></i> Completed Orders</span></a></li>
        </ul>
      </div>

      <!-- MARKETING Section -->
      <div class="admin-sidebar-section">
        <div class="sidebar-heading">MARKETING</div>
        <ul class="sidebar-nav-list">
          <li class="sidebar-nav-item"><a href="/admin/banners"><span><i class="fa-regular fa-images"></i> Banners</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/coupons"><span><i class="fa-solid fa-ticket"></i> Coupons</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/email-campaigns"><span><i class="fa-regular fa-paper-plane"></i> Email Campaigns</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/homepage"><span><i class="fa-solid fa-table-cells-large"></i> Homepage Layout</span></a></li>
        </ul>
      </div>

      <!-- SYSTEM Section -->
      <div class="admin-sidebar-section">
        <div class="sidebar-heading">SYSTEM</div>
        <ul class="sidebar-nav-list">
          <li class="sidebar-nav-item"><a href="/admin/messages"><span><i class="fa-regular fa-envelope"></i> Enquiries</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/reviews"><span><i class="fa-regular fa-star"></i> Customer Reviews</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/customers"><span><i class="fa-solid fa-users"></i> Customers</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/settings"><span><i class="fa-solid fa-gear"></i> Settings</span></a></li>
        </ul>
      </div>
    </aside>

    <!-- Main Content Body -->
    <main class="admin-content-body">

      <!-- Breadcrumbs & Header -->
      <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1.8rem;">
        <div>
          <div style="font-size: 0.8rem; color: var(--admin-text-muted); margin-bottom: 0.4rem;">
            <a href="/admin" style="color: var(--admin-text-muted); text-decoration: none;">Dashboard</a> &nbsp;>&nbsp; <span style="color: var(--admin-primary); font-weight: 600;">Custom Orders</span>
          </div>
          <h1 style="font-family: var(--font-heading); font-size: 2.2rem; font-weight: 700; color: var(--admin-text-dark); margin: 0 0 0.3rem;">Custom Orders</h1>
          <p style="font-size: 0.88rem; color: var(--admin-text-muted); margin: 0;">Manage customer requests for custom embroidery digitization and quotes.</p>
        </div>
      </div>

      <% if (flash && flash.success && flash.success.length > 0) { %>
        <div class="alert alert-success" style="margin-bottom: 1.5rem; border-radius: 10px;">
          <i class="fa-solid fa-circle-check"></i> <%= flash.success[0] %>
        </div>
      <% } %>

      <% if (flash && flash.error && flash.error.length > 0) { %>
        <div class="alert alert-danger" style="margin-bottom: 1.5rem; border-radius: 10px;">
          <i class="fa-solid fa-circle-exclamation"></i> <%= flash.error[0] %>
        </div>
      <% } %>

      <!-- 4 Stat Summary Cards Row matching Master Manage Designs UI -->
      <div class="admin-stats-row" style="margin-bottom: 1.8rem;">
        <div class="admin-summary-card">
          <div class="card-icon-badge"><i class="fa-solid fa-wand-magic-sparkles"></i></div>
          <div class="card-info-content">
            <div class="stat-title">Total Requests</div>
            <div style="display: flex; align-items: baseline;">
              <span class="stat-num"><%= (typeof stats !== 'undefined' && stats.total !== undefined) ? stats.total : (requests ? requests.length : 0) %></span>
            </div>
            <span style="font-size: 0.72rem; color: var(--admin-text-muted);">custom inquiries</span>
          </div>
        </div>

        <div class="admin-summary-card">
          <div class="card-icon-badge" style="background: #E3F2FD; color: #1565C0;"><i class="fa-regular fa-clock"></i></div>
          <div class="card-info-content">
            <div class="stat-title">New / In Review</div>
            <div style="display: flex; align-items: baseline;">
              <span class="stat-num"><%= (typeof stats !== 'undefined' && stats.pending !== undefined) ? stats.pending : 0 %></span>
            </div>
            <span style="font-size: 0.72rem; color: var(--admin-text-muted);">awaiting review / quote</span>
          </div>
        </div>

        <div class="admin-summary-card">
          <div class="card-icon-badge" style="background: #F3E5F5; color: #6A1B9A;"><i class="fa-solid fa-tag"></i></div>
          <div class="card-info-content">
            <div class="stat-title">Quoted</div>
            <div style="display: flex; align-items: baseline;">
              <span class="stat-num"><%= (typeof stats !== 'undefined' && stats.quoted !== undefined) ? stats.quoted : 0 %></span>
            </div>
            <span style="font-size: 0.72rem; color: var(--admin-text-muted);">quotes sent to client</span>
          </div>
        </div>

        <div class="admin-summary-card">
          <div class="card-icon-badge" style="background: #E8F5E9; color: #2E7D32;"><i class="fa-regular fa-circle-check"></i></div>
          <div class="card-info-content">
            <div class="stat-title">Completed</div>
            <div style="display: flex; align-items: baseline;">
              <span class="stat-num"><%= (typeof stats !== 'undefined' && stats.completed !== undefined) ? stats.completed : 0 %></span>
            </div>
            <span style="font-size: 0.72rem; color: var(--admin-text-muted);">digitized & delivered</span>
          </div>
        </div>
      </div>

      <!-- Filter Controls Bar Card -->
      <div class="admin-card-box" style="padding: 1rem 1.4rem; margin-bottom: 1.5rem;">
        <form action="/admin/custom-orders" method="GET" style="display: flex; gap: 1rem; align-items: center; flex-wrap: wrap;">
          <div style="flex: 1; min-width: 280px; position: relative;">
            <i class="fa-solid fa-magnifying-glass" style="position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: var(--admin-text-muted); font-size: 0.88rem;"></i>
            <input type="text" name="search" value="<%= typeof currentSearch !== 'undefined' ? currentSearch : '' %>" placeholder="Search request #, customer name, email, phone, or title..." style="width: 100%; height: 40px; border-radius: 8px; border: 1px solid var(--admin-border); padding-left: 2.5rem; font-size: 0.85rem;">
          </div>

          <select name="status" style="height: 40px; border-radius: 8px; border: 1px solid var(--admin-border); padding: 0 1rem; font-size: 0.85rem; background: #FFFFFF; color: var(--admin-text-dark);">
            <option value="">All Statuses</option>
            <option value="new" <%= currentStatus === 'new' ? 'selected' : '' %>>New</option>
            <option value="in_review" <%= currentStatus === 'in_review' ? 'selected' : '' %>>In Review</option>
            <option value="quoted" <%= currentStatus === 'quoted' ? 'selected' : '' %>>Quoted</option>
            <option value="accepted" <%= currentStatus === 'accepted' ? 'selected' : '' %>>Accepted</option>
            <option value="completed" <%= currentStatus === 'completed' ? 'selected' : '' %>>Completed</option>
            <option value="rejected" <%= currentStatus === 'rejected' ? 'selected' : '' %>>Rejected</option>
          </select>

          <!-- Standardized Sort Filter -->
          <%- include('../../partials/sort-dropdown', {
            id: 'admin_custom_orders_sort_dd',
            label: 'Sort by:',
            actionType: 'submit',
            currentSort: typeof currentSort !== 'undefined' ? currentSort : 'newest',
            options: [
              { value: 'newest', label: 'Sort by Newest', iconType: 'latest' },
              { value: 'oldest', label: 'Sort by Oldest', iconType: 'oldest' }
            ]
          }) %>

          <a href="/admin/custom-orders" class="btn btn-outline" style="height: 40px; border-radius: 8px; font-size: 0.85rem; padding: 0 1rem; display: inline-flex; align-items: center; gap: 6px; background: #FFF;">
            <i class="fa-solid fa-rotate-left"></i> Reset
          </a>
        </form>
      </div>

      <!-- Main Custom Orders Table Card -->
      <div class="admin-card-box" style="padding: 0; overflow: hidden; margin-bottom: 1.5rem;">
        <table class="admin-table-styled">
          <thead>
            <tr>
              <th style="width: 120px;">Request #</th>
              <th>Customer</th>
              <th>Design Request</th>
              <th>Reference Image</th>
              <th>Status</th>
              <th>Quote Price</th>
              <th>Submitted</th>
              <th style="text-align: right;">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (requests && requests.length > 0) { %>
              <% requests.forEach(r => { %>
                <%
                  const st = r.status || 'new';
                  const badgeClass = 'badge-status-' + st;
                  const reqNum = r.request_number || ('CR-LEGACY-' + r.id);
                  const custName = r.name || r.full_name || 'Customer';
                  const custEmail = r.email || '';
                  const custPhone = r.phone || '';
                  const title = r.design_title || 'Custom Design';
                  const desc = r.description || r.design_details || '';
                  const hasImage = Boolean(r.reference_image_key || r.reference_image_url);
                  const previewUrl = hasImage ? ('/admin/custom-orders/preview/' + r.id) : null;
                %>
                <tr id="customOrderRow-<%= r.id %>">
                  <td>
                    <strong style="color: var(--admin-primary); font-size: 0.82rem; font-family: monospace;"><%= reqNum %></strong>
                  </td>
                  <td>
                    <strong style="display: block; font-size: 0.88rem; color: var(--admin-text-dark);"><%= custName %></strong>
                    <span style="font-size: 0.74rem; color: var(--admin-text-muted); display: block;"><%= custEmail %></span>
                    <% if (custPhone) { %>
                      <span style="font-size: 0.72rem; color: var(--admin-text-muted);"><i class="fa-solid fa-phone" style="font-size: 0.65rem;"></i> <%= custPhone %></span>
                    <% } %>
                  </td>
                  <td style="max-width: 250px;">
                    <strong style="display: block; font-size: 0.82rem; color: var(--admin-text-dark);"><%= title %></strong>
                    <span style="font-size: 0.75rem; color: var(--admin-text-muted); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;"><%= desc %></span>
                  </td>
                  <td style="text-align: center;">
                    <% if (hasImage) { %>
                      <a href="<%= previewUrl %>" target="_blank" title="Click to view full reference image">
                        <img src="<%= previewUrl %>" alt="Reference Image" style="width: 44px; height: 44px; border-radius: 8px; object-fit: cover; border: 1px solid var(--admin-border);" onerror="this.onerror=null; this.src='/public/images/logo.jpg';">
                      </a>
                    <% } else { %>
                      <span style="font-size: 0.72rem; color: var(--admin-text-muted); font-style: italic;">No image</span>
                    <% } %>
                  </td>
                  <td>
                    <form action="/admin/custom-orders/status/<%= r.id %>" method="POST" style="display: inline-flex; gap: 4px;">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <select name="status" onchange="this.form.submit()" style="height: 30px; border-radius: 6px; font-size: 0.74rem; font-weight: 600; border: 1px solid var(--admin-border); background: #FAF6F0;">
                        <option value="new" <%= st === 'new' ? 'selected' : '' %>>New</option>
                        <option value="in_review" <%= st === 'in_review' ? 'selected' : '' %>>In Review</option>
                        <option value="quoted" <%= st === 'quoted' ? 'selected' : '' %>>Quoted</option>
                        <option value="accepted" <%= st === 'accepted' ? 'selected' : '' %>>Accepted</option>
                        <option value="completed" <%= st === 'completed' ? 'selected' : '' %>>Completed</option>
                        <option value="rejected" <%= st === 'rejected' ? 'selected' : '' %>>Rejected</option>
                      </select>
                    </form>
                  </td>
                  <td>
                    <% if (r.quoted_price) { %>
                      <strong style="color: #2E7D32; font-size: 0.88rem;">₹<%= Number(r.quoted_price).toFixed(2) %></strong>
                    <% } else { %>
                      <span style="color: var(--admin-text-muted); font-size: 0.76rem;">Pending quote</span>
                    <% } %>
                  </td>
                  <td style="color: var(--admin-text-muted); font-size: 0.78rem;">
                    <%= formatDateTime(r.created_at) %>
                  </td>
                  <td style="text-align: right;">
                    <div style="display: inline-flex; gap: 6px;">
                      <button type="button" class="action-icon-btn" onclick="openCustomOrderModal(<%= JSON.stringify(r) %>)" title="View Full Details & Quote"><i class="fa-regular fa-eye"></i></button>
                      <a href="mailto:<%= custEmail %>?subject=Regarding%20Your%20Custom%20Embroidery%20Request%20[<%= encodeURIComponent(reqNum) %>]" class="action-icon-btn" title="Reply Email"><i class="fa-regular fa-envelope"></i></a>
                      <button type="button" onclick="confirmDeleteCustomOrder('<%= r.id %>')" class="action-icon-btn" style="color: #C62828; border: none; background: transparent;" title="Delete"><i class="fa-regular fa-trash-can"></i></button>
                    </div>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="8" style="text-align: center; padding: 3rem 1rem;">
                  <div style="max-width: 360px; margin: 0 auto; color: var(--admin-text-muted);">
                    <i class="fa-solid fa-wand-magic-sparkles" style="font-size: 2.5rem; color: #D1C4E9; margin-bottom: 12px; display: block;"></i>
                    <h3 style="font-size: 1.1rem; color: var(--admin-text-dark); margin-bottom: 6px;">No Custom Orders Found</h3>
                    <p style="font-size: 0.84rem; line-height: 1.5;">There are no custom design requests matching your current filter. Clear your filters or check back later.</p>
                    <a href="/admin/custom-orders" class="btn btn-outline btn-sm" style="margin-top: 10px; display: inline-block;">Reset Filter</a>
                  </div>
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>

        <!-- Pagination Bar -->
        <div style="padding: 1rem 1.4rem; background: #FAF6F0; border-top: 1px solid var(--admin-border); display: flex; align-items: center; justify-content: space-between;">
          <div style="font-size: 0.82rem; color: var(--admin-text-muted);">
            Showing 1 to <%= requests ? requests.length : 0 %> of <strong><%= typeof total !== 'undefined' ? total : 0 %></strong> requests
          </div>

          <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
            <div style="display: flex; gap: 6px;">
              <% for (let p = 1; p <= totalPages; p++) { %>
                <a href="/admin/custom-orders?page=<%= p %>&status=<%= currentStatus %>&search=<%= currentSearch %>&sort=<%= currentSort %>" class="action-icon-btn" style="<%= p === currentPage ? 'background: var(--admin-primary); color: #FFF; font-weight: 700;' : '' %>"><%= p %></a>
              <% } %>
            </div>
          <% } %>
        </div>
      </div>

    </main>
  </div>
</div>

<!-- Custom Order Detail & Price Quote Modal -->
<div class="custom-modal-overlay" id="orderModalOverlay">
  <div class="custom-modal-card">
    <div style="padding: 1.4rem 1.6rem; border-bottom: 1px solid var(--admin-border); display: flex; justify-content: space-between; align-items: center;">
      <div>
        <h3 style="margin: 0; font-size: 1.25rem; color: var(--admin-text-dark);" id="modalReqNumber">Request Details</h3>
        <span style="font-size: 0.78rem; color: var(--admin-text-muted);" id="modalSubmittedDate"></span>
      </div>
      <button type="button" onclick="closeCustomOrderModal()" style="background: none; border: none; font-size: 1.3rem; color: var(--admin-text-muted); cursor: pointer;"><i class="fa-solid fa-xmark"></i></button>
    </div>

    <div style="padding: 1.6rem;">
      <!-- Customer Information Grid -->
      <div style="background: #FAF6F0; border-radius: 10px; padding: 1.2rem; margin-bottom: 1.4rem; border: 1px solid var(--admin-border);">
        <h4 style="margin: 0 0 10px; font-size: 0.95rem; color: var(--admin-primary); display: flex; align-items: center; gap: 6px;">
          <i class="fa-regular fa-user"></i> Customer Information
        </h4>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px; font-size: 0.85rem;">
          <div><strong style="color: var(--admin-text-muted);">Name:</strong> <span id="modalCustName" style="color: var(--admin-text-dark); font-weight: 600;"></span></div>
          <div><strong style="color: var(--admin-text-muted);">Email:</strong> <a id="modalCustEmail" href="#" style="color: var(--admin-primary);"></a></div>
          <div><strong style="color: var(--admin-text-muted);">Phone:</strong> <span id="modalCustPhone"></span></div>
          <div><strong style="color: var(--admin-text-muted);">Target Budget:</strong> <span id="modalCustBudget"></span></div>
          <div><strong style="color: var(--admin-text-muted);">Size / Hoop:</strong> <span id="modalCustSize"></span></div>
          <div><strong style="color: var(--admin-text-muted);">Formats:</strong> <span id="modalCustFormats"></span></div>
          <div><strong style="color: var(--admin-text-muted);">Deadline:</strong> <span id="modalCustDeadline"></span></div>
        </div>
      </div>

      <!-- Design Title & Description -->
      <div style="margin-bottom: 1.4rem;">
        <h4 style="margin: 0 0 6px; font-size: 0.92rem; color: var(--admin-text-dark);" id="modalDesignTitle"></h4>
        <div style="background: #FFF; border: 1px solid var(--admin-border); border-radius: 8px; padding: 12px; font-size: 0.86rem; color: #444; white-space: pre-wrap; line-height: 1.6;" id="modalDesignDesc"></div>
      </div>

      <!-- Reference Image -->
      <div id="modalImageSection" style="margin-bottom: 1.4rem; display: none;">
        <h4 style="margin: 0 0 8px; font-size: 0.9rem; color: var(--admin-text-dark);"><i class="fa-regular fa-image"></i> Reference Image</h4>
        <div style="display: flex; gap: 14px; align-items: center;">
          <img id="modalReferenceImg" src="" alt="Reference Preview" style="max-height: 120px; max-width: 180px; border-radius: 8px; border: 1px solid var(--admin-border); object-fit: cover;">
          <div>
            <a id="modalFullImageLink" href="#" target="_blank" class="btn btn-outline btn-sm"><i class="fa-solid fa-up-right-from-square"></i> Open Full Image</a>
          </div>
        </div>
      </div>

      <!-- Update Quote & Notes Form -->
      <form id="modalQuoteForm" method="POST" action="">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <h4 style="margin: 0 0 10px; font-size: 0.95rem; color: var(--admin-primary);"><i class="fa-solid fa-calculator"></i> Quote Price & Status</h4>
        
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 1rem;">
          <div class="form-group-field">
            <label style="font-size: 0.8rem; font-weight: 600; color: var(--admin-text-dark); margin-bottom: 4px; display: block;">Status</label>
            <select name="status" id="modalStatusSelect" style="width: 100%; height: 38px; border-radius: 8px; border: 1px solid var(--admin-border); padding: 0 10px; font-size: 0.85rem;">
              <option value="new">New</option>
              <option value="in_review">In Review</option>
              <option value="quoted">Quoted</option>
              <option value="accepted">Accepted</option>
              <option value="completed">Completed</option>
              <option value="rejected">Rejected</option>
            </select>
          </div>

          <div class="form-group-field">
            <label style="font-size: 0.8rem; font-weight: 600; color: var(--admin-text-dark); margin-bottom: 4px; display: block;">Quoted Price (INR ₹)</label>
            <input type="number" step="10" name="quoted_price" id="modalQuotedPriceInput" placeholder="e.g., 750" style="width: 100%; height: 38px; border-radius: 8px; border: 1px solid var(--admin-border); padding: 0 10px; font-size: 0.85rem;">
          </div>
        </div>

        <div class="form-group-field" style="margin-bottom: 1.2rem;">
          <label style="font-size: 0.8rem; font-weight: 600; color: var(--admin-text-dark); margin-bottom: 4px; display: block;">Admin Private Notes</label>
          <textarea name="admin_notes" id="modalAdminNotesInput" rows="3" placeholder="Internal digitizer notes, stitch count estimate, color changes..." style="width: 100%; border-radius: 8px; border: 1px solid var(--admin-border); padding: 8px 10px; font-size: 0.85rem;"></textarea>
        </div>

        <div style="display: flex; justify-content: space-between; align-items: center; border-top: 1px solid var(--admin-border); padding-top: 1rem;">
          <a id="modalMailtoBtn" href="#" class="btn btn-outline btn-sm"><i class="fa-regular fa-envelope"></i> Email Customer</a>
          <div style="display: flex; gap: 8px;">
            <button type="button" onclick="closeCustomOrderModal()" class="btn btn-outline btn-sm">Close</button>
            <button type="submit" class="btn btn-primary btn-sm"><i class="fa-solid fa-floppy-disk"></i> Save Quote & Notes</button>
          </div>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  function openCustomOrderModal(req) {
    if (!req) return;
    const reqNum = req.request_number || ('CR-LEGACY-' + req.id);
    document.getElementById('modalReqNumber').textContent = 'Request #' + reqNum;
    document.getElementById('modalSubmittedDate').textContent = 'Submitted on: ' + (req.created_at ? new Date(req.created_at).toLocaleString() : 'N/A');
    document.getElementById('modalCustName').textContent = req.name || req.full_name || 'Customer';
    
    const emailEl = document.getElementById('modalCustEmail');
    emailEl.textContent = req.email || 'N/A';
    emailEl.href = 'mailto:' + (req.email || '');

    document.getElementById('modalCustPhone').textContent = req.phone || 'N/A';
    document.getElementById('modalCustBudget').textContent = req.budget ? ('₹' + req.budget) : 'Not specified';
    document.getElementById('modalCustSize').textContent = req.size_hoop || 'Standard machine';
    document.getElementById('modalCustFormats').textContent = req.preferred_formats || 'DST, PES, JEF, EXP';
    document.getElementById('modalCustDeadline').textContent = req.deadline || 'Standard (24-48h)';

    document.getElementById('modalDesignTitle').textContent = req.design_title || 'Custom Design';
    document.getElementById('modalDesignDesc').textContent = req.description || req.design_details || 'No description provided.';

    // Image section
    const imgSection = document.getElementById('modalImageSection');
    const previewImg = document.getElementById('modalReferenceImg');
    const fullLink = document.getElementById('modalFullImageLink');
    if (req.reference_image_key || req.reference_image_url) {
      const previewUrl = '/admin/custom-orders/preview/' + req.id;
      previewImg.src = previewUrl;
      fullLink.href = previewUrl;
      imgSection.style.display = 'block';
    } else {
      imgSection.style.display = 'none';
    }

    // Form settings
    document.getElementById('modalQuoteForm').action = '/admin/custom-orders/quote/' + req.id;
    document.getElementById('modalStatusSelect').value = req.status || 'new';
    document.getElementById('modalQuotedPriceInput').value = req.quoted_price || '';
    document.getElementById('modalAdminNotesInput').value = req.admin_notes || '';

    // Mailto button
    const subject = encodeURIComponent('Regarding Your Custom Embroidery Request [' + reqNum + ']');
    const body = encodeURIComponent('Hello ' + (req.name || req.full_name || 'Customer') + ',\n\nRegarding your custom embroidery request (' + reqNum + '):\n\n');
    document.getElementById('modalMailtoBtn').href = 'mailto:' + (req.email || '') + '?subject=' + subject + '&body=' + body;

    document.getElementById('orderModalOverlay').style.display = 'flex';
  }

  function closeCustomOrderModal() {
    document.getElementById('orderModalOverlay').style.display = 'none';
  }

  function confirmDeleteCustomOrder(id) {
    if (confirm('Are you sure you want to delete this custom order request? This action cannot be undone.')) {
      const csrf = '<%= csrfToken %>';
      const form = document.createElement('form');
      form.method = 'POST';
      form.action = '/admin/custom-orders/delete/' + id;
      
      const csrfInput = document.createElement('input');
      csrfInput.type = 'hidden';
      csrfInput.name = '_csrf';
      csrfInput.value = csrf;
      form.appendChild(csrfInput);
      
      document.body.appendChild(form);
      form.submit();
    }
  }

  // Close modal on escape key
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closeCustomOrderModal();
  });
</script>

</body>
</html>
