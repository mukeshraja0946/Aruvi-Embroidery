<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="icon" type="image/x-icon" href="/public/assets/brand/favicon.ico">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;1,400&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="/public/css/main.css">
  <link rel="stylesheet" href="/public/css/admin.css">
  <style>
    .tools-stat-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 1.25rem;
      margin-bottom: 2rem;
    }
    .tools-stat-card {
      background: #FFFFFF;
      border: 1px solid var(--admin-border);
      border-radius: 12px;
      padding: 1.25rem;
      display: flex;
      align-items: center;
      gap: 1rem;
      box-shadow: 0 2px 8px rgba(0,0,0,0.03);
    }
    .tools-stat-icon {
      width: 48px;
      height: 48px;
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.25rem;
    }
    .tools-stat-icon.green { background: #E8F5E9; color: #2E7D32; }
    .tools-stat-icon.red { background: #FFEBEE; color: #C62828; }
    .tools-stat-icon.amber { background: #FFF8E1; color: #F57F17; }
    .tools-stat-icon.blue { background: #E3F2FD; color: #1565C0; }

    .tools-stat-data strong {
      display: block;
      font-size: 1.5rem;
      font-weight: 700;
      color: var(--admin-text-dark);
      line-height: 1.2;
    }
    .tools-stat-data span {
      font-size: 0.8rem;
      color: var(--admin-text-muted);
      font-weight: 500;
    }

    .badge-status-missing {
      background: #FFEBEE;
      color: #C62828;
      font-size: 0.72rem;
      font-weight: 700;
      padding: 0.3rem 0.6rem;
      border-radius: 6px;
      display: inline-flex;
      align-items: center;
      gap: 4px;
    }
    .badge-status-ok {
      background: #E8F5E9;
      color: #2E7D32;
      font-size: 0.72rem;
      font-weight: 700;
      padding: 0.3rem 0.6rem;
      border-radius: 6px;
      display: inline-flex;
      align-items: center;
      gap: 4px;
    }

    .quick-replace-btn {
      background: #FFFFFF;
      border: 1px solid var(--admin-border);
      color: var(--admin-text-dark);
      padding: 0.35rem 0.75rem;
      border-radius: 6px;
      font-size: 0.75rem;
      font-weight: 600;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 5px;
      transition: all 0.2s;
    }
    .quick-replace-btn:hover {
      border-color: var(--admin-primary);
      color: var(--admin-primary);
      background: #FAF6F0;
    }

    .modal-overlay {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.5);
      z-index: 9999;
      align-items: center;
      justify-content: center;
      backdrop-filter: blur(3px);
    }
    .modal-box {
      background: #FFFFFF;
      border-radius: 12px;
      width: 90%;
      max-width: 480px;
      padding: 1.75rem;
      box-shadow: 0 10px 30px rgba(0,0,0,0.2);
    }
  </style>
</head>
<body class="admin-body">

<div class="admin-wrapper">
  <!-- Top Header -->
  <header class="admin-top-header">
    <a href="/admin" class="admin-header-brand">
      <% const currentLogo = (typeof siteSettings !== 'undefined' && siteSettings.logo_url) ? siteSettings.logo_url : '/public/assets/brand/logo.png'; %>
      <img src="<%= currentLogo %>" alt="ARUVI Admin Logo" style="max-height: 42px; width: auto; object-fit: contain;">
    </a>

    <div class="admin-search-bar">
      <i class="fa-solid fa-magnifying-glass"></i>
      <input type="text" placeholder="Search missing files, designs, SKU...">
    </div>

    <div class="admin-header-right">
      <a href="/admin/tools/backup" class="admin-icon-btn" title="Backups & Storage">
        <i class="fa-solid fa-database"></i>
      </a>
      <div class="admin-user-menu">
        <div class="admin-user-avatar">A</div>
        <div class="admin-user-info">
          <strong>Admin</strong>
          <span>Administrator</span>
        </div>
      </div>
    </div>
  </header>

  <div class="admin-main-container">
    <!-- Sidebar -->
    <aside class="admin-sidebar">
      <ul class="sidebar-nav-list" style="margin-bottom: 1.2rem;">
        <li class="sidebar-nav-item">
          <a href="/admin">
            <span><i class="fa-solid fa-house"></i> Dashboard</span>
          </a>
        </li>
      </ul>

      <div class="admin-sidebar-section">
        <div class="sidebar-heading">DESIGNS</div>
        <ul class="sidebar-nav-list">
          <li class="sidebar-nav-item"><a href="/admin/designs"><span><i class="fa-solid fa-box-archive"></i> Manage Designs</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/designs/create"><span><i class="fa-solid fa-circle-plus"></i> Add New Design</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/categories"><span><i class="fa-solid fa-border-all"></i> Categories</span></a></li>
        </ul>
      </div>

      <div class="admin-sidebar-section">
        <div class="sidebar-heading">STORAGE & RECOVERY</div>
        <ul class="sidebar-nav-list">
          <li class="sidebar-nav-item"><a href="/admin/tools/missing-files" class="active"><span><i class="fa-solid fa-triangle-exclamation"></i> Missing Files Report</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/tools/bulk-image-relink"><span><i class="fa-solid fa-images"></i> Bulk Image Relink</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/tools/bulk-file-relink"><span><i class="fa-solid fa-file-zipper"></i> Bulk File Relink</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/tools/backup"><span><i class="fa-solid fa-database"></i> Backup & Health</span></a></li>
        </ul>
      </div>

      <div class="admin-sidebar-section">
        <div class="sidebar-heading">SYSTEM SETTINGS</div>
        <ul class="sidebar-nav-list">
          <li class="sidebar-nav-item"><a href="/admin/settings"><span><i class="fa-solid fa-gear"></i> Website Settings</span></a></li>
        </ul>
      </div>

      <div style="margin-top: auto; padding-top: 1rem; border-top: 1px solid var(--admin-border);">
        <a href="/admin/logout" style="display: flex; align-items: center; gap: 8px; color: var(--admin-primary); font-size: 0.85rem; font-weight: 600; text-decoration: none; padding: 0.5rem 0.8rem;">
          <i class="fa-solid fa-arrow-right-from-bracket"></i> Logout Admin
        </a>
      </div>
    </aside>

    <!-- Main Content -->
    <main class="admin-content-body">
      <% if (messages && messages.success) { %>
        <div class="alert alert-success" style="margin-bottom: 1.5rem; background: #E8F5E9; color: #2E7D32; padding: 1rem; border-radius: 8px; border: 1px solid #C8E6C9;">
          <i class="fa-solid fa-circle-check"></i> <%= messages.success %>
        </div>
      <% } %>
      <% if (messages && messages.error) { %>
        <div class="alert alert-danger" style="margin-bottom: 1.5rem; background: #FFEBEE; color: #C62828; padding: 1rem; border-radius: 8px; border: 1px solid #FFCDD2;">
          <i class="fa-solid fa-circle-exclamation"></i> <%= messages.error %>
        </div>
      <% } %>

      <!-- Page Header -->
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 1rem;">
        <div>
          <h1 style="font-size: 1.6rem; font-weight: 700; color: var(--admin-text-dark); margin: 0;">Missing Files & Storage Diagnostics</h1>
          <p style="color: var(--admin-text-muted); font-size: 0.85rem; margin-top: 4px;">
            Scans all <%= scan.totalDesigns %> database designs against persistent storage to identify missing preview images or machine archives.
          </p>
        </div>
        <div style="display: flex; gap: 0.6rem; flex-wrap: wrap;">
          <a href="/admin/tools/missing-files/export-csv" class="btn btn-outline" style="font-size: 0.85rem; padding: 0.55rem 1rem; border-radius: 8px; text-decoration: none; display: inline-flex; align-items: center; gap: 6px;">
            <i class="fa-solid fa-file-csv"></i> Export CSV Report
          </a>
          <a href="/admin/tools/bulk-image-relink" class="btn btn-primary" style="font-size: 0.85rem; padding: 0.55rem 1rem; border-radius: 8px; text-decoration: none; display: inline-flex; align-items: center; gap: 6px;">
            <i class="fa-solid fa-images"></i> Bulk Image Relink
          </a>
          <a href="/admin/tools/bulk-file-relink" class="btn btn-primary" style="font-size: 0.85rem; padding: 0.55rem 1rem; border-radius: 8px; text-decoration: none; display: inline-flex; align-items: center; gap: 6px;">
            <i class="fa-solid fa-file-zipper"></i> Bulk File Relink
          </a>
        </div>
      </div>

      <!-- Stat Cards -->
      <div class="tools-stat-grid">
        <div class="tools-stat-card">
          <div class="tools-stat-icon blue"><i class="fa-solid fa-boxes-stacked"></i></div>
          <div class="tools-stat-data">
            <strong><%= scan.totalDesigns %></strong>
            <span>Total Catalog Designs</span>
          </div>
        </div>

        <div class="tools-stat-card">
          <div class="tools-stat-icon green"><i class="fa-solid fa-circle-check"></i></div>
          <div class="tools-stat-data">
            <strong><%= scan.healthyDesignsCount %></strong>
            <span>Healthy Products (100% OK)</span>
          </div>
        </div>

        <div class="tools-stat-card">
          <div class="tools-stat-icon amber"><i class="fa-regular fa-image"></i></div>
          <div class="tools-stat-data">
            <strong><%= scan.missingImagesCount %></strong>
            <span>Missing Preview Images</span>
          </div>
        </div>

        <div class="tools-stat-card">
          <div class="tools-stat-icon red"><i class="fa-solid fa-file-circle-xmark"></i></div>
          <div class="tools-stat-data">
            <strong><%= scan.missingFilesCount %></strong>
            <span>Missing Machine Files</span>
          </div>
        </div>
      </div>

      <!-- Filters & Report Table -->
      <div style="background: #FFFFFF; border: 1px solid var(--admin-border); border-radius: 12px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.03);">
        <div style="padding: 1rem 1.25rem; border-bottom: 1px solid var(--admin-border); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem;">
          <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
            <a href="/admin/tools/missing-files?filter=all" class="btn <%= currentFilter === 'all' ? 'btn-primary' : 'btn-outline' %>" style="font-size: 0.8rem; padding: 0.4rem 0.8rem; border-radius: 6px; text-decoration: none;">
              All Issues (<%= scan.totalIssues %>)
            </a>
            <a href="/admin/tools/missing-files?filter=missing_image" class="btn <%= currentFilter === 'missing_image' ? 'btn-primary' : 'btn-outline' %>" style="font-size: 0.8rem; padding: 0.4rem 0.8rem; border-radius: 6px; text-decoration: none;">
              Missing Images Only
            </a>
            <a href="/admin/tools/missing-files?filter=missing_file" class="btn <%= currentFilter === 'missing_file' ? 'btn-primary' : 'btn-outline' %>" style="font-size: 0.8rem; padding: 0.4rem 0.8rem; border-radius: 6px; text-decoration: none;">
              Missing Machine Files Only
            </a>
            <a href="/admin/tools/missing-files?filter=missing_both" class="btn <%= currentFilter === 'missing_both' ? 'btn-primary' : 'btn-outline' %>" style="font-size: 0.8rem; padding: 0.4rem 0.8rem; border-radius: 6px; text-decoration: none;">
              Missing Both (<%= scan.missingBothCount %>)
            </a>
          </div>

          <span style="font-size: 0.8rem; color: var(--admin-text-muted);">
            Scan completed: <%= new Date(scan.scanTime).toLocaleString() %>
          </span>
        </div>

        <% if (designs.length === 0) { %>
          <div style="text-align: center; padding: 3.5rem 1.5rem;">
            <div style="width: 64px; height: 64px; background: #E8F5E9; color: #2E7D32; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; font-size: 2rem; margin-bottom: 1rem;">
              <i class="fa-solid fa-circle-check"></i>
            </div>
            <h3 style="font-size: 1.25rem; font-weight: 700; color: var(--admin-text-dark); margin-bottom: 0.5rem;">Storage System 100% Healthy!</h3>
            <p style="color: var(--admin-text-muted); font-size: 0.9rem; max-width: 480px; margin: 0 auto;">
              All <%= scan.totalDesigns %> designs have verified persistent images and authentic machine archives intact on disk.
            </p>
          </div>
        <% } else { %>
          <div style="overflow-x: auto;">
            <table class="admin-table" style="width: 100%; border-collapse: collapse; font-size: 0.85rem;">
              <thead>
                <tr style="background: #F9FAFB; border-bottom: 1px solid var(--admin-border); text-align: left;">
                  <th style="padding: 0.75rem 1rem;">Design</th>
                  <th style="padding: 0.75rem 1rem;">SKU / Code</th>
                  <th style="padding: 0.75rem 1rem;">Category</th>
                  <th style="padding: 0.75rem 1rem;">Preview Image</th>
                  <th style="padding: 0.75rem 1rem;">Machine File</th>
                  <th style="padding: 0.75rem 1rem; text-align: right;">Action</th>
                </tr>
              </thead>
              <tbody>
                <% designs.forEach(d => { %>
                  <tr style="border-bottom: 1px solid var(--admin-border);">
                    <td style="padding: 0.75rem 1rem;">
                      <div style="display: flex; align-items: center; gap: 0.75rem;">
                        <div style="width: 40px; height: 40px; border-radius: 6px; background: #F3F4F6; display: flex; align-items: center; justify-content: center; overflow: hidden; border: 1px solid var(--admin-border);">
                          <% if (d.image_missing || !d.image_url) { %>
                            <i class="fa-regular fa-image" style="color: #9CA3AF; font-size: 1.2rem;"></i>
                          <% } else { %>
                            <img src="<%= d.image_url %>" alt="" style="width: 100%; height: 100%; object-fit: cover;">
                          <% } %>
                        </div>
                        <div>
                          <strong><%= d.title %></strong>
                          <div style="font-size: 0.75rem; color: var(--admin-text-muted);">ID: #<%= d.id %> • ₹<%= d.price %></div>
                        </div>
                      </div>
                    </td>
                    <td style="padding: 0.75rem 1rem; font-weight: 600; color: var(--admin-primary);"><%= d.sku %></td>
                    <td style="padding: 0.75rem 1rem; color: var(--admin-text-muted);"><%= d.category_name %></td>
                    <td style="padding: 0.75rem 1rem;">
                      <% if (d.image_missing) { %>
                        <span class="badge-status-missing"><i class="fa-solid fa-triangle-exclamation"></i> MISSING</span>
                        <button type="button" class="quick-replace-btn" style="margin-left: 6px;" onclick="openReplaceModal(<%= d.id %>, '<%= d.sku %>', 'image')">
                          <i class="fa-solid fa-upload"></i> Upload
                        </button>
                      <% } else { %>
                        <span class="badge-status-ok"><i class="fa-solid fa-check"></i> OK</span>
                      <% } %>
                    </td>
                    <td style="padding: 0.75rem 1rem;">
                      <% if (d.file_missing) { %>
                        <span class="badge-status-missing"><i class="fa-solid fa-triangle-exclamation"></i> MISSING</span>
                        <button type="button" class="quick-replace-btn" style="margin-left: 6px;" onclick="openReplaceModal(<%= d.id %>, '<%= d.sku %>', 'file')">
                          <i class="fa-solid fa-upload"></i> Upload
                        </button>
                      <% } else { %>
                        <span class="badge-status-ok"><i class="fa-solid fa-check"></i> OK</span>
                        <span style="font-size: 0.72rem; color: var(--admin-text-muted); margin-left: 4px;"><%= d.file_name %></span>
                      <% } %>
                    </td>
                    <td style="padding: 0.75rem 1rem; text-align: right;">
                      <a href="/admin/designs/edit/<%= d.id %>" class="quick-replace-btn" style="text-decoration: none;">
                        <i class="fa-regular fa-pen-to-square"></i> Edit
                      </a>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
    </main>
  </div>
</div>

<!-- Modal: Quick File Replacement -->
<div id="quickReplaceModal" class="modal-overlay">
  <div class="modal-box">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem;">
      <h3 id="modalTitle" style="font-size: 1.15rem; font-weight: 700; color: var(--admin-text-dark); margin: 0;">Replace File</h3>
      <button type="button" onclick="closeReplaceModal()" style="background: none; border: none; font-size: 1.2rem; cursor: pointer; color: var(--admin-text-muted);">&times;</button>
    </div>

    <form id="quickReplaceForm" enctype="multipart/form-data">
      <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
      <input type="hidden" id="modalDesignId" name="designId">
      <input type="hidden" id="modalReplaceType" name="replaceType">

      <p id="modalSubtitle" style="font-size: 0.85rem; color: var(--admin-text-muted); margin-bottom: 1.25rem;"></p>

      <div style="margin-bottom: 1.25rem;">
        <label id="fileInputLabel" style="display: block; font-size: 0.82rem; font-weight: 600; margin-bottom: 0.4rem;">Select New File:</label>
        <input type="file" id="modalFileInput" name="file" required style="width: 100%; padding: 0.6rem; border: 1px dashed var(--admin-border); border-radius: 8px;">
      </div>

      <div style="display: flex; justify-content: flex-end; gap: 0.75rem;">
        <button type="button" class="btn btn-outline" onclick="closeReplaceModal()" style="font-size: 0.85rem; padding: 0.5rem 1rem;">Cancel</button>
        <button type="submit" id="modalSubmitBtn" class="btn btn-primary" style="font-size: 0.85rem; padding: 0.5rem 1.2rem;">
          <i class="fa-solid fa-cloud-arrow-up"></i> Upload & Relink
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  function openReplaceModal(designId, sku, type) {
    document.getElementById('modalDesignId').value = designId;
    document.getElementById('modalReplaceType').value = type;
    const modal = document.getElementById('quickReplaceModal');
    const title = document.getElementById('modalTitle');
    const sub = document.getElementById('modalSubtitle');
    const fileInput = document.getElementById('modalFileInput');

    if (type === 'image') {
      title.innerText = 'Upload Product Preview Image';
      sub.innerText = `Replacing missing image for Design SKU: ${sku} (#${designId})`;
      fileInput.accept = '.jpg,.jpeg,.png,.webp,.avif';
    } else {
      title.innerText = 'Upload Machine Design File';
      sub.innerText = `Replacing missing design archive for Design SKU: ${sku} (#${designId})`;
      fileInput.accept = '.dst,.pes,.jef,.exp,.zip,.rar';
    }

    modal.style.display = 'flex';
  }

  function closeReplaceModal() {
    document.getElementById('quickReplaceModal').style.display = 'none';
  }

  document.getElementById('quickReplaceForm').addEventListener('submit', async function(e) {
    e.preventDefault();
    const btn = document.getElementById('modalSubmitBtn');
    btn.disabled = true;
    btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Uploading...';

    const formData = new FormData(this);
    try {
      const res = await fetch('/admin/tools/replace-file-quick', {
        method: 'POST',
        body: formData
      });
      const data = await res.json();
      if (data.success) {
        alert(data.message);
        window.location.reload();
      } else {
        alert('Upload Error: ' + (data.message || 'Failed to replace file'));
        btn.disabled = false;
        btn.innerHTML = '<i class="fa-solid fa-cloud-arrow-up"></i> Upload & Relink';
      }
    } catch (err) {
      alert('Network error while replacing file: ' + err.message);
      btn.disabled = false;
      btn.innerHTML = '<i class="fa-solid fa-cloud-arrow-up"></i> Upload & Relink';
    }
  });
</script>
</body>
</html>
