<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="icon" type="image/x-icon" href="/public/assets/brand/favicon.ico">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;1,400&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="/public/css/main.css">
  <link rel="stylesheet" href="/public/css/admin.css">
  <style>
    .backup-info-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 1.25rem;
      margin-bottom: 2rem;
    }
    .backup-info-card {
      background: #FFFFFF;
      border: 1px solid var(--admin-border);
      border-radius: 12px;
      padding: 1.25rem;
      box-shadow: 0 2px 8px rgba(0,0,0,0.03);
    }
  </style>
</head>
<body class="admin-body">

<div class="admin-wrapper">
  <!-- Top Header -->
  <header class="admin-top-header">
    <a href="/admin" class="admin-header-brand">
      <% const currentLogo = (typeof siteSettings !== 'undefined' && siteSettings.logo_url) ? siteSettings.logo_url : '/public/assets/brand/logo.png'; %>
      <img src="<%= currentLogo %>" alt="ARUVI Admin Logo" style="max-height: 42px; width: auto; object-fit: contain;">
    </a>

    <div class="admin-search-bar">
      <i class="fa-solid fa-magnifying-glass"></i>
      <input type="text" placeholder="Search backups...">
    </div>

    <div class="admin-header-right">
      <a href="/admin/tools/missing-files" class="admin-icon-btn" title="Missing Files">
        <i class="fa-solid fa-triangle-exclamation"></i>
      </a>
      <div class="admin-user-menu">
        <div class="admin-user-avatar">A</div>
        <div class="admin-user-info">
          <strong>Admin</strong>
          <span>Administrator</span>
        </div>
      </div>
    </div>
  </header>

  <div class="admin-main-container">
    <!-- Sidebar -->
    <aside class="admin-sidebar">
      <ul class="sidebar-nav-list" style="margin-bottom: 1.2rem;">
        <li class="sidebar-nav-item">
          <a href="/admin">
            <span><i class="fa-solid fa-house"></i> Dashboard</span>
          </a>
        </li>
      </ul>

      <div class="admin-sidebar-section">
        <div class="sidebar-heading">DESIGNS</div>
        <ul class="sidebar-nav-list">
          <li class="sidebar-nav-item"><a href="/admin/designs"><span><i class="fa-solid fa-box-archive"></i> Manage Designs</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/designs/create"><span><i class="fa-solid fa-circle-plus"></i> Add New Design</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/categories"><span><i class="fa-solid fa-border-all"></i> Categories</span></a></li>
        </ul>
      </div>

      <div class="admin-sidebar-section">
        <div class="sidebar-heading">STORAGE & RECOVERY</div>
        <ul class="sidebar-nav-list">
          <li class="sidebar-nav-item"><a href="/admin/tools/system-health"><span><i class="fa-solid fa-heart-pulse"></i> System Health</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/tools/missing-files"><span><i class="fa-solid fa-triangle-exclamation"></i> Missing Files Report</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/tools/bulk-image-relink"><span><i class="fa-solid fa-images"></i> Bulk Image Relink</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/tools/bulk-file-relink"><span><i class="fa-solid fa-file-zipper"></i> Bulk File Relink</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/tools/backup" class="active"><span><i class="fa-solid fa-database"></i> Backup & Storage</span></a></li>
        </ul>
      </div>

      <div class="admin-sidebar-section">
        <div class="sidebar-heading">SYSTEM SETTINGS</div>
        <ul class="sidebar-nav-list">
          <li class="sidebar-nav-item"><a href="/admin/settings"><span><i class="fa-solid fa-gear"></i> Website Settings</span></a></li>
        </ul>
      </div>

      <div style="margin-top: auto; padding-top: 1rem; border-top: 1px solid var(--admin-border);">
        <a href="/admin/logout" style="display: flex; align-items: center; gap: 8px; color: var(--admin-primary); font-size: 0.85rem; font-weight: 600; text-decoration: none; padding: 0.5rem 0.8rem;">
          <i class="fa-solid fa-arrow-right-from-bracket"></i> Logout Admin
        </a>
      </div>
    </aside>

    <!-- Main Content Body -->
    <main class="admin-content-body">
      <% 
        const alertSuccess = (typeof flash !== 'undefined' && flash.success && flash.success.length ? flash.success[0] : null) || (typeof messages !== 'undefined' && messages.success ? messages.success : null);
        const alertError = (typeof flash !== 'undefined' && flash.error && flash.error.length ? flash.error[0] : null) || (typeof messages !== 'undefined' && messages.error ? messages.error : null);
      %>
      <% if (alertSuccess) { %>
        <div class="alert alert-success" style="margin-bottom: 1.5rem; background: #E8F5E9; color: #2E7D32; padding: 1rem; border-radius: 8px; border: 1px solid #C8E6C9;">
          <i class="fa-solid fa-circle-check"></i> <%= alertSuccess %>
        </div>
      <% } %>
      <% if (alertError) { %>
        <div class="alert alert-danger" style="margin-bottom: 1.5rem; background: #FFEBEE; color: #C62828; padding: 1rem; border-radius: 8px; border: 1px solid #FFCDD2;">
          <i class="fa-solid fa-circle-exclamation"></i> <%= alertError %>
        </div>
      <% } %>

      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.75rem; flex-wrap: wrap; gap: 1rem;">
        <div>
          <h1 style="font-size: 1.6rem; font-weight: 700; color: var(--admin-text-dark); margin: 0;">System Backups & Storage Architecture</h1>
          <p style="color: var(--admin-text-muted); font-size: 0.85rem; margin-top: 4px;">
            One-click database export + uploads archive. Never lose products, images, or customer orders during deployment.
          </p>
        </div>

        <form action="/admin/tools/backup/run" method="POST">
          <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
          <button type="submit" class="btn btn-primary" style="font-size: 0.9rem; padding: 0.65rem 1.4rem; border-radius: 8px; display: inline-flex; align-items: center; gap: 6px;">
            <i class="fa-solid fa-cloud-arrow-down"></i> Create New Full Backup Now
          </button>
        </form>
      </div>

      <!-- Storage Configuration Info -->
      <div class="backup-info-grid">
        <div class="backup-info-card">
          <span style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1px; color: var(--admin-text-muted); font-weight: 700;">ACTIVE STORAGE DRIVER</span>
          <div style="font-size: 1.25rem; font-weight: 700; color: var(--admin-primary); margin-top: 4px; display: flex; align-items: center; gap: 8px;">
            <i class="fa-solid fa-hard-drive"></i> <%= storageDriver.toUpperCase() %>
          </div>
          <small style="display: block; color: var(--admin-text-muted); margin-top: 4px; font-size: 0.75rem;">
            Configured via <code>STORAGE_DRIVER</code> in <code>.env</code>
          </small>
        </div>

        <div class="backup-info-card">
          <span style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1px; color: var(--admin-text-muted); font-weight: 700;">UPLOADS VOLUME PATH</span>
          <div style="font-size: 0.95rem; font-weight: 600; color: var(--admin-text-dark); margin-top: 6px; word-break: break-all; font-family: monospace;">
            <%= uploadsDir %>
          </div>
          <small style="display: block; color: #2E7D32; margin-top: 4px; font-size: 0.75rem; font-weight: 600;">
            ✓ Persistent directory independent of Git
          </small>
        </div>

        <div class="backup-info-card">
          <span style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1px; color: var(--admin-text-muted); font-weight: 700;">INTEGRITY HEALTH</span>
          <div style="font-size: 1.25rem; font-weight: 700; margin-top: 4px; color: <%= health.healthy ? '#2E7D32' : '#C62828' %>;">
            <%= health.healthy ? '100% HEALTHY' : health.totalIssues + ' ISSUES FOUND' %>
          </div>
          <small style="display: block; color: var(--admin-text-muted); margin-top: 4px; font-size: 0.75rem;">
            <a href="/admin/tools/missing-files" style="color: var(--admin-primary); text-decoration: none; font-weight: 600;">View Missing Files Report →</a>
          </small>
        </div>
      </div>

      <!-- Backups List Table -->
      <div style="background: #FFFFFF; border: 1px solid var(--admin-border); border-radius: 12px; overflow: hidden; margin-bottom: 2rem; box-shadow: 0 2px 8px rgba(0,0,0,0.03);">
        <div style="padding: 1rem 1.25rem; border-bottom: 1px solid var(--admin-border); display: flex; justify-content: space-between; align-items: center;">
          <h2 style="font-size: 1.1rem; font-weight: 700; color: var(--admin-text-dark); margin: 0;">
            Saved Backup Archives (<%= backups.length %>)
          </h2>
          <span style="font-size: 0.78rem; color: var(--admin-text-muted);">
            Auto-prunes backups older than 30 days
          </span>
        </div>

        <% if (backups.length === 0) { %>
          <div style="text-align: center; padding: 3rem 1.5rem;">
            <div style="width: 54px; height: 54px; background: #F3F4F6; color: var(--admin-text-muted); border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; font-size: 1.5rem; margin-bottom: 0.75rem;">
              <i class="fa-solid fa-box-open"></i>
            </div>
            <p style="color: var(--admin-text-muted); font-size: 0.9rem; margin: 0;">No backup archives generated yet. Click "Create New Full Backup Now" above.</p>
          </div>
        <% } else { %>
          <table style="width: 100%; border-collapse: collapse; font-size: 0.85rem;">
            <thead>
              <tr style="background: #F9FAFB; border-bottom: 1px solid var(--admin-border); text-align: left;">
                <th style="padding: 0.75rem 1rem;">Archive Filename</th>
                <th style="padding: 0.75rem 1rem;">Type</th>
                <th style="padding: 0.75rem 1rem;">Size</th>
                <th style="padding: 0.75rem 1rem;">Created At</th>
                <th style="padding: 0.75rem 1rem; text-align: right;">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% backups.forEach(b => { %>
                <% const isSql = b.filename.endsWith('.sql'); %>
                <% const isCsv = b.filename.endsWith('.csv'); %>
                <% const isZip = b.filename.endsWith('.zip'); %>
                <tr style="border-bottom: 1px solid var(--admin-border);">
                  <td style="padding: 0.75rem 1rem; font-family: monospace; font-weight: 600;">
                    <i class="fa-solid fa-<%= isSql ? 'database' : (isCsv ? 'file-csv' : 'file-zipper') %>" style="color: <%= isSql ? '#2563EB' : (isCsv ? '#059669' : 'var(--admin-primary)') %>; margin-right: 6px;"></i>
                    <%= b.filename %>
                  </td>
                  <td style="padding: 0.75rem 1rem;">
                    <span style="font-size: 0.72rem; padding: 2px 7px; border-radius: 4px; font-weight: 700; text-transform: uppercase; background: <%= isSql ? '#EFF6FF' : (isCsv ? '#ECFDF5' : '#FFF1F2') %>; color: <%= isSql ? '#1D4ED8' : (isCsv ? '#047857' : '#BE123C') %>;">
                      <%= isSql ? 'SQL Dump' : (isCsv ? 'CSV Export' : 'Full ZIP') %>
                    </span>
                  </td>
                  <td style="padding: 0.75rem 1rem; color: var(--admin-text-dark); font-weight: 600;"><%= b.sizeMb %> MB</td>
                  <td style="padding: 0.75rem 1rem; color: var(--admin-text-muted);"><%= new Date(b.createdAt).toLocaleString() %></td>
                  <td style="padding: 0.75rem 1rem; text-align: right;">
                    <div style="display: inline-flex; align-items: center; gap: 6px;">
                      <a href="/admin/tools/backup/download/<%= b.filename %>" class="btn btn-outline" style="font-size: 0.75rem; padding: 0.35rem 0.75rem; border-radius: 6px; text-decoration: none; display: inline-flex; align-items: center; gap: 4px;">
                        <i class="fa-solid fa-download"></i> Download
                      </a>
                      <% if (isSql) { %>
                        <button type="button" onclick="openRestoreModal('<%= b.filename %>')" class="btn btn-outline" style="font-size: 0.75rem; padding: 0.35rem 0.75rem; border-radius: 6px; color: #2563EB; border-color: #93C5FD; background: #EFF6FF; cursor: pointer; display: inline-flex; align-items: center; gap: 4px;">
                          <i class="fa-solid fa-clock-rotate-left"></i> Restore
                        </button>
                      <% } %>
                    </div>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        <% } %>
      </div>

      <!-- Automated Daily Cron Guide -->
      <div style="background: #FAF9F6; border: 1px solid var(--admin-border); border-radius: 12px; padding: 1.5rem;">
        <h3 style="font-size: 1rem; font-weight: 700; color: var(--admin-text-dark); margin-bottom: 0.5rem; display: flex; align-items: center; gap: 8px;">
          <i class="fa-solid fa-clock"></i> Automated Daily Backup Schedule (Cron)
        </h3>
        <p style="font-size: 0.85rem; color: var(--admin-text-muted); margin-bottom: 0.75rem;">
          To ensure backups run automatically every midnight without manual intervention, configure this cron job on your production server:
        </p>
        <div style="background: #2D3748; color: #E2E8F0; padding: 0.75rem 1rem; border-radius: 6px; font-family: monospace; font-size: 0.85rem; overflow-x: auto;">
          0 2 * * * cd /var/www/aruvi-embroidery && npm run backup >> /var/log/aruvi-backup.log 2>&1
        </div>
        <small style="display: block; color: var(--admin-text-muted); margin-top: 6px; font-size: 0.75rem;">
          Runs at 02:00 AM every night, exports the database, archives uploads, and keeps the last 30 days of archives.
        </small>
      </div>
    </main>
  </div>
</div>

<!-- Restore Confirmation Modal -->
<div id="restoreModal" style="display: none; position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(15, 23, 42, 0.65); backdrop-filter: blur(4px); z-index: 999999; align-items: center; justify-content: center; padding: 1.5rem;">
  <div style="background: #FFFFFF; border-radius: 14px; max-width: 480px; width: 100%; padding: 1.5rem; box-shadow: 0 20px 45px rgba(0,0,0,0.2); border: 1px solid var(--admin-border);">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
      <h3 style="margin: 0; font-size: 1.15rem; font-weight: 700; color: var(--admin-text-dark); display: flex; align-items: center; gap: 8px;">
        <i class="fa-solid fa-clock-rotate-left" style="color: #2563EB;"></i>
        Restore Database from Backup
      </h3>
      <button type="button" onclick="closeRestoreModal()" style="background: none; border: none; font-size: 1.5rem; color: var(--admin-text-muted); cursor: pointer;">&times;</button>
    </div>

    <p style="font-size: 0.84rem; color: var(--admin-text-muted); line-height: 1.5; margin-bottom: 1rem;">
      Restoring from this backup will overwrite current table data with the snapshot in:
      <br><code id="restoreFilenameDisplay" style="font-weight: 700; color: var(--admin-primary); word-break: break-all;"></code>
    </p>

    <form action="/admin/tools/backup/restore" method="POST">
      <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
      <input type="hidden" id="restoreFilenameInput" name="filename" value="">

      <div style="margin-bottom: 1.25rem;">
        <label style="display: block; font-size: 0.84rem; font-weight: 600; color: var(--admin-text-dark); margin-bottom: 4px;">
          Enter Admin Password to Authorize Restore:
        </label>
        <input type="password" name="password" required class="form-control" style="width: 100%; padding: 0.6rem 0.8rem; border-radius: 8px; border: 1px solid var(--admin-border);" placeholder="Your password">
      </div>

      <div style="display: flex; justify-content: flex-end; gap: 10px;">
        <button type="button" onclick="closeRestoreModal()" class="btn btn-outline" style="padding: 0.5rem 1rem;">Cancel</button>
        <button type="submit" class="btn btn-primary" style="background: #2563EB; border-color: #2563EB; padding: 0.5rem 1.2rem;">
          <i class="fa-solid fa-rotate-left"></i> Confirm Restore
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  function openRestoreModal(filename) {
    document.getElementById('restoreFilenameDisplay').textContent = filename;
    document.getElementById('restoreFilenameInput').value = filename;
    document.getElementById('restoreModal').style.display = 'flex';
  }
  function closeRestoreModal() {
    document.getElementById('restoreModal').style.display = 'none';
  }
</script>

</body>
</html>
