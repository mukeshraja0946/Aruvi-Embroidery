<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Customer Reviews - ARUVI Admin</title>
  <link rel="icon" type="image/jpeg" href="/public/images/logo.jpg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;1,400&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="/public/css/main.css">
  <link rel="stylesheet" href="/public/css/admin.css">
  <style>
    .action-icon-btn {
      width: 32px; height: 32px; border-radius: 8px; border: 1px solid var(--admin-border); background: #FFFFFF; color: var(--admin-text-dark); display: inline-flex; align-items: center; justify-content: center; font-size: 0.82rem; text-decoration: none; transition: var(--transition);
    }
    .action-icon-btn:hover { border-color: var(--admin-primary); color: var(--admin-primary); background: #FAF6F0; }
    .star-rating { color: #FFA000; font-size: 0.85rem; letter-spacing: 2px; }
  </style>
</head>
<body class="admin-body">

<div class="admin-wrapper">
  <!-- Top Header -->
  <header class="admin-top-header">
    <a href="/admin" class="admin-header-brand">
      <% const currentLogo = (typeof siteSettings !== 'undefined' && siteSettings.logo_url) ? siteSettings.logo_url : '/public/images/logo.jpg'; %>
      <img src="<%= currentLogo %>" alt="ARUVI Admin Logo" style="max-height: 42px; width: auto; object-fit: contain;">
    </a>

    <!-- Global Search -->
    <div class="admin-search-bar">
      <i class="fa-solid fa-magnifying-glass"></i>
      <input type="text" placeholder="Search designs, orders, customers...">
    </div>

    <!-- Right User Header Icons -->
    <div class="admin-header-right">
      <a href="/admin/messages" class="admin-icon-btn" title="Enquiries">
        <i class="fa-regular fa-bell"></i>
        <% if (typeof adminNavBadges !== 'undefined' && adminNavBadges.unreadMessages > 0) { %>
          <span class="badge-count"><%= adminNavBadges.unreadMessages %></span>
        <% } %>
      </a>

      <div class="admin-user-menu">
        <div class="admin-user-avatar">A</div>
        <div class="admin-user-info">
          <strong>Admin</strong>
          <span>Administrator</span>
        </div>
        <i class="fa-solid fa-chevron-down" style="font-size: 0.75rem; color: var(--admin-text-muted); margin-left: 4px;"></i>
      </div>
    </div>
  </header>

  <!-- Admin Main Layout with Sidebar -->
  <div class="admin-main-container">
    <!-- Left Sidebar -->
    <aside class="admin-sidebar">
      <ul class="sidebar-nav-list" style="margin-bottom: 1.2rem;">
        <li class="sidebar-nav-item">
          <a href="/admin">
            <span><i class="fa-solid fa-house"></i> Dashboard</span>
          </a>
        </li>
      </ul>

      <!-- DESIGNS Section -->
      <div class="admin-sidebar-section">
        <div class="sidebar-heading">DESIGNS</div>
        <ul class="sidebar-nav-list">
          <li class="sidebar-nav-item"><a href="/admin/designs"><span><i class="fa-solid fa-box-archive"></i> Manage Designs</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/designs/create"><span><i class="fa-solid fa-circle-plus"></i> Add New Design</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/categories"><span><i class="fa-solid fa-border-all"></i> Categories</span></a></li>
          <li class="sidebar-nav-item">
            <a href="/admin/custom-orders">
              <span><i class="fa-solid fa-wand-magic-sparkles"></i> Custom Orders</span>
              <% if (typeof adminNavBadges !== 'undefined' && adminNavBadges.pendingCustomOrders > 0) { %>
                <span class="sidebar-badge"><%= adminNavBadges.pendingCustomOrders %></span>
              <% } %>
            </a>
          </li>
        </ul>
      </div>

      <!-- ORDERS Section -->
      <div class="admin-sidebar-section">
        <div class="sidebar-heading">ORDERS</div>
        <ul class="sidebar-nav-list">
          <li class="sidebar-nav-item"><a href="/admin/orders"><span><i class="fa-regular fa-newspaper"></i> All Orders</span></a></li>
          <li class="sidebar-nav-item">
            <a href="/admin/orders?status=pending">
              <span><i class="fa-regular fa-clock"></i> Pending Orders</span>
              <% if (typeof adminNavBadges !== 'undefined' && adminNavBadges.pendingOrders > 0) { %>
                <span class="sidebar-badge"><%= adminNavBadges.pendingOrders %></span>
              <% } %>
            </a>
          </li>
          <li class="sidebar-nav-item"><a href="/admin/orders?status=completed"><span><i class="fa-regular fa-circle-check"></i> Completed Orders</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/orders?status=cancelled"><span><i class="fa-regular fa-circle-xmark"></i> Cancelled Orders</span></a></li>
        </ul>
      </div>

      <!-- CUSTOMERS Section -->
      <div class="admin-sidebar-section">
        <div class="sidebar-heading">CUSTOMERS</div>
        <ul class="sidebar-nav-list">
          <li class="sidebar-nav-item"><a href="/admin/customers"><span><i class="fa-solid fa-users"></i> All Customers</span></a></li>
          <li class="sidebar-nav-item">
            <a href="/admin/messages">
              <span><i class="fa-regular fa-comment-dots"></i> Enquiries</span>
              <% if (typeof adminNavBadges !== 'undefined' && adminNavBadges.unreadMessages > 0) { %>
                <span class="sidebar-badge"><%= adminNavBadges.unreadMessages %></span>
              <% } %>
            </a>
          </li>
          <li class="sidebar-nav-item"><a href="/admin/reviews" class="active"><span><i class="fa-regular fa-star"></i> Reviews</span></a></li>
        </ul>
      </div>

      <!-- CONTENT Section -->
      <div class="admin-sidebar-section">
        <div class="sidebar-heading">CONTENT</div>
        <ul class="sidebar-nav-list">
          <li class="sidebar-nav-item"><a href="/admin/homepage"><span><i class="fa-solid fa-house-chimney"></i> Homepage</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/banners"><span><i class="fa-regular fa-image"></i> Banners</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/coupons"><span><i class="fa-solid fa-ticket"></i> Coupons</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/settings"><span><i class="fa-solid fa-gear"></i> Website Settings</span></a></li>
        </ul>
      </div>

      <div style="margin-top: auto; padding-top: 1rem; border-top: 1px solid var(--admin-border);">
        <a href="/admin/logout" style="display: flex; align-items: center; gap: 8px; color: var(--admin-primary); font-size: 0.85rem; font-weight: 600; text-decoration: none; padding: 0.5rem 0.8rem;">
          <i class="fa-solid fa-arrow-right-from-bracket"></i> Logout Admin
        </a>
      </div>
    </aside>

    <!-- Main Content Body -->
    <main class="admin-content-body">

      <!-- Breadcrumbs & Header -->
      <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1.8rem;">
        <div>
          <div style="font-size: 0.8rem; color: var(--admin-text-muted); margin-bottom: 0.4rem;">
            <a href="/admin" style="color: var(--admin-text-muted); text-decoration: none;">Dashboard</a> &nbsp;>&nbsp; <span style="color: var(--admin-primary); font-weight: 600;">Reviews</span>
          </div>
          <h1 style="font-family: var(--font-heading); font-size: 2.2rem; font-weight: 700; color: var(--admin-text-dark); margin: 0 0 0.3rem;">Customer Reviews</h1>
          <p style="font-size: 0.88rem; color: var(--admin-text-muted); margin: 0;">Moderate and manage real customer feedback on embroidery designs.</p>
        </div>
      </div>

      <% if (flash && flash.success && flash.success.length > 0) { %>
        <div class="alert alert-success" style="margin-bottom: 1.5rem; border-radius: 10px;">
          <i class="fa-solid fa-circle-check"></i> <%= flash.success[0] %>
        </div>
      <% } %>

      <!-- 4 Stat Summary Cards Row -->
      <%
        const totalCount = reviews ? reviews.length : 0;
        const approvedCount = reviews ? reviews.filter(r => r.is_approved).length : 0;
        const pendingCount = reviews ? reviews.filter(r => !r.is_approved).length : 0;
        const avgRating = totalCount > 0 ? (reviews.reduce((acc, r) => acc + (parseFloat(r.rating) || 0), 0) / totalCount).toFixed(1) : '5.0';
      %>
      <div class="admin-stats-row" style="margin-bottom: 1.8rem;">
        <div class="admin-summary-card">
          <div class="card-icon-badge"><i class="fa-regular fa-star"></i></div>
          <div class="card-info-content">
            <div class="stat-title">Total Reviews</div>
            <div style="display: flex; align-items: baseline;">
              <span class="stat-num"><%= total || totalCount %></span>
            </div>
            <span style="font-size: 0.72rem; color: var(--admin-text-muted);">verified purchases</span>
          </div>
        </div>

        <div class="admin-summary-card">
          <div class="card-icon-badge"><i class="fa-regular fa-circle-check"></i></div>
          <div class="card-info-content">
            <div class="stat-title">Approved Reviews</div>
            <div style="display: flex; align-items: baseline;">
              <span class="stat-num"><%= approvedCount %></span>
            </div>
            <span style="font-size: 0.72rem; color: var(--admin-text-muted);">visible on store</span>
          </div>
        </div>

        <div class="admin-summary-card">
          <div class="card-icon-badge"><i class="fa-regular fa-clock"></i></div>
          <div class="card-info-content">
            <div class="stat-title">Pending Moderation</div>
            <div style="display: flex; align-items: baseline;">
              <span class="stat-num"><%= pendingCount %></span>
            </div>
            <span style="font-size: 0.72rem; color: var(--admin-text-muted);">requires review</span>
          </div>
        </div>

        <div class="admin-summary-card">
          <div class="card-icon-badge"><i class="fa-solid fa-ranking-star"></i></div>
          <div class="card-info-content">
            <div class="stat-title">Average Rating</div>
            <div style="display: flex; align-items: baseline;">
              <span class="stat-num"><%= avgRating %> ★</span>
            </div>
            <span style="font-size: 0.72rem; color: var(--admin-text-muted);">overall customer score</span>
          </div>
        </div>
      </div>

      <!-- Filter Controls Bar Card -->
      <div class="admin-card-box" style="padding: 1rem 1.4rem; margin-bottom: 1.5rem;">
        <form action="/admin/reviews" method="GET" style="display: flex; gap: 1rem; align-items: center; flex-wrap: wrap;">
          <div style="flex: 1; min-width: 280px; position: relative;">
            <i class="fa-solid fa-magnifying-glass" style="position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: var(--admin-text-muted); font-size: 0.88rem;"></i>
            <input type="text" name="search" value="<%= currentSearch %>" placeholder="Search by customer, design title, or comment..." style="width: 100%; height: 40px; border-radius: 8px; border: 1px solid var(--admin-border); padding-left: 2.5rem; font-size: 0.85rem;">
          </div>

          <select name="status" style="height: 40px; border-radius: 8px; border: 1px solid var(--admin-border); padding: 0 1rem; font-size: 0.85rem; background: #FFFFFF; color: var(--admin-text-dark);">
            <option value="">All Status</option>
            <option value="approved" <%= currentStatus === 'approved' ? 'selected' : '' %>>Approved</option>
            <option value="pending" <%= currentStatus === 'pending' ? 'selected' : '' %>>Pending</option>
          </select>

          <select name="sort" style="height: 40px; border-radius: 8px; border: 1px solid var(--admin-border); padding: 0 1rem; font-size: 0.85rem; background: #FFFFFF; color: var(--admin-text-dark);">
            <option value="newest" <%= currentSort === 'newest' ? 'selected' : '' %>>Sort by Newest</option>
            <option value="oldest" <%= currentSort === 'oldest' ? 'selected' : '' %>>Sort by Oldest</option>
            <option value="rating_high" <%= currentSort === 'rating_high' ? 'selected' : '' %>>Rating: High to Low</option>
            <option value="rating_low" <%= currentSort === 'rating_low' ? 'selected' : '' %>>Rating: Low to High</option>
          </select>

          <button type="submit" class="btn btn-primary" style="height: 40px; border-radius: 8px; font-size: 0.85rem; padding: 0 1.2rem;">Filter</button>
          <a href="/admin/reviews" class="btn btn-outline" style="height: 40px; border-radius: 8px; font-size: 0.85rem; padding: 0 1rem; display: inline-flex; align-items: center; gap: 6px; background: #FFF;">
            <i class="fa-solid fa-rotate-left"></i> Reset
          </a>
        </form>
      </div>

      <!-- Main Reviews Table Card -->
      <div class="admin-card-box" style="padding: 0; overflow: hidden; margin-bottom: 1.5rem;">
        <table class="admin-table-styled">
          <thead>
            <tr>
              <th style="width: 38px; text-align: center;"><input type="checkbox"></th>
              <th>Customer</th>
              <th>Design</th>
              <th>Rating</th>
              <th>Comment</th>
              <th>Status</th>
              <th>Date Added</th>
              <th style="text-align: right;">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (reviews && reviews.length > 0) { %>
              <% reviews.forEach(r => { %>
                <tr id="reviewRow-<%= r.id %>">
                  <td style="text-align: center;"><input type="checkbox"></td>
                  <td>
                    <strong style="display: block; font-size: 0.88rem; color: var(--admin-text-dark);"><%= r.user_name || 'Verified Customer' %></strong>
                    <span style="font-size: 0.74rem; color: var(--admin-text-muted);"><%= r.user_email || '-' %></span>
                  </td>
                  <td>
                    <div style="display: flex; align-items: center; gap: 8px;">
                      <% if (r.design_image) { %>
                        <img src="<%= r.design_image %>" style="width: 36px; height: 36px; border-radius: 6px; object-fit: contain; background: #FAF6F0; border: 1px solid var(--admin-border);">
                      <% } else { %>
                        <div style="width: 36px; height: 36px; border-radius: 6px; background: #FAF6F0; border: 1px dashed var(--admin-border); display: flex; align-items: center; justify-content: center; color: var(--admin-text-muted); font-size: 0.75rem;"><i class="fa-regular fa-image"></i></div>
                      <% } %>
                      <div>
                        <strong style="display: block; font-size: 0.84rem; color: var(--admin-text-dark);"><%= r.design_title %></strong>
                        <% if (r.design_slug) { %>
                          <a href="/design/<%= r.design_slug %>" target="_blank" style="font-size: 0.72rem; color: var(--admin-primary); text-decoration: none;">View Design &rarr;</a>
                        <% } %>
                      </div>
                    </div>
                  </td>
                  <td>
                    <span class="star-rating">
                      <% for (let i = 1; i <= 5; i++) { %>
                        <i class="fa-<%= i <= r.rating ? 'solid' : 'regular' %> fa-star"></i>
                      <% } %>
                    </span>
                    <strong style="font-size: 0.82rem; margin-left: 4px; color: var(--admin-text-dark);"><%= r.rating %>.0</strong>
                  </td>
                  <td style="max-width: 320px;">
                    <span style="font-size: 0.82rem; color: var(--admin-text-dark); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                      "<%= r.comment %>"
                    </span>
                  </td>
                  <td>
                    <label class="switch-toggle">
                      <input type="checkbox" <%= r.is_approved ? 'checked' : '' %> onchange="toggleReviewStatus('<%= r.id %>')">
                      <span class="slider-round"></span>
                      <span id="statusLabel-<%= r.id %>" style="font-size: 0.78rem; font-weight: 600; color: <%= r.is_approved ? '#2E7D32' : 'var(--admin-text-muted)' %>;"><%= r.is_approved ? 'Approved' : 'Pending' %></span>
                    </label>
                  </td>
                  <td style="color: var(--admin-text-muted); font-size: 0.78rem;">
                    <%= formatDateTime(r.created_at) %>
                  </td>
                  <td style="text-align: right;">
                    <div style="display: inline-flex; gap: 6px;">
                      <button type="button" onclick="confirmDeleteReview('<%= r.id %>')" class="action-icon-btn" style="color: #C62828; border: none; background: transparent; cursor: pointer;" title="Delete Review"><i class="fa-regular fa-trash-can"></i></button>
                    </div>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="8" style="text-align: center; padding: 2.5rem; color: var(--admin-text-muted);">
                  <i class="fa-regular fa-star" style="font-size: 2rem; display: block; margin-bottom: 8px; opacity: 0.4;"></i>
                  <strong>No reviews yet</strong>
                  <p style="font-size: 0.85rem; margin: 4px 0 0;">Customer reviews submitted from design pages will appear here for live moderation.</p>
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>

        <!-- Pagination Bar -->
        <div style="padding: 1rem 1.4rem; background: #FAF6F0; border-top: 1px solid var(--admin-border); display: flex; align-items: center; justify-content: space-between;">
          <div style="font-size: 0.82rem; color: var(--admin-text-muted);">
            Showing 1 to <%= reviews ? reviews.length : 0 %> of <strong><%= total || (reviews ? reviews.length : 0) %></strong> reviews
          </div>

          <div style="display: flex; gap: 6px;">
            <% if (currentPage > 1) { %>
              <a href="/admin/reviews?page=<%= currentPage - 1 %>&status=<%= currentStatus %>&search=<%= currentSearch %>&sort=<%= currentSort %>" class="action-icon-btn" style="width: 32px; height: 32px;"><i class="fa-solid fa-chevron-left" style="font-size: 0.7rem;"></i></a>
            <% } %>
            <span class="action-icon-btn" style="width: 32px; height: 32px; background: var(--admin-primary); color: #FFFFFF; border-color: var(--admin-primary); font-weight: 700;"><%= currentPage %></span>
            <% if (currentPage < totalPages) { %>
              <a href="/admin/reviews?page=<%= currentPage + 1 %>&status=<%= currentStatus %>&search=<%= currentSearch %>&sort=<%= currentSort %>" class="action-icon-btn" style="width: 32px; height: 32px;"><i class="fa-solid fa-chevron-right" style="font-size: 0.7rem;"></i></a>
            <% } %>
          </div>
        </div>
      </div>

    </main>
  </div>
</div>

<script>
async function toggleReviewStatus(id) {
  try {
    const res = await fetch(`/admin/reviews/toggle-status/${id}`, {
      method: 'POST',
      headers: { 'Accept': 'application/json' }
    });
    const data = await res.json();
    if (data.success) {
      const lbl = document.getElementById(`statusLabel-${id}`);
      if (lbl) {
        lbl.innerText = data.is_approved ? 'Approved' : 'Pending';
        lbl.style.color = data.is_approved ? '#2E7D32' : 'var(--admin-text-muted)';
      }
    } else {
      alert(data.message || 'Unable to update status');
    }
  } catch (err) {
    alert('Network error updating review status.');
  }
}

async function confirmDeleteReview(id) {
  if (!confirm('Are you sure you want to delete this review?')) return;
  try {
    const res = await fetch(`/admin/reviews/delete/${id}`, {
      method: 'POST',
      headers: { 'Accept': 'application/json' }
    });
    const data = await res.json();
    if (data.success) {
      const row = document.getElementById(`reviewRow-${id}`);
      if (row) row.remove();
    } else {
      alert(data.message || 'Error deleting review');
    }
  } catch (err) {
    alert('Network error deleting review.');
  }
}
</script>

</body>
</html>
