<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Order Details #<%= order.order_number || order.id %> - ARUVI Admin</title>
  <link rel="icon" type="image/jpeg" href="/public/images/logo.jpg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;1,400&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="/public/css/main.css">
  <link rel="stylesheet" href="/public/css/admin.css">
</head>
<body class="admin-body">

<div class="admin-wrapper">
  <!-- Top Header matching Master Admin UI -->
  <header class="admin-top-header">
    <a href="/admin" class="admin-header-brand">
      <% const currentLogo = (typeof siteSettings !== 'undefined' && siteSettings.logo_url) ? siteSettings.logo_url : '/public/images/logo.jpg'; %>
      <img src="<%= currentLogo %>" alt="ARUVI Admin Logo" style="max-height: 42px; width: auto; object-fit: contain;">
    </a>

    <!-- Global Search -->
    <div class="admin-search-bar">
      <i class="fa-solid fa-magnifying-glass"></i>
      <input type="text" placeholder="Search designs, orders, customers...">
    </div>

    <!-- Right User Header Icons -->
    <div class="admin-header-right">
      <a href="#" class="admin-icon-btn" title="Notifications">
        <i class="fa-regular fa-bell"></i>
        <span class="badge-count">3</span>
      </a>

      <div class="admin-user-menu">
        <div class="admin-user-avatar">A</div>
        <div class="admin-user-info">
          <strong>Admin</strong>
          <span>Administrator</span>
        </div>
        <i class="fa-solid fa-chevron-down" style="font-size: 0.75rem; color: var(--admin-text-muted); margin-left: 4px;"></i>
      </div>
    </div>
  </header>

  <!-- Admin Main Layout with Sidebar -->
  <div class="admin-main-container">
    <!-- Left Sidebar matching Master Admin UI -->
    <aside class="admin-sidebar">
      <ul class="sidebar-nav-list" style="margin-bottom: 1.2rem;">
        <li class="sidebar-nav-item">
          <a href="/admin">
            <span><i class="fa-solid fa-house"></i> Dashboard</span>
          </a>
        </li>
      </ul>

      <!-- DESIGNS Section -->
      <div class="admin-sidebar-section">
        <div class="sidebar-heading">DESIGNS</div>
        <ul class="sidebar-nav-list">
          <li class="sidebar-nav-item"><a href="/admin/designs"><span><i class="fa-solid fa-box-archive"></i> Manage Designs</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/designs/create"><span><i class="fa-solid fa-circle-plus"></i> Add New Design</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/categories"><span><i class="fa-solid fa-border-all"></i> Categories</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/custom-orders"><span><i class="fa-solid fa-wand-magic-sparkles"></i> Custom Orders</span></a></li>
        </ul>
      </div>

      <!-- ORDERS Section -->
      <div class="admin-sidebar-section">
        <div class="sidebar-heading">ORDERS</div>
        <ul class="sidebar-nav-list">
          <li class="sidebar-nav-item"><a href="/admin/orders" class="active"><span><i class="fa-regular fa-newspaper"></i> All Orders</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/orders?status=pending"><span><i class="fa-regular fa-clock"></i> Pending Orders</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/orders?status=completed"><span><i class="fa-regular fa-circle-check"></i> Completed Orders</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/orders?status=cancelled"><span><i class="fa-regular fa-circle-xmark"></i> Cancelled Orders</span></a></li>
        </ul>
      </div>

      <!-- CUSTOMERS Section -->
      <div class="admin-sidebar-section">
        <div class="sidebar-heading">CUSTOMERS</div>
        <ul class="sidebar-nav-list">
          <li class="sidebar-nav-item"><a href="/admin/customers"><span><i class="fa-solid fa-users"></i> All Customers</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/messages"><span><i class="fa-regular fa-comment-dots"></i> Enquiries</span></a></li>
        </ul>
      </div>

      <!-- CONTENT Section -->
      <div class="admin-sidebar-section">
        <div class="sidebar-heading">CONTENT</div>
        <ul class="sidebar-nav-list">
          <li class="sidebar-nav-item"><a href="/admin/homepage"><span><i class="fa-solid fa-house-chimney"></i> Homepage</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/banners"><span><i class="fa-regular fa-image"></i> Banners</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/settings"><span><i class="fa-solid fa-gear"></i> Website Settings</span></a></li>
        </ul>
      </div>

      <div style="margin-top: auto; padding-top: 1rem; border-top: 1px solid var(--admin-border);">
        <a href="/admin/logout" style="display: flex; align-items: center; gap: 8px; color: var(--admin-primary); font-size: 0.85rem; font-weight: 600; text-decoration: none; padding: 0.5rem 0.8rem;">
          <i class="fa-solid fa-arrow-right-from-bracket"></i> Logout Admin
        </a>
      </div>
    </aside>

    <!-- Main Content Body -->
    <main class="admin-content-body">

      <!-- Breadcrumbs & Header -->
      <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1.8rem;">
        <div>
          <div style="font-size: 0.8rem; color: var(--admin-text-muted); margin-bottom: 0.4rem;">
            <a href="/admin" style="color: var(--admin-text-muted); text-decoration: none;">Dashboard</a> &nbsp;>&nbsp; 
            <a href="/admin/orders" style="color: var(--admin-text-muted); text-decoration: none;">Orders</a> &nbsp;>&nbsp; 
            <span style="color: var(--admin-primary); font-weight: 600;">Details</span>
          </div>
          <h1 style="font-family: var(--font-heading); font-size: 2.2rem; font-weight: 700; color: var(--admin-text-dark); margin: 0 0 0.3rem;">Order #<%= order.order_number || order.id %> Details</h1>
          <p style="font-size: 0.88rem; color: var(--admin-text-muted); margin: 0;">Placed on <%= new Date(order.created_at).toLocaleString('en-US', { dateStyle: 'medium', timeStyle: 'short' }) %></p>
        </div>

        <a href="/admin/orders" class="btn btn-outline" style="height: 44px; border-radius: 10px; font-size: 0.88rem; font-weight: 600; background: #FFF; display: inline-flex; align-items: center; gap: 8px; padding: 0 1.2rem;">
          <i class="fa-solid fa-arrow-left"></i> Back to Orders
        </a>
      </div>

      <div style="display: grid; grid-template-columns: 1fr 340px; gap: 1.8rem;">
        
        <!-- Left Side: Order Items Table -->
        <div>
          <div class="admin-card-box" style="padding: 0; overflow: hidden; margin-bottom: 1.5rem;">
            <div style="padding: 1.2rem 1.5rem; background: #FAF6F0; border-bottom: 1px solid var(--admin-border);">
              <h3 style="font-size: 1.1rem; color: var(--admin-text-dark); margin: 0; font-family: var(--font-heading); font-weight: 700;">Purchased Embroidery Designs</h3>
            </div>
            
            <table class="admin-table-styled">
              <thead>
                <tr>
                  <th>Design</th>
                  <th>Formats</th>
                  <th style="text-align: right;">Price</th>
                </tr>
              </thead>
              <tbody>
                <% if (order.items && order.items.length > 0) { %>
                  <% order.items.forEach(item => { %>
                    <tr>
                      <td>
                        <div style="display: flex; align-items: center; gap: 12px;">
                          <img src="<%= item.image_url || '/public/images/hero_embroidery.jpg' %>" style="width: 44px; height: 44px; border-radius: 8px; object-fit: cover; border: 1px solid var(--admin-border);">
                          <div>
                            <strong style="display: block; font-size: 0.92rem; color: var(--admin-text-dark);"><%= item.title %></strong>
                            <span style="font-size: 0.76rem; color: var(--admin-text-muted);">Design ID: #<%= item.design_id || 'N/A' %></span>
                          </div>
                        </div>
                      </td>
                      <td>
                        <span style="background: #FAF6F0; border: 1px solid var(--admin-border); padding: 3px 8px; border-radius: 6px; font-size: 0.78rem; font-weight: 600; color: var(--admin-text-dark);">
                          <%= item.formats || 'DST, PES, JEF, EXP' %>
                        </span>
                      </td>
                      <td style="text-align: right;">
                        <strong style="font-size: 0.98rem; color: var(--admin-primary);">
                          <% if (item.price_aed || item.price_at_purchase) { %>
                            AED <%= item.price_aed || item.price_at_purchase %> <% if (item.price_at_purchase) { %>(₹<%= item.price_at_purchase %>)<% } %>
                          <% } else { %>
                            ₹<%= item.price_at_purchase || '0.00' %>
                          <% } %>
                        </strong>
                      </td>
                    </tr>
                  <% }) %>
                <% } else { %>
                  <tr>
                    <td colspan="3" style="text-align: center; padding: 2rem; color: var(--admin-text-muted);">No items found in this order.</td>
                  </tr>
                <% } %>
              </tbody>
            </table>

            <div style="padding: 1.2rem 1.5rem; background: #FAF6F0; border-top: 1px solid var(--admin-border); display: flex; justify-content: space-between; align-items: center;">
              <span style="font-weight: 600; color: var(--admin-text-dark); font-size: 0.95rem;">Total Order Value</span>
              <strong style="font-size: 1.3rem; color: var(--admin-primary); font-family: var(--font-heading);">
                <% if (order.currency && order.currency.toUpperCase() === 'AED') { %>
                  AED <%= order.final_amount || order.total_amount || 0 %>
                <% } else if (order.total_amount) { %>
                  AED <%= order.total_amount %> (₹<%= order.final_amount || order.total_amount %>)
                <% } else { %>
                  ₹<%= order.final_amount || '0' %>
                <% } %>
              </strong>
            </div>
          </div>
        </div>

        <!-- Right Side: Order Status & Customer Summary Card -->
        <div>
          <div class="admin-card-box" style="padding: 1.5rem; margin-bottom: 1.5rem;">
            <h3 style="font-size: 1.1rem; color: var(--admin-text-dark); margin-bottom: 1.2rem; border-bottom: 1px solid var(--admin-border); padding-bottom: 0.6rem; font-family: var(--font-heading); font-weight: 700;">Update Order Status</h3>
            
            <form action="/admin/orders/status/<%= order.id %>" method="POST">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <div style="margin-bottom: 1.2rem;">
                <label style="display: block; font-size: 0.82rem; font-weight: 600; color: var(--admin-text-dark); margin-bottom: 0.4rem;">Current Status</label>
                <select name="status" style="width: 100%; height: 42px; border-radius: 8px; border: 1px solid var(--admin-border); padding: 0 1rem; font-size: 0.88rem; background: #FFFFFF; color: var(--admin-text-dark);">
                  <option value="pending" <%= order.status === 'pending' ? 'selected' : '' %>>Pending</option>
                  <option value="completed" <%= order.status === 'completed' ? 'selected' : '' %>>Completed (Unlocked Files)</option>
                  <option value="cancelled" <%= order.status === 'cancelled' ? 'selected' : '' %>>Cancelled</option>
                  <option value="refunded" <%= order.status === 'refunded' ? 'selected' : '' %>>Refunded</option>
                </select>
              </div>
              <button type="submit" class="btn btn-primary" style="width: 100%; height: 44px; border-radius: 8px; font-weight: 600; font-size: 0.9rem;">Update Status</button>
            </form>

            <div style="margin-top: 1.5rem; padding-top: 1.2rem; border-top: 1px solid var(--admin-border); font-size: 0.86rem; color: var(--admin-text-dark);">
              <h4 style="font-size: 0.95rem; font-weight: 700; margin-bottom: 0.8rem; color: var(--admin-text-dark);">Customer Info</h4>
              <p style="margin-bottom: 0.4rem;"><strong>Customer:</strong> <%= order.guest_name || order.user_name || 'N/A' %></p>
              <p style="margin-bottom: 0.4rem;"><strong>Email:</strong> <%= order.guest_email || order.user_email || 'N/A' %></p>
              <p style="margin-bottom: 0.4rem;"><strong>Payment Gateway:</strong> <span style="text-transform: uppercase; font-weight: 600; color: var(--admin-primary);"><%= (order.payment_gateway || 'razorpay').toUpperCase() %></span></p>
              <p style="margin-bottom: 0;"><strong>Payment ID:</strong> <code style="background: #FAF6F0; border: 1px solid var(--admin-border); padding: 2px 6px; border-radius: 4px; font-size: 0.78rem;"><%= order.razorpay_payment_id || order.razorpay_order_id || 'N/A' %></code></p>
            </div>
          </div>
        </div>

      </div>

    </main>
  </div>
</div>

</body>
</html>

