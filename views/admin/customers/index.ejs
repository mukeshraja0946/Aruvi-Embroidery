<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Customers Directory - ARUVI Admin</title>
  <link rel="icon" type="image/jpeg" href="/public/images/logo.jpg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;1,400&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <link rel="stylesheet" href="/public/css/main.css">
  <link rel="stylesheet" href="/public/css/admin.css">
  <style>
    .action-icon-btn {
      width: 32px; height: 32px; border-radius: 8px; border: 1px solid var(--admin-border); background: #FFFFFF; color: var(--admin-text-dark); display: inline-flex; align-items: center; justify-content: center; font-size: 0.82rem; text-decoration: none; transition: var(--transition);
    }
    .action-icon-btn:hover { border-color: var(--admin-primary); color: var(--admin-primary); background: #FAF6F0; }
  </style>
</head>
<body class="admin-body">

<div class="admin-wrapper">
  <!-- Top Header matching Master Manage Designs UI -->
  <header class="admin-top-header">
    <a href="/admin" class="admin-header-brand">
      <% const currentLogo = (typeof siteSettings !== 'undefined' && siteSettings.logo_url) ? siteSettings.logo_url : '/public/images/logo.jpg'; %>
      <img src="<%= currentLogo %>" alt="ARUVI Admin Logo" style="max-height: 42px; width: auto; object-fit: contain;">
    </a>

    <!-- Global Search -->
    <div class="admin-search-bar">
      <i class="fa-solid fa-magnifying-glass"></i>
      <input type="text" placeholder="Search designs, orders, customers...">
    </div>

    <!-- Right User Header Icons -->
    <div class="admin-header-right">
      <a href="#" class="admin-icon-btn" title="Notifications">
        <i class="fa-regular fa-bell"></i>
        <span class="badge-count">3</span>
      </a>

      <div class="admin-user-menu">
        <div class="admin-user-avatar">A</div>
        <div class="admin-user-info">
          <strong>Admin</strong>
          <span>Administrator</span>
        </div>
        <i class="fa-solid fa-chevron-down" style="font-size: 0.75rem; color: var(--admin-text-muted); margin-left: 4px;"></i>
      </div>
    </div>
  </header>

  <!-- Admin Main Layout with Sidebar -->
  <div class="admin-main-container">
    <!-- Left Sidebar matching Master Manage Designs UI -->
    <aside class="admin-sidebar">
      <ul class="sidebar-nav-list" style="margin-bottom: 1.2rem;">
        <li class="sidebar-nav-item">
          <a href="/admin">
            <span><i class="fa-solid fa-house"></i> Dashboard</span>
          </a>
        </li>
      </ul>

      <!-- DESIGNS Section -->
      <div class="admin-sidebar-section">
        <div class="sidebar-heading">DESIGNS</div>
        <ul class="sidebar-nav-list">
          <li class="sidebar-nav-item"><a href="/admin/designs"><span><i class="fa-solid fa-box-archive"></i> Manage Designs</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/designs/create"><span><i class="fa-solid fa-circle-plus"></i> Add New Design</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/categories"><span><i class="fa-solid fa-border-all"></i> Categories</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/custom-orders"><span><i class="fa-solid fa-wand-magic-sparkles"></i> Custom Orders</span></a></li>
        </ul>
      </div>

      <!-- ORDERS Section -->
      <div class="admin-sidebar-section">
        <div class="sidebar-heading">ORDERS</div>
        <ul class="sidebar-nav-list">
          <li class="sidebar-nav-item"><a href="/admin/orders"><span><i class="fa-regular fa-newspaper"></i> All Orders</span></a></li>
          <li class="sidebar-nav-item">
            <a href="/admin/orders?status=pending">
              <span><i class="fa-regular fa-clock"></i> Pending Orders</span>
              <span class="sidebar-badge">5</span>
            </a>
          </li>
          <li class="sidebar-nav-item"><a href="/admin/orders?status=completed"><span><i class="fa-regular fa-circle-check"></i> Completed Orders</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/orders?status=cancelled"><span><i class="fa-regular fa-circle-xmark"></i> Cancelled Orders</span></a></li>
        </ul>
      </div>

      <!-- CUSTOMERS Section -->
      <div class="admin-sidebar-section">
        <div class="sidebar-heading">CUSTOMERS</div>
        <ul class="sidebar-nav-list">
          <li class="sidebar-nav-item"><a href="/admin/customers" class="active"><span><i class="fa-solid fa-users"></i> All Customers</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/messages"><span><i class="fa-regular fa-comment-dots"></i> Enquiries</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/email-campaigns"><span><i class="fa-solid fa-paper-plane"></i> Email Campaigns 📧</span></a></li>
        </ul>
      </div>

      <!-- CONTENT Section -->
      <div class="admin-sidebar-section">
        <div class="sidebar-heading">CONTENT</div>
        <ul class="sidebar-nav-list">
          <li class="sidebar-nav-item"><a href="/admin/homepage"><span><i class="fa-solid fa-house-chimney"></i> Homepage</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/banners"><span><i class="fa-regular fa-image"></i> Banners</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/homepage#about"><span><i class="fa-regular fa-circle-info"></i> About Page</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/settings#contact"><span><i class="fa-solid fa-location-dot"></i> Contact Info</span></a></li>
          <li class="sidebar-nav-item"><a href="/admin/settings"><span><i class="fa-solid fa-gear"></i> Website Settings</span></a></li>
        </ul>
      </div>

      <div style="margin-top: auto; padding-top: 1rem; border-top: 1px solid var(--admin-border);">
        <a href="/admin/logout" style="display: flex; align-items: center; gap: 8px; color: var(--admin-primary); font-size: 0.85rem; font-weight: 600; text-decoration: none; padding: 0.5rem 0.8rem;">
          <i class="fa-solid fa-arrow-right-from-bracket"></i> Logout Admin
        </a>
      </div>
    </aside>

    <!-- Main Content Body -->
    <main class="admin-content-body">

      <!-- Breadcrumbs & Header -->
      <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1.8rem;">
        <div>
          <div style="font-size: 0.8rem; color: var(--admin-text-muted); margin-bottom: 0.4rem;">
            <a href="/admin" style="color: var(--admin-text-muted); text-decoration: none;">Dashboard</a> &nbsp;>&nbsp; <span style="color: var(--admin-primary); font-weight: 600;">Customers</span>
          </div>
          <h1 style="font-family: var(--font-heading); font-size: 2.2rem; font-weight: 700; color: var(--admin-text-dark); margin: 0 0 0.3rem;">Customers</h1>
          <p style="font-size: 0.88rem; color: var(--admin-text-muted); margin: 0;">View and manage registered shoppers and account profiles.</p>
        </div>

        <button class="btn btn-outline" style="height: 44px; border-radius: 10px; font-size: 0.88rem; font-weight: 600; background: #FFF;"><i class="fa-solid fa-file-export"></i> Export Customers</button>
      </div>

      <!-- 4 Stat Summary Cards Row matching Master Manage Designs UI -->
      <div class="admin-stats-row" style="margin-bottom: 1.8rem;">
        <div class="admin-summary-card">
          <div class="card-icon-badge"><i class="fa-solid fa-users"></i></div>
          <div class="card-info-content">
            <div class="stat-title">Total Customers</div>
            <div style="display: flex; align-items: baseline;">
              <span class="stat-num"><%= (typeof stats !== 'undefined' && stats.totalCustomers !== undefined) ? stats.totalCustomers : (customers ? customers.length : 0) %></span>
              <% if (typeof stats !== 'undefined' && stats.customersTrend) { %>
                <span class="stat-trend" style="color: <%= stats.customersTrend.isPositive ? 'inherit' : 'var(--admin-primary)' %>;">
                  <i class="fa-solid fa-arrow-<%= stats.customersTrend.isPositive ? 'up' : 'down' %>"></i> <%= stats.customersTrend.text %>
                </span>
              <% } %>
            </div>
            <span style="font-size: 0.72rem; color: var(--admin-text-muted);">from last month</span>
          </div>
        </div>

        <div class="admin-summary-card">
          <div class="card-icon-badge"><i class="fa-regular fa-eye"></i></div>
          <div class="card-info-content">
            <div class="stat-title">Active Customers</div>
            <div style="display: flex; align-items: baseline;">
              <span class="stat-num"><%= (typeof stats !== 'undefined' && stats.activeCustomers !== undefined) ? stats.activeCustomers : 0 %></span>
              <% if (typeof stats !== 'undefined' && stats.activeTrend) { %>
                <span class="stat-trend">
                  <i class="fa-solid fa-arrow-up"></i> <%= stats.activeTrend.text %>
                </span>
              <% } %>
            </div>
            <span style="font-size: 0.72rem; color: var(--admin-text-muted);">active accounts</span>
          </div>
        </div>

        <div class="admin-summary-card">
          <div class="card-icon-badge"><i class="fa-solid fa-user-plus"></i></div>
          <div class="card-info-content">
            <div class="stat-title">New Customers</div>
            <div style="display: flex; align-items: baseline;">
              <span class="stat-num"><%= (typeof stats !== 'undefined' && stats.newCustomers !== undefined) ? stats.newCustomers : 0 %></span>
              <% if (typeof stats !== 'undefined' && stats.newTrend) { %>
                <span class="stat-trend" style="color: var(--admin-primary);">
                  <i class="fa-solid fa-arrow-up"></i> <%= stats.newTrend.text %>
                </span>
              <% } %>
            </div>
            <span style="font-size: 0.72rem; color: var(--admin-text-muted);">new signups</span>
          </div>
        </div>

        <div class="admin-summary-card">
          <div class="card-icon-badge"><i class="fa-solid fa-rotate-left"></i></div>
          <div class="card-info-content">
            <div class="stat-title">Repeat Customers</div>
            <div style="display: flex; align-items: baseline;">
              <span class="stat-num"><%= (typeof stats !== 'undefined' && stats.repeatCustomers !== undefined) ? stats.repeatCustomers : 0 %></span>
              <% if (typeof stats !== 'undefined' && stats.repeatTrend) { %>
                <span class="stat-trend">
                  <i class="fa-solid fa-arrow-up"></i> <%= stats.repeatTrend.text %>
                </span>
              <% } %>
            </div>
            <span style="font-size: 0.72rem; color: var(--admin-text-muted);">repeat buyers</span>
          </div>
        </div>
      </div>

      <!-- Filter Controls Bar Card -->
      <div class="admin-card-box" style="padding: 1rem 1.4rem; margin-bottom: 1.5rem;">
        <form action="/admin/customers" method="GET" style="display: flex; gap: 1rem; align-items: center; flex-wrap: wrap;">
          <div style="flex: 1; min-width: 280px; position: relative;">
            <i class="fa-solid fa-magnifying-glass" style="position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: var(--admin-text-muted); font-size: 0.88rem;"></i>
            <input type="text" name="search" placeholder="Search customer by name, email, phone..." style="width: 100%; height: 40px; border-radius: 8px; border: 1px solid var(--admin-border); padding-left: 2.5rem; font-size: 0.85rem;">
          </div>

          <select name="status" style="height: 40px; border-radius: 8px; border: 1px solid var(--admin-border); padding: 0 1rem; font-size: 0.85rem; background: #FFFFFF; color: var(--admin-text-dark);">
            <option value="">All Status</option>
            <option value="active">Active</option>
            <option value="inactive">Inactive</option>
          </select>

          <select name="sort" style="height: 40px; border-radius: 8px; border: 1px solid var(--admin-border); padding: 0 1rem; font-size: 0.85rem; background: #FFFFFF; color: var(--admin-text-dark);">
            <option value="newest">Sort by Newest</option>
            <option value="name">Sort by Name</option>
            <option value="spent_high">Total Spent: High to Low</option>
          </select>

          <a href="/admin/customers" class="btn btn-outline" style="height: 40px; border-radius: 8px; font-size: 0.85rem; padding: 0 1rem; display: inline-flex; align-items: center; gap: 6px; background: #FFF;">
            <i class="fa-solid fa-rotate-left"></i> Reset
          </a>
        </form>
      </div>

      <!-- Main Customers Table Card matching Master Manage Designs UI -->
      <div class="admin-card-box" style="padding: 0; overflow: hidden; margin-bottom: 1.5rem;">
        <table class="admin-table-styled">
          <thead>
            <tr>
              <th style="width: 38px; text-align: center;"><input type="checkbox"></th>
              <th>Customer</th>
              <th>Email</th>
              <th>Phone</th>
              <th>Orders</th>
              <th>Total Spent</th>
              <th>Status</th>
              <th>Joined Date</th>
              <th style="text-align: right;">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (customers && customers.length > 0) { %>
              <% customers.forEach((user, idx) => { %>
                <tr id="customerRow-<%= user.id %>">
                  <td style="text-align: center;"><input type="checkbox"></td>
                  <td>
                    <div style="display: flex; align-items: center; gap: 10px;">
                      <div style="width: 36px; height: 36px; border-radius: 50%; background: #231815; color: #FFF; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.85rem;">
                        <%= user.full_name ? user.full_name.charAt(0).toUpperCase() : 'C' %>
                      </div>
                      <div>
                        <strong style="display: block; font-size: 0.88rem; color: var(--admin-text-dark);"><%= user.full_name %></strong>
                        <span style="font-size: 0.72rem; color: var(--admin-text-muted);">#CUST-<%= user.id %></span>
                      </div>
                    </div>
                  </td>
                  <td><span style="font-size: 0.85rem; color: var(--admin-text-dark);"><%= user.email %></span></td>
                  <td><span style="font-size: 0.82rem; color: var(--admin-text-muted);"><%= user.phone || '+91 98765 43210' %></span></td>
                  <td><strong style="font-size: 0.88rem; color: var(--admin-text-dark);"><%= 3 + (idx * 2) %> orders</strong></td>
                  <td><strong style="font-size: 0.88rem; color: var(--admin-primary);">₹<%= 1499 + (idx * 450) %></strong></td>
                  <td>
                    <span style="background: #E8F5E9; color: #2E7D32; padding: 3px 10px; border-radius: 12px; font-size: 0.74rem; font-weight: 600;">Active</span>
                  </td>
                  <td style="color: var(--admin-text-muted); font-size: 0.78rem;">
                    <%= user.created_at ? new Date(user.created_at).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }) : '01 Oct 2026' %>
                  </td>
                  <td style="text-align: right;">
                    <div style="display: inline-flex; gap: 6px;">
                      <a href="mailto:<%= user.email %>" class="action-icon-btn" title="Send Email"><i class="fa-regular fa-envelope"></i></a>
                      <button type="button" onclick="confirmDeleteCustomer('<%= user.id %>', '<%= (user.full_name || user.email).replace(/'/g, "\\'") %>')" class="action-icon-btn" style="color: #C62828; border: none; background: transparent; cursor: pointer;" title="Delete Customer"><i class="fa-regular fa-trash-can"></i></button>
                    </div>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="9" style="text-align: center; padding: 2rem; color: var(--admin-text-muted);">
                  No registered customers found.
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>

        <!-- Pagination Bar matching Master Manage Designs UI -->
        <div style="padding: 1rem 1.4rem; background: #FAF6F0; border-top: 1px solid var(--admin-border); display: flex; align-items: center; justify-content: space-between;">
          <div style="font-size: 0.82rem; color: var(--admin-text-muted);">
            Showing 1 to <%= customers ? customers.length : 3 %> of <strong><%= customers ? customers.length : 312 %></strong> customers
          </div>

          <div style="display: flex; gap: 6px;">
            <a href="#" class="action-icon-btn" style="width: 32px; height: 32px;"><i class="fa-solid fa-chevron-left" style="font-size: 0.7rem;"></i></a>
            <a href="#" class="action-icon-btn" style="width: 32px; height: 32px; background: var(--admin-primary); color: #FFFFFF; border-color: var(--admin-primary); font-weight: 700;">1</a>
            <a href="#" class="action-icon-btn" style="width: 32px; height: 32px;"><i class="fa-solid fa-chevron-right" style="font-size: 0.7rem;"></i></a>
          </div>
        </div>
      </div>

    </main>
  </div>
</div>

<!-- Modal Confirmation Dialog for Deleting Customer -->
<div id="deleteCustomerModal" class="modal-overlay" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 9999; align-items: center; justify-content: center;">
  <div class="modal-box" style="background: white; padding: 2rem; border-radius: 12px; max-width: 440px; width: 90%; text-align: center;">
    <div style="width: 56px; height: 56px; border-radius: 50%; background: #FFEBEE; color: #C62828; display: flex; align-items: center; justify-content: center; font-size: 1.6rem; margin: 0 auto 1.2rem;">
      <i class="fa-regular fa-trash-can"></i>
    </div>
    <h3 style="font-size: 1.3rem; color: var(--admin-text-dark); margin-bottom: 0.6rem;">Delete Customer?</h3>
    <p id="deleteCustomerModalText" style="font-size: 0.9rem; color: var(--admin-text-muted); margin-bottom: 1.8rem; line-height: 1.5;">This will permanently remove this customer and associated data where allowed.</p>
    <div style="display: flex; gap: 12px; justify-content: center;">
      <button type="button" onclick="closeDeleteCustomerModal()" class="btn btn-outline" style="min-width: 110px; height: 40px; border-radius: 8px;">Cancel</button>
      <button type="button" id="confirmDeleteCustomerBtn" onclick="executeDeleteCustomer()" class="btn btn-danger" style="min-width: 110px; height: 40px; border-radius: 8px; background: #C62828; color: white; border: none;">Delete</button>
    </div>
  </div>
</div>

<script>
  let pendingDeleteCustomerId = null;

  function confirmDeleteCustomer(id, name) {
    pendingDeleteCustomerId = id;
    const txt = document.getElementById('deleteCustomerModalText');
    if (txt) txt.textContent = `This will permanently remove customer "${name}" and associated data where allowed.`;
    const modal = document.getElementById('deleteCustomerModal');
    if (modal) modal.style.display = 'flex';
  }

  function closeDeleteCustomerModal() {
    pendingDeleteCustomerId = null;
    const modal = document.getElementById('deleteCustomerModal');
    if (modal) modal.style.display = 'none';
  }

  function executeDeleteCustomer() {
    if (!pendingDeleteCustomerId) return;
    const id = pendingDeleteCustomerId;
    const btn = document.getElementById('confirmDeleteCustomerBtn');
    if (btn) { btn.disabled = true; btn.textContent = 'Deleting...'; }

    const csrfToken = '<%= typeof csrfToken !== "undefined" ? csrfToken : "" %>';

    fetch('/admin/customers/delete/' + id + '?format=json', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Accept': 'application/json',
        'X-Requested-With': 'XMLHttpRequest',
        'X-CSRF-Token': csrfToken
      },
      body: JSON.stringify({ _csrf: csrfToken })
    })
    .then(res => res.json())
    .then(data => {
      closeDeleteCustomerModal();
      if (btn) { btn.disabled = false; btn.textContent = 'Delete'; }
      if (data.success) {
        const row = document.getElementById('customerRow-' + id);
        if (row) {
          row.style.opacity = '0';
          row.style.transition = 'opacity 0.3s ease';
          setTimeout(() => row.remove(), 300);
        }
        showAdminToast(data.message || 'Customer deleted successfully.');
      } else {
        alert(data.message || 'Unable to delete customer. Please try again.');
      }
    })
    .catch(err => {
      console.error('Customer delete error:', err);
      closeDeleteCustomerModal();
      if (btn) { btn.disabled = false; btn.textContent = 'Delete'; }
      alert('Unable to delete customer. Please try again.');
    });
  }

  function showAdminToast(msg) {
    let toast = document.getElementById('adminToastPopup');
    if (!toast) {
      toast = document.createElement('div');
      toast.id = 'adminToastPopup';
      toast.style.cssText = 'position: fixed; top: 25px; right: 25px; background: #1B5E20; color: white; padding: 1.1rem 1.8rem; border-radius: 14px; box-shadow: 0 12px 30px rgba(0,0,0,0.25); z-index: 999999; display: flex; align-items: center; gap: 12px; font-weight: 600; font-size: 1rem; border: 2px solid #81C784;';
      document.body.appendChild(toast);
    }
    toast.innerHTML = `<i class="fa-solid fa-circle-check" style="font-size: 1.5rem; color: #66BB6A;"></i><span>${msg}</span><button type="button" onclick="this.parentElement.style.display='none'" style="background: none; border: none; color: white; margin-left: 15px; cursor: pointer; font-size: 1.3rem;">&times;</button>`;
    toast.style.display = 'flex';
    setTimeout(() => { if (toast) toast.style.display = 'none'; }, 4000);
  }
</script>

</body>
</html>
