<%- include('../partials/header') %>

<div class="container designs-page-container category-detail-container">
  <!-- Page Header: Title & Breadcrumbs without promotional hero banner -->
  <div class="page-banner-card clean-banner">
    <div class="banner-content">
      <div class="breadcrumb-trail banner-desktop-only">
        <a href="/">Home</a> <span class="breadcrumb-sep">›</span> <a href="/categories">Categories</a> <span class="breadcrumb-sep">›</span> <span><%= category.name %></span>
      </div>
      <h1 class="page-banner-title"><%= category.name %></h1>
      <p class="page-banner-subtitle banner-desktop-only">
        <%= category.description || 'Explore our exclusive collection of premium machine embroidery design files.' %>
      </p>
    </div>
  </div>

  <% 
    const sortVal = typeof currentSort !== 'undefined' ? currentSort : 'latest';
    const catPageNum = typeof currentPage !== 'undefined' ? (parseInt(currentPage) || 1) : 1;
    const catPageLimit = typeof limit !== 'undefined' ? limit : 24;
    const catTotalCount = typeof total !== 'undefined' ? parseInt(total) : designs.length;
    const catFromNum = designs.length > 0 ? ((catPageNum - 1) * catPageLimit + 1) : 0;
    const catToNum = designs.length > 0 ? Math.min((catPageNum - 1) * catPageLimit + designs.length, catTotalCount) : 0;
    const catTotalDisplay = catTotalCount >= 10 ? (catTotalCount + '+') : (catTotalCount || designs.length);
  %>

  <!-- Mobile Smart Sticky Toolbar Wrapper (< 768px): Contains Search + Filters/Sort row -->
  <div class="mobile-sticky-toolbar-wrapper" id="mobileStickyToolbar">
    <!-- Standalone Search Bar: Full width, 48px height, rounded 14px, soft beige -->
    <div class="designs-search-bar" id="designsSearchBar">
      <form action="/category/<%= category.slug %>" method="GET" class="designs-search-form" id="shopSearchForm" autocomplete="off">
        <i class="fa-solid fa-magnifying-glass search-icon"></i>
        <input type="text" name="search" id="shopSearchInput" placeholder="Search in <%= category.name %>..." value="<%= search || '' %>" autocomplete="off" aria-label="Search designs">
        <button type="button" class="search-clear-btn <%= search ? 'visible' : '' %>" id="searchClearBtn" aria-label="Clear search">
          <i class="fa-solid fa-xmark"></i>
        </button>
        <% if (sortVal && sortVal !== 'latest') { %><input type="hidden" name="sort" value="<%= sortVal %>"><% } %>
      </form>
      <!-- Live Suggestions Dropdown Container -->
      <div class="search-suggestions-dropdown" id="searchSuggestionsDropdown" style="display: none;"></div>
    </div>

    <!-- 1. Dedicated Mobile Unified Toolbar (< 768px): Filters (with count badge) + Sort Dropdown + Grid/List Toggle in ONE row -->
    <div class="mobile-shop-toolbar">
      <a href="/designs?category=<%= category.slug %>" class="mobile-toolbar-btn mobile-filter-btn" aria-label="Filters">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="4" y1="21" x2="4" y2="14"/><line x1="4" y1="10" x2="4" y2="3"/>
          <line x1="12" y1="21" x2="12" y2="12"/><line x1="12" y1="8" x2="12" y2="3"/>
          <line x1="20" y1="21" x2="20" y2="16"/><line x1="20" y1="12" x2="20" y2="3"/>
          <line x1="1" y1="14" x2="7" y2="14"/><line x1="9" y1="8" x2="15" y2="8"/><line x1="17" y1="16" x2="23" y2="16"/>
        </svg>
        <span>Filters</span>
        <span class="mobile-toolbar-count">(<%= catTotalCount %>)</span>
      </a>

      <%- include('../partials/sort-dropdown', {
        id: 'cat_mobile_sort_dd',
        currentSort: sortVal,
        actionType: 'ajax'
      }) %>

      <div class="mobile-view-toggle">
        <button type="button" class="view-btn active" data-view="grid" title="Grid View" aria-label="Grid View"><i class="fa-solid fa-border-all"></i></button>
        <button type="button" class="view-btn" data-view="list" title="List View" aria-label="List View"><i class="fa-solid fa-list"></i></button>
      </div>
    </div>
  </div>

  <!-- 3. Desktop Controls Toolbar (>= 768px) -->
  <div class="shop-controls-bar">
    <!-- Exact Two-Line Results Count -->
    <div class="results-count-twoline">
      <span class="rc-line1">Showing</span>
      <span class="rc-line2"><strong><%= catFromNum %>–<%= catToNum %></strong> of <strong><%= catTotalDisplay %></strong> designs</span>
    </div>

    <!-- Vertical Divider -->
    <div class="toolbar-divider"></div>
    
    <!-- Sort Dropdown at top right of grid -->
    <div class="controls-right">
      <%- include('../partials/sort-dropdown', {
        id: 'cat_desktop_sort_dd',
        currentSort: sortVal,
        actionType: 'ajax'
      }) %>
    </div>
  </div>

  <!-- 4. Category Filter Pills: Horizontally Scrollable with Scroll-Snap & Real DB Counts -->
  <% if (typeof categories !== 'undefined' && categories.length > 0) { %>
    <div class="category-pills-scroll-row hide-scrollbar" id="categoryPillsRow">
      <a href="/designs" class="cat-pill-btn">
        All (<%= typeof totalActiveDesigns !== 'undefined' ? totalActiveDesigns : catTotalCount %>)
      </a>
      <% categories.forEach(cat => { %>
        <% if (typeof hideEmptyCategories === 'undefined' || !hideEmptyCategories || cat.design_count > 0 || cat.id === category.id) { %>
          <a href="/category/<%= cat.slug %>" class="cat-pill-btn <%= cat.id === category.id ? 'active' : '' %>" data-slug="<%= cat.slug %>">
            <%= cat.name %> (<%= cat.design_count %>)
          </a>
        <% } %>
      <% }) %>
    </div>
  <% } %>

  <!-- Dedicated Results Container -->
  <div class="results-container">
    <% if (designs.length === 0) { %>
      <div class="no-results-box empty-state-box">
        <div class="empty-icon-circle">
          <i class="fa-solid fa-magnifying-glass"></i>
        </div>
        <h3>No designs found in <%= category.name %></h3>
        <p>We haven't added any designs to this category matching your search. Check back soon or explore our other collections!</p>
        <a href="/designs" class="btn btn-primary browse-all-designs-btn">
          <i class="fa-solid fa-compass" style="margin-right: 6px;"></i> Browse all designs
        </a>
      </div>
    <% } else { %>
      <!-- 2-column mobile grid (<768px), 4-column desktop grid (>=768px) -->
      <div class="grid-4-strict" id="designsGrid">
        <% designs.forEach(design => { %>
          <%- include('../partials/design-card', {
            design,
            userPurchasedDesignIds: typeof userPurchasedDesignIds !== 'undefined' ? userPurchasedDesignIds : [],
            userWishlistDesignIds: typeof userWishlistDesignIds !== 'undefined' ? userWishlistDesignIds : [],
            siteSettings: typeof siteSettings !== 'undefined' ? siteSettings : {}
          }) %>
        <% }) %>
      </div>

      <!-- Infinite Scroll / Load More (24 per page) -->
      <div class="load-more-container" id="loadMoreContainer" style="<%= catPageNum >= totalPages ? 'display: none;' : '' %>">
        <button type="button" class="load-more-btn" id="loadMoreBtn" data-page="<%= catPageNum %>" data-total-pages="<%= totalPages %>">
          <span>Load more (<%= Math.max(0, catTotalCount - (catPageNum * catPageLimit)) %> remaining)</span>
          <i class="fa-solid fa-arrow-down"></i>
        </button>
        <div class="load-more-spinner" id="loadMoreSpinner" style="display: none;">
          <div class="spinner-dot"></div>
          <div class="spinner-dot"></div>
          <div class="spinner-dot"></div>
        </div>
      </div>

      <!-- Desktop Pagination Controls Bar (>= 768px) -->
      <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
        <div class="pagination-wrapper desktop-pagination-only">
          <a href="/category/<%= category.slug %>?page=<%= Math.max(1, catPageNum - 1) %><%= currentSort ? '&sort=' + currentSort : '' %><%= search ? '&search=' + encodeURIComponent(search) : '' %>" class="page-nav-btn <%= catPageNum <= 1 ? 'disabled' : '' %>"><i class="fa-solid fa-chevron-left"></i></a>
          <% for (let i = 1; i <= Math.min(5, totalPages); i++) { %>
            <a href="/category/<%= category.slug %>?page=<%= i %><%= currentSort ? '&sort=' + currentSort : '' %><%= search ? '&search=' + encodeURIComponent(search) : '' %>" class="page-num-btn <%= catPageNum === i ? 'active' : '' %>"><%= i %></a>
          <% } %>
          <% if (totalPages > 5) { %>
            <span class="page-dots">...</span>
            <a href="/category/<%= category.slug %>?page=<%= totalPages %><%= currentSort ? '&sort=' + currentSort : '' %><%= search ? '&search=' + encodeURIComponent(search) : '' %>" class="page-num-btn <%= catPageNum === totalPages ? 'active' : '' %>"><%= totalPages %></a>
          <% } %>
          <a href="/category/<%= category.slug %>?page=<%= Math.min(totalPages, catPageNum + 1) %><%= currentSort ? '&sort=' + currentSort : '' %><%= search ? '&search=' + encodeURIComponent(search) : '' %>" class="page-nav-btn <%= catPageNum >= totalPages ? 'disabled' : '' %>"><i class="fa-solid fa-chevron-right"></i></a>
        </div>
      <% } %>
    <% } %>
  </div>
</div>

<!-- Floating Back to Top Button -->
<button type="button" class="back-to-top-btn" id="backToTopBtn" aria-label="Back to top" title="Back to top">
  <i class="fa-solid fa-arrow-up"></i>
</button>

<!-- Mobile shop interactive behaviors -->
<script src="/public/js/shop-mobile.js" defer></script>

<%- include('../partials/footer') %>
