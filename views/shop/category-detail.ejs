<%- include('../partials/header') %>

<div class="container category-detail-container" style="margin-top: 1.2rem; margin-bottom: 2.5rem;">
  <!-- Breadcrumb -->
  <div class="category-breadcrumb-bar" style="margin-bottom: 0.5rem;">
    <a href="/" style="color: var(--text-muted);">Home</a> &gt; <a href="/categories" style="color: var(--text-muted);">Categories</a> &gt; <span style="color: var(--text-dark); font-weight: 600;"><%= category.name %></span>
  </div>

  <!-- Category Header -->
  <div class="section-heading-box category-header-box" style="margin-bottom: 0.5rem;">
    <h1 class="category-main-title" style="margin-bottom: 0.2rem;">
      <%= category.name %>
    </h1>
    <div class="category-count-badge-wrap" style="margin-bottom: 0.2rem;">
      <span class="category-count-badge">
        Showing <%= designs.length %> of <%= total %> <%= total === 1 ? 'Design' : 'Designs' %>
      </span>
    </div>
    <p class="category-desc" style="margin-bottom: 0.2rem;">
      <%= category.description || 'Explore our exclusive collection of premium machine embroidery design files.' %>
    </p>
  </div>

  <!-- Filter & Controls Toolbar matching Reference UI -->
  <% 
    const subVal = typeof currentSub !== 'undefined' ? currentSub : '';
    const sortVal = typeof currentSort !== 'undefined' ? currentSort : 'latest';
    const catPageNum = typeof currentPage !== 'undefined' ? (parseInt(currentPage) || 1) : 1;
    const catPageLimit = 16;
    const catTotalCount = typeof total !== 'undefined' ? parseInt(total) : designs.length;
    const catFromNum = designs.length > 0 ? ((catPageNum - 1) * catPageLimit + 1) : 0;
    const catToNum = designs.length > 0 ? Math.min((catPageNum - 1) * catPageLimit + designs.length, catTotalCount) : 0;
    const catTotalDisplay = catTotalCount >= 10 ? (catTotalCount + '+') : (catTotalCount || designs.length);

    function getSortLabel(val) {
      switch(val) {
        case 'price_low':
        case 'price_asc':
          return 'Price: Low to High';
        case 'price_high':
        case 'price_desc':
          return 'Price: High to Low';
        case 'popular':
        case 'most_popular':
          return 'Popular';
        case 'rating':
        case 'top_rated':
          return 'Top Rated';
        case 'oldest':
          return 'Oldest';
        case 'newest':
        case 'latest':
        default:
          return 'Latest';
      }
    }
  %>

  <!-- 1. Dedicated Clean Mobile Toolbar (< 768px): One clean row with 44px buttons -->
  <div class="mobile-shop-toolbar">
    <a href="/designs?category=<%= category.slug %>" class="mobile-toolbar-btn mobile-filter-btn" aria-label="Filters">
      <i class="fa-solid fa-sliders"></i>
      <span>Filters</span>
    </a>

    <button type="button" class="mobile-toolbar-btn mobile-sort-btn" id="openMobileSortBtn" aria-haspopup="dialog" aria-expanded="false" aria-label="Sort designs">
      <span class="mobile-sort-btn-left">
        <i class="fa-solid fa-arrow-down-short-wide"></i>
        <span class="mobile-sort-btn-text">Sort: <strong><%= getSortLabel(sortVal) %></strong></span>
      </span>
      <i class="fa-solid fa-chevron-down mobile-sort-chevron"></i>
    </button>
  </div>

  <!-- 2. Mobile Results Count Line (< 768px) -->
  <div class="mobile-results-row">
    <span class="mobile-results-count"><%= catTotalCount %> <%= catTotalCount === 1 ? 'design' : 'designs' %></span>
  </div>

  <!-- 3. Desktop Controls Toolbar (>= 768px) -->
  <div class="shop-controls-bar" style="margin-bottom: 1.5rem;">
    <!-- Filters Button -->
    <a href="/designs?category=<%= category.slug %>" class="mobile-filter-toggle-btn" aria-label="Filters">
      <i class="fa-solid fa-sliders"></i> <span>Filters</span>
    </a>

    <!-- Vertical Divider -->
    <div class="toolbar-divider"></div>

    <!-- Exact Two-Line Results Count -->
    <div class="results-count-twoline">
      <span class="rc-line1">Showing</span>
      <span class="rc-line2"><strong><%= catFromNum %>–<%= catToNum %></strong> of <strong><%= catTotalDisplay %></strong> designs</span>
    </div>

    <!-- Vertical Divider -->
    <div class="toolbar-divider"></div>
    
    <!-- Sort By label and dropdown -->
    <div class="controls-right">
      <%- include('../partials/sort-dropdown', {
        id: 'cat_sort_dd',
        label: 'Sort by:',
        actionType: 'url',
        currentSort: sortVal,
        options: [
          { value: 'latest', label: 'Latest', iconType: 'latest' },
          { value: 'oldest', label: 'Oldest', iconType: 'oldest' },
          { value: 'price_low', label: 'Price: Low to High', iconType: 'price_low' },
          { value: 'price_high', label: 'Price: High to Low', iconType: 'price_high' },
          { value: 'popular', label: 'Most Popular', iconType: 'popular' },
          { value: 'rating', label: 'Top Rated', iconType: 'rating' }
        ]
      }) %>
    </div>
  </div>

  <!-- Dedicated Results Container -->
  <div class="results-container">
    <% if (designs.length === 0) { %>
      <div class="empty-designs-box empty-state empty-state-box" style="min-height: 350px; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 3rem 1rem;">
        <i class="fa-solid fa-folder-open empty-state-icon" style="font-size: 3rem; color: #BD442E; margin-bottom: 1rem;"></i>
        <h3 style="font-family: var(--font-heading); font-size: 1.5rem; margin-bottom: 0.5rem;">No designs found in <%= category.name %></h3>
        <p style="color: var(--text-muted); font-size: 0.9rem; max-width: 480px; margin: 0 auto 1.2rem auto;">We haven't added any designs to this category yet. Check back soon or explore our other collections!</p>
        <a href="/designs" class="btn btn-primary browse-all-designs-btn" style="border-radius: 8px; padding: 0.65rem 1.4rem; font-weight: 600;">
          <i class="fa-solid fa-compass" style="margin-right: 6px;"></i> Browse all designs
        </a>
      </div>
    <% } else { %>
    <div class="grid-4-strict">
      <% designs.forEach(design => { %>
        <div class="listing-product-card">
          <!-- Wishlist Heart Button -->
          <button class="wishlist-round-btn wishlist-btn" data-id="<%= design.id %>" title="Wishlist">
            <i class="fa-regular fa-heart"></i>
          </button>
          
          <!-- Image Box -->
          <div class="card-image-box">
            <a href="/design/<%= design.slug %>" style="display: flex; align-items: center; justify-content: center; width: 100%; height: 100%;">
              <% if (design.primary_image) { %>
                <img src="<%= design.primary_image %>" alt="<%= design.title %>" loading="lazy" style="object-fit: contain; width: 100%; height: 100%;" onerror="this.onerror=null; this.src='/public/images/cat_blouse.jpg';">
              <% } else { %>
                <img src="/public/images/cat_blouse.jpg" alt="<%= design.title %>" loading="lazy" style="object-fit: contain; width: 100%; height: 100%;">
              <% } %>
            </a>
          </div>

          <!-- Card Content Body -->
          <div class="card-body-content">
            <h3 class="card-item-title">
              <a href="/design/<%= design.slug %>"><%= design.title %></a>
            </h3>
            <span class="card-item-category"><%= category.name %></span>

            <% const catFmts = design.formats ? design.formats.split(',').map(s => s.trim()).filter(Boolean) : []; %>
            <% if (catFmts.length > 0) { %>
              <div class="format-pill-row">
                <% catFmts.forEach(fmt => { %>
                  <span class="fmt-pill"><%= fmt %></span>
                <% }) %>
              </div>
            <% } %>

            <!-- Rating Row -->
            <%
              const catRatingScore = parseFloat(design.average_rating || design.rating || 0);
              const catNumReviews = parseInt(design.reviews_count !== undefined && design.reviews_count !== null ? design.reviews_count : 0);
            %>
            <% if (catNumReviews > 0 || catRatingScore > 0) { %>
              <div style="font-size: 0.78rem; color: #F5A623; margin-bottom: 0.6rem; display: flex; align-items: center; gap: 4px;">
                <i class="fa-solid fa-star"></i>
                <span style="font-weight: 700; color: var(--text-dark);"><%= catRatingScore.toFixed(1) %></span>
                <span style="color: var(--text-muted);">(<%= catNumReviews %>)</span>
              </div>
            <% } else { %>
              <div style="font-size: 0.75rem; color: var(--text-muted); margin-bottom: 0.6rem;">
                <span>No reviews yet</span>
              </div>
            <% } %>

            <!-- Price Row -->
            <%
              const curPrice = (design.sale_price !== null && design.sale_price !== undefined && design.sale_price !== '') ? parseFloat(design.sale_price) : parseFloat(design.price);
              const origPrice = parseFloat(design.price || 0);
              const hasDisc = curPrice < origPrice;
              const discPct = hasDisc ? Math.round(((origPrice - curPrice) / origPrice) * 100) : 0;
            %>
            <div class="card-price-row">
              <span class="current-price">₹<%= curPrice %></span>
              <% if (hasDisc) { %>
                <span class="old-price">₹<%= origPrice %></span>
                <span class="discount-badge"><%= discPct %>% OFF</span>
              <% } %>
            </div>

            <!-- Dual Action Buttons: Add to Cart & Buy Now OR Owned Badge -->
            <% const isOwnedCat = (typeof userPurchasedDesignIds !== 'undefined' && userPurchasedDesignIds && userPurchasedDesignIds.includes(design.id)); %>
            <% if (isOwnedCat) { %>
              <div class="card-actions-row">
                <a href="/design/<%= design.slug %>" class="btn btn-owned" style="display: flex; align-items: center; justify-content: center; gap: 6px; width: 100%; height: 38px; border-radius: 8px; font-weight: 600; font-size: 0.88rem; background: #F4EBE0; color: #2E7D32; border: 1px solid #C8E6C9; text-decoration: none;">
                  <i class="fa-solid fa-circle-check"></i> ✓ Owned
                </a>
              </div>
            <% } else { %>
              <div class="card-actions-row">
                <form class="ajax-add-to-cart" style="flex: 1;">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <input type="hidden" name="design_id" value="<%= design.id %>">
                  <button type="submit" class="btn btn-outline card-btn-add">
                    <i class="fa-solid fa-cart-plus"></i> Add
                  </button>
                </form>

                <form action="/cart/buy-now?_csrf=<%= csrfToken %>" method="POST" style="flex: 1;">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <input type="hidden" name="design_id" value="<%= design.id %>">
                  <button type="submit" class="btn btn-primary card-btn-buy">
                    <i class="fa-solid fa-bolt"></i> Buy Now
                  </button>
                </form>
              </div>
            <% } %>

          </div>
        </div>
      <% }) %>
    </div>

    <!-- Pagination Controls Bar -->
    <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
      <div class="pagination-wrapper" style="margin-top: 3rem;">
        <a href="/category/<%= category.slug %>?page=<%= Math.max(1, currentPage - 1) %><%= currentSort ? '&sort=' + currentSort : '' %><%= currentSub ? '&sub=' + currentSub : '' %>" class="page-nav-btn <%= currentPage <= 1 ? 'disabled' : '' %>"><i class="fa-solid fa-chevron-left"></i></a>
        <% for (let i = 1; i <= totalPages; i++) { %>
          <a href="/category/<%= category.slug %>?page=<%= i %><%= currentSort ? '&sort=' + currentSort : '' %><%= currentSub ? '&sub=' + currentSub : '' %>" class="page-num-btn <%= currentPage === i ? 'active' : '' %>"><%= i %></a>
        <% } %>
        <a href="/category/<%= category.slug %>?page=<%= Math.min(totalPages, currentPage + 1) %><%= currentSort ? '&sort=' + currentSort : '' %><%= currentSub ? '&sub=' + currentSub : '' %>" class="page-nav-btn <%= currentPage >= totalPages ? 'disabled' : '' %>"><i class="fa-solid fa-chevron-right"></i></a>
      </div>
    <% } %>
    <% } %>
  </div>
</div>

<!-- Mobile Sort Bottom Sheet Drawer (< 768px) -->
<div class="mobile-sort-sheet-overlay" id="sortSheetOverlay" aria-hidden="true"></div>
<div class="mobile-sort-sheet" id="sortSheet" role="dialog" aria-modal="true" aria-labelledby="sortSheetTitle" aria-hidden="true">
  <div class="sort-sheet-header">
    <div class="sort-sheet-title-group">
      <i class="fa-solid fa-arrow-down-short-wide"></i>
      <h3 id="sortSheetTitle">Sort Designs</h3>
    </div>
    <button type="button" class="sort-sheet-close-btn" id="closeSortSheetBtn" aria-label="Close sort dialog">
      <i class="fa-solid fa-xmark"></i>
    </button>
  </div>
  <div class="sort-sheet-body" role="listbox">
    <%
      const catSortOptions = [
        { value: 'latest', label: 'Latest', icon: 'fa-regular fa-clock' },
        { value: 'price_low', label: 'Price: Low to High', icon: 'fa-solid fa-arrow-down-1-9' },
        { value: 'price_high', label: 'Price: High to Low', icon: 'fa-solid fa-arrow-up-9-1' },
        { value: 'popular', label: 'Popular', icon: 'fa-solid fa-fire' },
        { value: 'rating', label: 'Top Rated', icon: 'fa-solid fa-star' }
      ];
      const curCatSortVal = (typeof sortVal !== 'undefined' && sortVal) ? sortVal : 'latest';
    %>
    <% catSortOptions.forEach(opt => {
      const isSelected = (curCatSortVal === opt.value) ||
                         (opt.value === 'latest' && (!curCatSortVal || curCatSortVal === 'newest')) ||
                         (opt.value === 'price_low' && curCatSortVal === 'price_asc') ||
                         (opt.value === 'price_high' && curCatSortVal === 'price_desc') ||
                         (opt.value === 'rating' && curCatSortVal === 'top_rated');
    %>
      <button type="button" class="sort-sheet-option <%= isSelected ? 'selected' : '' %>" data-sort-val="<%= opt.value %>" role="option" aria-selected="<%= isSelected ? 'true' : 'false' %>">
        <span class="sort-option-label-wrap">
          <i class="<%= opt.icon %> sort-option-icon"></i>
          <span class="sort-option-text"><%= opt.label %></span>
        </span>
        <% if (isSelected) { %>
          <i class="fa-solid fa-circle-check sort-check-icon"></i>
        <% } %>
      </button>
    <% }) %>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const openSortBtn = document.getElementById('openMobileSortBtn');
    const closeSortBtn = document.getElementById('closeSortSheetBtn');
    const sortSheet = document.getElementById('sortSheet');
    const sortOverlay = document.getElementById('sortSheetOverlay');

    function openSortSheet() {
      if (sortSheet) {
        sortSheet.classList.add('open');
        sortSheet.setAttribute('aria-hidden', 'false');
      }
      if (sortOverlay) {
        sortOverlay.classList.add('active');
        sortOverlay.setAttribute('aria-hidden', 'false');
      }
      document.body.style.overflow = 'hidden';
      document.documentElement.style.overflow = 'hidden';
    }

    function closeSortSheet() {
      if (sortSheet) {
        sortSheet.classList.remove('open');
        sortSheet.setAttribute('aria-hidden', 'true');
      }
      if (sortOverlay) {
        sortOverlay.classList.remove('active');
        sortOverlay.setAttribute('aria-hidden', 'true');
      }
      document.body.style.overflow = '';
      document.documentElement.style.overflow = '';
    }

    if (openSortBtn) openSortBtn.addEventListener('click', openSortSheet);
    if (closeSortBtn) closeSortBtn.addEventListener('click', closeSortSheet);
    if (sortOverlay) {
      sortOverlay.addEventListener('click', closeSortSheet);
      sortOverlay.addEventListener('touchmove', function(e) {
        e.preventDefault();
      }, { passive: false });
    }

    // Sort Option Selection: Update URL preserving existing params
    document.querySelectorAll('.sort-sheet-option').forEach(btn => {
      btn.addEventListener('click', function() {
        const sVal = this.getAttribute('data-sort-val');
        if (sVal) {
          const url = new URL(window.location.href);
          url.searchParams.set('sort', sVal);
          url.searchParams.delete('page');
          closeSortSheet();
          window.location.href = url.toString();
        }
      });
    });

    // Escape key closes sort drawer
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        if (sortSheet && sortSheet.classList.contains('open')) closeSortSheet();
      }
    });
  });
</script>

<%- include('../partials/footer') %>
