<%- include('../partials/header') %>

<div class="container" style="margin-top: 2rem; margin-bottom: 5rem;">
  <!-- Breadcrumb Trail matching Reference -->
  <div class="breadcrumb-trail" style="margin-bottom: 2rem;">
    <a href="/">Home</a> &nbsp;>&nbsp;
    <a href="/designs">Designs</a> &nbsp;>&nbsp;
    <a href="/category/<%= design.category_slug || 'floral-designs' %>"><%= design.category_name || 'Floral Designs' %></a> &nbsp;>&nbsp;
    <span><%= design.title %></span>
  </div>

  <!-- Top Main 3-Column Layout -->
  <div class="product-detail-hero">
    <!-- Left Column: Gallery (Thumbnails Stack + Large Main Preview) -->
    <div class="product-gallery-box">
      <div class="thumbnails-stack">
        <% if (design.images && design.images.length > 0) { %>
          <% design.images.forEach((img, idx) => { %>
            <div class="thumb-item <%= (img.is_primary || idx === 0) ? 'active' : '' %>" onclick="changeMainImage('<%= img.image_url %>', this)">
              <img src="<%= img.image_url %>" alt="<%= design.title %> - Preview <%= idx + 1 %>" style="object-fit: contain; background: #FAF6F0;">
            </div>
          <% }) %>
        <% } else { %>
          <div class="thumb-item active" onclick="changeMainImage('<%= design.primary_image || '/public/images/cat_floral.jpg' %>', this)">
            <img src="<%= design.primary_image || '/public/images/cat_floral.jpg' %>" alt="<%= design.title %>" style="object-fit: contain; background: #FAF6F0;">
          </div>
        <% } %>
        <% if (design.images && design.images.length > 4) { %>
          <div class="thumb-scroll-down"><i class="fa-solid fa-chevron-down"></i></div>
        <% } %>
      </div>

      <div class="main-image-display">
        <button class="wishlist-round-btn wishlist-btn <%= inWishlist ? 'active' : '' %>" data-id="<%= design.id %>" title="Wishlist">
          <i class="fa-<%= inWishlist ? 'solid' : 'regular' %> fa-heart"></i>
        </button>
        <img id="mainDisplayImg" src="<%= design.primary_image || '/public/images/cat_floral.jpg' %>" alt="<%= design.title %>">
      </div>
    </div>

    <!-- Center Column: Title, Ratings, Specs & Cart Controls -->
    <div class="product-summary-box">
      <h1 class="detail-product-title"><%= design.title %></h1>
      
      <!-- Rating Stars -->
      <div class="detail-rating-row">
        <div class="stars-gold">
          <i class="fa-solid fa-star"></i>
          <i class="fa-solid fa-star"></i>
          <i class="fa-solid fa-star"></i>
          <i class="fa-solid fa-star"></i>
          <i class="fa-solid fa-star-half-stroke"></i>
        </div>
        <span class="rating-number">4.9</span>
        <span class="reviews-count">(120 reviews)</span>
      </div>

      <!-- Price Row -->
      <div class="detail-price-row">
        <span class="detail-current-price">₹<%= design.sale_price || design.price %></span>
        <% if (design.sale_price && design.price > design.sale_price) { %>
          <span class="detail-old-price">₹<%= design.price %></span>
          <span class="detail-discount-tag"><%= Math.round(((design.price - design.sale_price) / design.price) * 100) %>% OFF</span>
        <% } else { %>
          <span class="detail-old-price">₹399</span>
          <span class="detail-discount-tag">25% OFF</span>
        <% } %>
      </div>

      <!-- Design Features Checklist -->
      <div class="product-features-box" style="margin: 0.8rem 0 1.2rem; background: #FAF6F0; border-radius: 12px; padding: 0.8rem 1rem;">
        <div style="display: flex; flex-direction: column; gap: 6px;">
          <div style="display: flex; align-items: center; gap: 8px; font-size: 0.85rem; color: #2E7D32; font-weight: 500;">
            <i class="fa-solid fa-circle-check" style="color: #4CAF50;"></i> High-quality digitized design
          </div>
          <div style="display: flex; align-items: center; gap: 8px; font-size: 0.85rem; color: #2E7D32; font-weight: 500;">
            <i class="fa-solid fa-circle-check" style="color: #4CAF50;"></i> Tested machine files
          </div>
          <div style="display: flex; align-items: center; gap: 8px; font-size: 0.85rem; color: #2E7D32; font-weight: 500;">
            <i class="fa-solid fa-circle-check" style="color: #4CAF50;"></i> Instant digital download
          </div>
          <div style="display: flex; align-items: center; gap: 8px; font-size: 0.85rem; color: #2E7D32; font-weight: 500;">
            <i class="fa-solid fa-circle-check" style="color: #4CAF50;"></i> Suitable for multiple fabric types
          </div>
        </div>
      </div>

      <!-- Specs Key-Value Grid -->
      <div class="specs-table">
        <div class="spec-row">
          <span class="spec-label">Design Code</span>
          <span class="spec-colon">:</span>
          <span class="spec-value"><%= design.sku || ('AF-00' + design.id) %></span>
        </div>
        <div class="spec-row">
          <span class="spec-label">Available Formats</span>
          <span class="spec-colon">:</span>
          <span class="spec-value"><%= design.formats || 'None' %></span>
        </div>
        <div class="spec-row">
          <span class="spec-label">Recommended Fabric</span>
          <span class="spec-colon">:</span>
          <span class="spec-value">Cotton, Silk, Linen, Net</span>
        </div>
      </div>

      <!-- Add to Cart & Buy Now Actions -->
      <form action="/cart/add" method="POST" class="detail-action-form" id="addToCartForm">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="design_id" value="<%= design.id %>">
      </form>

      <form action="/cart/buy-now?_csrf=<%= csrfToken %>" method="POST" id="buyNowForm">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="design_id" value="<%= design.id %>">
      </form>

      <div class="detail-action-box" style="margin-top: 1rem; display: flex; flex-direction: column; gap: 10px;">
        <% if (typeof hasPurchased !== 'undefined' && hasPurchased) { %>
          <div class="purchased-download-banner" style="background: #FAF6F0; border: 1px solid #EFE6D9; padding: 1.25rem; border-radius: 16px; margin-bottom: 0.5rem; text-align: left;">
            <div style="display: flex; align-items: center; gap: 8px; color: #2E7D32; font-weight: 700; font-size: 1.05rem; margin-bottom: 0.6rem;">
              <i class="fa-solid fa-circle-check" style="font-size: 1.2rem; color: #2E7D32;"></i>
              <span>✓ Purchased — Available Downloads</span>
            </div>
            <p style="font-size: 0.88rem; color: #5C504A; margin-bottom: 0.6rem;">
              Your purchased design is ready to download.
            </p>
            <div style="font-size: 0.85rem; color: #6E615A; margin-bottom: 1rem;">
              <strong>Available Formats:</strong> <%= (design.formats ? [...new Set(design.formats.split(',').map(f => f.trim().toUpperCase()))].join(' • ') : 'DST') %>
            </div>
            <% const cleanTitle = design.title || design.slug || ('AED_' + design.id); %>
            <a href="/user/download/<%= design.id %>" download class="btn btn-primary" style="padding: 0.75rem 1.2rem; font-size: 0.95rem; border-radius: 12px; font-weight: 700; display: flex; align-items: center; justify-content: center; gap: 8px; background-color: var(--primary);">
              <i class="fa-solid fa-download"></i> Download <%= cleanTitle %>.zip
            </a>
          </div>
        <% } else { %>
          <button type="submit" form="addToCartForm" class="btn btn-outline btn-block" style="border-radius: 25px; font-weight: 600; padding: 0.8rem; border-color: var(--primary); color: var(--primary);">
            Add to Cart
          </button>
          <button type="submit" form="buyNowForm" class="btn btn-primary btn-block" style="border-radius: 25px; font-weight: 600; padding: 0.8rem; background-color: var(--primary);">
            Buy Now
          </button>
          <div style="font-size: 0.82rem; color: #666; margin-top: 0.3rem; text-align: center;">
            <i class="fa-solid fa-lock" style="color: #888;"></i> Formats: <%= design.formats || 'None' %> &bull; Purchase this design to download files
          </div>
        <% } %>
      </div>
    </div>

    <!-- Right Column: 5 Value Cards Stack matching Reference -->
    <div class="value-cards-stack">
      <div class="value-card-item">
        <div class="value-icon-box"><i class="fa-solid fa-download"></i></div>
        <div>
          <h4>Instant Download</h4>
          <p>Get files immediately after purchase</p>
        </div>
      </div>

      <div class="value-card-item">
        <div class="value-icon-box"><i class="fa-solid fa-file-code"></i></div>
        <div>
          <h4>Available Formats</h4>
          <p><%= design.formats ? design.formats + ' included' : 'Machine formats included' %></p>
        </div>
      </div>

      <div class="value-card-item">
        <div class="value-icon-box"><i class="fa-solid fa-shield-halved"></i></div>
        <div>
          <h4>Tested Design</h4>
          <p>100% tested machine fills</p>
        </div>
      </div>

      <div class="value-card-item">
        <div class="value-icon-box"><i class="fa-solid fa-headset"></i></div>
        <div>
          <h4>Dedicated Support</h4>
          <p>We're here to help you</p>
        </div>
      </div>

      <div class="value-card-item">
        <div class="value-icon-box"><i class="fa-solid fa-infinity"></i></div>
        <div>
          <h4>Commercial Use</h4>
          <p>Use on personal & business projects</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Tabs Navigation Header -->
  <div class="detail-tabs-wrapper">
    <div class="detail-tabs-nav">
      <button class="tab-nav-btn active" onclick="switchDetailTab('files', this)">File Details</button>
      <button class="tab-nav-btn" onclick="switchDetailTab('reviews', this)">Reviews (120)</button>
      <button class="tab-nav-btn" onclick="switchDetailTab('ideas', this)">Usage Ideas</button>
    </div>

    <!-- Tab Content Container Grid -->
    <div class="tab-main-grid">
      <!-- Left Tab Pane -->
      <div class="tab-left-pane">
        <!-- Related Designs Section matching Reference -->
        <div class="related-designs-box" style="margin-bottom: 2rem;">
            <div class="section-heading-box flex-between">
              <h3 class="tab-heading">Related Designs</h3>
              <a href="/designs" class="view-all-link">View All Designs <i class="fa-solid fa-arrow-right"></i></a>
            </div>

            <div class="grid-4-strict">
              <div class="mini-product-card">
                <button class="mini-wishlist-btn wishlist-btn" data-id="2"><i class="fa-regular fa-heart"></i></button>
                <div class="mini-card-img">
                  <a href="/design/lotus-mandala"><img src="/public/images/cat_traditional.jpg" alt="Lotus Mandala"></a>
                </div>
                <div class="mini-card-body">
                  <h4><a href="/design/lotus-mandala">Lotus Mandala</a></h4>
                  <div class="mini-bottom-row">
                    <span class="mini-price">₹349</span>
                    <button class="mini-cart-btn"><i class="fa-solid fa-cart-shopping"></i></button>
                  </div>
                </div>
              </div>

              <div class="mini-product-card">
                <button class="mini-wishlist-btn wishlist-btn" data-id="3"><i class="fa-regular fa-heart"></i></button>
                <div class="mini-card-img">
                  <a href="/design/butterfly-floral"><img src="/public/images/cat_kids.jpg" alt="Butterfly Floral"></a>
                </div>
                <div class="mini-card-body">
                  <h4><a href="/design/butterfly-floral">Butterfly Floral</a></h4>
                  <div class="mini-bottom-row">
                    <span class="mini-price">₹249</span>
                    <button class="mini-cart-btn"><i class="fa-solid fa-cart-shopping"></i></button>
                  </div>
                </div>
              </div>

              <div class="mini-product-card">
                <button class="mini-wishlist-btn wishlist-btn" data-id="4"><i class="fa-regular fa-heart"></i></button>
                <div class="mini-card-img">
                  <a href="/design/letter-a-monogram"><img src="/public/images/cat_monogram.jpg" alt="Letter A Monogram"></a>
                </div>
                <div class="mini-card-body">
                  <h4><a href="/design/letter-a-monogram">Letter A Monogram</a></h4>
                  <div class="mini-bottom-row">
                    <span class="mini-price">₹199</span>
                    <button class="mini-cart-btn"><i class="fa-solid fa-cart-shopping"></i></button>
                  </div>
                </div>
              </div>

              <div class="mini-product-card">
                <button class="mini-wishlist-btn wishlist-btn" data-id="5"><i class="fa-regular fa-heart"></i></button>
                <div class="mini-card-img">
                  <a href="/design/peacock-design"><img src="/public/images/cat_traditional.jpg" alt="Peacock Design"></a>
                </div>
                <div class="mini-card-body">
                  <h4><a href="/design/peacock-design">Peacock Design</a></h4>
                  <div class="mini-bottom-row">
                    <span class="mini-price">₹399</span>
                    <button class="mini-cart-btn"><i class="fa-solid fa-cart-shopping"></i></button>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Tab 1: File Details -->
          <div class="detail-tab-pane active" id="tab-files">
            <h3 class="tab-heading">Technical File Details</h3>
            <p class="tab-text-content">
              This digital download includes precision-engineered machine embroidery files in standard format(s) (<%= design.formats || 'N/A' %>). Tested on Tajima, Brother, Janome, and Singer machines for zero thread breakage and high density coverage.
            </p>
          </div>

        <!-- Tab 3: Reviews -->
        <div class="detail-tab-pane" id="tab-reviews" style="display: none;">
          <h3 class="tab-heading">Customer Reviews (120)</h3>
          <div style="background: white; border: 1px solid var(--border-light); border-radius: 12px; padding: 1.2rem; margin-top: 1rem;">
            <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
              <strong>Priya L.</strong>
              <span style="color: #F39C12;">★★★★★ 5.0</span>
            </div>
            <p style="font-size: 0.9rem; color: var(--text-dark);">Stitched this rose motif on a silk blouse back. Clean fills and zero thread breaks!</p>
          </div>
        </div>

        <!-- Tab 4: Usage Ideas -->
        <div class="detail-tab-pane" id="tab-ideas" style="display: none;">
          <h3 class="tab-heading">Styling & Usage Ideas</h3>
          <p class="tab-text-content">
            Ideal for bridal blouse backs, saree borders, dupattas, cushion covers, wall art frames, and boutique embroidery collections.
          </p>
        </div>
      </div>

      <!-- Right Side Box: Included Files & Design Information matching Reference -->
      <aside class="included-files-sidebar">
        <h4 class="sidebar-box-title">Included Formats</h4>
        
        <div class="download-formats-grid">
          <% const activeFormatsList = (design.formats ? design.formats.split(',').map(s => s.trim().toUpperCase()).filter(Boolean) : []); %>
          <% if (activeFormatsList.length > 0) { %>
            <% activeFormatsList.forEach(fmt => { %>
              <div class="format-download-card">
                <div class="format-title-wrap">
                  <span class="format-code"><%= fmt %></span>
                  <i class="fa-solid fa-check" style="font-size: 0.75rem; color: #2E7D32;"></i>
                </div>
                <% if (typeof hasPurchased !== 'undefined' && hasPurchased) { %>
                  <a href="/user/download/<%= design.id %>" download class="download-link" style="text-decoration: none; color: var(--primary); font-weight: 700;">Download ZIP</a>
                <% } else { %>
                  <span class="download-link" style="color: var(--text-muted);">Included in ZIP</span>
                <% } %>
              </div>
            <% }) %>
          <% } else { %>
            <div style="font-size: 0.82rem; color: var(--text-muted); grid-column: 1 / -1;">No machine format files attached yet.</div>
          <% } %>
        </div>

        <h4 class="sidebar-box-title" style="margin-top: 1.8rem;">Design Information</h4>
        <div class="design-info-list">
          <div class="info-row">
            <span>Design Size</span>
            <strong>120.5 mm × 98.3 mm (Approx)</strong>
          </div>
          <div class="info-row">
            <span>Stitch Count</span>
            <strong>28,450 (Approx)</strong>
          </div>
          <div class="info-row">
            <span>Colors</span>
            <strong>8 Colors</strong>
          </div>
          <div class="info-row">
            <span>Formats</span>
            <strong><%= design.formats || 'None' %></strong>
          </div>
        </div>
      </aside>
    </div>
  </div>
</div>

<script>
  function changeMainImage(src, element) {
    document.getElementById('mainDisplayImg').src = src;
    document.querySelectorAll('.thumb-item').forEach(el => el.classList.remove('active'));
    element.classList.add('active');
  }

  function switchDetailTab(tabId, btn) {
    document.querySelectorAll('.tab-nav-btn').forEach(b => b.classList.remove('active'));
    document.querySelectorAll('.detail-tab-pane').forEach(p => p.style.display = 'none');
    btn.classList.add('active');
    document.getElementById('tab-' + tabId).style.display = 'block';
  }

  document.addEventListener('DOMContentLoaded', () => {
    const addToCartForm = document.getElementById('addToCartForm');
    if (addToCartForm) {
      addToCartForm.addEventListener('submit', function(e) {
        if (typeof window.isUserLoggedIn !== 'undefined' && !window.isUserLoggedIn) {
          e.preventDefault();
          if (typeof openLoginModal === 'function') {
            openLoginModal(() => addToCartForm.submit());
          } else {
            window.location.href = '/auth/login';
          }
        }
      });
    }

    const buyNowForm = document.getElementById('buyNowForm');
    if (buyNowForm) {
      buyNowForm.addEventListener('submit', function(e) {
        if (typeof window.isUserLoggedIn !== 'undefined' && !window.isUserLoggedIn) {
          e.preventDefault();
          if (typeof openLoginModal === 'function') {
            openLoginModal(() => buyNowForm.submit());
          } else {
            window.location.href = '/auth/login';
          }
        }
      });
    }
  });
</script>

<%- include('../partials/footer') %>
