<%- include('../partials/header') %>

<div class="container" style="margin-top: 2rem; margin-bottom: 5rem;">
  <!-- Breadcrumb Trail matching Reference -->
  <div class="breadcrumb-trail" style="margin-bottom: 2rem;">
    <a href="/">Home</a> &nbsp;>&nbsp;
    <a href="/designs">Designs</a> &nbsp;>&nbsp;
    <a href="/category/<%= design.category_slug || 'floral-designs' %>"><%= design.category_name || 'Floral Designs' %></a> &nbsp;>&nbsp;
    <span><%= design.title %></span>
  </div>

  <!-- Top Main 3-Column Layout -->
  <div class="product-detail-hero">
    <!-- Left Column: Gallery (Thumbnails Strip + Large Main Preview) -->
    <div class="product-gallery-box">
      <%
        const primaryPrev = (typeof getPrimaryPreview === 'function') ? getPrimaryPreview(design) : null;
        let initialMainImage = null;
        let selectedThumbIdx = 0;
        if (design.images && design.images.length > 0) {
          const primaryIdx = design.images.findIndex(img => img.is_primary === 1 || img.is_primary === true);
          selectedThumbIdx = primaryIdx >= 0 ? primaryIdx : 0;
          initialMainImage = design.images[selectedThumbIdx].image_url || primaryPrev?.largeUrl;
        } else if (primaryPrev && primaryPrev.hasPreview) {
          initialMainImage = primaryPrev.largeUrl;
        } else if (design.primary_image) {
          initialMainImage = design.primary_image;
        } else {
          initialMainImage = '/public/images/placeholder-preview.svg';
        }
      %>
      <div class="main-image-display" id="mainImageDisplayWrapper" style="cursor: zoom-in;" onclick="if (event.target.closest('.wishlist-btn, .wishlist-round-btn, .download-preview-btn')) return; openLightbox(document.getElementById('mainDisplayImg').src)">
        <% const isWish = (typeof inWishlist !== 'undefined' && inWishlist) || (typeof userWishlistDesignIds !== 'undefined' && userWishlistDesignIds && userWishlistDesignIds.includes(design.id)); %>
        <button type="button" class="wishlist-round-btn wishlist-btn <%= isWish ? 'active' : '' %>" data-id="<%= design.id %>" aria-label="Save to Wishlist" title="Wishlist">
          <i class="fa-<%= isWish ? 'solid' : 'regular' %> fa-heart"></i>
        </button>
        <img id="mainDisplayImg" src="<%= initialMainImage %>" alt="<%= design.title %>" class="zoomable-detail-img" onerror="if (this.src.indexOf('placeholder-preview.svg') === -1) { this.src = '/public/images/placeholder-preview.svg'; }">
        
        <% if (typeof siteSettings === 'undefined' || siteSettings.show_preview_download_button !== '0') { %>
          <!-- Preview PNG / Original Download Pill (available on image for all visitors) -->
          <button type="button" id="downloadPreviewBtn" class="download-preview-btn" onclick="downloadPreviewImage(event);" title="<%= design.has_clean_original ? 'Download Original File' : 'Download Preview Quality (Original not available)' %>" aria-label="Download design image">
            <i class="fa-solid fa-download"></i>
            <span>Download</span>
          </button>
        <% } %>

        <button type="button" id="tapToZoomBtn" class="tap-zoom-badge" onclick="event.stopPropagation(); openLightbox(document.getElementById('mainDisplayImg').src);" aria-label="Tap to zoom image">
          <i class="fa-solid fa-magnifying-glass"></i> Tap to zoom
        </button>
      </div>

      <div class="thumbnails-scroll-container hide-scrollbar">
        <div class="thumbnails-stack">
          <% if (design.images && design.images.length > 0) { %>
            <% design.images.forEach((img, idx) => { %>
              <% const itemThumbSrc = img.thumb_url || img.thumb_key || img.image_url; %>
              <div class="thumb-item <%= idx === selectedThumbIdx ? 'active' : '' %>" onclick="changeMainImage('<%= img.image_url %>', this)">
                <img src="<%= itemThumbSrc %>" alt="<%= design.title %> - Preview <%= idx + 1 %>" style="object-fit: contain; background: #FAF6F0;" onerror="if (this.src !== '<%= img.image_url %>') { this.src = '<%= img.image_url %>'; } else { this.closest('.thumb-item')?.remove(); }">
              </div>
            <% }) %>
          <% } else { %>
            <div class="thumb-item active" onclick="changeMainImage('<%= initialMainImage %>', this)">
              <img src="<%= initialMainImage %>" alt="<%= design.title %>" style="object-fit: contain; background: #FAF6F0;" onerror="this.closest('.thumb-item')?.remove();">
            </div>
          <% } %>
          <% if (design.images && design.images.length > 4) { %>
            <div class="thumb-scroll-down"><i class="fa-solid fa-chevron-down"></i></div>
          <% } %>
        </div>
      </div>
    </div>

    <!-- Center Column: Title, Ratings, Specs & Cart Controls -->
    <div class="product-summary-box">
      <h1 class="detail-product-title"><%= design.title %></h1>
      
      <!-- Rating Stars: strictly based on real approved DB reviews -->
      <%
        const realReviewsList = (typeof reviews !== 'undefined' && Array.isArray(reviews)) ? reviews : [];
        const realCount = realReviewsList.length;
        const realAvg = realCount > 0 ? (realReviewsList.reduce((sum, r) => sum + parseFloat(r.rating || 5), 0) / realCount) : 0;
      %>
      <% if (realCount > 0) { %>
        <div class="detail-rating-row">
          <div class="stars-gold">
            <% const fullStars = Math.floor(realAvg); %>
            <% const hasHalf = (realAvg - fullStars) >= 0.3; %>
            <% for (let i = 0; i < fullStars; i++) { %><i class="fa-solid fa-star"></i><% } %>
            <% if (hasHalf) { %><i class="fa-solid fa-star-half-stroke"></i><% } %>
            <% for (let i = (fullStars + (hasHalf ? 1 : 0)); i < 5; i++) { %><i class="fa-regular fa-star"></i><% } %>
          </div>
          <span class="rating-number"><%= realAvg.toFixed(1) %></span>
          <span class="reviews-count">(<%= realCount %> <%= realCount === 1 ? 'review' : 'reviews' %>)</span>
        </div>
      <% } else { %>
        <div class="detail-rating-row" style="color: var(--text-muted); font-size: 0.85rem; margin-bottom: 0.8rem;">
          <i class="fa-regular fa-star"></i> <span>No reviews yet</span>
        </div>
      <% } %>

      <!-- Price Row -->
      <%
        const curPrice = (design.sale_price !== null && design.sale_price !== undefined && design.sale_price !== '') ? parseFloat(design.sale_price) : parseFloat(design.price);
        const origPrice = parseFloat(design.price || 0);
        const hasDisc = curPrice < origPrice;
        const discPct = hasDisc ? Math.round(((origPrice - curPrice) / origPrice) * 100) : 0;
      %>
      <div class="detail-price-row">
        <span class="detail-current-price">₹<%= curPrice %></span>
        <% if (hasDisc) { %>
          <span class="detail-old-price">₹<%= origPrice %></span>
          <span class="detail-discount-tag"><%= discPct %>% OFF</span>
        <% } %>
      </div>

      <!-- Design Features Checklist -->
      <div class="product-features-box" style="margin: 0.8rem 0 1.2rem; background: #FAF6F0; border-radius: 12px; padding: 0.8rem 1rem;">
        <div style="display: flex; flex-direction: column; gap: 6px;">
          <div style="display: flex; align-items: center; gap: 8px; font-size: 0.85rem; color: #2E7D32; font-weight: 500;">
            <i class="fa-solid fa-circle-check" style="color: #4CAF50;"></i> High-quality digitized design
          </div>
          <div style="display: flex; align-items: center; gap: 8px; font-size: 0.85rem; color: #2E7D32; font-weight: 500;">
            <i class="fa-solid fa-circle-check" style="color: #4CAF50;"></i> Tested machine files
          </div>
          <div style="display: flex; align-items: center; gap: 8px; font-size: 0.85rem; color: #2E7D32; font-weight: 500;">
            <i class="fa-solid fa-circle-check" style="color: #4CAF50;"></i> Instant digital download
          </div>
          <div style="display: flex; align-items: center; gap: 8px; font-size: 0.85rem; color: #2E7D32; font-weight: 500;">
            <i class="fa-solid fa-circle-check" style="color: #4CAF50;"></i> Suitable for multiple fabric types
          </div>
        </div>
      </div>

      <!-- Details Section in Summary Box -->
      <div class="product-details-summary" style="margin: 1.2rem 0 1rem 0;">
        <h4 style="font-size: 0.95rem; font-weight: 700; color: var(--text-dark); margin: 0 0 0.6rem 0; letter-spacing: 0.2px;">
          Details
        </h4>
        <div class="specs-table">
          <div class="spec-row">
            <span class="spec-label">Design Code</span>
            <span class="spec-colon">:</span>
            <span class="spec-value"><%= design.sku || ('AED-00' + design.id) %></span>
          </div>
          <% if (design.category_name && design.category_name.trim()) { %>
            <div class="spec-row">
              <span class="spec-label">Category</span>
              <span class="spec-colon">:</span>
              <span class="spec-value"><%= design.category_name.trim() %></span>
            </div>
          <% } %>
          <% if (design.formats && design.formats.trim()) { %>
            <div class="spec-row">
              <span class="spec-label">Available Formats</span>
              <span class="spec-colon">:</span>
              <span class="spec-value"><%= design.formats.trim() %></span>
            </div>
          <% } %>
          <% if (design.dimensions && design.dimensions.trim()) { %>
            <div class="spec-row">
              <span class="spec-label">Design Size</span>
              <span class="spec-colon">:</span>
              <span class="spec-value"><%= design.dimensions.trim() %></span>
            </div>
          <% } %>
          <% if (design.hoop_size && design.hoop_size.trim()) { %>
            <div class="spec-row">
              <span class="spec-label">Hoop Size</span>
              <span class="spec-colon">:</span>
              <span class="spec-value"><%= design.hoop_size.trim() %></span>
            </div>
          <% } %>
          <% if (design.total_files_count && design.total_files_count > 1 && design.files_summary) { %>
            <div class="spec-row">
              <span class="spec-label">Files Included</span>
              <span class="spec-colon">:</span>
              <span class="spec-value highlight-bold"><%= design.files_summary %></span>
            </div>
          <% } %>

          <%
            const _stitchFmtLocale = (typeof siteSettings !== 'undefined' && siteSettings && siteSettings.stitch_number_format === 'international') ? 'en-US' : 'en-IN';
            function _parseStitchVal(val) {
              if (val === null || val === undefined || val === '') return null;
              const clean = String(val).replace(/,/g, '').trim();
              if (clean === '') return null;
              const n = parseInt(clean, 10);
              return (!isNaN(n) && n > 0) ? n : null;
            }
            function _fmtStitchVal(n) {
              return (n !== null && n > 0) ? n.toLocaleString(_stitchFmtLocale) : null;
            }

            const _frontNum = _parseStitchVal(design.stitch_count_front !== undefined ? design.stitch_count_front : design.frontStitchCount);
            const _backNum = _parseStitchVal(design.stitch_count_back !== undefined ? design.stitch_count_back : design.backStitchCount);
            const _sleeveNum = _parseStitchVal(design.stitch_count_sleeve !== undefined ? design.stitch_count_sleeve : design.sleeveStitchCount);

            const _frontStr = _fmtStitchVal(_frontNum);
            const _backStr = _fmtStitchVal(_backNum);
            const _sleeveStr = _fmtStitchVal(_sleeveNum);

            const _hasParts = Boolean(_frontNum || _backNum || _sleeveNum);
            const _isManualTotal = Boolean(design.stitch_total_manual === 1 || design.stitch_total_manual === '1' || design.stitchTotalManual === 1 || design.stitchTotalManual === '1');
            const _rawManualTotal = _parseStitchVal(design.stitch_count_total !== undefined ? design.stitch_count_total : (design.totalStitchCount !== undefined ? design.totalStitchCount : design.stitch_count));

            let _finalTotalNum = null;
            if (_isManualTotal && _rawManualTotal) {
              _finalTotalNum = _rawManualTotal;
            } else if (_hasParts) {
              _finalTotalNum = (_frontNum || 0) + (_backNum || 0) + (_sleeveNum || 0);
            } else {
              _finalTotalNum = null;
            }

            const _totalStr = _fmtStitchVal(_finalTotalNum);

            const _showFront = (typeof siteSettings === 'undefined' || siteSettings.show_stitch_front !== '0') && Boolean(_frontStr);
            const _showBack = (typeof siteSettings === 'undefined' || siteSettings.show_stitch_back !== '0') && Boolean(_backStr);
            const _showSleeve = (typeof siteSettings === 'undefined' || siteSettings.show_stitch_sleeve !== '0') && Boolean(_sleeveStr);
            const _showTotal = (typeof siteSettings === 'undefined' || siteSettings.show_stitch_total !== '0') && Boolean(_totalStr) && (_hasParts || (_isManualTotal && _rawManualTotal));

            const _labelFront = (typeof siteSettings !== 'undefined' && siteSettings.label_stitch_front) || 'Stitch Count (Front)';
            const _labelBack = (typeof siteSettings !== 'undefined' && siteSettings.label_stitch_back) || 'Stitch Count (Back)';
            const _labelSleeve = (typeof siteSettings !== 'undefined' && siteSettings.label_stitch_sleeve) || 'Stitch Count (Sleeve)';
            const _labelTotal = (typeof siteSettings !== 'undefined' && siteSettings.label_stitch_total) || 'Total Stitch Count';
          %>

          <% if (_showFront) { %>
            <div class="spec-row">
              <span class="spec-label"><%= _labelFront %></span>
              <span class="spec-colon">:</span>
              <span class="spec-value"><%= _frontStr %></span>
            </div>
          <% } %>
          <% if (_showBack) { %>
            <div class="spec-row">
              <span class="spec-label"><%= _labelBack %></span>
              <span class="spec-colon">:</span>
              <span class="spec-value"><%= _backStr %></span>
            </div>
          <% } %>
          <% if (_showSleeve) { %>
            <div class="spec-row">
              <span class="spec-label"><%= _labelSleeve %></span>
              <span class="spec-colon">:</span>
              <span class="spec-value"><%= _sleeveStr %></span>
            </div>
          <% } %>
          <% if (_showTotal) { %>
            <div class="spec-row">
              <span class="spec-label"><%= _labelTotal %></span>
              <span class="spec-colon">:</span>
              <span class="spec-value highlight-bold"><%= _totalStr %></span>
            </div>
          <% } %>
        </div>

        <% if (design.description && design.description.trim()) { %>
          <div style="margin-top: 1rem; padding-top: 0.9rem; border-top: 1px dashed var(--border-light); font-size: 0.88rem; color: var(--text-dark); line-height: 1.6; white-space: pre-line;">
            <%= design.description %>
          </div>
        <% } %>
      </div>

      <!-- JSON-LD Structured Data with Stitches -->
      <script type="application/ld+json">
      {
        "@context": "https://schema.org/",
        "@type": "Product",
        "name": <%- JSON.stringify(design.title) %>,
        "sku": <%- JSON.stringify(design.sku || ('AED-00' + design.id)) %>,
        "description": <%- JSON.stringify((design.description ? design.description + ' ' : '') + (_showTotal && _totalStr ? 'Total Stitch Count: ' + _totalStr + '. ' : '')) %>,
        "offers": {
          "@type": "Offer",
          "priceCurrency": "INR",
          "price": <%= (design.sale_price !== null && design.sale_price !== undefined) ? design.sale_price : design.price %>,
          "availability": "https://schema.org/InStock"
        }
      }
      </script>

      <%
        const hasVariants = (typeof variants !== 'undefined' && Array.isArray(variants) && variants.length > 0);
        const purchasedVariantList = (typeof purchasedVariantIds !== 'undefined' && Array.isArray(purchasedVariantIds)) ? purchasedVariantIds : [];
        const isFullyPurchasedLegacy = (!hasVariants && typeof hasPurchased !== 'undefined' && hasPurchased);
      %>

      <!-- Add to Cart & Buy Now Actions -->
      <form action="/cart/add" method="POST" class="detail-action-form" id="addToCartForm">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="design_id" value="<%= design.id %>">
        <input type="hidden" name="variant_id" id="addToCartVariantId" value="">
      </form>

      <form action="/cart/buy-now?_csrf=<%= csrfToken %>" method="POST" id="buyNowForm">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="design_id" value="<%= design.id %>">
        <input type="hidden" name="variant_id" id="buyNowVariantId" value="">
      </form>

      <div class="detail-action-box" style="margin-top: 1rem; display: flex; flex-direction: column; gap: 10px;">
        <% if (isFullyPurchasedLegacy) { %>
          <div class="purchased-download-banner" style="background: #FAF6F0; border: 1px solid #EFE6D9; padding: 1.25rem; border-radius: 16px; margin-bottom: 0.5rem; text-align: left;">
            <div style="display: flex; align-items: center; gap: 8px; color: #2E7D32; font-weight: 700; font-size: 1.05rem; margin-bottom: 0.6rem;">
              <i class="fa-solid fa-circle-check" style="font-size: 1.2rem; color: #2E7D32;"></i>
              <span>✓ Purchased — Available Downloads</span>
            </div>
            <p style="font-size: 0.88rem; color: #5C504A; margin-bottom: 0.6rem;">
              Your purchased design is ready to download.
            </p>
            <div style="font-size: 0.85rem; color: #6E615A; margin-bottom: 1rem;">
              <strong>Available Formats:</strong> <%= (design.formats ? [...new Set(design.formats.split(',').map(f => f.trim().toUpperCase()))].join(' • ') : 'DST') %>
            </div>
            <% const cleanTitle = design.title || design.slug || ('AED_' + design.id); %>
            <a href="/user/download/<%= design.id %>" download class="btn btn-primary" style="padding: 0.75rem 1.2rem; font-size: 0.95rem; border-radius: 12px; font-weight: 700; display: flex; align-items: center; justify-content: center; gap: 8px; background-color: var(--primary);">
              <i class="fa-solid fa-download"></i> Download <%= cleanTitle %>.zip
            </a>
          </div>
        <% } else { %>
          <% if (hasVariants) { %>
            <!-- File Type Variant Selection -->
            <div class="variant-selection-section" id="variantSelectionSection">
              <div class="variant-selection-header">
                <label class="variant-label">
                  <span>Select File / Machine Type:</span>
                  <span class="req">*</span>
                </label>
                <span class="variant-selection-hint">Choose one option before checkout</span>
              </div>

              <div class="variant-pills-grid" id="variantPillsGrid">
                <% variants.forEach(v => { %>
                  <% const isPurchased = purchasedVariantList.includes(v.id); %>
                  <button type="button" 
                          class="variant-pill-btn <%= isPurchased ? 'is-purchased' : '' %>" 
                          data-variant-id="<%= v.id %>" 
                          data-variant-name="<%= v.variant_name %>" 
                          data-purchased="<%= isPurchased ? '1' : '0' %>">
                    <span class="variant-pill-name"><%= v.variant_name %></span>
                    <% if (isPurchased) { %>
                      <span class="variant-pill-tag"><i class="fa-solid fa-circle-check"></i> Already purchased</span>
                    <% } %>
                  </button>
                <% }) %>
              </div>

              <!-- Inline Alert for Already Purchased or Missing Selection -->
              <div id="variantAlertBox" class="variant-alert-box" style="display: none;">
                <i class="fa-solid fa-triangle-exclamation"></i>
                <span id="variantAlertMsg"></span>
              </div>

              <!-- Direct Download Box for an Already-Purchased Variant -->
              <div id="variantPurchasedDownloadBox" class="variant-purchased-dl-box" style="display: none; margin-top: 8px; margin-bottom: 8px;">
                <a href="#" id="variantDirectDownloadBtn" download class="btn btn-primary" style="padding: 0.65rem 1.1rem; font-size: 0.88rem; border-radius: 10px; font-weight: 700; display: flex; align-items: center; justify-content: center; gap: 8px; background-color: #2E7D32;">
                  <i class="fa-solid fa-download"></i> Download <span id="dlVariantName"></span>
                </a>
              </div>

              <!-- File Usage Guide -->
              <% if (typeof fileUsageGuide !== 'undefined' && fileUsageGuide) { %>
                <div class="file-usage-guide-box">
                  <div class="file-usage-title">
                    <i class="fa-solid fa-circle-info"></i>
                    <span>File Usage Guide</span>
                  </div>
                  <div class="file-usage-body">
                    <%= fileUsageGuide %>
                  </div>
                </div>
              <% } %>
            </div>
          <% } %>

          <button type="submit" form="addToCartForm" id="detailAddToCartBtn" class="btn btn-outline btn-block btn-lg" style="border-color: var(--primary); color: var(--primary);">
            <i class="fa-solid fa-cart-shopping"></i> Add to Cart
          </button>
          <button type="submit" form="buyNowForm" id="detailBuyNowBtn" class="btn btn-primary btn-block btn-lg">
            <i class="fa-solid fa-bag-shopping"></i> Buy Now
          </button>
          <div style="font-size: 0.82rem; color: #666; margin-top: 0.3rem; text-align: center;">
            <i class="fa-solid fa-lock" style="color: #888;"></i> Formats: <%= design.formats || 'None' %> &bull; Purchase this design to download files
          </div>
        <% } %>
      </div>
    </div>

    <!-- Right Column: 5 Value Cards Stack matching Reference -->
    <div class="value-cards-stack">
      <div class="value-card-item">
        <div class="value-icon-box"><i class="fa-solid fa-download"></i></div>
        <div>
          <h4>Instant Download</h4>
          <p>Get files immediately after purchase</p>
        </div>
      </div>

      <div class="value-card-item">
        <div class="value-icon-box"><i class="fa-solid fa-file-code"></i></div>
        <div>
          <h4>Available Formats</h4>
          <p><%= design.formats ? design.formats + ' included' : 'Machine formats included' %></p>
        </div>
      </div>

      <div class="value-card-item">
        <div class="value-icon-box"><i class="fa-solid fa-shield-halved"></i></div>
        <div>
          <h4>Tested Design</h4>
          <p>100% tested machine fills</p>
        </div>
      </div>

      <div class="value-card-item">
        <div class="value-icon-box"><i class="fa-solid fa-headset"></i></div>
        <div>
          <h4>Dedicated Support</h4>
          <p>We're here to help you</p>
        </div>
      </div>

      <div class="value-card-item">
        <div class="value-icon-box"><i class="fa-solid fa-infinity"></i></div>
        <div>
          <h4>Commercial Use</h4>
          <p>Use on personal & business projects</p>
        </div>
      </div>
    </div>
  </div>

  <% if ((typeof siteSettings !== 'undefined' && siteSettings.show_design_reviews === '1') || (typeof siteSettings !== 'undefined' && siteSettings.show_design_related === '1' && typeof relatedDesigns !== 'undefined' && relatedDesigns && relatedDesigns.length > 0)) { %>
    <!-- Detail Content Section: Reviews & Related Designs -->
    <div class="detail-content-section" style="margin-top: 1.5rem; margin-bottom: 2rem;">
      <div class="tab-main-grid" style="display: block; width: 100%;">
        <div class="tab-left-pane" style="width: 100%;">
          <% if (typeof siteSettings !== 'undefined' && siteSettings.show_design_reviews === '1') { %>
            <!-- Real Reviews (Only when toggle is ON in Admin and real reviews exist) -->
            <div class="real-reviews-container" style="background: #FFFFFF; border: 1px solid var(--border-light); border-radius: 14px; padding: 1.4rem; margin-bottom: 1.5rem; box-shadow: var(--shadow-sm);">
              <h3 class="tab-heading" style="margin-bottom: 0.8rem; font-family: var(--font-heading); font-size: 1.2rem; font-weight: 700;">Customer Reviews (<%= (typeof reviews !== 'undefined' && reviews) ? reviews.length : 0 %>)</h3>
              <% if (typeof reviews !== 'undefined' && reviews && reviews.length > 0) { %>
                <div style="display: flex; flex-direction: column; gap: 12px;">
                  <% reviews.forEach(r => { %>
                    <div style="background: #FAF6F0; border: 1px solid var(--border-light); border-radius: 10px; padding: 0.9rem 1rem;">
                      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
                        <strong style="font-size: 0.9rem; color: var(--text-dark);"><%= r.user_name || 'Customer' %></strong>
                        <span style="color: #F39C12; font-size: 0.85rem; font-weight: 600;">★ <%= r.rating %></span>
                      </div>
                      <p style="font-size: 0.88rem; color: var(--text-dark); margin: 0; line-height: 1.5;"><%= r.comment %></p>
                    </div>
                  <% }) %>
                </div>
              <% } else { %>
                <p style="color: var(--text-muted); font-size: 0.88rem; margin: 0;">No approved reviews yet for this design.</p>
              <% } %>
            </div>
          <% } %>

          <% if (typeof siteSettings !== 'undefined' && siteSettings.show_design_related === '1' && typeof relatedDesigns !== 'undefined' && relatedDesigns && relatedDesigns.length > 0) { %>
            <!-- Real Database Related Designs (Only when toggle is ON in Admin) -->
            <div class="real-related-container" style="margin-bottom: 1.5rem;">
              <div class="section-heading-box flex-between" style="margin-bottom: 0.8rem;">
                <h3 class="tab-heading" style="font-family: var(--font-heading); font-size: 1.2rem; font-weight: 700; margin: 0;">Related Designs</h3>
                <a href="/designs?category=<%= design.category_slug %>" class="view-all-link">View All <i class="fa-solid fa-arrow-right"></i></a>
              </div>
              <div class="grid-4-strict">
                <% relatedDesigns.forEach(relDesign => { %>
                  <%- include('../partials/design-card', {
                    design: relDesign,
                    userPurchasedDesignIds: typeof userPurchasedDesignIds !== 'undefined' ? userPurchasedDesignIds : [],
                    userWishlistDesignIds: typeof userWishlistDesignIds !== 'undefined' ? userWishlistDesignIds : [],
                    siteSettings: typeof siteSettings !== 'undefined' ? siteSettings : {}
                  }) %>
                <% }) %>
              </div>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  <% } %>

  <!-- Reusable Trust/Feature Cards Bar (Controls via Admin Homepage/Settings) -->
  <%- include('../partials/feature-cards', { page: 'design_detail' }) %>
</div>

<!-- Fullscreen Tap-to-Zoom / Pinch-Zoom Lightbox Modal -->
<div id="imageLightboxModal" class="image-lightbox-modal" style="display: none;" onclick="closeLightbox(event)">
  <button type="button" class="lightbox-close-btn" onclick="closeLightbox(event)" aria-label="Close Lightbox">&times;</button>
  <% if (typeof siteSettings === 'undefined' || siteSettings.show_preview_download_button !== '0') { %>
    <button type="button" class="lightbox-download-btn" onclick="event.stopPropagation(); downloadPreviewImage(event, document.getElementById('lightboxImg')?.src);" aria-label="Download Image" title="<%= design.has_clean_original ? 'Download Original File' : 'Download Preview Quality (Original not available)' %>">
      <i class="fa-solid fa-download"></i>
      <span>Download</span>
    </button>
  <% } %>
  <div class="lightbox-viewport" id="lightboxViewport" onclick="event.stopPropagation()">
    <img id="lightboxImg" src="" alt="Full Preview" draggable="false">
  </div>
  <div class="lightbox-footer-hint">Double tap or pinch to zoom • Tap outside to close</div>
</div>

<script>
  function changeMainImage(src, element) {
    document.getElementById('mainDisplayImg').src = src;
    document.querySelectorAll('.thumb-item').forEach(el => el.classList.remove('active'));
    element.classList.add('active');
  }

  // Download currently displayed preview / original image (Byte-for-byte fidelity with status check & user feedback)
  async function downloadPreviewImage(e, explicitSrc) {
    if (e) {
      e.preventDefault();
      e.stopPropagation();
    }

    const targetImgSrc = explicitSrc || document.getElementById('mainDisplayImg')?.src;
    if (!targetImgSrc) {
      if (typeof showToast === 'function') {
        showToast('Preview image not available for download.', 'error');
      } else {
        alert('Preview image not available for download.');
      }
      return;
    }

    const designSlug = '<%= design.slug || design.id %>';
    const downloadUrl = `/designs/${encodeURIComponent(designSlug)}/preview-download?imgUrl=${encodeURIComponent(targetImgSrc)}`;

    <% if (typeof siteSettings !== 'undefined' && siteSettings.require_login_preview_download === '1') { %>
      if (typeof window.isUserLoggedIn !== 'undefined' && !window.isUserLoggedIn) {
        if (typeof openLoginModal === 'function') {
          openLoginModal(() => { downloadPreviewImage(null, explicitSrc); });
          return;
        } else {
          window.location.href = `/auth/login?returnUrl=${encodeURIComponent(window.location.pathname)}`;
          return;
        }
      }
    <% } %>

    const btn = (e && e.currentTarget) ? e.currentTarget : document.getElementById('downloadPreviewBtn');
    const originalHtml = btn ? btn.innerHTML : null;
    if (btn) {
      btn.disabled = true;
      btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> <span>Downloading...</span>';
    }

    try {
      const response = await fetch(downloadUrl);
      const contentType = response.headers.get('content-type') || '';

      if (!response.ok || contentType.includes('text/html')) {
        let errorMsg = 'Download failed - please try again';
        try {
          const errData = await response.json();
          if (errData && errData.message) errorMsg = errData.message;
        } catch (_) {}
        if (typeof showToast === 'function') {
          showToast(errorMsg, 'error');
        } else {
          alert(errorMsg);
        }
        return;
      }

      // Check if server indicated original was missing and served preview fallback
      const originalStatus = response.headers.get('x-original-status');
      if (originalStatus === 'missing-preview-fallback') {
        if (typeof showToast === 'function') {
          showToast('Preview quality (original not available - admin: please re-upload)', 'info');
        }
      }

      // Extract filename from Content-Disposition header if available
      const disposition = response.headers.get('content-disposition') || '';
      let filename = '';
      const utf8Match = disposition.match(/filename\*=UTF-8''([^;]+)/i);
      const regularMatch = disposition.match(/filename="?([^";]+)"?/i);
      if (utf8Match && utf8Match[1]) {
        filename = decodeURIComponent(utf8Match[1].trim());
      } else if (regularMatch && regularMatch[1]) {
        filename = regularMatch[1].trim();
      }
      if (!filename) {
        const ext = contentType.includes('webp') ? '.webp' : '.png';
        filename = '<%= (design.sku || design.title || "design").replace(/[/\\?%*:|"<>]/g, "-") %>' + ext;
      }

      const blob = await response.blob();
      const blobUrl = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.style.display = 'none';
      a.href = blobUrl;
      a.download = filename;
      document.body.appendChild(a);
      a.click();
      setTimeout(() => {
        document.body.removeChild(a);
        URL.revokeObjectURL(blobUrl);
      }, 2000);
    } catch (err) {
      console.error('[Download error]:', err);
      if (typeof showToast === 'function') {
        showToast('Download failed - please try again', 'error');
      } else {
        alert('Download failed - please try again');
      }
    } finally {
      if (btn && originalHtml) {
        btn.disabled = false;
        btn.innerHTML = originalHtml;
      }
    }
  }

  // Tap-to-Zoom Fullscreen Lightbox Controller (Pinch, Pan, Drag & Double-tap)
  let currentZoomScale = 1;
  let initialPinchDistance = 0;
  let initialScale = 1;
  let isLightboxOpen = false;
  let panX = 0;
  let panY = 0;
  let isDragging = false;
  let dragStartX = 0;
  let dragStartY = 0;

  function updateLightboxTransform() {
    const img = document.getElementById('lightboxImg');
    if (!img) return;
    if (currentZoomScale <= 1) {
      panX = 0;
      panY = 0;
      img.style.transform = 'scale(1) translate(0px, 0px)';
      img.style.cursor = 'grab';
    } else {
      img.style.transform = `scale(${currentZoomScale}) translate(${panX / currentZoomScale}px, ${panY / currentZoomScale}px)`;
      img.style.cursor = isDragging ? 'grabbing' : 'grab';
    }
  }

  function openLightbox(src) {
    const modal = document.getElementById('imageLightboxModal');
    const img = document.getElementById('lightboxImg');
    if (!modal || !img) return;

    img.src = src || document.getElementById('mainDisplayImg')?.src;
    currentZoomScale = 1;
    panX = 0;
    panY = 0;
    img.style.transform = 'scale(1) translate(0px, 0px)';
    modal.style.display = 'flex';
    document.body.style.overflow = 'hidden';
    document.documentElement.style.overflow = 'hidden';
    isLightboxOpen = true;
  }

  function closeLightbox(e) {
    if (e && e.target && e.target.id === 'lightboxImg') return; // Don't close when clicking image
    const modal = document.getElementById('imageLightboxModal');
    if (!modal) return;
    modal.style.display = 'none';
    document.body.style.overflow = '';
    document.documentElement.style.overflow = '';
    isLightboxOpen = false;
    currentZoomScale = 1;
    panX = 0;
    panY = 0;
  }

  // Mobile swipe navigation for gallery
  document.addEventListener('DOMContentLoaded', () => {
    const mainWrapper = document.getElementById('mainImageDisplayWrapper');
    if (!mainWrapper) return;

    let touchStartX = 0;
    let touchStartY = 0;

    mainWrapper.addEventListener('touchstart', (e) => {
      if (e.touches.length === 1) {
        touchStartX = e.touches[0].clientX;
        touchStartY = e.touches[0].clientY;
      }
    }, { passive: true });

    mainWrapper.addEventListener('touchend', (e) => {
      if (e.changedTouches.length === 1) {
        const deltaX = e.changedTouches[0].clientX - touchStartX;
        const deltaY = e.changedTouches[0].clientY - touchStartY;
        // Check if horizontal swipe and larger than vertical movement
        if (Math.abs(deltaX) > 40 && Math.abs(deltaX) > Math.abs(deltaY)) {
          const thumbs = Array.from(document.querySelectorAll('.thumbnails-stack .thumb-item'));
          if (thumbs.length <= 1) return;
          const activeIndex = thumbs.findIndex(t => t.classList.contains('active'));
          let nextIndex = activeIndex;
          if (deltaX < 0) {
            // Swipe Left -> Next Image
            nextIndex = (activeIndex + 1) % thumbs.length;
          } else {
            // Swipe Right -> Prev Image
            nextIndex = (activeIndex - 1 + thumbs.length) % thumbs.length;
          }
          if (thumbs[nextIndex]) {
            thumbs[nextIndex].click();
          }
        }
      }
    }, { passive: true });
  });

  // Lightbox Pinch, Pan, Drag, and Keyboard Zoom Handlers
  document.addEventListener('DOMContentLoaded', () => {
    const img = document.getElementById('lightboxImg');
    const viewport = document.getElementById('lightboxViewport');
    if (!img || !viewport) return;

    let lastTap = 0;

    // Double tap toggle (Mobile)
    img.addEventListener('touchend', function(e) {
      if (e.touches.length > 0) return;
      const currentTime = Date.now();
      const tapLength = currentTime - lastTap;
      if (tapLength < 300 && tapLength > 0) {
        e.preventDefault();
        if (currentZoomScale > 1) {
          currentZoomScale = 1;
          panX = 0;
          panY = 0;
        } else {
          currentZoomScale = 2.5;
        }
        updateLightboxTransform();
      }
      lastTap = currentTime;
    });

    // Touch Pinch & Pan Handlers (Mobile)
    let touchPanStartX = 0;
    let touchPanStartY = 0;

    viewport.addEventListener('touchstart', function(e) {
      if (e.touches.length === 2) {
        initialPinchDistance = Math.hypot(
          e.touches[0].pageX - e.touches[1].pageX,
          e.touches[0].pageY - e.touches[1].pageY
        );
        initialScale = currentZoomScale;
      } else if (e.touches.length === 1 && currentZoomScale > 1) {
        touchPanStartX = e.touches[0].pageX - panX;
        touchPanStartY = e.touches[0].pageY - panY;
      }
    }, { passive: true });

    viewport.addEventListener('touchmove', function(e) {
      if (e.touches.length === 2 && initialPinchDistance > 0) {
        e.preventDefault();
        const dist = Math.hypot(
          e.touches[0].pageX - e.touches[1].pageX,
          e.touches[0].pageY - e.touches[1].pageY
        );
        const scale = (dist / initialPinchDistance) * initialScale;
        currentZoomScale = Math.min(Math.max(1, scale), 4);
        updateLightboxTransform();
      } else if (e.touches.length === 1 && currentZoomScale > 1) {
        e.preventDefault();
        panX = e.touches[0].pageX - touchPanStartX;
        panY = e.touches[0].pageY - touchPanStartY;
        updateLightboxTransform();
      }
    }, { passive: false });

    // Desktop Click-to-Zoom & Mouse Drag Pan
    viewport.addEventListener('mousedown', function(e) {
      if (e.target !== img && e.target !== viewport) return;
      if (currentZoomScale > 1) {
        isDragging = true;
        dragStartX = e.clientX - panX;
        dragStartY = e.clientY - panY;
        e.preventDefault();
      }
    });

    window.addEventListener('mousemove', function(e) {
      if (isDragging && isLightboxOpen && currentZoomScale > 1) {
        panX = e.clientX - dragStartX;
        panY = e.clientY - dragStartY;
        updateLightboxTransform();
      }
    });

    window.addEventListener('mouseup', function() {
      if (isDragging) {
        isDragging = false;
        updateLightboxTransform();
      }
    });

    img.addEventListener('click', function(e) {
      e.stopPropagation();
      // Toggle zoom
      currentZoomScale = currentZoomScale > 1 ? 1 : 2.5;
      updateLightboxTransform();
    });

    // Desktop Escape key to close
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && isLightboxOpen) {
        closeLightbox();
      }
    });
  });

  document.addEventListener('DOMContentLoaded', () => {
    const hasVariants = <%= (typeof variants !== 'undefined' && Array.isArray(variants) && variants.length > 0) ? 'true' : 'false' %>;
    const addToCartVariantInput = document.getElementById('addToCartVariantId');
    const buyNowVariantInput = document.getElementById('buyNowVariantId');
    const addToCartBtn = document.getElementById('detailAddToCartBtn');
    const buyNowBtn = document.getElementById('detailBuyNowBtn');
    const variantAlertBox = document.getElementById('variantAlertBox');
    const variantAlertMsg = document.getElementById('variantAlertMsg');
    const variantDlBox = document.getElementById('variantPurchasedDownloadBox');
    const directDlBtn = document.getElementById('variantDirectDownloadBtn');
    const dlVariantName = document.getElementById('dlVariantName');
    const variantPillBtns = document.querySelectorAll('.variant-pill-btn');

    let currentSelectedVariantId = '';
    let isSelectedVariantPurchased = false;

    function showAlert(msg) {
      if (variantAlertBox && variantAlertMsg) {
        variantAlertMsg.textContent = msg;
        variantAlertBox.style.display = 'flex';
      }
    }

    function hideAlert() {
      if (variantAlertBox) {
        variantAlertBox.style.display = 'none';
      }
    }

    if (hasVariants && variantPillBtns.length > 0) {
      variantPillBtns.forEach(btn => {
        btn.addEventListener('click', function() {
          const vId = this.dataset.variantId;
          const isPurchased = this.dataset.purchased === '1';
          const vName = this.dataset.variantName || 'Selected File';

          // Update active pill state
          variantPillBtns.forEach(b => b.classList.remove('is-selected'));
          this.classList.add('is-selected');

          currentSelectedVariantId = vId;
          isSelectedVariantPurchased = isPurchased;

          if (isPurchased) {
            showAlert('You Have Already Purchased This Design. Please Select Some Other File.');
            if (addToCartBtn) { addToCartBtn.disabled = true; addToCartBtn.style.opacity = '0.5'; }
            if (buyNowBtn) { buyNowBtn.disabled = true; buyNowBtn.style.opacity = '0.5'; }
            if (addToCartVariantInput) addToCartVariantInput.value = '';
            if (buyNowVariantInput) buyNowVariantInput.value = '';

            if (variantDlBox && directDlBtn) {
              directDlBtn.href = '/user/download/<%= design.id %>/all?variant_id=' + encodeURIComponent(vId);
              if (dlVariantName) dlVariantName.textContent = vName;
              variantDlBox.style.display = 'block';
            }
          } else {
            hideAlert();
            if (variantDlBox) variantDlBox.style.display = 'none';
            if (addToCartBtn) { addToCartBtn.disabled = false; addToCartBtn.style.opacity = '1'; }
            if (buyNowBtn) { buyNowBtn.disabled = false; buyNowBtn.style.opacity = '1'; }
            if (addToCartVariantInput) addToCartVariantInput.value = vId;
            if (buyNowVariantInput) buyNowVariantInput.value = vId;
          }
        });
      });
    }

    function validateVariantSelection(e) {
      if (!hasVariants) return true;
      if (!currentSelectedVariantId) {
        e.preventDefault();
        showAlert('Please select a file / machine type to proceed.');
        const section = document.getElementById('variantSelectionSection');
        if (section) section.scrollIntoView({ behavior: 'smooth', block: 'center' });
        return false;
      }
      if (isSelectedVariantPurchased) {
        e.preventDefault();
        showAlert('You Have Already Purchased This Design. Please Select Some Other File.');
        return false;
      }
      return true;
    }

    const addToCartForm = document.getElementById('addToCartForm');
    if (addToCartForm) {
      addToCartForm.addEventListener('submit', function(e) {
        if (!validateVariantSelection(e)) return;

        if (typeof window.isUserLoggedIn !== 'undefined' && !window.isUserLoggedIn) {
          e.preventDefault();
          const returnUrl = window.location.pathname + window.location.search;
          if (typeof openLoginModal === 'function') {
            openLoginModal(() => addToCartForm.submit(), returnUrl);
          } else {
            window.location.href = '/auth/login?returnTo=' + encodeURIComponent(returnUrl);
          }
        }
      });
    }

    const buyNowForm = document.getElementById('buyNowForm');
    if (buyNowForm) {
      buyNowForm.addEventListener('submit', function(e) {
        if (!validateVariantSelection(e)) return;

        if (typeof window.isUserLoggedIn !== 'undefined' && !window.isUserLoggedIn) {
          e.preventDefault();
          const returnUrl = '/cart/buy-now?design_id=<%= design.id %>' + (currentSelectedVariantId ? '&variant_id=' + encodeURIComponent(currentSelectedVariantId) : '');
          if (typeof openLoginModal === 'function') {
            openLoginModal(() => buyNowForm.submit(), returnUrl);
          } else {
            window.location.href = '/auth/login?returnTo=' + encodeURIComponent(returnUrl);
          }
        }
      });
    }
  });
</script>

<%- include('../partials/footer') %>
