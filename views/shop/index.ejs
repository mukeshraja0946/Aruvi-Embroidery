<%- include('../partials/header') %>

<div class="container designs-page-container">
  <!-- Page Header: Title & Breadcrumbs without promotional hero banner -->
  <div class="page-banner-card clean-banner">
    <div class="banner-content">
      <div class="breadcrumb-trail banner-desktop-only">
        <a href="/">Home</a> <span class="breadcrumb-sep">›</span> <span><%= selectedCategory ? selectedCategory.name : 'Designs' %></span>
      </div>
      <h1 class="page-banner-title"><%= selectedCategory ? selectedCategory.name : 'All Designs' %></h1>
      <p class="page-banner-subtitle banner-desktop-only">
        Explore our collection of premium machine embroidery designs. Perfect for personal and commercial use.
      </p>
    </div>
  </div>

  <%
    function buildRemoveUrl(keyToRemove) {
      let queryObj = {};
      if (keyToRemove !== 'search' && search) queryObj.search = search;
      if (keyToRemove !== 'category' && selectedCategory) queryObj.category = selectedCategory.slug;
      if (keyToRemove !== 'format' && selectedFormat) queryObj.format = selectedFormat;
      if (keyToRemove !== 'max_price' && max_price && Number(max_price) < 2000) queryObj.max_price = max_price;
      if (keyToRemove !== 'min_rating' && min_rating) queryObj.min_rating = min_rating;
      if (sort && sort !== 'newest') queryObj.sort = sort;
      let qs = new URLSearchParams(queryObj).toString();
      return '/designs' + (qs ? '?' + qs : '');
    }

    let hasActiveFilters = search || selectedCategory || selectedFormat || (max_price && Number(max_price) < 2000) || min_rating;
    const pageNum = typeof currentPage !== 'undefined' ? (parseInt(currentPage) || 1) : 1;
    const pageLimit = typeof limit !== 'undefined' ? limit : 24;
    const totalCount = typeof total !== 'undefined' ? parseInt(total) : designs.length;
    const fromNum = designs.length > 0 ? ((pageNum - 1) * pageLimit + 1) : 0;
    const toNum = designs.length > 0 ? Math.min((pageNum - 1) * pageLimit + designs.length, totalCount) : 0;
    const totalDisplay = totalCount >= 10 ? (totalCount + '+') : (totalCount || designs.length);
  %>

  <!-- Overlay for Mobile Filter Drawer -->
  <div class="mobile-filter-overlay" id="filterOverlay"></div>

  <!-- Main Grid: Left Filter Sidebar + Right 4-Column / 2-Column Product Grid -->
  <div class="shop-listing-layout">
    <!-- Left Filter Sidebar / Mobile Bottom-Sheet Drawer -->
    <aside class="filter-sidebar" id="filterSidebar">
      <!-- Drawer Header matching Reference UI -->
      <div class="filter-drawer-header">
        <div class="drawer-header-left">
          <i class="fa-solid fa-sliders red-filter-icon"></i>
          <h2 class="drawer-title">Filters</h2>
        </div>
        <div class="drawer-header-right">
          <a href="/designs" class="clear-all-link">Clear All</a>
          <button type="button" class="close-filter-btn" id="closeFilterBtn" aria-label="Close filters">
            <i class="fa-solid fa-xmark"></i>
          </button>
        </div>
      </div>

      <form action="/designs" method="GET" id="filterForm" class="filter-form-body">
        <% if (search) { %><input type="hidden" name="search" value="<%= search %>"><% } %>
        <% if (sort && sort !== 'latest') { %><input type="hidden" name="sort" value="<%= sort %>"><% } %>

        <!-- 1. Categories Accordion -->
        <div class="filter-accordion-group">
          <div class="accordion-header" onclick="toggleAccordion(this)">
            <h3>Categories</h3>
            <i class="fa-solid fa-chevron-up accordion-icon"></i>
          </div>
          <div class="accordion-content open">
            <div class="category-chips-wrap">
              <label class="cat-chip-label <%= !selectedCategory ? 'active' : '' %>">
                <input type="radio" name="category" value="" <%= !selectedCategory ? 'checked' : '' %> onchange="handleFilterChange(this)">
                All Categories (<%= typeof totalActiveDesigns !== 'undefined' ? totalActiveDesigns : (total || 0) %>)
              </label>
              <% categories.forEach(cat => { %>
                <% if (typeof hideEmptyCategories === 'undefined' || !hideEmptyCategories || cat.design_count > 0 || (selectedCategory && selectedCategory.slug === cat.slug)) { %>
                  <label class="cat-chip-label <%= selectedCategory && selectedCategory.slug === cat.slug ? 'active' : '' %>">
                    <input type="radio" name="category" value="<%= cat.slug %>" <%= selectedCategory && selectedCategory.slug === cat.slug ? 'checked' : '' %> onchange="handleFilterChange(this)">
                    <%= cat.name %> (<%= cat.design_count %>)
                  </label>
                <% } %>
              <% }) %>
            </div>
          </div>
        </div>

        <!-- 2. Price Range Accordion -->
        <div class="filter-accordion-group">
          <div class="accordion-header" onclick="toggleAccordion(this)">
            <h3>Price Range</h3>
            <i class="fa-solid fa-chevron-up accordion-icon"></i>
          </div>
          <div class="accordion-content open">
            <div class="price-range-top">
              <span>₹0</span>
              <span id="priceValDisplay">₹<%= max_price || 2000 %></span>
            </div>
            <input type="range" min="0" max="2000" step="50" name="max_price" value="<%= max_price || 2000 %>" class="custom-red-range" oninput="document.getElementById('priceValDisplay').innerText = '₹' + this.value" onchange="handleFilterChange(this)">
            
            <div class="price-presets-wrap">
              <label class="price-preset-chip <%= !max_price || max_price == 2000 ? 'active' : '' %>">
                <input type="radio" name="price_preset" value="2000" onchange="this.form.max_price.value=this.value; document.getElementById('priceValDisplay').innerText='₹2000'; handleFilterChange(this)"> All
              </label>
              <label class="price-preset-chip <%= max_price == 100 ? 'active' : '' %>">
                <input type="radio" name="price_preset" value="100" onchange="this.form.max_price.value=this.value; document.getElementById('priceValDisplay').innerText='₹100'; handleFilterChange(this)"> ₹0 - ₹100
              </label>
              <label class="price-preset-chip <%= max_price == 200 ? 'active' : '' %>">
                <input type="radio" name="price_preset" value="200" onchange="this.form.max_price.value=this.value; document.getElementById('priceValDisplay').innerText='₹200'; handleFilterChange(this)"> ₹101 - ₹200
              </label>
              <label class="price-preset-chip <%= max_price == 300 ? 'active' : '' %>">
                <input type="radio" name="price_preset" value="300" onchange="this.form.max_price.value=this.value; document.getElementById('priceValDisplay').innerText='₹300'; handleFilterChange(this)"> ₹201 - ₹300
              </label>
              <label class="price-preset-chip <%= max_price == 400 ? 'active' : '' %>">
                <input type="radio" name="price_preset" value="400" onchange="this.form.max_price.value=this.value; document.getElementById('priceValDisplay').innerText='₹400'; handleFilterChange(this)"> ₹301 - ₹400
              </label>
              <label class="price-preset-chip <%= max_price == 500 ? 'active' : '' %>">
                <input type="radio" name="price_preset" value="500" onchange="this.form.max_price.value=this.value; document.getElementById('priceValDisplay').innerText='₹500'; handleFilterChange(this)"> ₹401 - ₹500
              </label>
            </div>
          </div>
        </div>

        <!-- 3. File Format Accordion -->
        <div class="filter-accordion-group">
          <div class="accordion-header" onclick="toggleAccordion(this)">
            <h3>File Format</h3>
            <i class="fa-solid fa-chevron-down accordion-icon"></i>
          </div>
          <div class="accordion-content">
            <div class="format-checkbox-grid">
              <label class="format-check-item">
                <input type="checkbox" name="format" value="DST" <%= selectedFormat === 'DST' ? 'checked' : '' %> onchange="handleFilterChange(this)"> DST
              </label>
              <label class="format-check-item">
                <input type="checkbox" name="format" value="PES" <%= selectedFormat === 'PES' ? 'checked' : '' %> onchange="handleFilterChange(this)"> PES
              </label>
              <label class="format-check-item">
                <input type="checkbox" name="format" value="JEF" <%= selectedFormat === 'JEF' ? 'checked' : '' %> onchange="handleFilterChange(this)"> JEF
              </label>
              <label class="format-check-item">
                <input type="checkbox" name="format" value="EXP" <%= selectedFormat === 'EXP' ? 'checked' : '' %> onchange="handleFilterChange(this)"> EXP
              </label>
            </div>
          </div>
        </div>

        <!-- 4. Rating Accordion -->
        <div class="filter-accordion-group">
          <div class="accordion-header" onclick="toggleAccordion(this)">
            <h3>Rating</h3>
            <i class="fa-solid fa-chevron-down accordion-icon"></i>
          </div>
          <div class="accordion-content">
            <div class="rating-radio-list">
              <label class="rating-radio-item">
                <input type="radio" name="min_rating" value="4.0" <%= min_rating === '4.0' ? 'checked' : '' %> onchange="handleFilterChange(this)">
                <span class="stars-gold">★★★★★</span> 4 & above
              </label>
              <label class="rating-radio-item">
                <input type="radio" name="min_rating" value="3.0" <%= min_rating === '3.0' ? 'checked' : '' %> onchange="handleFilterChange(this)">
                <span class="stars-gold">★★★★☆</span> 3 & above
              </label>
              <label class="rating-radio-item">
                <input type="radio" name="min_rating" value="2.0" <%= min_rating === '2.0' ? 'checked' : '' %> onchange="handleFilterChange(this)">
                <span class="stars-gold">★★★☆☆</span> 2 & above
              </label>
              <label class="rating-radio-item">
                <input type="radio" name="min_rating" value="1.0" <%= min_rating === '1.0' ? 'checked' : '' %> onchange="handleFilterChange(this)">
                <span class="stars-gold">★★☆☆☆</span> 1 & above
              </label>
            </div>
          </div>
        </div>

        <!-- 5. Sort By Accordion -->
        <div class="filter-accordion-group">
          <div class="accordion-header" onclick="toggleAccordion(this)">
            <h3>Sort By</h3>
            <i class="fa-solid fa-chevron-down accordion-icon"></i>
          </div>
          <div class="accordion-content">
            <div class="sort-radio-list">
              <label class="sort-radio-item">
                <input type="radio" name="sort" value="latest" <%= !sort || sort === 'latest' || sort === 'newest' ? 'checked' : '' %> onchange="handleFilterChange(this)"> Latest
              </label>
              <label class="sort-radio-item">
                <input type="radio" name="sort" value="price_asc" <%= sort === 'price_asc' || sort === 'price_low' ? 'checked' : '' %> onchange="handleFilterChange(this)"> Price: Low to High
              </label>
              <label class="sort-radio-item">
                <input type="radio" name="sort" value="price_desc" <%= sort === 'price_desc' || sort === 'price_high' ? 'checked' : '' %> onchange="handleFilterChange(this)"> Price: High to Low
              </label>
              <label class="sort-radio-item">
                <input type="radio" name="sort" value="popular" <%= sort === 'popular' || sort === 'most_popular' ? 'checked' : '' %> onchange="handleFilterChange(this)"> Popular
              </label>
              <label class="sort-radio-item">
                <input type="radio" name="sort" value="top_rated" <%= sort === 'top_rated' || sort === 'rating' ? 'checked' : '' %> onchange="handleFilterChange(this)"> Top Rated
              </label>
            </div>
          </div>
        </div>

        <!-- Bottom Sticky Apply Filters Button with live count -->
        <div class="drawer-apply-footer">
          <a href="/designs" class="drawer-clear-btn" id="drawerClearBtn">Clear all</a>
          <button type="submit" class="apply-filters-btn" id="drawerApplyBtn">
            Show <%= totalCount %> <%= (totalCount === 1) ? 'design' : 'designs' %>
          </button>
        </div>
      </form>
    </aside>

    <!-- Right Main Content Area -->
    <main class="shop-main-content">
      <!-- Mobile Smart Sticky Toolbar Wrapper (< 768px): Contains Search + Filters/Sort row -->
      <div class="mobile-sticky-toolbar-wrapper" id="mobileStickyToolbar">
        <!-- Standalone Search Bar: Full width, 48px height, rounded 14px, soft beige -->
        <div class="designs-search-bar" id="designsSearchBar">
          <form action="/designs" method="GET" class="designs-search-form" id="shopSearchForm" autocomplete="off">
            <i class="fa-solid fa-magnifying-glass search-icon"></i>
            <input type="text" name="search" id="shopSearchInput" placeholder="Search designs..." value="<%= search || '' %>" autocomplete="off" aria-label="Search designs">
            <button type="button" class="search-clear-btn <%= search ? 'visible' : '' %>" id="searchClearBtn" aria-label="Clear search">
              <i class="fa-solid fa-xmark"></i>
            </button>
            <% if (selectedCategory) { %><input type="hidden" name="category" value="<%= selectedCategory.slug %>"><% } %>
            <% if (selectedFormat) { %><input type="hidden" name="format" value="<%= selectedFormat %>"><% } %>
            <% if (max_price) { %><input type="hidden" name="max_price" value="<%= max_price %>"><% } %>
            <% if (sort && sort !== 'latest') { %><input type="hidden" name="sort" value="<%= sort %>"><% } %>
          </form>
          <!-- Live Suggestions Dropdown Container -->
          <div class="search-suggestions-dropdown" id="searchSuggestionsDropdown" style="display: none;"></div>
        </div>

        <!-- 1. Dedicated Mobile Unified Toolbar (< 768px): Filters (with count badge) + Sort Dropdown + Grid/List Toggle in ONE row -->
        <div class="mobile-shop-toolbar">
          <button type="button" class="mobile-toolbar-btn mobile-filter-btn" id="openMobileFilterBtn" aria-label="Open Filters">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="4" y1="21" x2="4" y2="14"/><line x1="4" y1="10" x2="4" y2="3"/>
              <line x1="12" y1="21" x2="12" y2="12"/><line x1="12" y1="8" x2="12" y2="3"/>
              <line x1="20" y1="21" x2="20" y2="16"/><line x1="20" y1="12" x2="20" y2="3"/>
              <line x1="1" y1="14" x2="7" y2="14"/><line x1="9" y1="8" x2="15" y2="8"/><line x1="17" y1="16" x2="23" y2="16"/>
            </svg>
            <span>Filters</span>
            <% if (hasActiveFilters) { %><span class="mobile-filter-dot"></span><% } %>
            <span class="mobile-toolbar-count">(<%= totalCount %>)</span>
          </button>

          <%- include('../partials/sort-dropdown', {
            id: 'mobile_sort_dd',
            currentSort: sort || 'latest',
            actionType: 'ajax'
          }) %>

          <div class="mobile-view-toggle">
            <button type="button" class="view-btn active" data-view="grid" title="Grid View" aria-label="Grid View"><i class="fa-solid fa-border-all"></i></button>
            <button type="button" class="view-btn" data-view="list" title="List View" aria-label="List View"><i class="fa-solid fa-list"></i></button>
          </div>
        </div>
      </div>

      <!-- 3. Desktop Controls Top Bar (>= 768px) -->
      <div class="shop-controls-bar">
        <!-- Exact Two-Line Results Count -->
        <div class="results-count-twoline">
          <span class="rc-line1">Showing</span>
          <span class="rc-line2"><strong><%= fromNum %>–<%= toNum %></strong> of <strong><%= totalDisplay %></strong> designs</span>
        </div>

        <!-- Vertical Divider -->
        <div class="toolbar-divider"></div>
        
        <!-- Sort Dropdown at top right of product grid -->
        <div class="controls-right">
          <%- include('../partials/sort-dropdown', {
            id: 'desktop_sort_dd',
            currentSort: sort || 'latest',
            actionType: 'ajax'
          }) %>

          <div class="view-toggle-btns">
            <button class="view-btn active" title="Grid View" type="button"><i class="fa-solid fa-border-all"></i></button>
            <button class="view-btn" title="List View" type="button"><i class="fa-solid fa-list"></i></button>
          </div>
        </div>
      </div>

      <!-- 4. Category Filter Pills: Horizontally Scrollable with Scroll-Snap, 44px height, Real DB Counts -->
      <div class="category-pills-scroll-row hide-scrollbar" id="categoryPillsRow">
        <a href="/designs<%= search ? '?search=' + encodeURIComponent(search) : '' %>" class="cat-pill-btn <%= !selectedCategory ? 'active' : '' %>">
          All (<%= typeof totalActiveDesigns !== 'undefined' ? totalActiveDesigns : totalCount %>)
        </a>
        <% categories.forEach(cat => { %>
          <% if (typeof hideEmptyCategories === 'undefined' || !hideEmptyCategories || cat.design_count > 0 || (selectedCategory && selectedCategory.slug === cat.slug)) { %>
            <a href="/designs?category=<%= cat.slug %><%= search ? '&search=' + encodeURIComponent(search) : '' %>" class="cat-pill-btn <%= selectedCategory && selectedCategory.slug === cat.slug ? 'active' : '' %>" data-slug="<%= cat.slug %>">
              <%= cat.name %> (<%= cat.design_count %>)
            </a>
          <% } %>
        <% }) %>
      </div>

      <% if (hasActiveFilters) { %>
        <div class="active-filters-bar">
          <span class="active-filters-label">Active Filters:</span>
          <div class="active-chips-wrapper">
            <% if (search) { %>
              <a href="<%= buildRemoveUrl('search') %>" class="active-filter-chip">
                Search: "<%= search %>" <i class="fa-solid fa-xmark"></i>
              </a>
            <% } %>

            <% if (selectedCategory) { %>
              <a href="<%= buildRemoveUrl('category') %>" class="active-filter-chip">
                Category: <%= selectedCategory.name %> <i class="fa-solid fa-xmark"></i>
              </a>
            <% } %>

            <% if (selectedFormat) { %>
              <a href="<%= buildRemoveUrl('format') %>" class="active-filter-chip">
                Format: <%= selectedFormat %> <i class="fa-solid fa-xmark"></i>
              </a>
            <% } %>

            <% if (max_price && Number(max_price) < 2000) { %>
              <a href="<%= buildRemoveUrl('max_price') %>" class="active-filter-chip">
                Max Price: ₹<%= max_price %> <i class="fa-solid fa-xmark"></i>
              </a>
            <% } %>

            <% if (min_rating) { %>
              <a href="<%= buildRemoveUrl('min_rating') %>" class="active-filter-chip">
                Rating: <%= min_rating %>★+ <i class="fa-solid fa-xmark"></i>
              </a>
            <% } %>

            <a href="/designs" class="clear-all-filters-btn">Clear All</a>
          </div>
        </div>
      <% } %>

      <!-- 5. Product Grid & Friendly Empty State -->
      <% if (designs.length === 0) { %>
        <div class="no-results-box empty-state-box">
          <div class="empty-icon-circle">
            <i class="fa-solid fa-magnifying-glass"></i>
          </div>
          <h3><%= selectedCategory ? ('No designs found in ' + selectedCategory.name) : 'No designs found' %></h3>
          <p>We couldn't find any designs matching your current filters. Clear filters or explore another category.</p>
          <a href="/designs" class="btn btn-primary browse-all-designs-btn"><i class="fa-solid fa-rotate-left" style="margin-right: 6px;"></i> Clear filters</a>
        </div>
      <% } else { %>
        <!-- 2-column mobile grid (<768px), 4-column desktop grid (>=768px) -->
        <div class="grid-4-strict" id="designsGrid">
          <% designs.forEach(design => { %>
            <%- include('../partials/design-card', {
              design,
              userPurchasedDesignIds: typeof userPurchasedDesignIds !== 'undefined' ? userPurchasedDesignIds : [],
              userWishlistDesignIds: typeof userWishlistDesignIds !== 'undefined' ? userWishlistDesignIds : [],
              siteSettings: typeof siteSettings !== 'undefined' ? siteSettings : {}
            }) %>
          <% }) %>
        </div>

        <!-- Infinite Scroll / Load More (24 per page) -->
        <div class="load-more-container" id="loadMoreContainer" style="<%= pageNum >= totalPages ? 'display: none;' : '' %>">
          <button type="button" class="load-more-btn" id="loadMoreBtn" data-page="<%= pageNum %>" data-total-pages="<%= totalPages %>">
            <span>Load more (<%= Math.max(0, totalCount - (pageNum * pageLimit)) %> remaining)</span>
            <i class="fa-solid fa-arrow-down"></i>
          </button>
          <div class="load-more-spinner" id="loadMoreSpinner" style="display: none;">
            <div class="spinner-dot"></div>
            <div class="spinner-dot"></div>
            <div class="spinner-dot"></div>
          </div>
        </div>

        <!-- Desktop Pagination Controls Bar (>= 768px) -->
        <% if (totalPages > 1) { %>
          <div class="pagination-wrapper desktop-pagination-only">
            <a href="/designs?page=<%= Math.max(1, pageNum - 1) %><%= search ? '&search=' + encodeURIComponent(search) : '' %><%= selectedCategory ? '&category=' + selectedCategory.slug : '' %><%= selectedFormat ? '&format=' + selectedFormat : '' %><%= max_price ? '&max_price=' + max_price : '' %><%= min_rating ? '&min_rating=' + min_rating : '' %><%= sort && sort !== 'latest' ? '&sort=' + sort : '' %>" class="page-nav-btn <%= pageNum <= 1 ? 'disabled' : '' %>"><i class="fa-solid fa-chevron-left"></i></a>
            <% for (let i = 1; i <= Math.min(5, totalPages); i++) { %>
              <a href="/designs?page=<%= i %><%= search ? '&search=' + encodeURIComponent(search) : '' %><%= selectedCategory ? '&category=' + selectedCategory.slug : '' %><%= selectedFormat ? '&format=' + selectedFormat : '' %><%= max_price ? '&max_price=' + max_price : '' %><%= min_rating ? '&min_rating=' + min_rating : '' %><%= sort && sort !== 'latest' ? '&sort=' + sort : '' %>" class="page-num-btn <%= pageNum === i ? 'active' : '' %>"><%= i %></a>
            <% } %>
            <% if (totalPages > 5) { %>
              <span class="page-dots">...</span>
              <a href="/designs?page=<%= totalPages %><%= search ? '&search=' + encodeURIComponent(search) : '' %><%= selectedCategory ? '&category=' + selectedCategory.slug : '' %><%= selectedFormat ? '&format=' + selectedFormat : '' %><%= max_price ? '&max_price=' + max_price : '' %><%= min_rating ? '&min_rating=' + min_rating : '' %><%= sort && sort !== 'latest' ? '&sort=' + sort : '' %>" class="page-num-btn <%= pageNum === totalPages ? 'active' : '' %>"><%= totalPages %></a>
            <% } %>
            <a href="/designs?page=<%= Math.min(totalPages, pageNum + 1) %><%= search ? '&search=' + encodeURIComponent(search) : '' %><%= selectedCategory ? '&category=' + selectedCategory.slug : '' %><%= selectedFormat ? '&format=' + selectedFormat : '' %><%= max_price ? '&max_price=' + max_price : '' %><%= min_rating ? '&min_rating=' + min_rating : '' %><%= sort && sort !== 'latest' ? '&sort=' + sort : '' %>" class="page-nav-btn <%= pageNum >= totalPages ? 'disabled' : '' %>"><i class="fa-solid fa-chevron-right"></i></a>
          </div>
        <% } %>
      <% } %>
    </main>
  </div>
</div>

<!-- Floating Back to Top Button -->
<button type="button" class="back-to-top-btn" id="backToTopBtn" aria-label="Back to top" title="Back to top">
  <i class="fa-solid fa-arrow-up"></i>
</button>

<script>
  function toggleAccordion(header) {
    const content = header.nextElementSibling;
    const icon = header.querySelector('.accordion-icon');
    if (content.classList.contains('open')) {
      content.classList.remove('open');
      if (icon) { icon.classList.remove('fa-chevron-up'); icon.classList.add('fa-chevron-down'); }
    } else {
      content.classList.add('open');
      if (icon) { icon.classList.remove('fa-chevron-down'); icon.classList.add('fa-chevron-up'); }
    }
  }

  function handleFilterChange(input) {
    if (!input) return;
    if (input.name === 'category') {
      document.querySelectorAll('.cat-chip-label').forEach(el => el.classList.remove('active'));
      const parent = input.closest('.cat-chip-label');
      if (parent) parent.classList.add('active');
    } else if (input.name === 'price_preset') {
      document.querySelectorAll('.price-preset-chip').forEach(el => el.classList.remove('active'));
      const parent = input.closest('.price-preset-chip');
      if (parent) parent.classList.add('active');
    }

    // On desktop screen (>= 768px), submit immediately for live filtering
    if (window.innerWidth >= 768) {
      if (input.form) input.form.submit();
    }
  }
</script>

<!-- Mobile shop interactive behaviors -->
<script src="/public/js/shop-mobile.js" defer></script>

<%- include('../partials/footer') %>
