<%- include('../partials/header') %>

<div class="container section" style="padding-top: 1.8rem; padding-bottom: 3rem;">
  <div class="section-header" style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem; margin-bottom: 1.5rem;">
    <div>
      <h1 style="font-family: var(--font-heading, serif); font-size: 2rem; font-weight: 700; color: var(--text-dark, #231815); margin: 0 0 0.3rem 0;">My Saved Wishlist</h1>
      <p style="margin: 0; color: var(--text-muted, #8C7F79); font-size: 0.92rem;">
        Your saved favorite embroidery designs (<span id="wishlistCountHeader"><%= items ? items.length : 0 %></span>)
      </p>
    </div>
    <% if (items && items.length > 1) { %>
      <div>
        <%- include('../partials/sort-dropdown', {
          id: 'wishlist_sort_dd',
          currentSort: typeof sort !== 'undefined' ? sort : 'latest',
          actionType: 'url'
        }) %>
      </div>
    <% } %>
  </div>

  <% if (typeof inactiveCount !== 'undefined' && inactiveCount > 0) { %>
    <div class="alert alert-info" style="margin-bottom: 1.5rem; border-radius: 10px; display: flex; align-items: center; gap: 8px; background: #EBF3FA; color: #1D6F93; padding: 0.8rem 1.2rem; font-size: 0.88rem;">
      <i class="fa-solid fa-circle-info"></i>
      <span><%= inactiveCount %> unavailable <%= inactiveCount === 1 ? 'design has' : 'designs have' %> been hidden from your wishlist.</span>
    </div>
  <% } %>

  <!-- Authenticated User Server-Rendered Wishlist -->
  <% if (!isGuest) { %>
    <% if (!items || items.length === 0) { %>
      <div id="authEmptyWishlist" style="text-align: center; padding: 4rem 2rem; background: var(--bg-soft, #FAF6F0); border-radius: 16px; border: 1px solid var(--border-light, #E8E0D5);">
        <i class="fa-regular fa-heart" style="font-size: 3.5rem; color: var(--primary, #900C3F); margin-bottom: 1rem;"></i>
        <h3 style="font-family: var(--font-heading, serif); font-size: 1.5rem; color: var(--text-dark, #231815); margin-bottom: 0.5rem;">Your wishlist is currently empty</h3>
        <p style="color: var(--text-muted, #8C7F79); font-size: 0.92rem; margin: 0 auto 1.5rem; max-width: 400px;">Click the heart icon on any design to save it here for later purchase.</p>
        <a href="/designs" class="btn btn-primary" style="padding: 0.75rem 2rem; border-radius: 30px; font-weight: 600;">Explore Designs</a>
      </div>
    <% } else { %>
      <div class="grid-4-strict grid-3" id="authWishlistGrid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 1.5rem;">
        <% items.forEach(design => { %>
          <%
            const prev = (typeof getPrimaryPreview === 'function') ? getPrimaryPreview(design) : null;
            const thumbUrl = prev?.thumbUrl || design.thumbnail_image || design.primary_image || '/public/images/placeholder-preview.svg';
            const largeUrl = prev?.largeUrl || design.primary_image || thumbUrl;
            const curP = (design.sale_price !== null && design.sale_price !== undefined && design.sale_price !== '') ? parseFloat(design.sale_price) : parseFloat(design.price);
            const origP = parseFloat(design.price || 0);
            const hasDisc = origP > curP && origP > 0;
            const discPct = hasDisc ? Math.round(((origP - curP) / origP) * 100) : 0;
          %>
          <div class="listing-product-card wishlist-card-item" id="wishCard-<%= design.id %>" data-design-id="<%= design.id %>" style="background: #FFF; border: 1px solid #E8E0D5; border-radius: 14px; overflow: hidden; display: flex; flex-direction: column;">
            <div class="card-image-box" style="position: relative; aspect-ratio: 1/1; background: #FAF6F0; overflow: hidden;">
              <a href="/design/<%= design.slug %>" class="card-img-link" aria-label="<%= design.title %>" style="display: block; width: 100%; height: 100%;">
                <img src="<%= thumbUrl %>" alt="<%= prev?.altText || design.title %>" width="300" height="300" loading="lazy" style="width: 100%; height: 100%; object-fit: cover;" onerror="if (this.src !== '<%= largeUrl %>' && '<%= largeUrl %>' !== '/public/images/placeholder-preview.svg') { this.src = '<%= largeUrl %>'; } else if (this.src.indexOf('placeholder-preview.svg') === -1) { this.src = '/public/images/placeholder-preview.svg'; }">
              </a>
              <button type="button" class="wishlist-round-btn wishlist-btn active" data-id="<%= design.id %>" aria-label="Remove from Wishlist" title="Remove from Wishlist" style="position: absolute; top: 10px; right: 10px; width: 36px; height: 36px; border-radius: 50%; background: #FFF; border: 1px solid #E8E0D5; cursor: pointer; display: flex; align-items: center; justify-content: center; color: var(--primary, #900C3F); box-shadow: 0 2px 6px rgba(0,0,0,0.1);">
                <i class="fa-solid fa-heart"></i>
              </button>
            </div>
            <div class="card-body-content" style="padding: 1rem; flex: 1; display: flex; flex-direction: column;">
              <span class="card-item-category" style="font-size: 0.75rem; text-transform: uppercase; color: var(--text-muted, #8C7F79); font-weight: 600; margin-bottom: 4px;"><%= design.category_name || 'Blouse Designs' %></span>
              <h3 class="card-item-title" style="font-size: 0.95rem; font-weight: 600; margin: 0 0 0.5rem; line-height: 1.3;">
                <a href="/design/<%= design.slug %>" style="color: #231815; text-decoration: none;"><%= design.title %></a>
              </h3>
              <div class="card-price-action-row" style="margin-top: auto; padding-top: 0.6rem; display: flex; align-items: center; justify-content: space-between;">
                <div class="card-price-group" style="display: flex; align-items: baseline; gap: 6px;">
                  <% if (hasDisc) { %>
                    <span class="old-price" style="font-size: 0.8rem; color: #8C7F79; text-decoration: line-through;">₹<%= origP %></span>
                  <% } %>
                  <span class="current-price" style="font-size: 1.1rem; font-weight: 700; color: #231815;">₹<%= curP %></span>
                  <% if (hasDisc) { %>
                    <span class="discount-badge" style="font-size: 0.7rem; color: #2E7D32; font-weight: 700;"><%= discPct %>% OFF</span>
                  <% } %>
                </div>
                <button type="button" class="card-cart-btn-instant btn btn-primary btn-sm" data-id="<%= design.id %>" aria-label="Add to Cart" title="Add to Cart" style="border-radius: 8px; padding: 6px 12px; font-size: 0.82rem; display: flex; align-items: center; gap: 6px;">
                  <i class="fa-solid fa-cart-shopping"></i> Add to Cart
                </button>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>

  <% } else { %>
    <!-- Guest User Client-Hydrated Wishlist -->
    <div id="guestLoading" style="text-align: center; padding: 3rem 1rem; color: var(--text-muted, #8C7F79);">
      <i class="fa-solid fa-spinner fa-spin" style="font-size: 2rem; color: var(--primary, #900C3F); margin-bottom: 0.8rem;"></i>
      <p>Loading your saved wishlist items...</p>
    </div>

    <div id="guestEmptyWishlist" style="display: none; text-align: center; padding: 4rem 2rem; background: var(--bg-soft, #FAF6F0); border-radius: 16px; border: 1px solid var(--border-light, #E8E0D5);">
      <i class="fa-regular fa-heart" style="font-size: 3.5rem; color: var(--primary, #900C3F); margin-bottom: 1rem;"></i>
      <h3 style="font-family: var(--font-heading, serif); font-size: 1.5rem; color: var(--text-dark, #231815); margin-bottom: 0.5rem;">Your wishlist is currently empty</h3>
      <p style="color: var(--text-muted, #8C7F79); font-size: 0.92rem; margin: 0 auto 1.5rem; max-width: 400px;">Click the heart icon on any design to save it here for later purchase.</p>
      <a href="/designs" class="btn btn-primary" style="padding: 0.75rem 2rem; border-radius: 30px; font-weight: 600;">Explore Designs</a>
    </div>

    <div class="grid-4-strict grid-3" id="guestWishlistGrid" style="display: none; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 1.5rem;"></div>
  <% } %>
</div>

<script>
  // Guest Wishlist Client Loader
  document.addEventListener('DOMContentLoaded', async () => {
    const isGuest = <%= isGuest ? 'true' : 'false' %>;
    if (!isGuest) return;

    const loader = document.getElementById('guestLoading');
    const emptyBox = document.getElementById('guestEmptyWishlist');
    const grid = document.getElementById('guestWishlistGrid');
    const countSpan = document.getElementById('wishlistCountHeader');

    try {
      const raw = localStorage.getItem('aruvi_guest_wishlist');
      const ids = raw ? JSON.parse(raw) : [];

      if (!Array.isArray(ids) || ids.length === 0) {
        if (loader) loader.style.display = 'none';
        if (emptyBox) emptyBox.style.display = 'block';
        if (countSpan) countSpan.textContent = '0';
        return;
      }

      if (countSpan) countSpan.textContent = ids.length;

      const res = await fetch(`/api/designs/by-ids?ids=${ids.join(',')}`);
      if (!res.ok) throw new Error('Failed to load designs');
      const data = await res.json();
      const designs = data.designs || [];

      if (loader) loader.style.display = 'none';

      if (designs.length === 0) {
        if (emptyBox) emptyBox.style.display = 'block';
        if (countSpan) countSpan.textContent = '0';
        return;
      }

      if (countSpan) countSpan.textContent = designs.length;

      grid.innerHTML = designs.map(d => {
        const thumbUrl = d.preview?.thumbUrl || d.thumb_url || d.thumbnail_image || d.primary_image || '/public/images/placeholder-preview.svg';
        const largeUrl = d.preview?.largeUrl || d.large_url || d.primary_image || thumbUrl;
        const curP = (d.sale_price !== null && d.sale_price !== undefined && d.sale_price !== '') ? parseFloat(d.sale_price) : parseFloat(d.price);
        const origP = parseFloat(d.price || 0);
        const hasDisc = origP > curP && origP > 0;
        const discPct = hasDisc ? Math.round(((origP - curP) / origP) * 100) : 0;

        return `
          <div class="listing-product-card wishlist-card-item" id="wishCard-${d.id}" data-design-id="${d.id}" style="background: #FFF; border: 1px solid #E8E0D5; border-radius: 14px; overflow: hidden; display: flex; flex-direction: column;">
            <div class="card-image-box" style="position: relative; aspect-ratio: 1/1; background: #FAF6F0; overflow: hidden;">
              <a href="/design/${d.slug}" class="card-img-link" aria-label="${d.title}" style="display: block; width: 100%; height: 100%;">
                <img src="${thumbUrl}" alt="${d.title}" width="300" height="300" loading="lazy" style="width: 100%; height: 100%; object-fit: cover;" onerror="if (this.src !== '${largeUrl}') { this.src = '${largeUrl}'; } else { this.onerror=null; this.src='/public/images/placeholder-preview.svg'; }">
              </a>
              <button type="button" class="wishlist-round-btn wishlist-btn active" data-id="${d.id}" aria-label="Remove from Wishlist" title="Remove from Wishlist" style="position: absolute; top: 10px; right: 10px; width: 36px; height: 36px; border-radius: 50%; background: #FFF; border: 1px solid #E8E0D5; cursor: pointer; display: flex; align-items: center; justify-content: center; color: var(--primary, #900C3F); box-shadow: 0 2px 6px rgba(0,0,0,0.1);">
                <i class="fa-solid fa-heart"></i>
              </button>
            </div>
            <div class="card-body-content" style="padding: 1rem; flex: 1; display: flex; flex-direction: column;">
              <span class="card-item-category" style="font-size: 0.75rem; text-transform: uppercase; color: var(--text-muted, #8C7F79); font-weight: 600; margin-bottom: 4px;">${d.category_name || 'Blouse Designs'}</span>
              <h3 class="card-item-title" style="font-size: 0.95rem; font-weight: 600; margin: 0 0 0.5rem; line-height: 1.3;">
                <a href="/design/${d.slug}" style="color: #231815; text-decoration: none;">${d.title}</a>
              </h3>
              <div class="card-price-action-row" style="margin-top: auto; padding-top: 0.6rem; display: flex; align-items: center; justify-content: space-between;">
                <div class="card-price-group" style="display: flex; align-items: baseline; gap: 6px;">
                  ${hasDisc ? `<span class="old-price" style="font-size: 0.8rem; color: #8C7F79; text-decoration: line-through;">₹${origP}</span>` : ''}
                  <span class="current-price" style="font-size: 1.1rem; font-weight: 700; color: #231815;">₹${curP}</span>
                  ${hasDisc ? `<span class="discount-badge" style="font-size: 0.7rem; color: #2E7D32; font-weight: 700;">${discPct}% OFF</span>` : ''}
                </div>
                <button type="button" class="card-cart-btn-instant btn btn-primary btn-sm" data-id="${d.id}" aria-label="Add to Cart" title="Add to Cart" style="border-radius: 8px; padding: 6px 12px; font-size: 0.82rem; display: flex; align-items: center; gap: 6px;">
                  <i class="fa-solid fa-cart-shopping"></i> Add to Cart
                </button>
              </div>
            </div>
          </div>
        `;
      }).join('');

      grid.style.display = 'grid';

    } catch (err) {
      console.warn('Guest wishlist error:', err);
      if (loader) loader.style.display = 'none';
      if (emptyBox) emptyBox.style.display = 'block';
    }
  });
</script>

<%- include('../partials/footer') %>
